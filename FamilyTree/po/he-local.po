#, python-format
msgid "Family Tree for %s"
msgstr "אילן־יוחסין עבור %s"

msgid "Paper too small"
msgstr "דף קטן מדי"

msgid "Some elements may not appear or be badly rendered."
msgstr "ייתכן שחלק מהרכיבים לא יופיעו או יוצגו באופן לקוי."

msgid "Anonymous"
msgstr "אלמוני"

msgid "born"
msgstr "נולד"

msgid "baptised"
msgstr "נטבל"

msgid "died"
msgstr "נפטר"

msgid "buried"
msgstr "נקבר"

msgid "cremated"
msgstr "נשרף"

msgid "married"
msgstr "נישא"

msgid "divorced"
msgstr "התגרש"

msgid "resident"
msgstr "תושב"

#, python-format
msgid "on %(ymd_date)s"
msgstr "ב־%(ymd_date)s"

#, python-format
msgid "in %(ym_date)s"
msgstr "ב־%(ym_date)s"

#, python-format
msgid "in %(y_date)s"
msgstr "ב־%(y_date)s"

#, python-format
msgid "on %(placeholder)s"
msgstr "ב־%(placeholder)s"

#, python-format
msgid "on %(placeholder)s (%(partial)s)"
msgstr "ב־%(placeholder)s (%(partial)s)"

#, python-format
msgid "in %(place)s"
msgstr "בתוך %(place)s"

#, python-format
msgid "(%(description)s)"
msgstr "%(description)s"

msgid "The center family for the tree"
msgstr "המשפחה המרכזית עבור האילן"

msgid "Ancestor Generations"
msgstr "דורות אבות"

msgid "The number of ancestor generations to include in the tree"
msgstr "מספר אב דורות שיש לכלול באילן"

msgid "Descendant Generations"
msgstr "דורות צאצאים"

msgid "The number of descendant generations to include in the tree"
msgstr "מספר צאצא דורות שיש לכלול באילן"

msgid "Kekule number of husband"
msgstr "מספר קקולה של הבעל"

msgid ""
"The Kekule number of the husband (central family). Set 0 to not show Kekule "
"numbers"
msgstr "מספר קקולה של הבעל (המשפחה המרכזית). הגדרת 0 לאי־הצגת מספרי קקולה"

msgid "Scale to fit on a single page"
msgstr "שינוי קנה מידה להתאמה לעמוד יחיד"

msgid "Whether to scale to fit on a single page."
msgstr "האם לשנות קנה מידה כדי להתאים לעמוד יחיד."

msgid "No color"
msgstr "ללא צבע"

msgid "First generation"
msgstr "דור ראשון"

msgid "Second generation"
msgstr "דור שני"

msgid "Third generation"
msgstr "דור שלישי"

msgid "Male line"
msgstr "קו זכרי"

msgid "Male line and illegitimate children"
msgstr "קו זכרי וילדים שנולדו מחוץ לנישואין"

msgid "Female line"
msgstr "קו נקבי"

msgid "Shuffle colors"
msgstr "ערבוב צבעים"

msgid "Whether to shuffle colors or order them in rainbow fashion."
msgstr "האם לערבב צבעים או לסדר אותם בסגנון קשת."

msgid "Replace first name with call name"
msgstr "החלפת שם פרטי בשם מקובל"

msgid "Underline call name in first name / add call name to first name"
msgstr "הדגשת שם קריאה בשם הפרטי / הוספת שם קריאה לשם הפרטי"

msgid "Include Occupation"
msgstr "הכללת עיסוק"

msgid "Include Residence"
msgstr "הכללת מגורים"

msgid "Print event data (dead person)"
msgstr "הדפסת נתוני אירוע (אדם שנפטר)"

msgid "Year only"
msgstr "שנה בלבד"

msgid "Full date"
msgstr "תאריך מלא"

msgid "Full date and place"
msgstr "תאריך מלא ומקום"

msgid "Print event data (living person)"
msgstr "הדפסת נתוני אירוע (אדם בחיים)"

msgid "Fall back to baptism if birth event missing"
msgstr "חזרה לאירוע טבילה אם אירוע לידה חסר"

msgid "Fall back to burial or cremation if death event missing"
msgstr "חזרה לאירוע קבורה או שרפה אם אירוע פטירה חסר"

msgid "Protect private items"
msgstr "הגנה על פריטים פרטיים"

msgid "Include event description"
msgstr "לכלול אירוע תיאור"

msgid "Text Options"
msgstr "מלל אפשרויות"

msgid "The style used for names."
msgstr "הסגנון שמשמש לשמות."

msgid "The style used for data (birth, death, marriage, divorce)."
msgstr "הסגנון שמשמש עבור נתונים (לידה, פטירה, נישואין, גירושין)."

msgid "Produces a graphical family tree."
msgstr "מפיק אילן־יוחסין גרפי."
