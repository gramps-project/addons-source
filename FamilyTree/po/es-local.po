#, python-format
msgid "Family Tree for %s"
msgstr "Árbol de familia para %s"

msgid "Paper too small"
msgstr "El papel es demasiado pequeño"

msgid "Some elements may not appear or be badly rendered."
msgstr "Algunos elementos podrían no aparecer o distorsionarse."

msgid "Anonymous"
msgstr "Anónimo"

msgid "born"
msgstr "nacimiento"

msgid "baptised"
msgstr "bautizo"

msgid "died"
msgstr "defunción"

msgid "buried"
msgstr "sepultura"

msgid "cremated"
msgstr "cremación"

msgid "married"
msgstr "matrimonio"

msgid "divorced"
msgstr "divorcio"

msgid "resident"
msgstr "residente"

#, python-format
msgid "on %(ymd_date)s"
msgstr "el %(ymd_date)s"

#, python-format
msgid "in %(ym_date)s"
msgstr "en %(ym_date)s"

#, python-format
msgid "in %(y_date)s"
msgstr "en %(y_date)s"

#, python-format
msgid "on %(placeholder)s"
msgstr "sobre %(placeholder)s"

#, python-format
msgid "on %(placeholder)s (%(partial)s)"
msgstr "sobre %(placeholder)s %(partial)s"

#, python-format
msgid "in %(place)s"
msgstr "interno a %(place)s"

#, python-format
msgid "(%(description)s)"
msgstr "(%(description)s)"

msgid "The center family for the tree"
msgstr "La familia de centro para el árbol"

msgid "Ancestor Generations"
msgstr "Generaciones de ancestros"

msgid "The number of ancestor generations to include in the tree"
msgstr "El número de generaciones de ancestros para incluir en el árbol"

msgid "Descendant Generations"
msgstr "Generaciones descendentes"

msgid "The number of descendant generations to include in the tree"
msgstr "El número de generaciones descendientes para incluir en el árbol"

msgid "Kekule number of husband"
msgstr "Número de marido Kekule"

msgid ""
"The Kekule number of the husband (central family). Set 0 to not show Kekule "
"numbers"
msgstr ""
"El número del marido Kekule (familia central). Establezca 0 para no mostrar "
"números de Kekule"

msgid "Scale to fit on a single page"
msgstr "Escala para caber en una sola página"

msgid "Whether to scale to fit on a single page."
msgstr "Si o no escalar para caber en una única página."

msgid "No color"
msgstr "Sin color"

msgid "First generation"
msgstr "Generación primera"

msgid "Second generation"
msgstr "Generación segunda"

msgid "Third generation"
msgstr "Generación tercera"

msgid "Male line"
msgstr "Línea masculina"

msgid "Male line and illegitimate children"
msgstr "Línea masculina e hijos ilegítimos"

msgid "Female line"
msgstr "Línea femenina"

msgid "Shuffle colors"
msgstr "Arrastrar colores"

msgid "Whether to shuffle colors or order them in rainbow fashion."
msgstr "Si arrastra colores u ordenarles en modelo de arco iris."

msgid "Replace first name with call name"
msgstr "Reemplazar nombre de pila por apelativo"

msgid "Underline call name in first name / add call name to first name"
msgstr ""
"Subrayar nombre de llamada interna al nombre de pila / agregar nombre de "
"llamada al nombre de pila"

msgid "Include Occupation"
msgstr "Incluir Ocupación"

msgid "Include Residence"
msgstr "Incluir Residencia"

msgid "Print event data (dead person)"
msgstr "Declarar fecha de evento (persona fallecida)"

msgid "Year only"
msgstr "Solo año"

msgid "Full date"
msgstr "Fecha completa"

msgid "Full date and place"
msgstr "Fecha y lugar completos"

msgid "Print event data (living person)"
msgstr "Declara datos de evento (persona viva)"

msgid "Fall back to baptism if birth event missing"
msgstr "Regresar al bautismo si falta el evento de nacimiento"

msgid "Fall back to burial or cremation if death event missing"
msgstr "Retrocede al entierro o cremación si falta el evento de defunción"

msgid "Protect private items"
msgstr "Protege los elementos privados"

msgid "Include event description"
msgstr "Incluye descripción de evento"

msgid "Text Options"
msgstr "Opciones de Texto"

msgid "The style used for names."
msgstr "El estilo utilizado para nombres."

msgid "The style used for data (birth, death, marriage, divorce)."
msgstr ""
"El estilo utilizado para datos (nacimiento, defunción, matrimonio, divorcio)."

msgid "Produces a graphical family tree."
msgstr "Produce un árbol genealógico gráfico."
