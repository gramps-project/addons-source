msgid "Ancestry Table"
msgstr "Afkomsttabel"

msgid "Produces a table of ancestry about a person"
msgstr "Produceert een tabel van afkomst over een persoon"

#, python-format
msgid "Person %(name)s is not in the Database"
msgstr "Persoon %(name)s staat niet in de database"

#, python-format
msgid "Ancestry Table Report for %(name)s"
msgstr "Afkomsttabel-rapport voor %(name)s"

#, python-format
msgid "Generation %(gen_number)d"
msgstr "Generatie %(gen_number)d"

#, python-format
msgid "Number of Ancestors for %(name)s"
msgstr "Aantal voorouders voor %(name)s"

msgid "Generation"
msgstr "Generatie"

msgid "To start a new page after each generation."
msgstr "Na elke generatie een nieuwe pagina."

msgid "Number of ancestors per generation"
msgstr "Aantal voorouders per generatie"

msgid "Add a page with tne number of ancestors per generation."
msgstr "Een pagina toevoegen met het aantal voorouders per generatie."

msgid "Mask the name of the calendar in the dates"
msgstr "Masker de naam van de kalender in de data"

msgid ""
"By default, except for gregorian dates, Gramps shows the name of the "
"calendar in the dates."
msgstr ""
"Standaard toont Gramps, met uitzondering van de Gregoriaanse data, de naam "
"van de kalender in de data."

msgid "The style used for the title of the report."
msgstr "De stijl die wordt gebruikt voor de titel van het verslag."

msgid "The style used for the Sosa number of the paternal branch."
msgstr "De stijl die wordt gebruikt voor het Sosa-nummer in de parentele tak."

msgid "The style used for the Sosa number of the maternal branch."
msgstr "De stijl die wordt gebruikt voor het Sosa-nummer in de maternele tak."

msgid "The style used for the data of the males."
msgstr "De stijl die wordt gebruikt voor de gegevens van mannen."

msgid "The style used for the data of the females."
msgstr "De stijl die wordt gebruikt voor de gegevens van vrouwen."

msgid "The style used for the marriage."
msgstr "De stijl die wordt gebruikt voor het huwelijk."

msgid ""
"The style used for an empty row.\n"
"To enlarge the height of the empty row, just increase the size of the font."
msgstr ""
"De stijl die wordt gebruikt voor een lege rij.\n"
"Vergroot de grootte van het lettertype om de hoogte ervan te vergroten."

msgid ""
"The style used for the header table of the number of ancestors per "
"generation."
msgstr ""
"De stijl die wordt gebruikt voor de koptabel met het aantal voorouders per "
"generatie."

msgid "The style used for the number of ancestors per generation."
msgstr "De stijl die wordt gebruikt voor het aantal voorouders per generatie."

msgid ""
"The style used for the total line of the number of ancestors per generation."
msgstr ""
"De stijl die wordt gebruikt voor de regel met het totaal van het aantal "
"voorouders per generatie."
