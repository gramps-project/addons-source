#, python-format
msgid "Person %(name)s is not in the Database"
msgstr "Osoba, %(name)s, nie znajduje się w bazie danych"

msgid "To start a new page after each generation."
msgstr "Rozpocznij nową stronę po każdym pokoleniu."

msgid ""
"By default, except for gregorian dates, Gramps shows the name of the "
"calendar in the dates."
msgstr ""
"Domyślnie, z wyjątkiem dat gregoriańskich, Gramps pokazuje nazwę kalendarza "
"w datach."

msgid "The style used for the title of the report."
msgstr "Styl używany do tytułu raportu."

msgid ""
"The style used for an empty row.\n"
"To enlarge the height of the empty row, just increse the size of the police."
msgstr ""
"Styl używany dla pustego rzędu. \n"
"Aby powiększyć wysokość pustego wiersza, zwiększ rozmiar czcionki."
