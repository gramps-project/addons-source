msgid "Ancestry Table"
msgstr "Tabela de ascendência"

msgid "Produces a table of ancestry about a person"
msgstr "Produz uma tabela de ascendentes de um indivíduo"

#, python-format
msgid "Person %(name)s is not in the Database"
msgstr "O %(name)s do indivíduo não está na base de dados"

#, python-format
msgid "Ancestry Table Report for %(name)s"
msgstr "Tabela de ascendência de %(name)s"

#, python-format
msgid "Generation %(gen_number)d"
msgstr "Geração %(gen_number)d"

#, python-format
msgid "Number of Ancestors for %(name)s"
msgstr "Número de ascendentes de %(name)s"

msgid "Generation"
msgstr "Geração"

msgid "To start a new page after each generation."
msgstr "Iniciar uma nova página após cada geração."

msgid "Number of ancestors per generation"
msgstr "Número de ascendentes por geração"

msgid "Add a page with tne number of ancestors per generation."
msgstr "Adicionar uma página com o número de ascendentes por geração."

msgid "Mask the name of the calendar in the dates"
msgstr "Mascarar o nome do calendário nas datas"

msgid ""
"By default, except for gregorian dates, Gramps shows the name of the "
"calendar in the dates."
msgstr ""
"Por defeito, excepto nas datas gregorianas, o Gramps mostra o nome do "
"calendário nas datas."

msgid "The style used for the title of the report."
msgstr "O estilo usado para o título do relatório."

msgid "The style used for the Sosa number of the paternal branch."
msgstr "O estilo usado para o o número Sosa no ramo paterno."

msgid "The style used for the Sosa number of the maternal branch."
msgstr "O estilo usado para o número Sosa no ramo materno."

msgid "The style used for the data of the males."
msgstr "O estilo usado para os dados dos homens."

msgid "The style used for the data of the females."
msgstr "O estilo usado para os dados das mulheres."

msgid "The style used for the marriage."
msgstr "O estilo usado para casamentos."

msgid ""
"The style used for an empty row.\n"
"To enlarge the height of the empty row, just increse the size of the police."
msgstr ""
"O estilo usado para uma linha vazia.\n"
"Para aumentar a altura da linha, aumente o tamanho da letra."

msgid ""
"The style used for the header table of the number of ancestors per "
"generation."
msgstr ""
"O estilo usado para o cabeçalho na tabela do número de ascendentes por "
"geração."

msgid "The style used for the number of ancestors per generation."
msgstr "O estilo usado para o número de ascendentes por geração."

msgid ""
"The style used for the total line of the number of ancestors per generation."
msgstr ""
"O estilo usado para a linha de totais do número de ascendentes por geração."
