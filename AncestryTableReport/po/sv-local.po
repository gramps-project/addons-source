msgid "Ancestry Table"
msgstr "Antabell"

msgid "Produces a table of ancestry about a person"
msgstr "Producerar en tabell med anor för en person"

#, python-format
msgid "Person %(name)s is not in the Database"
msgstr "Personen %(name)s finns inte i databasen"

#, python-format
msgid "Ancestry Table Report for %(name)s"
msgstr "Antabells-rapport för %(name)s"

#, python-format
msgid "Generation %(gen_number)d"
msgstr "Generation %(gen_number)d"

#, python-format
msgid "Number of Ancestors for %(name)s"
msgstr "Antal förfäder för %(name)s"

msgid "Generation"
msgstr "Generation"

msgid "To start a new page after each generation."
msgstr "Att börja en ny sida efter varje generation."

msgid "Number of ancestors per generation"
msgstr "Antal förfäder per generation"

msgid "Add a page with tne number of ancestors per generation."
msgstr "Lägg till en sida med antalet förfäder per generation."

msgid "Mask the name of the calendar in the dates"
msgstr "Maskera kalendernamnet i datumen"

msgid ""
"By default, except for gregorian dates, Gramps shows the name of the "
"calendar in the dates."
msgstr ""
"Som standard, förutom för gregorianska datum, visar Gramps namnet på "
"kalendern i datumen."

msgid "The style used for the title of the report."
msgstr "Den mall, som används för rapportens titel."

msgid "The style used for the Sosa number of the paternal branch."
msgstr "Den stil som används för sosa-numret för faderns gren."

msgid "The style used for the Sosa number of the maternal branch."
msgstr "Den stil som används för Sosa-numret för möderne-grenen."

msgid "The style used for the data of the males."
msgstr "Stilen som används för data om män."

msgid "The style used for the data of the females."
msgstr "Stilen som används för data om kvinnor."

msgid "The style used for the marriage."
msgstr "Stilen som används för äktenskap."

msgid ""
"The style used for the header table of the number of ancestors per "
"generation."
msgstr ""
"Stilen som används för rubriktabellen över antalet förfäder per generation."

msgid "The style used for the number of ancestors per generation."
msgstr "Stilen som används för antalet förfäder per generation."

msgid ""
"The style used for the total line of the number of ancestors per generation."
msgstr ""
"Stilen som används för den totala linjen av antalet förfäder per generation."
