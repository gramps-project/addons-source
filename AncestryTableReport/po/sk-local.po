msgid "Ancestry Table"
msgstr "Tabuľka predkov"

msgid "Produces a table of ancestry about a person"
msgstr "Vytvára tabuľku predkov danej osoby"

#, python-format
msgid "Person %(name)s is not in the Database"
msgstr "Osoba %(name)s nie je v databáze"

#, python-format
msgid "Ancestry Table Report for %(name)s"
msgstr "Tabuľkový prehľad predkov pre %(name)s"

#, python-format
msgid "Generation %(gen_number)d"
msgstr "Generácia %(gen_number)d"

#, python-format
msgid "Number of Ancestors for %(name)s"
msgstr "Počet predkov pre %(name)s"

msgid "Generation"
msgstr "Generácia"

msgid "To start a new page after each generation."
msgstr "Po každej generácii začať novú stranu."

msgid "Number of ancestors per generation"
msgstr "Počet predkov podľa generácie"

msgid "Add a page with tne number of ancestors per generation."
msgstr "Pridať stránku s počtom predkov podľa generácie."

msgid "Mask the name of the calendar in the dates"
msgstr "Skryť názov kalendára v dátumoch"

msgid ""
"By default, except for gregorian dates, Gramps shows the name of the "
"calendar in the dates."
msgstr ""
"V predvolenom nastavení, s výnimkou gregoriánskych dátumov, Gramps v "
"dátumoch zobrazuje názov kalendára."

msgid "The style used for the title of the report."
msgstr "Štýl použitý pre názov správy."

msgid "The style used for the Sosa number of the paternal branch."
msgstr "Štýl použitý pre číslo Sosa otcovskej vetvy."

msgid "The style used for the Sosa number of the maternal branch."
msgstr "Štýl použitý pre číslo Sosa materskej vetvy."

msgid "The style used for the data of the males."
msgstr "Štýl použitý pre údaje mužov."

msgid "The style used for the data of the females."
msgstr "Štýl použitý pre údaje žien."

msgid "The style used for the marriage."
msgstr "Štýl použitý pre manželstvo."

msgid ""
"The style used for the header table of the number of ancestors per "
"generation."
msgstr "Štýl použitý pre záhlavie tabuľky počtu predkov podľa generácie."

msgid "The style used for the number of ancestors per generation."
msgstr "Štýl použitý pre počet predkov podľa generácie."

msgid ""
"The style used for the total line of the number of ancestors per generation."
msgstr "Štýl použitý pre súhrnný riadok počtu predkov podľa generácie."
