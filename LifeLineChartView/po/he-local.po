msgid ""
"LifeLineChartView dependencies are missing. It is not possible to use this "
"plugin without them."
msgstr "תלויות LifeLineChartView חסרות. אי־אפשר להשתמש במתקע זה בלעדיהן."

#, python-brace-format
msgid "cursor position at {date}"
msgstr "איות הסמן ב־{date}"

msgid "Hide person"
msgstr "להסתיר אדם"

msgid "Show person"
msgstr "הצגת אדם"

msgid "Show siblings"
msgstr "הצגת אחאים"

msgid "Hide siblings"
msgstr "הסתרת אחאים"

msgid "Show ancestors above "
msgstr "הצגת אבות למעלה "

msgid "General Layout"
msgstr "עימוד כללי"

msgid "Life Line Chart"
msgstr "תרשים קו חיים"

msgid "Zoom in"
msgstr "התקרבות"

msgid "Ctrl"
msgstr "Ctrl"

msgid "Mouse wheel"
msgstr "גלגל העכבר"

msgid "Zoom out"
msgstr "התרחקות"

msgid "Zoom to original"
msgstr "תקריב לגודל המקורי"

msgid "Zoom to best fit"
msgstr "תקריב להתאמה מיטבית"

msgid "Rebuild data cache"
msgstr "בנייה מחדש נתונים מטמון"

msgid "Revert the placement and person selection"
msgstr "החזרת האיות ובחירת האדם לקדמותם"

msgid "Open Life Line Chart help"
msgstr "פתיחת עזרה לתרשים קו חיים"

msgid "Export View as SVG"
msgstr "ייצוא מצג כ־SVG"

msgid "Label Configuration"
msgstr "תצורת תווית"

msgid "Reset all settings"
msgstr "שיצוב כלל ההגדרות"

msgid "Life Line Ancestor Chart"
msgstr "תרשים אבות בקו חיים"

msgid "Persons and their relation in a time based chart"
msgstr "אדם ושלהם יוחסה בזמן מבוסס תרשים"

msgid "Life Line Descendant Chart"
msgstr "תרשים קו חיים לצאצאים"

msgid "Warp the chart shape"
msgstr "עיוות צורת התרשים"

msgid "The overall shape of the chart can be warped."
msgstr "אפשר לעוות את הצורה הכוללת של התרשים."

msgid "Normal grid shape"
msgstr "צורת רשת רגילה"

msgid "Sine shape"
msgstr "צורת סינוס"

msgid "Triangular shape"
msgstr "צורה משולשת"

msgid "Show photos"
msgstr "הצגת תמונות"

msgid "Photos of the individual are shown."
msgstr "תמונות האדם מוצגות."

msgid "Photo size"
msgstr "גודל תמונה"

msgid ""
"Photos which are shown are fitted into a square of this extent. The size is "
"given relative to the line thickness."
msgstr "תמונות שמוצגות מותאמות לריבוע בגודל זה. הגודל ניתן ביחס לעובי הקו."

msgid "Total height"
msgstr "גובה כללי"

msgid "Total height of the whole chart."
msgstr "הגובה הכולל של התרשים כולו."

msgid "Relative line thickness"
msgstr "עובי קו יחסי"

msgid ""
"The line thickness of an individual is given relatively to the horizontal "
"step size."
msgstr "עובי הקו של אדם ניתן ביחס לגודל הצעד האופקי."

msgid "Horizontal step size"
msgstr "גודל צעד אופקי"

msgid ""
"This is the distance from one line to another. This value is also used for "
"scaling of other items."
msgstr "זהו המרחק מקו אחד לאחר. ערך זה משמש גם לקנה־מידה של פריטים אחרים."

msgid "Show birth label"
msgstr "הצגת תווית לידה"

msgid "Activate the birth label."
msgstr "שפעול תווית הלידה."

msgid "Birth label along path"
msgstr "לידה תווית לאורך נתיב"

msgid "The birth label is aligned to the individual line."
msgstr "תווית הלידה מיושרת לקו האדם."

msgid "Birth label rotation"
msgstr "לידה תווית סיבוב"

msgid "The birth label is written in a text frame rotated by this value."
msgstr "תווית הלידה נכתבת במסגרת מלל שמסובבת לפי ערך זה."

msgid "Horizontal offset of birth label"
msgstr "היסט אופקי של תווית הלידה"

msgid ""
"The birth label is moved horizontally by this value, which is given "
"relatively to the font size."
msgstr "תווית הלידה מוזזת אופקית לפי ערך זה, שניתן ביחס לגודל הגופן."

msgid "Vertical offset of birth label"
msgstr "היסט אנכי של תווית הלידה"

msgid ""
"The birth label is moved vertically by this value, which is given relatively "
"to the font size."
msgstr "תווית הלידה מוזזת אנכית לפי ערך זה, שניתן ביחס לגודל הגופן."

msgid "Wrap words in birth label"
msgstr "גלישה מילים בלידה תווית"

msgid "The birth label content is wrapped where possible."
msgstr "תוכן תווית הלידה נגלל לשורה חדשה ככל שניתן."

msgid "Birth label anchor"
msgstr "לידה תווית עוגן"

msgid "Text alignment of the birth label."
msgstr "מלל יישור של לידה תווית."

msgid "Center"
msgstr "מרכז"

msgid "Show death label"
msgstr "הצגת תווית פטירה"

msgid "Activate the death label."
msgstr "שפעול תווית הפטירה."

msgid "Death label rotation"
msgstr "פטירה תווית סיבוב"

msgid "The death label is written in a text frame rotated by this value."
msgstr "תווית הפטירה נכתבת במסגרת מלל שמסובבת לפי ערך זה."

msgid "Horizontal offset of death label"
msgstr "היסט אופקי של תווית הפטירה"

msgid ""
"The death label is moved horizontally by this value, which is given "
"relatively to the font size."
msgstr "תווית הפטירה מוזזת אופקית לפי ערך זה, שניתן ביחס לגודל הגופן."

msgid "Vertical offset of death label"
msgstr "היסט אנכי של תווית הפטירה"

msgid ""
"The death label is moved vertically by this value, which is given relatively "
"to the font size."
msgstr "תווית הפטירה מוזזת אנכית לפי ערך זה, שניתן ביחס לגודל הגופן."

msgid "Wrap words in death label"
msgstr "גלישה מילים בפטירה תווית"

msgid "The death label content is wrapped where possible."
msgstr "תוכן תווית הפטירה נגלל לשורה חדשה ככל שניתן."

msgid "Death label anchor"
msgstr "עוגן תווית פטירה"

msgid "Text alignment of the death label."
msgstr "יישור מלל תווית הפטירה."

msgid "Show marriage label"
msgstr "הצגת תווית נישואין"

msgid "Activate the marriage label."
msgstr "שפעול תווית ההנישואין."

msgid "Fade individual color"
msgstr "דהיית צבע אדם"

msgid "The color of the individuals is faded to black with increasing age."
msgstr "צבע האנשים דוהה לשחור עם העלייה בגיל."

msgid "Font name"
msgstr "שם גופן"

msgid "Name of the font family used for labels."
msgstr "שם משפחת הגופנים שמשמשת לתוויות."

msgid "Relative font size"
msgstr "גודל גופן יחסי"

msgid "The font size is given relatively to the line thickness."
msgstr "גודל הגופן ניתן ביחס לעובי הקו."

msgid "Family shape"
msgstr "צורת משפחה"

msgid "The shape of the families can be varied."
msgstr "אפשר לגוון את צורת המשפחות."

msgid "Rectangular"
msgstr "מלבני"

msgid "Softer"
msgstr "רך יותר"

msgid "Upper year minimum margin"
msgstr "שוליים מזעריים עליונים בשנים"

msgid ""
"The upper bound of the chart is extended by at least this number of years."
msgstr "הגבול העליון של התרשים מורחב לפחות במספר שנים זה."

msgid "Lower year minimum margin"
msgstr "שוליים מזעריים תחתונים בשנים"

msgid ""
"The lower bound of the chart is extended by at least this number of years."
msgstr "הגבול התחתון של התרשים מורחב לפחות במספר שנים זה."

msgid "Visualize connections"
msgstr "החזיית חיבורים"

msgid ""
"Visualize the connections between families and individuals. This is for "
"debugging purposes."
msgstr "החזיית חיבורים בין משפחות ויחידים. נועד לצרכי ניפוי־תקלים."

msgid "Visualize ambiguous placement"
msgstr "הצגת איות דו־משמעי"

msgid "Visualize automatically detected errors in the placement algorithm."
msgstr "הצגת שגיאות שזוהו אוטומטית באלגוריתם האיות."

msgid "Coloring of individuals"
msgstr "צביעת אנשים"

msgid "There are different ways to determine the color of an individual."
msgstr "יש דרכים שונות לקבוע את צבעו של אדם."

msgid "Unique"
msgstr "ייחודי"

msgid "Based on surname"
msgstr "מבוסס על שם משפחה"

msgid "Flip vertically"
msgstr "היפוך אנכי"

msgid "If active, the chart is flipped vertically."
msgstr "כאשר פעיל, התרשים מתהפך אנכית."

msgid "Line weighting"
msgstr "שקלול קווים"

msgid "The line width can be configured."
msgstr "ניתן להגדיר את רוחב הקו."

msgid "none"
msgstr "אין"

msgid "Show pedigree collapse"
msgstr "הצגת קריסת אילן־יוחסין"

msgid ""
"Due to pedigree collapse one individual might appear several times in a "
"simple ancestor chart. If this is active, then every individual only appears "
"once."
msgstr ""
"עקב קריסת אילן, אדם אחד עשוי להופיע כמה פעמים בתרשים אבות פשוט. כאשר אפשרות "
"זו פעילה, כל אדם מופיע פעם אחת בלבד."

msgid "Maximum number of generations"
msgstr "מספר הדורות המרבי"

msgid ""
"if this number of generations has been reached, the algorithm doesn't go any "
"deeper"
msgstr "אם מספר דורות זה הושג, האלגוריתם לא יעמיק יותר"

msgid "Fathers have the same color"
msgstr "לאבות יש צבע זהה"

msgid ""
"Starting from the root person, each father of an added individual has the "
"same color as that individual."
msgstr "החל מאדם השורש, לכל אב של אדם שנוסף יש אותו צבע כמו לאותו אדם."

msgid "Maximum number of compression steps"
msgstr "מספר צעדי הדחיסה המרבי"

msgid "Debugging of the compression algorithm. Abort after x steps."
msgstr "ניפוי־תקלים של אלגוריתם הדחיסה. ביטול לאחר x צעדים."

msgid "Maximum number of flipping steps"
msgstr "מספר צעדי ההיפוך המרבי"

msgid "Debugging of the flipping algorithm. Abort after x steps."
msgstr "ניפוי־תקלים של אלגוריתם ההיפוך. ביטול לאחר x צעדים."

msgid "Compress the chart horizontally"
msgstr "דחיסת התרשים אופקית"

msgid ""
"By default every individual has a unique horizontal slot. This can be "
"inefficient with many generations. This algorithm lets several people share "
"a horizontal slot, if they do not overlap."
msgstr ""
"כברירת מחדל לכל אדם מוקצה חריץ אופקי ייחודי. הדבר עלול להיות לא יעיל כאשר "
"קיימים דורות רבים. אלגוריתם זה מאפשר לכמה אנשים לחלוק חריץ אופקי, אם הם אינם "
"חופפים."

msgid "Flip families to reduce horizontal connections"
msgstr "היפוך משפחות לצימצום חיבורים מאוזנים"

msgid ""
"Switch the position of mother and father in a family, to reduce the overall "
"horizontal cross connections in larger graphs. This is happens if one person "
"is shown in more than one family or it is caused by pedigree collapse."
msgstr ""
"החלפת מיקום האם והאב במשפחה, כדי לצמצם את מספר החיבורים הצולבים האופקיים "
"הכולל בתרשימים גדולים. מצב זה מתרחש כאשר אדם מוצג ביותר ממשפחה אחת, או נגרם "
"בשל קריסת יוחסין."

msgid "Highlight descandants"
msgstr "הדגשת צאצאים"

msgid "Highlight the persons which are descendants."
msgstr "הדגשת אנשים שהם צאצאים."

msgid "Number of descendants"
msgstr "מספר צאצאים"

msgid "Very soft"
msgstr "רך מאוד"

msgid "General chart layout"
msgstr "עימוד תרשים כללי"

msgid "There are different layouts for descendant charts."
msgstr "קיימות פריסות שונות לתרשימי צאצאים."

msgid "Parents enclose children"
msgstr "הורים מקיפים ילדים"

msgid "Cactus"
msgstr "Cactus"
