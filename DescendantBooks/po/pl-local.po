#, python-format
msgid "sp. see  %(reference)s : %(spouse)s"
msgstr "małż. zobacz %(reference)s : %(spouse)s"

#, python-format
msgid "see report: %(report)s, ref: %(reference)s : %(person)s & %(spouse)s"
msgstr ""
"zobacz raport: %(report)s, ref: %(reference)s : %(person)s i %(spouse)s"

msgid "Descendants Report"
msgstr "Raport potomków"

#, python-format
msgid "Writing %s reports..."
msgstr "Zapisywanie %s raportów..."

#, python-brace-format
msgid "{report_count}. Descendants of {name}"
msgstr "{report_count}. Potomkowie {name}"

#, python-brace-format
msgid "{report_count:d}. {name}"
msgstr "{report_count:d}. {name}"

msgid "Select filter to restrict people that appear in the report"
msgstr "Wybierz filtr, aby ograniczyć ilość osób, które pojawią się w raporcie"

msgid "Whether to show duplicate family trees in the report."
msgstr "Określa, czy dołączać zduplikowane drzewa rodzinne do raportu."

msgid "The style used for the title of the page."
msgstr "Styl używany do tytułu strony."

msgid "The style used for the table of contents header."
msgstr "Styl używany do nagłówka spisu treści."

msgid "The style used for the table of contents detail."
msgstr "Styl używany do szczegółów spisu treści."

msgid "Detailed Descendants Report"
msgstr "Szczegółowy raport potomków"

#, python-format
msgid "Generating %s report references..."
msgstr "Generowanie %s referencji raportu..."

#, python-format
msgid "%(report_count)s. Descendant Report for %(person_name)s"
msgstr "%(report_count)s. Raport potomków dla %(person_name)s"

msgid "Index of Places"
msgstr "Indeks miejsc"

msgid "Index of Dates"
msgstr "Indeks dat"

msgid "Index of Names"
msgstr "Indeks nazwisk"

msgid "Report, Generation, Person, Name"
msgstr "Raport, Pokolenie, Osoba, Nazwisko"

#, python-brace-format
msgid "See Report : {report}, Generation : {generation}, Person : {person}"
msgstr "Zobacz Raport : {report}, Pokolenie : {generation}, Osoba : {person}"

#, python-format
msgid "Report appearances for %s"
msgstr "Wystąpienia w raporcie dla %s"

#, python-brace-format
msgid "Spouse of: Report: {report}, Generation: {generation}, Person: {person}"
msgstr "Małżonek: Raport: {report}, Pokolenie: {generation}, Osoba: {person}"

#, python-brace-format
msgid "Report: {report}, Generation: {generation}, Person: {person}"
msgstr "Raport: {report}, Pokolenie: {generation}, Osoba: {person}"

#, python-format
msgid "%(event_name)s of %(name)s "
msgstr "%(event_name)s osoby %(name)s "

#, python-format
msgid "%(event_name)s of %(name)s and %(mate)s "
msgstr "%(event_name)s osoby %(name)s i %(mate)s "

#, python-format
msgid "%(date)s, %(place)s"
msgstr "%(date)s, %(place)s"

#, python-format
msgid "%(date)s"
msgstr "%(date)s"

#, python-format
msgid "%(place)s"
msgstr "%(place)s"

#, python-format
msgid ". Ref: %(repno)s %(gen)s %(per)s "
msgstr ". Odn.: %(repno)s %(gen)s %(per)s "

#, python-format
msgid "%(event_name)s:"
msgstr "%(event_name)s:"

#, python-format
msgid " %(event_text)s"
msgstr " %(event_text)s"

#, python-brace-format
msgid "Ref: {number}. {name}"
msgstr "Odn.: {number}. {name}"

#, python-format
msgid "%(name_kind)s: %(name)s%(endnotes)s"
msgstr "%(name_kind)s: %(name)s%(endnotes)s"

#, python-format
msgid "%(type)s:"
msgstr "%(type)s:"

#, python-format
msgid " %(value)s%(endnotes)s"
msgstr " %(value)s%(endnotes)s"

msgid "List children"
msgstr "Wypisz dzieci"

msgid "Add descendant reference in child list"
msgstr "Dodaj odniesienia do potomków w liście dzieci"

msgid "Include Index of Names"
msgstr "Dołącz indeks nazwisk"

msgid "Whether to include the index of Names at the end of the report."
msgstr "Określa, czy dołączać indeks nazwisk na końcu raportu."

msgid "Include index of Dates"
msgstr "Dołącz indeks dat"

msgid "Whether to include the index of Dates at the end of the report."
msgstr "Określa, czy dołączać indeks dat na końcu raportu."

msgid "Include index of Places"
msgstr "Dołącz indeks miejsc"

msgid "Whether to include the index of Places at the end of the report."
msgstr "Określa, czy dołączać indeks miejsc na końcu raportu."

msgid "Include the 'Report appearances' section with each person"
msgstr "Dołącz sekcję 'Wystąpienia w raporcie' dla każdej osoby"

msgid ""
"The 'Report appearances' section shows other places in the report where the "
"person is mentioned."
msgstr ""
"Sekcja 'Wystąpienia w raporcie' pokazuje inne miejsca w raporcie, gdzie "
"osoba jest wspomniana."

msgid "The style used for the children list."
msgstr "Styl używany do listy dzieci."

msgid "The basic style used for Note header."
msgstr "Podstawowy styl używany do nagłówka notatki."

msgid "The style used for the first personal entry."
msgstr "Styl używany do pierwszego wpisu osobowego."

msgid "The style used for the More About header and for headers of mates."
msgstr "Styl używany do nagłówka 'Więcej informacji' i nagłówków małżonków."

msgid "The style used for additional detail data."
msgstr "Styl używany do dodatkowych danych szczegółowych."

msgid "The style used for note detail data."
msgstr "Styl używany do szczegółowych danych notatki."

msgid "The style used for the date in the Index of Dates."
msgstr "Styl używany do dat w indeksie dat."

msgid "The style used for the events in the Index of Dates."
msgstr "Styl używany do wydarzeń w indeksie dat."

msgid "The style used for the header in the Index of Names."
msgstr "Styl używany do nagłówka w indeksie nazwisk."

msgid "The style used for the references in the Index of Names."
msgstr "Styl używany do odniesień w indeksie nazwisk."

msgid "The style used for the header in the Index of Places."
msgstr "Styl używany do nagłówka w indeksie miejsc."

msgid "The style used for the references in the Index of Places."
msgstr "Styl używany do odniesień w indeksie miejsc."

msgid "Descendant Book"
msgstr "Księga potomków"

msgid "Produces one or more descendant reports based on a supplied query."
msgstr ""
"Tworzy jeden lub więcej raportów potomków na podstawie dostarczonego "
"zapytania."

msgid "Detailed Descendant Book"
msgstr "Szczegółowa księga potomków"

msgid ""
"Produces one or more detailed descendant reports based on a supplied query."
msgstr ""
"Tworzy jeden lub więcej szczegółowych raportów potomków na podstawie "
"dostarczonego zapytania."

#, python-format
msgid "Deep pruning ascendants from %s people..."
msgstr "Głębokie usuwanie przodków z %s osób..."

#, python-format
msgid "Pruning ascendants from %s people..."
msgstr "Usuwanie przodków z %s osób..."

#, python-format
msgid "Getting ascendants from %s people..."
msgstr "Pobieranie przodków z %s osób..."

#, python-format
msgid "Verifying descendants from %s people..."
msgstr "Weryfikowanie potomków z %s osób..."

#, python-format
msgid "Getting missing descendants from %s people..."
msgstr "Pobieranie brakujących potomków z %s osób..."

#, python-format
msgid "Verifying descendants from %s people after pruning..."
msgstr "Weryfikowanie potomków z %s osób po usunięciu..."

#, python-format
msgid "Getting missing descendants from %s people ..."
msgstr "Pobieranie brakujących potomków z %s osób..."
