msgid "Quilt Chart"
msgstr "Grafico a trapunta"

msgid "The view shows a quilt chart visualisation of a family tree"
msgstr ""
"La vista mostra un albero genealogico sotto forma di grafico a trapunta"

msgid "Quilt chart"
msgstr "Grafico a trapunta"

msgid "Select the name for which you want to see."
msgstr "Seleziona il nome che vuoi vedere."

msgid "Clear the entry field in the name selection box."
msgstr "Svuota il campo nella casella di selezione del nome."

msgid "Nothing is selected"
msgstr "Non è stato selezionato nulla"

#, python-format
msgid ""
"You have %(filter)d filtered people, %(count)d people shown on the tree and "
"%(total)d people in your database."
msgstr ""
"Hai %(filter)d persone filtrate, %(count)d persone mostrate nell'albero, e "
"%(total)d persone totali nel database."

msgid "Loading individuals"
msgstr "Caricamento degli individui"

msgid "Loading the data"
msgstr "Caricamento dei dati"

msgid "About Quilt View"
msgstr "Informazioni sulla vista a trapunta"

msgid "Edit tags"
msgstr "Modifica etichette"

msgid "Set as home person"
msgstr "Imposta come persona-casa"

#, python-format
msgid "Adding Tags to person (%s)"
msgstr "Aggiunta di etichette alla persona (%s)"

#, python-format
msgid "Adding Tags to family (%s)"
msgstr "Aggiunta di etichette alla famiglia (%s)"

msgid "Printing the tree"
msgstr "Stampa dell'albero"

#, python-format
msgid "Need to print %(pages)s pages (%(format)s format)"
msgstr "È necessario stampare %(pages)s pagine (formato %(format)s)"

msgid ""
"Center on the selected person.\n"
"The new position of the person will be near the top left corner."
msgstr ""
"Centra sulla persona selezionata.\n"
"La nuova posizione della persona sarà vicino all'angolo in alto a sinistra."

msgid "The path color"
msgstr "Il colore del percorso"

msgid "The selected person color"
msgstr "Il colore della persona selezionata"

msgid "The path transparency"
msgstr "La trasparenza del percorso"

msgid "General options"
msgstr "Opzioni generali"
