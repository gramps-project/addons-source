msgid "Quilt Chart"
msgstr "תרשים טלאים"

msgid "The view shows a quilt chart visualisation of a family tree"
msgstr "המצג מציג המחשת תרשים טלאים של אילן־יוחסין"

msgid "Quilt chart"
msgstr "תרשים טלאים"

msgid "Select the name for which you want to see."
msgstr "בחירת השם בו רוצים לצפות."

msgid "Clear the entry field in the name selection box."
msgstr "ניקוי שדה הרשומה בתיבת בחירת השם."

msgid "Nothing is selected"
msgstr "לא נבחר דבר"

#, python-format
msgid ""
"You have %(filter)d filtered people, %(count)d people shown on the tree and "
"%(total)d people in your database."
msgstr ""
"יש %(filter)d אנשים מסוננים, %(count)d אנשים שמוצגים באילן ו־%(total)d אנשים "
"במסד־הנתונים."

msgid "Loading individuals"
msgstr "טעינת אנשים"

msgid "Loading the data"
msgstr "טעינת הנתונים"

msgid "About Quilt View"
msgstr "על מצג טלאים"

msgid "Edit tags"
msgstr "עריכה תגים"

msgid "Set as home person"
msgstr "הגדרה כאדם הבית"

#, python-format
msgid "Adding Tags to person (%s)"
msgstr "הוספה תגים לאדם (%s)"

#, python-format
msgid "Adding Tags to family (%s)"
msgstr "הוספה תגים למשפחה (%s)"

msgid "Printing the tree"
msgstr "הדפסת האילן"

#, python-format
msgid "Need to print %(pages)s pages (%(format)s format)"
msgstr "נדרשת הדפסת %(pages)s עמודים (תסדיר %(format)s)"

msgid ""
"Center on the selected person.\n"
"The new position of the person will be near the top left corner."
msgstr ""
"מרכוז על האדם שנבחר.\n"
"האיות החדש של האדם יהיה סמוך לפינה השמאלית העליונה."

msgid "The path color"
msgstr "נתיב צבע"

msgid "The selected person color"
msgstr "שנבחר אדם צבע"

msgid "The path transparency"
msgstr "שקיפות הנתיב"

msgid "General options"
msgstr "אפשרויות כלליות"
