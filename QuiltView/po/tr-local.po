msgid "Quilt Chart"
msgstr "Yorgan Grafiği"

msgid "The view shows a quilt chart visualisation of a family tree"
msgstr ""
"Bu görselde bir aile ağacının yorgan deseni şeklinde görselleştirilmiş hali "
"gösterilmektedir"

msgid "Quilt chart"
msgstr "Yorgan grafiği"

msgid "Select the name for which you want to see."
msgstr "Görmek istediğiniz adı seçin."

msgid "Clear the entry field in the name selection box."
msgstr "Ad seçimi kutusundaki giriş alanını temizleyin."

msgid "Nothing is selected"
msgstr "Hiçbir şey seçilmedi"

#, python-format
msgid ""
"You have %(filter)d filtered people, %(count)d people shown on the tree and "
"%(total)d people in your database."
msgstr ""
"%(filter)d filtrelenmiş kişi var, ağaçta %(count)d kişi gösteriliyor ve "
"veritabanınızda %(total)d kişi var."

msgid "Loading individuals"
msgstr "Bireyler yükleniyor"

msgid "Loading the data"
msgstr "Veriler yükleniyor"

msgid "About Quilt View"
msgstr "Quilt Görünümü Hakkında"

msgid "Edit tags"
msgstr "Etiketleri düzenle"

msgid "Set as home person"
msgstr "Ana kişi olarak belirle"

#, python-format
msgid "Adding Tags to person (%s)"
msgstr "Kişiye (%s) etiket ekleme"

#, python-format
msgid "Adding Tags to family (%s)"
msgstr "Aileye etiket ekleme (%s)"

msgid "Printing the tree"
msgstr "Ağacı yazdırma"

#, python-format
msgid "Need to print %(pages)s pages (%(format)s format)"
msgstr "%(pages)s sayfa yazdırılması gerekiyor (%(format)s biçimi)"

msgid ""
"Center on the selected person.\n"
"The new position of the person will be near the top left corner."
msgstr ""
"Seçilen kişiyi ortala.\n"
"Kişinin yeni konumu sol üst köşeye yakın olacaktır."

msgid "The path color"
msgstr "Yol rengi"

msgid "The selected person color"
msgstr "Seçilen kişi rengi"

msgid "The path transparency"
msgstr "Yol şeffaflığı"

msgid "General options"
msgstr "Genel seçenekler"
