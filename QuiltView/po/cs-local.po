msgid "Quilt Chart"
msgstr "Schéma Quilt"

msgid "The view shows a quilt chart visualisation of a family tree"
msgstr "Pohled zobrazuje rodokmen jako schéma Quilt"

msgid "Quilt chart"
msgstr "Schéma Quilt"

msgid "Select the name for which you want to see."
msgstr "Vyberte jméno, které chcete zobrazit."

msgid "Clear the entry field in the name selection box."
msgstr "Vymazat vstupní pole ve výběru jména."

msgid "Nothing is selected"
msgstr "Není nic vybráno"

#, python-format
msgid ""
"You have %(filter)d filtered people, %(count)d people shown on the tree and "
"%(total)d people in your database."
msgstr ""
"Počet osob vybraných filtrem: %(filter)d, zobrazených v rodokmenu: "
"%(count)d, celkem v databázi: %(total)d."

msgid "Loading individuals"
msgstr "Načítání osob"

msgid "Loading the data"
msgstr "Načítání údajů"

msgid "About Quilt View"
msgstr "O pohledu Quilt"

msgid "Edit tags"
msgstr "Upravit štítky"

msgid "Set as home person"
msgstr "Nastavit jako výchozí osobu"

#, python-format
msgid "Adding Tags to person (%s)"
msgstr "Přidání štítků osobě (%s)"

#, python-format
msgid "Adding Tags to family (%s)"
msgstr "Přidání štítků rodině (%s)"

msgid "Printing the tree"
msgstr "Tisk rodokmenu"

#, python-format
msgid "Need to print %(pages)s pages (%(format)s format)"
msgstr "Počet stránek k tisku: %(pages)s (formát %(format)s)"

msgid ""
"Center on the selected person.\n"
"The new position of the person will be near the top left corner."
msgstr ""
"Zaměřit se na vybranou osobu.\n"
"Nová poloha osoby bude poblíž levého horního rohu."

msgid "The path color"
msgstr "Barva cesty"

msgid "The selected person color"
msgstr "Barva vybrané osoby"

msgid "The path transparency"
msgstr "Průhlednost cesty"

msgid "General options"
msgstr "Obecné možnosti"
