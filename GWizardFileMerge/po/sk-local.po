msgid ""
"The data being merged contains references to external objects that do not "
"exist in your family tree:\n"
"\n"
"%s\n"
"\n"
"To prevent broken links, these missing references must be imported along "
"with your selected details. Do you confirm importing these missing "
"references?"
msgstr ""
"Údaje, ktoré sa zlučujú, obsahujú odkazy na externé objekty, ktoré vo vašom "
"rodostrome neexistujú:\n"
"\n"
"%s\n"
"\n"
"Aby sa predišlo nefunkčným odkazom, tieto chýbajúce odkazy musia byť "
"importované spolu s vybranými detailami. Potvrdzujete import týchto "
"chýbajúcich odkazov?"

#, python-format
msgid ""
"%d source already in your family tree will be reused (matched by title, "
"author and publication info)."
msgid_plural ""
"%d sources already in your family tree will be reused (matched by title, "
"author and publication info)."
msgstr[0] ""
"%d zdroj, ktorý je už vo vašom rodostromel, bude znovu použitý (zhoda podľa "
"názvu, autora a publikačných informácií)."
msgstr[1] ""
"%d zdroje, ktoré sú už vo vašom rodostrome, budú znovu použité (zhoda podľa "
"názvu, autora a publikačných informácií)."
msgstr[2] ""
"%d zdrojov, ktoré sú už vo vašom rodostrome, bude znovu použitých (zhoda "
"podľa názvu, autora a publikačných informácií)."

