msgid "none"
msgstr "ingen"

msgid "New person"
msgstr "Ny person"

msgid "Incoming GEDCOM"
msgstr "Inkommande GEDCOM"

#, python-format
msgid "Incoming GEDCOM: %s"
msgstr "Inkommande GEDCOM: %s"

msgid "Configure Connection"
msgstr "Konfigurera anslutning"

msgid "Load Data"
msgstr "Läs in data"

msgid "Find Matching Persons"
msgstr "Hitta matchande personer"

msgid "Compare Differences"
msgstr "Jämför skillnader"

msgid "Apply Changes"
msgstr "Tillämpa ändringar"

msgid "Configure file path or authenticate with online service."
msgstr "Konfigurera filsökväg eller autentisera mot en onlinetjänst."

msgid "Load/parse the external genealogy data into memory."
msgstr "Läs in/tolka den externa släktforskningsdatan till minnet."

msgid "Search for potential matches in your database."
msgstr "Sök efter potentiella matchningar i din databas."

msgid "Compare fields side-by-side between the source and target."
msgstr "Jämför fält sida vid sida mellan källan och målet."

msgid "Merge selected changes or add new records to the database."
msgstr "Slå samman valda ändringar eller lägg till nya poster i databasen."

msgid "GWizard Compare"
msgstr "GWizard-jämförelse"

msgid "No source database available for comparison"
msgstr "Ingen källdatabas tillgänglig för jämförelse"

msgid "GWizard File Merge"
msgstr "GWizard-filsammanslagning"

msgid ""
"Family Tree Processing Tool to compare another genealogy file (GEDCOM, "
"Gramps XML, ...) side-by-side with the open Family Tree and merge selected "
"differences person by person."
msgstr ""
"Verktyg för släktträdsbearbetning som gör det möjligt att jämföra en annan "
"släktforskningsfil (GEDCOM, Gramps XML, ...) sida vid sida med det öppna "
"släktträdet, samt att slå samman valda skillnader person för person."
