msgid "Tree: '{}'"
msgstr "Arbre : '{}'"

msgid "Chat With Tree Interactive Addon"
msgstr "Greffon interactif « Chat avec l'arbre généalogique »"

msgid ""
"Chat With Tree with the help of AI Large Language Model, needs litellm module"
msgstr ""
"Chat avec l'arbre généalogique à l'aide d'un grand modèle de langage (LLM) "
"par IA, nécessitant le module litellm"

msgid "Chat With Tree"
msgstr "Chat avec l'arbre généalogique"

msgid "Type a message..."
msgstr "Saisissez un message…"

msgid "Send"
msgstr "Envoyer"

msgid "Chat with Tree initialized.                 Type /help for help."
msgstr "Chat avec l'arbre généalogique initialisé. Saisir /help pour l'aide."

msgid ""
"The ChatWithTree addon is not yet initialized.                     Please "
"reload Gramps or select a database."
msgstr ""
"Le greffon ChatWithTree n'est pas encore initialisé. Relancez Gramps ou "
"sélectionnez une base de données."

msgid "The chatbot is currently processing a query. Please wait."
msgstr "Le chatbot traite actuellement une requête. Veuillez patienter."

msgid "An error occurred while processing your query."
msgstr "Une erreur s’est produite lors du traitement de votre requête."
