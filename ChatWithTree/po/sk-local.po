msgid "Tree: '{}'"
msgstr "Strom: '{}'"

msgid "Chat With Tree Interactive Addon"
msgstr "Chatujte s doplnkom Tree Interactive"

msgid ""
"Chat With Tree with the help of AI Large Language Model, needs litellm module"
msgstr ""
"Chatujte so stromom pomocou AI Large Language Model, potrebujete modul "
"Litellm"

msgid "Chat With Tree"
msgstr "Chat so stromom"

msgid "Type a message..."
msgstr "Napíšte správu..."

msgid "Send"
msgstr "Poslať"

msgid "Chat with Tree initialized.                 Type /help for help."
msgstr ""
"Chat so stromom bol spustený.                  Napíšte /help pre pomoc."

msgid ""
"The ChatWithTree addon is not yet initialized.                     Please "
"reload Gramps or select a database."
msgstr ""
"Doplnok ChatWithTree ešte nie je inicializovaný.                     Prosím, "
"reštartujte Gramps alebo vyberte databázu."

msgid "The chatbot is currently processing a query. Please wait."
msgstr "Chatbot práve spracováva vašu požiadavku. Prosím, počkajte."

msgid "An error occurred while processing your query."
msgstr "Pri spracovávaní vašej požiadavky došlo k chybe."
