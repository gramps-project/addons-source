msgid "Tree: '{}'"
msgstr "אילן: '{}'"

msgid "Chat With Tree Interactive Addon"
msgstr "שיחוח עם תוסף אילן־יוחסין הידודי"

msgid ""
"Chat With Tree with the help of AI Large Language Model, needs litellm module"
msgstr ""
"שיחוח עם אילן־יוחסין בעזרת פרקן שפה גדול (LLM) של בינה מלאכותית, דורש פרקן "
"litellm"

msgid "Chat With Tree"
msgstr "שיחוח עם אילן"

msgid "Type a message..."
msgstr "להקליד הודעה..."

msgid "Send"
msgstr "לשלוח"

msgid "Chat with Tree initialized.                 Type /help for help."
msgstr "שיחוח עם האילן אותחל. יש להקליד /help לקבלת עזרה."

msgid ""
"The ChatWithTree addon is not yet initialized.                     Please "
"reload Gramps or select a database."
msgstr ""
"התוסף ChatWithTree עדיין לא אותחל. יש לטעון את גרמפס מחדש או לבחור מסד־"
"נתונים."

msgid "The chatbot is currently processing a query. Please wait."
msgstr "הצ׳טבוט מעבד כעת שאילתה. נא להמתין."

msgid "An error occurred while processing your query."
msgstr "אירעה שגיאה במהלך עיבוד השאילתה."
