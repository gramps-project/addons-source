#, python-brace-format
msgid "Tree: '{}'"
msgstr "Albero: '{}'"

msgid "Chat With Tree Interactive Addon"
msgstr "Addon interattivo Chat With Tree"

msgid ""
"Chat With Tree with the help of AI Large Language Model, needs litellm module"
msgstr ""
"Conversa con l'albero con l'aiuto di un modello linguistico di grandi "
"dimensioni (IA), richiede il modulo litellm"

msgid "Chat With Tree"
msgstr "Parla con l'albero"

msgid "Type a message..."
msgstr "Scrivi un messaggio..."

msgid "Send"
msgstr "Invia"

msgid "Chat with Tree initialized.                 Type /help for help."
msgstr ""
"Chat with Tree inizializzato.                 Digita /help per l'aiuto."

msgid ""
"The ChatWithTree addon is not yet initialized.                     Please "
"reload Gramps or select a database."
msgstr ""
"Il componente aggiuntivo ChatWithTree non è stato ancora "
"inizializzato..                     Ricarica Gramps o scegli un database."

msgid "The chatbot is currently processing a query. Please wait."
msgstr "Il chatbot sta attualmente elaborando una richiesta. Attendi."

msgid "An error occurred while processing your query."
msgstr "Si è verificato un errore durante l'elaborazione della tua richiesta."
