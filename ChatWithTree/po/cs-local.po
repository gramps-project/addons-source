#, python-brace-format
msgid "Tree: '{}'"
msgstr "Rodokmen: '{}'"

msgid "Chat With Tree Interactive Addon"
msgstr "Interaktivní rozšíření Chat With Tree"

msgid ""
"Chat With Tree with the help of AI Large Language Model, needs litellm module"
msgstr ""
"Konverzace s rodokmenem pomocí velkého jazykového modelu AI, vyžaduje modul "
"litellm"

msgid "Chat With Tree"
msgstr "Konverzace s rodokmenem"

msgid "Type a message..."
msgstr "Napište zprávu..."

msgid "Send"
msgstr "Odeslat"

msgid "Chat with Tree initialized.                 Type /help for help."
msgstr ""
"Konverzace s rodokmenem byla inicializována.                 Nápovědu "
"zobrazíte příkazem /help."

msgid ""
"The ChatWithTree addon is not yet initialized.                     Please "
"reload Gramps or select a database."
msgstr ""
"Rozšíření ChatWithTree dosud nebylo inicializováno.                     "
"Znovu spusťte Gramps nebo vyberte databázi."

msgid "The chatbot is currently processing a query. Please wait."
msgstr "Chatbot právě zpracovává dotaz. Čekejte."

msgid "An error occurred while processing your query."
msgstr "Při zpracování dotazu došlo k chybě."
