msgid "Reference Date or Date Range"
msgstr "Fecha de Referencia o Intervalo de Fecha"

msgid "a valid Gramps date"
msgstr "una fecha Gramps válida"

msgid "Date or offset ±y or ±y, m, d"
msgstr "Fecha o desplazamiento ±a o ±a, m, d"

msgid ""
"1. a Date\n"
"2. a positive or negative number, representing years\n"
"3. a positive or negative list of values, representing years, months, days"
msgstr ""
"1. una Fecha\n"
"2. un número positivo o negativo, representando años\n"
"3. un listado de valores positivos o negativos. representando años, meses, "
"días"

msgid "Result"
msgstr "Resultado"

msgid "Calculate"
msgstr "Cálculo"

msgid "Copy"
msgstr "Copiar"

msgid "Error: invalid date for first expression"
msgstr "Error: fecha no válida para primera expresión"

msgid "Error: invalid offset for second expression"
msgstr "Error: desplazamiento no válido para segunda expresión"

msgid "Error: at least one expression must be a date"
msgstr "Error: al menos una expresión debe ser una fecha"

msgid "Enter an expression in the entries above and click Calculate."
msgstr ""
"Introduzca una expresión dentro de los apuntes arriba y pulse Calcular."

msgid "Date Calculator"
msgstr "Calculador de Fecha"

msgid "Perform date math calculations"
msgstr "Realiza cálculos matemáticos de fecha"
