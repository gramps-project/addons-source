msgid "Reference Date or Date Range"
msgstr "Referans Tarihi veya Tarih Aralığı"

msgid "a valid Gramps date"
msgstr "geçerli bir Gramps tarihi"

msgid "Date or offset ±y or ±y, m, d"
msgstr "Tarih veya zaman farkı ±y veya ±y, a, g"

msgid ""
"1. a Date\n"
"2. a positive or negative number, representing years\n"
"3. a positive or negative list of values, representing years, months, days"
msgstr ""
"1. Bir Tarih\n"
"2. Yılları temsil eden pozitif veya negatif bir sayı\n"
"3. Yılları, ayları ve günleri temsil eden pozitif veya negatif değerler "
"listesi"

msgid "Result"
msgstr "Sonuç"

msgid "Calculate"
msgstr "Hesapla"

msgid "Copy"
msgstr "Kopyala"

msgid "Error: invalid date for first expression"
msgstr "Hata: İlk ifade için geçersiz tarih"

msgid "Error: invalid offset for second expression"
msgstr "Hata: İkinci ifade için geçersiz zaman farkı"

msgid "Error: at least one expression must be a date"
msgstr "Hata: En az bir ifade tarih olmalıdır"

msgid "Enter an expression in the entries above and click Calculate."
msgstr "Yukarıdaki girişlere bir ifade girin ve Hesapla öğesine tıklayın."

msgid "Date Calculator"
msgstr "Tarih Hesaplayıcı"

msgid "Perform date math calculations"
msgstr "Tarih matematik hesaplamalarını gerçekleştirin"
