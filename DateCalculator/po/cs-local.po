msgid "Reference Date or Date Range"
msgstr "Referenční datum nebo rozsah dat"

msgid "a valid Gramps date"
msgstr "platné datum Gramps"

msgid "Date or offset ±y or ±y, m, d"
msgstr "Datum nebo posun ±y či ±y, m, d"

msgid ""
"1. a Date\n"
"2. a positive or negative number, representing years\n"
"3. a positive or negative list of values, representing years, months, days"
msgstr ""
"1. Datum\n"
"2. Kladné nebo záporné číslo představující roky\n"
"3. Kladný nebo záporný seznam hodnot představujících roky, měsíce a dny"

msgid "Result"
msgstr "Výsledek"

msgid "Calculate"
msgstr "Vypočítat"

msgid "Copy"
msgstr "Zkopírovat"

msgid "Error: invalid date for first expression"
msgstr "Chyba: neplatné datum v prvním výrazu"

msgid "Error: invalid offset for second expression"
msgstr "Chyba: neplatný posun ve druhém výrazu"

msgid "Error: at least one expression must be a date"
msgstr "Chyba: alespoň jeden výraz musí být datum"

msgid "Enter an expression in the entries above and click Calculate."
msgstr "Zadejte výraz do polí výše a klikněte na Vypočítat."

msgid "Date Calculator"
msgstr "Kalkulačka datumů"

msgid "Perform date math calculations"
msgstr "Provádí výpočty s kalendářními daty"
