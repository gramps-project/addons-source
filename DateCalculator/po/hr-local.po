msgid "Reference Date or Date Range"
msgstr "Referentni datum ili raspon datuma"

msgid "a valid Gramps date"
msgstr "valjani Gramps datum"

msgid "Date or offset ±y or ±y, m, d"
msgstr "Datum ili pomak ±y (godna) ili ±y, m, d (godina, mjesec, dan)"

msgid ""
"1. a Date\n"
"2. a positive or negative number, representing years\n"
"3. a positive or negative list of values, representing years, months, days"
msgstr ""
"1. datum\n"
"2. pozitivan ili negativan broj koji predstavlja godine\n"
"3. pozitivan ili negativan niz vrijednosti koji predstavlja godine, mjesece "
"i dane"

msgid "Result"
msgstr "Rezultat"

msgid "Calculate"
msgstr "Izračunaj"

msgid "Copy"
msgstr "Kopiraj"

msgid "Error: invalid date for first expression"
msgstr "Greška: nevaljan datum za prvi izraz"

msgid "Error: invalid offset for second expression"
msgstr "Greška: nevaljan odmak za drugi izraz"

msgid "Error: at least one expression must be a date"
msgstr "Greška: barem jedan izraz mora biti datum"

msgid "Enter an expression in the entries above and click Calculate."
msgstr "Upiši izraz u gornja polja i klikni „Izračunaj”."

msgid "Date Calculator"
msgstr "Kalkulator datuma"

msgid "Perform date math calculations"
msgstr "Izvrši matematičke izračune datuma"
