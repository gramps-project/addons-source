msgid "Reference Date or Date Range"
msgstr "Data di riferimento o intervallo di date"

msgid "a valid Gramps date"
msgstr "una data di Gramps valida"

msgid "Date or offset ±y or ±y, m, d"
msgstr "Data o scostamento ±a o ±a, m, g"

msgid ""
"1. a Date\n"
"2. a positive or negative number, representing years\n"
"3. a positive or negative list of values, representing years, months, days"
msgstr ""
"1. una data\n"
"2. un numero positivo o negativo che rappresenta gli anni\n"
"3. un elenco di valori positivi o negativi, che rappresentano gli anni, i "
"mesi, i giorni"

msgid "Result"
msgstr "Risultato"

msgid "Calculate"
msgstr "Calcola"

msgid "Copy"
msgstr "Copia"

msgid "Error: invalid date for first expression"
msgstr "Errore: data non valida per la prima espressione"

msgid "Error: invalid offset for second expression"
msgstr "Errore: scostamento non valido per la seconda espressione"

msgid "Error: at least one expression must be a date"
msgstr "Errore: almeno un'espressione deve essere una data"

msgid "Enter an expression in the entries above and click Calculate."
msgstr "Inserisci un'espressione nel campo sopra e fai clic su Calcola."

msgid "Date Calculator"
msgstr "Calcolatore di date"

msgid "Perform date math calculations"
msgstr "Eseguire calcoli matematici con le date"
