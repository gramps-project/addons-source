msgid "Reference Date or Date Range"
msgstr "תאריך אזכור או טווח תאריכים"

msgid "a valid Gramps date"
msgstr "תאריך גרמפס תקין"

msgid "Date or offset ±y or ±y, m, d"
msgstr "תאריך או קיזוז ±y או ±y, m, d"

msgid ""
"1. a Date\n"
"2. a positive or negative number, representing years\n"
"3. a positive or negative list of values, representing years, months, days"
msgstr ""
"1. תאריך\n"
"2. מספר חיובי או שלילי, שמייצג שנים\n"
"3. רשימת ערכים חיובית או שלילית, שמייצגת שנים, חודשים, ימים"

msgid "Result"
msgstr "תוצאה"

msgid "Calculate"
msgstr "חישוב"

msgid "Copy"
msgstr "העתקה"

msgid "Error: invalid date for first expression"
msgstr "שגיאה: תאריך לא תקין בביטוי ראשון"

msgid "Error: invalid offset for second expression"
msgstr "שגיאה: קיזוז לא תקין בביטוי שני"

msgid "Error: at least one expression must be a date"
msgstr "שגיאה: לפחות אחד מהביטוים חייב להיות תאריך"

msgid "Enter an expression in the entries above and click Calculate."
msgstr "נא להזין ביטוי ברשומות לעיל ולהקיש על 'לחשב'."

msgid "Date Calculator"
msgstr "מחשבון תאריכים"

msgid "Perform date math calculations"
msgstr "ביצוע חישובי תאריך מתמטיים"
