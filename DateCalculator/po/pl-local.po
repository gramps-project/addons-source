msgid "Reference Date or Date Range"
msgstr "Data odniesienia lub zakres dat"

msgid "a valid Gramps date"
msgstr "prawidłowa data Gramps"

msgid "Date or offset ±y or ±y, m, d"
msgstr "Data lub przesunięcie ±y lub ±y, m, d"

msgid ""
"1. a Date\n"
"2. a positive or negative number, representing years\n"
"3. a positive or negative list of values, representing years, months, days"
msgstr ""
"1. data\n"
"2. liczba dodatnia lub ujemna, oznaczająca lata\n"
"3. lista wartości dodatnich lub ujemnych oznaczająca lata, miesiące, dni"

msgid "Result"
msgstr "Wynik"

msgid "Calculate"
msgstr "Oblicz"

msgid "Copy"
msgstr "Kopiuj"

msgid "Error: invalid date for first expression"
msgstr "Błąd: nieprawidłowa data w pierwszym wyrażeniu"

msgid "Error: invalid offset for second expression"
msgstr "Błąd: nieprawidłowe przesunięcie w drugim wyrażeniu"

msgid "Error: at least one expression must be a date"
msgstr "Błąd: przynajmniej jedno wyrażenie musi być datą"

msgid "Enter an expression in the entries above and click Calculate."
msgstr "Wprowadź wyrażenie w powyższych polach i kliknij Oblicz."

msgid "Date Calculator"
msgstr "Kalkulator dat"

msgid "Perform date math calculations"
msgstr "Wykonaj obliczenia dat"
