msgid "A gramps-object-query-language where-expression, e.g.\n"
msgstr "Et gramps-objekt-query-language \"where\"-udtryk, f.eks\n"

msgid "Enter inserts a newline; Ctrl+Enter runs Find.\n"
msgstr "Enter indsætter en ny linje; Ctrl+Enter udfører Find.\n"

msgid "Up/Down at the first/last line recalls previous expressions.\n"
msgstr ""
"Pil op og pil ned på den første/sidste linje genbruger tidligere udtryk\n"

msgid "Tab always completes -- it never inserts a tab character."
msgstr "Tab fuldfører altid strengen -- det indsætter aldrig et tab tegn."

#, python-format
msgid "%s filter"
msgstr "%s filter"

msgid "This resets the filter parameters to empty state."
msgstr "Dette nulstiller filter parametrerne."

msgid "This opens a dialog to save the current expression as a named filter."
msgstr ""
"Dette åbner en dialog, hvor man kan gemme det nuværende udtryk som et filter."

msgid "Open this gramplet's help page in a browser."
msgstr "Åbher denne gramplet hjælpeside i en browser."

msgid "SQL"
msgstr "SQL"

msgid "Python evaluation"
msgstr "Python evaluering"

#, python-format
msgid "Error applying filter: %s"
msgstr "Fejl under benyttelse af filter: %s"

#, python-format
msgid "Showing %(shown)d of %(total)d (%(method)s)"
