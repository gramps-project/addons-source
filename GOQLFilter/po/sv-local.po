msgid "A gramps-object-query-language where-expression, e.g.\n"
msgstr "Ett where-uttryck för Gramps objektfrågespråk, t.ex.\n"

msgid "Enter inserts a newline; Ctrl+Enter runs Find.\n"
msgstr "Enter infogar en ny rad; Ctrl+Enter kör Sök.\n"

msgid "Up/Down at the first/last line recalls previous expressions.\n"
msgstr "Upp/ned vid första/sista raden hämtar tidigare uttryck.\n"

msgid "Tab always completes -- it never inserts a tab character."
msgstr ""
"Tab-tangenten utför alltid komplettering – den infogar aldrig ett "
"tabulatortecken."

#, python-format
msgid "%s filter"
msgstr "%s-filter"

msgid "This resets the filter parameters to empty state."
msgstr "Detta återställer filterparametrarna till ett tomt läge."

msgid "This opens a dialog to save the current expression as a named filter."
msgstr ""
"Detta öppnar en dialogruta för att spara det aktuella uttrycket som ett "
"namngivet filter."

msgid "Open this gramplet's help page in a browser."
msgstr "Öppna den här gramplettens hjälpsida i en webbläsare."

