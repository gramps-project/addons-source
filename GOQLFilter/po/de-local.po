msgid "Note GOQL Filter"
msgstr "GOQL-Filter für Notizen"

msgid "Gramplet providing a gramps-object-query-language note filter"
msgstr ""
"Gramplet, das einen Notizenfilter für die Gramps-Objekt-Abfragesprache "
"bereitstellt"

msgid "A gramps-object-query-language where-expression, e.g.\n"
msgstr "Ein „where“-Ausdruck in der Gramps-Objekt-Abfragesprache, z. B.\n"

msgid "Enter inserts a newline; Ctrl+Enter runs Find.\n"
msgstr ""
"Mit der Eingabetaste wird ein Zeilenumbruch eingefügt; mit Strg+Eingabetaste "
"wird die Suchfunktion aufgerufen.\n"

msgid "Up/Down at the first/last line recalls previous expressions.\n"
msgstr ""
"Mit den Pfeiltasten „Auf“ und „Ab“ an der ersten bzw. letzten Zeile werden "
"vorherige Ausdrücke aufgerufen.\n"

msgid "Tab always completes -- it never inserts a tab character."
msgstr ""
"Die Tabulatortaste vervollständigt immer – sie fügt niemals ein "
"Tabulatorzeichen ein."

#, python-format
msgid "%s filter"
msgstr "%s Filter"

msgid "This resets the filter parameters to empty state."
msgstr ""
"Dadurch werden die Filterparameter auf den leeren Zustand zurückgesetzt."

msgid "This opens a dialog to save the current expression as a named filter."
msgstr ""
"Dadurch wird ein Dialogfeld geöffnet, in dem du den aktuellen Ausdruck als "
"benannten Filter speichern kannst."

msgid "Open this gramplet's help page in a browser."
msgstr "Öffne die Hilfeseite dieses Gramplets in einem Browser."

msgid "SQL"
msgstr "SQL"

msgid "Python evaluation"
msgstr "Python-Auswertung"

#, python-format
msgid "Error applying filter: %s"
msgstr "Fehler beim Anwenden des Filters: %s"

#, python-format
msgid "Showing %(shown)d of %(total)d (%(method)s)"
msgstr "Anzeige von %(shown)d von %(total)d (%(method)s)"

#, python-format
msgid "Error resetting filter: %s"
msgstr "Fehler beim Zurücksetzen des Filters: %s"

msgid "Enter an expression first"
msgstr "Gib zunächst einen Ausdruck ein"

#, python-brace-format
msgid "Created by the GOQL Filter gramplet on {today}"
msgstr "Erstellt vom GOQL-Filter-Gramplet am {today}"

