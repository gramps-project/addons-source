msgid "A gramps-object-query-language where-expression, e.g.\n"
msgstr "Gramps-objektikyselykielen where-lauseke, esim.\n"

msgid "Enter inserts a newline; Ctrl+Enter runs Find.\n"
msgstr "Enter lisää rivinvaihdon; Ctrl+Enter käynnistää haun.\n"

msgid "Up/Down at the first/last line recalls previous expressions.\n"
msgstr ""
"Ylös/Alas ensimmäisen tai viimeisen rivin kohdalla palauttaa edelliset "
"lausekkeet.\n"

msgid "Tab always completes -- it never inserts a tab character."
msgstr ""
"Tab-näppäin täydentää aina merkkijonon – se ei koskaan lisää sarkainmerkkiä."

#, python-format
msgid "%s filter"
msgstr "Käytä %s-suodinta"

msgid "This resets the filter parameters to empty state."
msgstr "Tämä tyhjentää suodatinparametrit."

msgid "This opens a dialog to save the current expression as a named filter."
msgstr ""
"Tämä avaa valintaikkunan, tallentaaksesi nykyisen lausekkeen nimettynä "
"suodattimena."

msgid "Open this gramplet's help page in a browser."
msgstr "Avaa tämän grampletin ohjesivun selaimessa."

msgid "SQL"
msgstr "SQL"

msgid "Python evaluation"
msgstr "Python-tulkki"

#, python-format
msgid "Error applying filter: %s"
msgstr "Virhe suodattinta %s sovellettaessa"

#, python-format
msgid "Showing %(shown)d of %(total)d (%(method)s)"
msgstr "Näytetään %(shown)d / %(total)d (%(method)s)"

#, python-format
msgid "Error resetting filter: %s"
msgstr "Virhe suodattimen %s tyhjennyksessä"

msgid "Enter an expression first"
msgstr "Syötä ensin lauseke"

#, python-brace-format
msgid "Created by the GOQL Filter gramplet on {today}"
msgstr "GOQL suotimen luoma {today}"

