msgid "Repositories matching the <GOQL expression>"
msgstr "Lauseeseen <GOQL expression> täsmäävät arkistot"

msgid "Sources matching the <GOQL expression>"
msgstr "Lauseeseen <GOQL expression> täsmäävät lähteet"

msgid "Citations matching the <GOQL expression>"
msgstr "Lauseeseen <GOQL expression> täsmäävät lainaukset"

msgid "Media matching the <GOQL expression>"
msgstr "Lauseeseen <GOQL expression> täsmäävät mediatiedostot"

msgid "Notes matching the <GOQL expression>"
msgstr "Lauseeseen <GOQL expression> täsmäävät lisätiedot"

msgid "Person GOQL Filter"
msgstr "Henkilö-GOQL suodin"

msgid "Gramplet providing a gramps-object-query-language person filter"
msgstr ""
"Gramplet, joka toteuttaa gramps-objektien kyselykielen henkilöiden "
"suodattamiseen"

