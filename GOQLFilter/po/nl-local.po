msgid "GOQL expression"
msgstr "GOQL-expressie"

msgid ""
"Matches objects for which the given gramps-object-query-language where-"
"expression evaluates to true"
msgstr ""
"Komt overeen met objecten waarvoor de gegeven gramps-object-query-taal "
"'where'-expressie evalueert tot waar"

msgid "People matching the <GOQL expression>"
msgstr "Personen die overeenkomen met de <GOQL-expressie>"

msgid "Families matching the <GOQL expression>"
msgstr "Gezinnen die overeenkomen met de <GOQL-expressie>"

msgid "Events matching the <GOQL expression>"
msgstr "Gebeurtenissen die overeenkomen met de <GOQL-expressie>"

msgid "Places matching the <GOQL expression>"
msgstr "Plaatsen die overeenkomen met de <GOQL-expressie>"

msgid "Repositories matching the <GOQL expression>"
msgstr "Opslagplaatsen die overeenkomen met de <GOQL-expressie>"

msgid "Sources matching the <GOQL expression>"
msgstr "Bronnen die overeenkomen met de <GOQL-expressie>"

msgid "Citations matching the <GOQL expression>"
msgstr "Citaten die overeenkomen met de <GOQL-expressie>"

msgid "Media matching the <GOQL expression>"
msgstr "Media die overeenkomen met de <GOQL-expressie>"

msgid "Notes matching the <GOQL expression>"
msgstr "Notities die overeenkomen met de <GOQL-expressie>"

msgid "Person GOQL Filter"
msgstr "GOQL-filter voor personen"

msgid "Gramplet providing a gramps-object-query-language person filter"
msgstr "Gramplet die een persoonsfilter biedt in gramps-object-query-taal"

msgid "GOQL Filter"
msgstr "GOQL-filter"

msgid "Family GOQL Filter"
msgstr "GOQL-filter voor gezinnen"

msgid "Gramplet providing a gramps-object-query-language family filter"
msgstr "Gramplet die een familiefilter biedt in gramps-object-query-taal"

msgid "Event GOQL Filter"
msgstr "GOQL-filter voor gebeurtenissen"

msgid "Gramplet providing a gramps-object-query-language event filter"
msgstr "Gramplet die een gebeurtenisfilter biedt in gramps-object-query-taal"

msgid "Place GOQL Filter"
msgstr "GOQL-filter voor plaatsen"

msgid "Gramplet providing a gramps-object-query-language place filter"
msgstr "Gramplet die een plaatsfilter biedt in gramps-object-query-taal"

msgid "Repository GOQL Filter"
msgstr "GOQL-filter voor opslagplaatsen"

msgid "Gramplet providing a gramps-object-query-language repository filter"
msgstr ""
"Gramplet die een filter biedt voor gramps-object-query-taal-opslagplaatsen"

msgid "Source GOQL Filter"
msgstr "GOQL-filter voor bronnen"

msgid "Gramplet providing a gramps-object-query-language source filter"
msgstr "Gramplet die een filter biedt voor gramps-object-query-taal-bronnen"

msgid "Citation GOQL Filter"
msgstr "GOQL-filter voor citaten"

msgid "Gramplet providing a gramps-object-query-language citation filter"
msgstr "Gramplet die een citatenfilter biedt in gramps-object-query-taal"

msgid "Media GOQL Filter"
msgstr "GOQL-filter voor media"

msgid "Gramplet providing a gramps-object-query-language media filter"
msgstr "Gramplet die een mediafilter biedt in gramps-object-query-taal"

msgid "Note GOQL Filter"
msgstr "GOQL-filter voor notities"

msgid "Gramplet providing a gramps-object-query-language note filter"
msgstr "Gramplet die een notitiesfilter biedt in gramps-object-query-taal"

msgid "A gramps-object-query-language where-expression, e.g.\n"
msgstr "Een 'where'-uitdrukking in gramps-object-query-taal, bijv.\n"

msgid "Enter inserts a newline; Ctrl+Enter runs Find.\n"
msgstr "Enter voegt een nieuwe regel in; Ctrl+Enter start Zoekopdracht.\n"

msgid "Up/Down at the first/last line recalls previous expressions.\n"
msgstr ""
"Omhoog/omlaag op de eerste/laatste regel roept eerdere uitdrukkingen op.\n"

msgid "Tab always completes -- it never inserts a tab character."
msgstr "De Tab-toets voltooit altijd – en voegt nooit een tabteken in."

#, python-format
msgid "%s filter"
msgstr "%s filter"

msgid "This resets the filter parameters to empty state."
msgstr "Hiermee worden de filterparameters teruggezet naar de lege toestand."

msgid "This opens a dialog to save the current expression as a named filter."
msgstr ""
"Dit opent een dialoogvenster om de huidige expressie op te slaan als een "
"benoemd filter."

msgid "Open this gramplet's help page in a browser."
msgstr "Open de helppagina van deze gramplet in een browser."

msgid "SQL"
msgstr "SQL"

msgid "Python evaluation"
msgstr "Python-evaluatie"

#, python-format
msgid "Error applying filter: %s"
msgstr "Fout bij toepassing filter: %s"

#, python-format
msgid "Showing %(shown)d of %(total)d (%(method)s)"
msgstr "%(shown)d van %(total)d (%(method)s) weergeven"

#, python-format
msgid "Error resetting filter: %s"
msgstr "Fout bij herstel van filter: %s"

msgid "Enter an expression first"
msgstr "Voer eerst een expressie in"

#, python-brace-format
msgid "Created by the GOQL Filter gramplet on {today}"
msgstr "{today} aangemaakt door de GOQL-filter gramplet"

