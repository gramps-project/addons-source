msgid "GOQL expression"
msgstr "Espressione GOQL"

msgid ""
"Matches objects for which the given gramps-object-query-language where-"
"expression evaluates to true"
msgstr ""
"Abbina gli oggetti per cui l'espressione where in gramps-object-query-"
"language indicata risulta vera"

msgid "People matching the <GOQL expression>"
msgstr "Persone che corrispondono all'<espressione GOQL>"

msgid "Families matching the <GOQL expression>"
msgstr "Famiglie che corrispondono all'<espressione GOQL>"

msgid "Events matching the <GOQL expression>"
msgstr "Eventi che corrispondono all'<espressione GOQL>"

msgid "Places matching the <GOQL expression>"
msgstr "Luoghi che corrispondono all'<espressione GOQL>"

msgid "Repositories matching the <GOQL expression>"
msgstr "Depositi che corrispondono all'<espressione GOQL>"

msgid "Sources matching the <GOQL expression>"
msgstr "Fonti che corrispondono all'<espressione GOQL>"

msgid "Citations matching the <GOQL expression>"
msgstr "Citazioni che corrispondono all'<espressione GOQL>"

msgid "Media matching the <GOQL expression>"
msgstr "Media che corrispondono all'<espressione GOQL>"

msgid "Notes matching the <GOQL expression>"
msgstr "Note che corrispondono all'<espressione GOQL>"

msgid "Person GOQL Filter"
msgstr "Filtro GOQL persone"

msgid "Gramplet providing a gramps-object-query-language person filter"
msgstr ""
"Gramplet che fornisce un filtro persone in gramps-object-query-language"

msgid "GOQL Filter"
msgstr "Filtro GOQL"

msgid "Family GOQL Filter"
msgstr "Filtro GOQL famiglie"

msgid "Gramplet providing a gramps-object-query-language family filter"
msgstr ""
"Gramplet che fornisce un filtro famiglie in gramps-object-query-language"

