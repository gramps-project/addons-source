msgstr "Filtro GOQL luoghi"

msgid "Gramplet providing a gramps-object-query-language place filter"
msgstr "Gramplet che fornisce un filtro luoghi in gramps-object-query-language"

msgid "Repository GOQL Filter"
msgstr "Filtro GOQL depositi"

msgid "Gramplet providing a gramps-object-query-language repository filter"
msgstr ""
"Gramplet che fornisce un filtro depositi in gramps-object-query-language"

msgid "Source GOQL Filter"
msgstr "Filtro GOQL fonti"

msgid "Gramplet providing a gramps-object-query-language source filter"
msgstr "Gramplet che fornisce un filtro fonti in gramps-object-query-language"

msgid "Citation GOQL Filter"
msgstr "Filtro GOQL citazioni"

msgid "Gramplet providing a gramps-object-query-language citation filter"
msgstr ""
"Gramplet che fornisce un filtro citazioni in gramps-object-query-language"

msgid "Media GOQL Filter"
msgstr "Filtro GOQL media"

msgid "Gramplet providing a gramps-object-query-language media filter"
msgstr "Gramplet che fornisce un filtro media in gramps-object-query-language"

msgid "Note GOQL Filter"
msgstr "Filtro GOQL note"

msgid "Gramplet providing a gramps-object-query-language note filter"
msgstr "Gramplet che fornisce un filtro note in gramps-object-query-language"

msgid "A gramps-object-query-language where-expression, e.g.\n"
msgstr "Un'espressione where in gramps-object-query-language, ad es.\n"

msgid "Enter inserts a newline; Ctrl+Enter runs Find.\n"
msgstr "Invio inserisce un a capo; Ctrl+Invio esegue Trova.\n"

msgid "Up/Down at the first/last line recalls previous expressions.\n"
msgstr "Su/Giù sulla prima/ultima riga richiama le espressioni precedenti.\n"

msgid "Tab always completes -- it never inserts a tab character."
msgstr "Tab completa sempre -- non inserisce mai un carattere di tabulazione."

#, python-format
msgid "%s filter"
msgstr "Filtro %s"

msgid "This resets the filter parameters to empty state."
msgstr "Riporta i parametri del filtro allo stato vuoto."

msgid "This opens a dialog to save the current expression as a named filter."
msgstr ""
"Apre una finestra per salvare l'espressione attuale come filtro con nome."

msgid "Open this gramplet's help page in a browser."
msgstr "Apri nel browser la pagina di aiuto di questo gramplet."

msgid "SQL"
msgstr "SQL"

msgid "Python evaluation"
msgstr "Valutazione Python"

#, python-format
msgid "Error applying filter: %s"
msgstr "Errore nell'applicazione del filtro: %s"

#, python-format
msgid "Showing %(shown)d of %(total)d (%(method)s)"
msgstr "Visualizzati %(shown)d di %(total)d (%(method)s)"

#, python-format
msgid "Error resetting filter: %s"
msgstr "Errore nel ripristino del filtro: %s"

msgid "Enter an expression first"
msgstr "Inserisci prima un'espressione"

#, python-brace-format
msgid "Created by the GOQL Filter gramplet on {today}"
msgstr "Creato dal gramplet Filtro GOQL il {today}"

