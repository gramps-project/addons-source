msgid "GOQL expression"
msgstr "Expressão GOQL"

msgid ""
"Matches objects for which the given gramps-object-query-language where-"
"expression evaluates to true"
msgstr ""
"Identifica os objectos para os quais a dada expressão-onde da gramps-object-"
"query-language é verdadeira"

msgid "People matching the <GOQL expression>"
msgstr "Indivíduos que cumprem a <expressão GOQL>"

msgid "Families matching the <GOQL expression>"
msgstr "Famílias que cumprem a <expressão-GOQL>"

msgid "Events matching the <GOQL expression>"
msgstr "Eventos que cumprem a <expressão GOQL>"

msgid "Places matching the <GOQL expression>"
msgstr "Locais que cumprem a <expressão-GOQL>"

msgid "Repositories matching the <GOQL expression>"
msgstr "Repositórios que cumprem a <expressão-GOQL>"

msgid "Sources matching the <GOQL expression>"
msgstr "Fontes que cumprem a <expressão-GOQL>"

msgid "Citations matching the <GOQL expression>"
msgstr "Citações que cumprem a <expressão-GOQL>"

msgid "Media matching the <GOQL expression>"
msgstr "Multimédia que cumpre a <expressão-GOQL>"

msgid "Notes matching the <GOQL expression>"
msgstr "Notas que cumprem a <expressão-GOQL>"

msgid "Person GOQL Filter"
msgstr "Filtro GOQL do indivíduo"

msgid "Gramplet providing a gramps-object-query-language person filter"
msgstr ""
"Gramplet que oferece a linguagem gramps-object-query-language para indivíduos"

msgid "GOQL Filter"
msgstr "Filtro GOQL"

msgid "Family GOQL Filter"
msgstr "Filtro GOQL de família"

msgid "Gramplet providing a gramps-object-query-language family filter"
msgstr ""
"Gramplet que oferece a linguagem gramps-object-query-language para famílias"

