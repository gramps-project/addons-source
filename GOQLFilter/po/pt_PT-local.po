msgstr "Filtro GOQL de eventos"

msgid "Gramplet providing a gramps-object-query-language event filter"
msgstr ""
"Gramplet que oferece a linguagem gramps-object-query-language para eventos"

msgid "Place GOQL Filter"
msgstr "Filtro GOQL de local"

msgid "Gramplet providing a gramps-object-query-language place filter"
msgstr ""
"Gramplet que oferece a linguagem gramps-object-query-language para locais"

msgid "Repository GOQL Filter"
msgstr "Filtro GOQL de repositórios"

msgid "Gramplet providing a gramps-object-query-language repository filter"
msgstr ""
"Gramplet que oferece a linguagem gramps-object-query-language para "
"repositórios"

msgid "Source GOQL Filter"
msgstr "Filtro GOQL para fontes"

msgid "Gramplet providing a gramps-object-query-language source filter"
msgstr ""
"Gramplet que oferece a linguagem gramps-object-query-language para fontes"

msgid "Citation GOQL Filter"
msgstr "Filtro GOQL de citações"

msgid "Gramplet providing a gramps-object-query-language citation filter"
msgstr ""
"Gramplet que oferece a linguagem gramps-object-query-language para citações"

msgid "Media GOQL Filter"
msgstr "Filtro GOQL de multimédia"

msgid "Gramplet providing a gramps-object-query-language media filter"
msgstr ""
"Gramplet que oferece a linguagem gramps-object-query-language para multimédia"

msgid "Note GOQL Filter"
msgstr "Filtro GOQL de notas"

msgid "Gramplet providing a gramps-object-query-language note filter"
msgstr ""
"Gramplet que oferece a linguagem gramps-object-query-language para notas"

msgid "A gramps-object-query-language where-expression, e.g.\n"
msgstr "Uma expressão-onde da gramps-object-query-language, e.g.\n"

msgid "Enter inserts a newline; Ctrl+Enter runs Find.\n"
msgstr "Enter insere uma nova linha; Ctrl+Enter faz uma procura.\n"

msgid "Up/Down at the first/last line recalls previous expressions.\n"
msgstr "Acima/Abaixo na primeira/última linha chama a expressão anterior.\n"

msgid "Tab always completes -- it never inserts a tab character."
msgstr "Tab completa sempre -- nunca insere uma tabulação."

#, python-format
msgid "%s filter"
msgstr "Filtro %s"

msgid "This resets the filter parameters to empty state."
msgstr "Isto remove todos os parâmetros de filtros."

msgid "This opens a dialog to save the current expression as a named filter."
msgstr ""
"Isto abre um diálogo para gravar a expressão actual como um filtro com nome."

msgid "Open this gramplet's help page in a browser."
msgstr "Abre a página de ajuda deste gramplet num navegador."

msgid "SQL"
msgstr "SQL"

msgid "Python evaluation"
msgstr "Avaliação Python"

#, python-format
msgid "Error applying filter: %s"
msgstr "Erro ao aplicar o filtro: %s"

#, python-format
msgid "Showing %(shown)d of %(total)d (%(method)s)"
msgstr "A mostrar %(shown)d de %(total)d (%(method)s)"

#, python-format
msgid "Error resetting filter: %s"
msgstr "Erro ao repor o filtro: %s"

msgid "Enter an expression first"
msgstr "Insira uma expressão primeiro"

#, python-brace-format
msgid "Created by the GOQL Filter gramplet on {today}"
msgstr "Criado pelo gramplet GOQL Filter a {today}"

