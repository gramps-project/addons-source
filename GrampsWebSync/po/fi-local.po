msgid "Gramps Web Sync"
msgstr "Gramps Web -synkronointi"

msgid "Synchronizes a local database with a Gramps Web instance."
msgstr "Synkronoi paikallisen tietokannan Gramps Web -instanssin kanssa."

msgid "Your user does not have sufficient server permissions to use sync."
msgstr ""
"Käyttäjätunuksellasi ei ole riittäviä palvelinoikeuksia synkronointiin."

msgid "Fetching remote data..."
msgstr "Haetaan etätietoja..."

msgid "Unexpected error while applying changes."
msgstr "Odottamaton virhe muutoksien toteuttamiseen."

msgid "Media files are in sync."
msgstr "Mediatiedostoissa ei synkronoitavaa."

#, python-format
msgid "Successfully downloaded %s media file."
msgid_plural "Successfully downloaded %s media files."
msgstr[0] "%s mediatiedosto tuotiin onnistuneesti."
msgstr[1] "%s mediatiedostoa tuotiin onnistuneesti."

#, python-format
