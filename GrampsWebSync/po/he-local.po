#, python-format
msgid "Server error %s. Please check your connection."
msgstr "שגיאת שרת %s. נא לבדוק חיבור."

msgid "Connection failed. Please check the URL and your internet connection."
msgstr "חיבור כשל. נא לבדוק את ה־URL והחיבור למרשתת."

msgid "Error: URL not found."
msgstr "שגיאה: לא נמצא URL."

msgid "Reset remote to local"
msgstr "שיצוב מצב מרוחק למקומי"

msgid "Reset local to remote"
msgstr "שיצוב מצב מקומי למרוחק"

msgid "Merge"
msgstr "מיזוג"

msgid "Local changes"
msgstr "שינויים מקומיים"

msgid "Modified"
msgstr "מוסגל"

msgid "Remote changes"
msgstr "שינויים מרחוק"

msgid "Simultaneous changes"
msgstr "שינויים בו־זמנית"

msgid "Applying changes to local database ..."
msgstr "החלת שינויים במסד נתונים מקומי ..."

msgid "Applying changes to remote database ..."
msgstr "החלת שינויים במסד נתונים מרוחק ..."

msgid "Missing locally"
msgstr "חסרים באופן מקומי"

msgid "Missing remotely"
msgstr "חסרים באופן מרוחק"
