msgid "Gramps Web Sync"
msgstr "מרשתת גרמפס סנכרון"

msgid "Synchronizes a local database with a Gramps Web instance."
msgstr "מסנכרן מסד־נתונים מקומי עם מופע מרשתת גרמפס."

#, python-format
msgid "Gramps Web Sync %(addon)s, Web API %(api)s"
msgstr "סנכרון Gramps Web %(addon)s API מרשתת %(api)s"

#, python-format
msgid "Gramps Web Sync %s"
msgstr "סנכרון Gramps Web %s"

msgid ""
"This URL uses http, so your password will be sent in clear text. Use only "
"for local testing."
msgstr ""
"כתובת URL זו משתמשת ב־http, כלומר, הססמה תישלח כמלל גלוי. יש להשתמש בזה "
"לבדיקה מקומית בלבד."

#, python-format
msgid ""
"The system keyring could not be used. Snap confinement blocks access until "
"you run: %s"
msgstr ""
"לא ניתן היה להשתמש בצרור־מפתחות המערכת. הגבלת Snap חוסמת את הגישה עד להרצת: "
"%s"

msgid ""
"The system keyring could not be used. You will need to enter your password "
"each time."
msgstr "לא ניתן היה להשתמש בצרור מפתחות המערכת. תדרש הזנת סיסמה בכל פעם."

msgid "Authentication failed. Please check your username and password."
msgstr "האימות נכשל. יש לבדוק שם משתמש וססמה."

msgid "Access forbidden. Please check username and password."
msgstr "הגישה אסורה. יש לבדוק שם משתמש וססמה."

msgid "GrampsWeb service not found. Please check the URL."
msgstr "שירות מרשתת גרמפס לא נמצא. יש לבדוק את כתובת ה־URL."

msgid "Too many requests, please try again in a few seconds."
msgstr "יותר מדי בקשות; יש לנסות שוב בעוד כמה שניות."

msgid "GrampsWeb tree is disabled."
msgstr "אילן מרשתת גרמפס מושבת."

msgid "Connection failed. Please check the URL and your internet connection."
msgstr "חיבור כשל. נא לבדוק את ה־URL והחיבור למרשתת."

msgid "Invalid server response. Please check the URL."
msgstr "תגובת שרת לא תקינה. יש לבדוק את כתובת ה־URL."

msgid "Your user does not have sufficient server permissions to use sync."
msgstr "למשתמש אין הרשאות שרת מספיקות לשימוש בסנכרון."

msgid "Failed importing downloaded XML file."
msgstr "ייבוא קובץ XML שהורד נכשל."

msgid "Unable to synchronize changes to server: objects have been modified."
msgstr "לא ניתן לסנכרון שינויים לשרת: עצמים יש היה שונו."

msgid "Unexpected error while applying changes."
msgstr "שגיאה בלתי צפויה בעת החלת שינויים."

msgid ""
"The family tree was modified while the changes were being reviewed. Nothing "
"has been applied. Please compare again."
msgstr "אילן־היוחסין הוסגל במהלך סקירת השינויים. לא הוחל דבר. נא להשוות שוב."

#, python-format
msgid ""
"This server runs Gramps Web API %(found)s, but synchronization needs "
"%(needed)s or newer. Please update the server."
msgstr ""
"שרת זה מירץ Gramps Web API %(found)s, אבל הסינכרון דורש %(needed)s או חדש "
"יותר. נא לעדכן את השרת."

#, python-format
msgid ""
"This server did not report a Gramps Web API version, so it is too old to "
"synchronize with. Version %s or newer is needed."
msgstr ""
"השרת לא דיווח על גרסת Gramps Web API, לכן הוא ישן מדי מכדי להסתנכרן. נדרשת "
"גרסה %s או חדשה יותר."

#, python-format
msgid ""
"This server runs Gramps Web API %(found)s. This version of Gramps works with "
"Gramps Web API %(major)s, so synchronizing with this server needs a newer "
"version of Gramps."
msgstr ""
"שרת זה מריץ את Gramps Web API %(found)s. גרסה זו של גרמפס עובדת עם Gramps "
"Web API %(major)s, לכן סנכרון עם שרת זה דורש גרסה חדשה יותר של גרמפס."

msgid ""
"This server is not configured to use a background task queue. "
"Synchronization needs one: without it, applying changes times out before the "
"server has finished. Please enable it on the server."
msgstr ""
"שרת זה לא מוגדר להרצת תור משימות ברקע. לסנכרון נדרש אחד כזה: בלעדיו, פסק זמן "
"להחלת שינויים יתרחש לפני שהשרת סיים. נא אפשר זאת בשרת."

#, python-format
msgid "The server could not apply the changes: %s"
msgstr "השרת לא הצליח להחיל שינויים: %s"

#, python-format
msgid "Server error %s. Please check your connection."
msgstr "שגיאת שרת %s. נא לבדוק חיבור."

#, python-format
msgid "Unexpected error: %s"
msgstr "שגיאה בלתי צפויה: %s"

msgid "Signing in…"
msgstr "מתבצעת התחברות…"

msgid "Downloading the remote family tree…"
msgstr "מתבצעת הורדתאילן־יוחסין מרוחק…"

msgid "Comparing the two family trees…"
msgstr "מתבצאת השוואת שני אילנות־היוחסין…"

msgid "Checking which media files are missing…"
msgstr "מתבצעת בדיקת עצמי מדיה חסרים…"

msgid "Applied the changes to this computer."
msgstr "החלת שינויים במחשב זה."

msgid "Sending the changes to the server…"
msgstr "השינויים נשלחים לשרת…"

msgid "Downloading media files…"
msgstr "מתבצעת הורדת קבצי מדיה…"

msgid "Uploading media files…"
msgstr "מתבצעת העלאת קבצי מדיה…"

msgid "Connect"
msgstr "התחברות"

msgid "Apply changes"
msgstr "החלת שינויים"

msgid "Transfer media files"
msgstr "העברת קבצי מדיה"

msgid "Bidirectional synchronization"
msgstr "סנכרון דו־כיווני"

msgid "Reset the server to match this computer"
msgstr "שיצוב השרת כך שיתאים למחשב זה"

msgid "Reset this computer to match the server"
msgstr "שיצוב מחשס זה כך שיתאים לשרת"

msgid ""
"Changes from both sides are combined. Objects edited in both places are "
"merged."
msgstr "שינויים משני הצדדים שולבו. עצמים שנערכו בשני המקומות מוזגו."

msgid ""
"The server is made to match this computer. Anything changed only on the "
"server is discarded."
msgstr "השרת בנוי כך שהתאמות יתבצעו למחשב זה. כל שינוי שנעשה רק בשרת יושלך."

msgid ""
"This computer is made to match the server. Anything changed only here is "
"discarded."
msgstr "מחשב זה בנוי כך שהתאמות יתבצעו לשרת. כל שינוי שנעשה רק כאן יושלך."

