msgid "Gramps Web Sync"
msgstr "Sincronizzazione Web di Gramps"

msgid "Synchronizes a local database with a Gramps Web instance."
msgstr "Sincronizza un database locale con un'istanza web di Gramps."

msgid "Your user does not have sufficient server permissions to use sync."
msgstr ""
"L'utente non dispone delle autorizzazioni necessarie sul server per "
"utilizzare la sincronizzazione."

msgid "Fetching remote data..."
msgstr "Recupero dei dati remoti..."

msgid "Unexpected error while applying changes."
msgstr "Errore inatteso nell'applicazione delle modifiche."

msgid "Media files are in sync."
msgstr "I file multimediali sono sincronizzati."

#, python-format
msgid "Successfully downloaded %s media files."
msgstr "Scaricati con successo %s file multimediali."

#, python-format
msgid "Encountered %s errors during download."
msgstr "Si sono verificati %s errori durante lo scaricamento."

#, python-format
msgid "Successfully uploaded %s media files."
msgstr "Caricati con successo %s file multimediali."

#, python-format
msgid "Encountered %s errors during upload."
msgstr "Si sono verificati %s errori durante il caricamento."

msgid "Authentication failed. Please check your username and password."
msgstr "Autenticazione non riuscita. Verifica nome utente e password."

msgid "Access forbidden. Please check username and password."
msgstr "Accesso negato. Verifica nome utente e password."

msgid "GrampsWeb service not found. Please check the URL."
msgstr "Servizio GrampsWeb non trovato. Controlla l'URL."

msgid "Too many requests, please try again in a few seconds."
msgstr "Troppe richieste, prova di nuovo tra qualche secondo."

msgid "GrampsWeb tree is disabled."
msgstr "L'albero GrampsWeb è disabilitato."

#, python-format
msgid "Server error %s. Please check your connection."
msgstr "Errore del server %s. Controlla la connessione."

msgid "Connection failed. Please check the URL and your internet connection."
msgstr "Connessione non riuscita. Controlla l'URL e la connessione Internet."

msgid "Invalid server response. Please check the URL."
msgstr "Risposta del server non valida. Controlla l'URL."

#, python-format
msgid "Unexpected error: %s"
msgstr "Errore inaspettato: %s"

msgid "Error accessing media object."
msgstr "Errore nell'accesso a oggetti multimediali."

msgid "Failed importing downloaded XML file."
msgstr "Impossibile importare il file XML scaricato."

msgid "Comparing local and remote data..."
msgstr "Confronto tra dati locali e remoti..."

msgid "Server authorization error."
msgstr "Errore di autorizzazione del server."

msgid "Server authorization error: insufficient permissions."
msgstr "Errore di autorizzazione del server: permessi insufficienti."

msgid "Error: URL not found."
msgstr "Errore: URL non trovato."

msgid "Unable to synchronize changes to server: objects have been modified."
msgstr ""
"Impossibile sincronizzare le modifiche al server: gli oggetti sono stati "
"modificati."

#, python-format
msgid "Error %s while connecting to server."
msgstr "Errore %s durante la connessione al server."

msgid "URL error while connecting to server."
msgstr "Errore URL durante la connessione al server."

msgid "Unable to synchronize changes to server."
msgstr "Impossibile sincronizzare le modifiche al server."

msgid "Continue without transport encryption?"
msgstr "Vuoi continuare senza crittografia del traffico?"

msgid ""
"You have specified a URL with http scheme. If you continue, your password "
"will be sent in clear text over the network. Use only for local testing!"
msgstr ""
"Hai specificato un URL con uno schema http. Se continui, la tua password "
"verrà inviata come testo in chiaro sulla rete. Da usare solo per test locali!"

msgid "Continue with HTTP"
msgstr "Continua con HTTP"

msgid "Use HTTPS"
msgstr "Usa HTTPS"

msgid "Server URL: "
msgstr "URL del server: "

msgid "Bidirectional Synchronization"
msgstr "Sincronizzazione bidirezionale"

msgid "Reset remote to local"
msgstr "Reimposta da remoto a locale"

msgid "Reset local to remote"
msgstr "Reimposta da locale a remoto"

msgid "Merge"
msgstr "Fondi"

msgid "Local changes"
msgstr "Modifiche locali"

msgid "Remote changes"
msgstr "Modifiche remote"

msgid "Simultaneous changes"
msgstr "Modifiche simultanee"

msgid "Fetching information about media files..."
msgstr "Recupero delle informazioni sui file multimediali..."

msgid "Both trees are the same."
msgstr "Entrambi gli alberi sono lo stesso."

msgid "Applying changes to local database ..."
msgstr "Applicazione delle modifiche al database locale..."

msgid "No changes to apply to local database."
msgstr "Nessuna modifica da applicare al database locale."

msgid "Applying changes to remote database ..."
msgstr "Applicazione delle modifiche al database remoto..."

msgid "No changes to apply to remote database."
msgstr "Nessuna modifica da applicare al database remoto."

msgid "Successfully applied changes to local database."
msgstr "Le modifiche al database locale sono state applicate con successo."

msgid "Missing locally"
msgstr "Mancante in locale"

msgid "Missing remotely"
msgstr "Mancante in remoto"

#, python-format
msgid "Downloading %s media file(s)"
msgstr "Scaricamento di %s file multimediali"

#, python-format
msgid "Uploading %s media file(s)"
msgstr "Caricamento di %s file multimediali"
