msgid "Gramps Web Sync"
msgstr "Gramps Web sinkronizacija"

msgid "Synchronizes a local database with a Gramps Web instance."
msgstr "Sinkronizira lokalnu bazu podataka s Gramps Web instancom."

msgid "Your user does not have sufficient server permissions to use sync."
msgstr ""
"Tvoj korisnik nema dovoljne dozvole na serveru za korištenje sinkronizacije."

msgid "Unexpected error while applying changes."
msgstr "Neočekivana greška prilikom primjene promjena."

msgid "Media files are in sync."
msgstr "Medijske datoteke su sinkronizirane."

msgid "Error accessing media object."
msgstr "Greška pri pristupu medijskom objektu."

msgid "Failed importing downloaded XML file."
msgstr "Uvoz preuzete XML datoteke nije uspio."

msgid "Comparing local and remote data..."
msgstr "Uspoređivanje lokalnih i udaljenih podataka …"

msgid "Server authorization error."
msgstr "Greška autorizacije servera."

msgid "Server authorization error: insufficient permissions."
msgstr "Greška autorizacije servera: nedovoljne dozvole."

msgid "Error: URL not found."
msgstr "Greška: URL nije pronađen."

msgid "Unable to synchronize changes to server: objects have been modified."
msgstr ""
"Nije moguće sinkronizirati promjene sa serverom: objekti su promijenjeni."

#, python-format
msgid "Error %s while connecting to server."
msgstr "Greška %s tijekom povezivanja na server."

msgid "URL error while connecting to server."
msgstr "URL greška tijekom povezivanja na server."

msgid "Error while parsing response from server."
msgstr "Greška tijekom obrade odgovora od servera."

msgid "Continue without transport encryption?"
msgstr "Nastaviti bez šifriranja prijenosa?"

msgid ""
"You have specified a URL with http scheme. If you continue, your password "
"will be sent in clear text over the network. Use only for local testing!"
msgstr ""
"Zadan je URL s http shemom. Ako nastaviš, tvoja će se lozinka poslati u "
"nešifriranom obliku putem mreže. Koristi samo za lokalno testiranje!"

msgid "Continue with HTTP"
msgstr "Nastavi s HTTP-om"

msgid "Use HTTPS"
msgstr "Koristi HTTPS"

msgid "Server URL: "
msgstr "URL servera: "

msgid "Bidirectional Synchronization"
msgstr "Dvosmjerna sinkronizacija"

msgid "Merge"
msgstr "Sjedini"

msgid "Local changes"
msgstr "Lokalne promjene"

msgid "Modified"
msgstr "Promijenjeno"

msgid "Simultaneous changes"
msgstr "Istovremene promjene"

msgid "Fetching information about media files..."
msgstr "Dohvaćanje podataka o medijskim datotekama …"

msgid "Both trees are the same."
msgstr "Oba rodoslova su jednaka."

msgid "Applying changes to local database ..."
msgstr "Primjena promjena na lokalnu bazu podataka …"

msgid "No changes to apply to local database."
msgstr "Nema promjena za lokalnu bazu podataka."

msgid "Applying changes to remote database ..."
msgstr "Primjena promjena na eksternu bazu podataka …"

msgid "No changes to apply to remote database."
msgstr "Nema promjena za eksternu bazu podataka."

msgid "Successfully applied changes to local database."
msgstr "Promjene na lokalnoj bazi podataka su uspješno primijenjene."

msgid "Missing locally"
msgstr "Nedostaje lokalno"

msgid "Missing remotely"
msgstr "Nedostaje eksterno"

#, python-format
msgid "Downloading %s media file(s)"
msgstr "Preuzimanje medijskih datoteka (%s)"

#, python-format
msgid "Uploading %s media file(s)"
msgstr "Prijenos medijskih datoteka (%s)"
