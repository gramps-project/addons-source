msgstr[1] "%s Objekte werden auf diesem Computer gelöscht."

#, python-format
msgid "%s object will be deleted on the server."
msgid_plural "%s objects will be deleted on the server."
msgstr[0] "%s Objekt wird auf dem Server gelöscht."
msgstr[1] "%s Objekte werden auf dem Server gelöscht."

#, python-format
msgid "%(down)s to download, %(up)s to upload"
msgstr "%(down)s zum Herunterladen, %(up)s zum Hochladen"

#, python-format
msgid "Also transfer %(total)s media file (%(counts)s)"
msgid_plural "Also transfer %(total)s media files (%(counts)s)"
msgstr[0] "Außerdem %(total)s Mediendatei (%(counts)s) übertragen"
msgstr[1] "Außerdem %(total)s Mediendateien (%(counts)s) übertragen"

#, python-format
msgid "%s media file is missing on both sides and cannot be transferred."
msgid_plural ""
"%s media files are missing on both sides and cannot be transferred."
msgstr[0] ""
"%s Mediendatei fehlt auf beiden Seiten und kann daher nicht übertragen "
