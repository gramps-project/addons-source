msgid_plural "Applied %s changes."
msgstr[0] "%s Änderung wurde übernommen."
msgstr[1] "%s Änderungen wurden übernommen."

msgid "Both trees are already in sync."
msgstr "Beide Bäume sind bereits synchronisiert."

msgid "Media files are in sync."
msgstr "Die Mediendateien sind synchronisiert."

#, python-format
