msgstr "תוסף שלא שוחרר – עבודה בתהליך"

msgid ""
"Wholly Genes - The Master Genealogist (TMG) Importer\n"
"\n"
"Select the TMG Data Set you wish to import."
msgstr ""
"יבואן Wholly Genes – The Master Genealogist‏ (TMG)\n"
"\n"
"בחירת ערכת נתוני TMG לייבוא."

msgid "Data Set Name"
msgstr "שם ערכת נתונים"

msgid "_Import TMG Data Set"
msgstr "_ייבוא TMG נתונים הגדרה"
