#, python-format
msgid ""
"Directly importing from TMG files is not supported\n"
"by the TMG Importer Addon.\n"
"\n"
"You need to use an backup copy of the TMG project(*.sqz)\n"
"\n"
"Ensure that your TMG project was created by:\n"
"TMG version 5.x or greater.\n"
"\n"
"Your file:\n"
"*.PJC - Project Configuration File for TMG 5.0 to TMG 9.05\n"
"\n"
"Please refer to:\n"
"%(gramps_wiki_import_pjc_direct_url)s"
msgstr ""
"Tuontia suoraan TMG-tiedostoista ei tueta\n"
"TMG Importer -lisäosassa.\n"
"\n"
"Sinun on käytettävä TMG-projektin varmuuskopiota (*.sqz).\n"
"\n"
"Varmista, että TMG-projektisi on luotu:\n"
"TMG-versiolla 5.x tai uudemmalla.\n"
"\n"
"Tiedostosi:\n"
"*.PJC - Projektin määritystiedosto on versiolle TMG 5.0 – TMG 9.05\n"
"\n"
"Katso:\n"
"%(gramps_wiki_import_pjc_direct_url)s"

msgid "TMG Project Backup"
msgstr "TMG-projektin varmuuskopiointi"

msgid "Import TMG project files"
msgstr "Tuo TMG-projektitiedostoja"

msgid "TMG Unsupported"
msgstr "TMG:tä ei tueta"

msgid "TMG Importer"
msgstr "TMG-tuoja"

msgid "Unreleased Addon - Work In Progress"
msgstr "Julkaisematon lisäosa - Työn alla"

msgid ""
"Wholly Genes - The Master Genealogist (TMG) Importer\n"
"\n"
"Select the TMG Data Set you wish to import."
msgstr ""
"Wholly Genes - Pääsukututkijan (TMG, The Master Genealogist) tuontityökalu\n"
"\n"
"Valitse tuotava TMG-tietojoukko."

msgid "Data Set Name"
msgstr "Tietojoukon nimi"

msgid "_Import TMG Data Set"
msgstr "_Tuo TMG-tietojoukko"
