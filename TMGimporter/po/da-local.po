#, python-format
msgid ""
"Directly importing from TMG files is not supported\n"
"by the TMG Importer Addon.\n"
"\n"
"You need to use an backup copy of the TMG project(*.sqz)\n"
"\n"
"Ensure that your TMG project was created by:\n"
"TMG version 5.x or greater.\n"
"\n"
"Your file:\n"
"*.PJC - Project Configuration File for TMG 5.0 to TMG 9.05\n"
"\n"
"Please refer to:\n"
"%(gramps_wiki_import_pjc_direct_url)s"
msgstr ""
"Direkte import fra TMG filer er ikke understøttet\n"
"af TMG import tillægget.\n"
"\n"
"Du skal benytte en sikkerhedskopi af TMG projektet(*sqz)\n"
"\n"
"Forsikkr dig om at dit TMG projekt var dannet af:\n"
"TMG version 5.x eller nyere.\n"
"Din fil:\n"
"*PJC projekt konfigurationfil for TMG 5.0 til TMG 9.05\n"
"\n"
"Se venligst:\n"
"%(gramps_wiki_import_pjc_direct_url)s"

msgid "TMG Project Backup"
msgstr "Sikkerhedskopier TMG projekt"

msgid "Import TMG project files"
msgstr "Importer TMG projekt filer"

msgid "TMG Unsupported"
msgstr "TMG ikke understøttet"

msgid "TMG Importer"
msgstr "TMG importer"

msgid "Unreleased Addon - Work In Progress"
msgstr "Ikke frigivet tillæg - igangværende arbejde"

msgid ""
"Wholly Genes - The Master Genealogist (TMG) Importer\n"
"\n"
"Select the TMG Data Set you wish to import."
msgstr ""
"Wholly Genes - The Master Genealogist (TMG) Importer\n"
"\n"
"Vælg de TMG data du vil importere ."

msgid "Data Set Name"
msgstr "Anvn på dataopsætning"

msgid "_Import TMG Data Set"
msgstr "_Importer TMG dataopsætning"
