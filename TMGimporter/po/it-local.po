msgid "TMG import failed"
msgstr "Importazione TMG non riuscita"

msgid ""
"The current Family Tree is not empty.\n"
"\n"
"Please create a new empty Family Tree before importing a TMG backup file."
msgstr ""
"L'albero genealogico corrente non è vuoto.\n"
"\n"
"Creane uno vuoto prima di importare un file di backup TMG."

msgid "TMG version not supported"
msgstr "Versione di TMG non supportata"

#, python-format
msgid ""
"Directly importing from TMG files is not supported\n"
"by the TMG Importer Addon.\n"
"\n"
"You need to use an backup copy of the TMG project(*.sqz)\n"
"\n"
"Ensure that your TMG project was created by:\n"
"TMG version 5.x or greater.\n"
"\n"
"Your file:\n"
"*.PJC - Project Configuration File for TMG 5.0 to TMG 9.05\n"
"\n"
"Please refer to:\n"
"%(gramps_wiki_import_pjc_direct_url)s"
msgstr ""
"L'importazione diretta dai file TMG non è supportata\n"
"dall'importatore TMG.\n"
"\n"
"Devi usare una copia di backup del progetto TMG (*.sqz)\n"
"\n"
"Assicurati che il progetto TMG sia stato creato con\n"
"una versione TMG 5.x o successiva.\n"
"\n"
"Il file:\n"
"*.PJC - Project Configuration File per TMG da 5.0 a TMG 9.05\n"
"\n"
"Fai riferimento a:\n"
"%(gramps_wiki_import_pjc_direct_url)s"

#, python-format
