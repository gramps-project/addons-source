msgid "TMG import failed"
msgstr "Ha fallado la importación de TMG"

msgid ""
"The current Family Tree is not empty.\n"
"\n"
"Please create a new empty Family Tree before importing a TMG backup file."
msgstr ""
"El Árbol de Familia actual no está vacío.\n"
"\n"
"Cree un Árbol de Familia vacío nuevo antes de importar un respaldo TMG."

#, python-format
msgid ""
"This backup was created with an older version of TMG (PjcVersion %(ver)s, "
"equivalent to TMG 9.01 or earlier).\n"
"\n"
"Please upgrade your TMG project to version 9.05 and create a new backup, "
"then import again.\n"
"\n"
"See: https://gramps-project.org/wiki/index.php/"
"Addon:TMGimporter#Before_Import_From_TMG_Backup_file"
msgstr ""
"Esta copia de seguridad estuvo creada con una versión más anterior que TMG "
"(PjcVersion %(ver)s, equivalente a TMG 9.01 o anterior)\n"
"\n"
"Mejore su versión del proyecto TMG a la 9.05 y cree un respaldo nuevo, "
"después importe otra vez.\n"
"\n"
"Consulte: https://gramps-project.org/wiki/index.php/"
"Addon:TMGimporter#Before_Import_From_TMG_Backup_file"

msgid "TMG Project Backup"
msgstr "TMG Copia de respaldo del proyecto"

msgid "TMG Unsupported"
msgstr "TMG Sin mantenimiento"

msgid "TMG Importer"
msgstr "Importador TMG"

msgid "_Import TMG Data Set"
msgstr "_Importar Conjunto de Datos TMG"
