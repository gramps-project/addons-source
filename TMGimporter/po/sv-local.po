msgid "TMG import failed"
msgstr "TMG-import misslyckades"

msgid "TMG version not supported"
msgstr "TMG-version stöds inte"

#, python-format
msgid ""
"Directly importing from TMG files is not supported\n"
"by the TMG Importer Addon.\n"
"\n"
"You need to use an backup copy of the TMG project(*.sqz)\n"
"\n"
"Ensure that your TMG project was created by:\n"
"TMG version 5.x or greater.\n"
"\n"
"Your file:\n"
"*.PJC - Project Configuration File for TMG 5.0 to TMG 9.05\n"
"\n"
"Please refer to:\n"
"%(gramps_wiki_import_pjc_direct_url)s"
msgstr ""
"Direkt import från TMG-filer stöds inte\n"
"av TMG-import-tillägget.\n"
"\n"
"Du behöver använda en säkerhetskopia av TMG-projektet(*.sqz)\n"
"\n"
"Säkerställ att ditt TMG-projekt skapades av:\n"
"TMG version 5.x eller högre.\n"
"\n"
"Din fil:\n"
"*.PJC - projektkonfigurationsfil för TMG 5.0 till TMG 9.05\n"
"\n"
"Vänligen hänvisa till:\n"
"%(gramps_wiki_import_pjc_direct_url)s"

msgid "TMG Project Backup"
msgstr "Säkerhetskopiera TMG-projekt"

msgid "Import TMG project files"
msgstr "Importera TMG-projektfiler"

msgid "TMG Unsupported"
msgstr "TMG stöds inte"

msgid "TMG Importer"
msgstr "TMG-importör"

msgid "Unreleased Addon - Work In Progress"
msgstr "Outgivet tillägg - Pågående arbete"

msgid ""
"Wholly Genes - The Master Genealogist (TMG) Importer\n"
"\n"
"Select the TMG Data Set you wish to import."
msgstr ""
"Wholly Genes - The Master Genealogist (TMG) importverktyg\n"
"\n"
"Välj datauppsättningen från TMG som du önskar importera."

msgid "Data Set Name"
msgstr "Namn på datauppsättning"

msgid "_Import TMG Data Set"
msgstr "_Importera TMG datauppsättning"
