msgid "Search"
msgstr "חיפוש"

msgid "Gramplet for search objects in database."
msgstr "גראמפלט לחיפוש עצמים מבמסד הנתונים."

msgid "Show bookmarked first"
msgstr "הצגת מסומן בסימנייה ראשון"

msgid "Sort by object type"
msgstr "מיון לפי סוג עצם"

msgid "Persons"
msgstr "אנשים"

msgid "Menu to set search objects"
msgstr "תפריט להגדרת עצמים לחיפוש"

msgid "Select objects to search"
msgstr "בחירת עצמים לחיפוש"

msgid "SearchGramplet configuration menu"
msgstr "תפריט תצורת גרמפלט החיפוש"

#, python-format
msgid "found: %s"
msgstr "נמצא: %s"

msgid "No matches..."
msgstr "אין התאמות..."

msgid "Start type to search"
msgstr "סוג התחלתי לחיפוש"

msgid ""
"Start type to search objects.\n"
"To show all objects enter only «*» symbol."
msgstr ""
"יש להתחיל להקליד כדי לחפש עצמים.\n"
"להצגת כל העצמים יש להזין רק את הסימן «*»."

msgid "Search..."
msgstr "חיפוש..."

msgid "Remove from bookmarks"
msgstr "הסרת מסימניות"

msgid "Add to bookmarks"
msgstr "הוספה לסימניות"

#, python-format
msgid "Birth: %s"
msgstr "לידה: %s"

#, python-format
msgid "Death: %s"
msgstr "תאריך: %s"

