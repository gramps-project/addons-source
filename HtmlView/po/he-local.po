msgid "HtmlView"
msgstr "מצג Html"

msgid "Go to the previous page in the history"
msgstr "מעבר לעמוד הקודם בהיסטוריה"

msgid "Go to the next page in the history"
msgstr "מעבר לעמוד הבא בהיסטוריה"

msgid "_Refresh"
msgstr "_רענון"

msgid "Stop and reload the page."
msgstr "עצירה וטעינה מחדש עמוד."

msgid "Start page for the Html View"
msgstr "עמוד אתחול עבור מצג Html"

msgid ""
"Type a webpage address at the top, and hit the execute button to load a "
"webpage in this page\n"
"<br>\n"
"For example: "
msgstr ""
"יש להקליד כתובת עמוד מרשתת למעלה ולהקיש על לחצן הביצוע כדי לטעון עמוד מרשתת "
"בעמוד זה\n"
"<br>\n"
"לדוגמה: "

msgid "Html View"
msgstr "מצג Html"

msgid "A view showing html pages embedded in Gramps"
msgstr "מצג שמציג עמודי html שמשובצים בגרמפס"

msgid "Web"
msgstr "מרשתת"
