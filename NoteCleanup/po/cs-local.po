msgstr "Vyčištění poznámek"

msgid "Clean up Notes that contain HTML markup"
msgstr "Vyčistit poznámky obsahující značky HTML"

msgid "Note Cleanup Tool"
msgstr "Nástroj pro vyčištění poznámek"

msgid "Cleaned Notes"
msgstr "Vyčištěné poznámky"

msgid "Links Only"
msgstr "Pouze odkazy"

msgid "Issues"
msgstr "Problémy"

msgid "Close the Note Cleanup Tool"
msgstr "Zavřít nástroj pro vyčištění poznámek"

msgid "Save All"
msgstr "Uložit vše"

msgid "Save All Changes"
msgstr "Uložit všechny změny"

