msgid "Note Cleanup"
msgstr "Not Temizleme"

msgid "Clean up Notes that contain HTML markup"
msgstr "HTML işaretlemesi içeren notları temizle"

msgid "Note Cleanup Tool"
msgstr "Not Temizleme Aracı"

msgid "Cleaned Notes"
msgstr "Temizlenmiş Notlar"

msgid "Links Only"
msgstr "Yalnızca Bağlantılar"

