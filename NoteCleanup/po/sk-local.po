msgstr "Vyčistite poznámky, ktoré obsahujú HTML značky"

msgid "Note Cleanup Tool"
msgstr "Nástroj Čistenie poznámok"

msgid "Cleaned Notes"
msgstr "Vyčistené poznámky"

msgid "Links Only"
msgstr "Len odkazy"

msgid "Issues"
msgstr "Problémy"

msgid "Close the Note Cleanup Tool"
msgstr "Zatvoriť nástroj Čistenie poznámok"

msgid "Save All"
msgstr "Uložiť všetko"

msgid "Save All Changes"
msgstr "Uložiť všetky zmeny"

