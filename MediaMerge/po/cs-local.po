msgid "Media Merge"
msgstr "Sloučení médií"

#, python-brace-format
msgid "{number_of} media merged"
msgid_plural "{number_of} media merged"
msgstr[0] "Sloučeno {number_of} médium"
msgstr[1] "Sloučena {number_of} média"
msgstr[2] "Sloučeno {number_of} médií"

msgid "No media items merged."
msgstr "Nebyla sloučena žádná média."

msgid "Merge Media"
msgstr "Sloučit média"

msgid ""
"Searches the entire database, looking for media that have the same path and "
"merges them."
msgstr "Prohledá celou databázi, vyhledá média se stejnou cestou a sloučí je."
