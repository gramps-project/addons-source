#, python-brace-format
msgid "Failure writing {target_path}: {message}"
msgstr "{target_path} yazılırken hata oluştu: {message}"

#, python-format
msgid "Failed to create directory structure : %s"
msgstr "Dizin yapısı oluşturulamadı : %s"

#, python-format
msgid "Failed to copy web files : %s"
msgstr "Web dosyaları kopyalanamadı : %s"

msgid "Ancestral Collapsible Tree Options"
msgstr "Soy Ağacı Katlanabilir Şablonu Seçenekleri"

msgid "Include Generations"
msgstr "Nesilleri Dahil Et"

msgid "Male Background Color"
msgstr "Erkek Arka Plan Rengi"

msgid "RGB-color for male box background."
msgstr "Erkek kutusu arka planı için RGB rengi."

msgid "Male Expandable Background Color"
msgstr "Erkek Genişletilebilir Arka Plan Rengi"

msgid "RGB-color for male expandable box background."
msgstr "Erkek genişletilebilir kutusu arka planı için RGB rengi."

msgid "Female Background"
msgstr "Kadın Arka Planı"

msgid "RGB-color for female box background."
msgstr "Kadın kutusu arka planı için RGB rengi."

msgid "Female Expandable Background"
msgstr "Kadın Genişletilebilir Arka Planı"

msgid "RGB-color for female expandable box background."
msgstr "Kadın genişletilebilir kutusu arka planı için RGB rengi."

msgid "The destination path for generated files."
msgstr "Oluşturulan dosyalar için hedef yol."

msgid "The destination file name for html content."
msgstr "Html içeriği için hedef dosya adı."

msgid "Ancestral Fan Chart"
msgstr "Soy Ağacı Yelpaze Şeması"

msgid ""
"Generates a web page with a graphical representation of ancestors (SVG) "
"represented as a Fan Chart from the D3.js JavaScript library."
msgstr ""
"D3.js JavaScript kütüphanesinden bir Yelpaze Şeması olarak temsil edilen "
"soyların grafiksel gösterimini (SVG) içeren bir web sayfası oluşturur."

#, python-format
msgctxt "spouse"
msgid "See %(reference)s : %(spouse)s"
msgstr "Bakınız %(reference)s : %(spouse)s"

msgid "Generating report..."
msgstr "Rapor oluşturuluyor..."

msgid "Descendant Indented Tree"
msgstr "Torunların Girintili Ağacı"

msgid "Invalid Destination Directory"
msgstr "Geçersiz Hedef Dizin"

#, python-format
msgid ""
"Destinaton diretory %s does not exist\n"
"Do you want to attempt to create it?"
msgstr ""
"%s hedef dizini mevcut değil\n"
"Oluşturmayı denemek ister misiniz?"

#, python-brace-format
msgid "Failed to create {target_path}: {message}"
msgstr "{target_path} oluşturulamadı: {message}"

#, python-format
msgid ""
"Destination file %s already exists.\n"
"Do you want to overwrite it?"
msgstr ""
"Hedef dosya %s zaten mevcut.\n"
"Üzerine yazmak istiyor musunuz?"

msgid "Default View"
msgstr "Varsayılan Görünüm"

msgid "Expand All"
msgstr "Tümünü Genişlet"

msgid "Include contraction level"
msgstr "Daralma seviyesini dahil et"

msgid "The number of descendant levels to contract on initial display."
msgstr "İlk görüntülemede daraltılacak alt seviye sayısı."

msgid "The font size in pixels for each node."
msgstr "Her düğüm için piksel cinsinden yazı tipi boyutu."

msgid "Whether to show duplicate family trees in the report."
msgstr "Raporda yinelenen aile ağaçlarının gösterilip gösterilmeyeceği."

msgid "Expanded Row Background Color"
msgstr "Genişletilmiş Satır Arka Plan Rengi"

msgid "RGB-color for expanded row background."
msgstr "Genişletilmiş satır arka planı için RGB rengi."

msgid "Expandable Background Color"
msgstr "Genişletilebilir Arka Plan Rengi"

msgid "RGB-color for expandable row background."
msgstr "Genişletilebilir satır arka planı için RGB rengi."

msgid "Non-Expandable Background Color"
msgstr "Genişletilemez Arka Plan Rengi"

msgid "RGB-color for non-expandable row background."
msgstr "Genişletilemez satır arka planı için RGB rengi."

msgid "Include records marked private"
msgstr "Özel olarak işaretlenmiş kayıtları dahil et"

msgid "Whether to include private objects."
msgstr "Özel nesnelerin dahil edilip edilmeyeceği seçeneği."

msgid "Include Last Name Only"
msgstr "Sadece Soyadını Dahil Et"

msgid "Include Full Name Only"
msgstr "Sadece Tam Adı Dahil Et"

msgid "How to handle living people."
msgstr "Yaşayan kişilerin nasıl ele alınacağı."

msgid "Whether or not to include people who may have recently died."
msgstr "Yakın zamanda ölmüş kişilerin dahil edilip edilmeyeceği."

msgid "Navigation"
msgstr "Navigasyon"

msgid "Contraction/Expansion mechanism"
msgstr "Daraltma/Genişletme mekanizması"

msgid "Entire node."
msgstr "Tüm düğüm."

msgid "Arrow images at start of node."
msgstr "Düğümün başında ok resimleri."

msgid "Plus/Minus images at start of node."
msgstr "Düğümün başında artı/eksi resimleri."

msgid "Where to click to expand/contract nodes."
msgstr "Düğümleri genişletmek/daraltmak için nereye tıklanacağı."

msgid "Auto-generate HREF links for nodes"
msgstr "Düğümler için otomatik HREF bağlantıları oluşturma"

msgid "Whether to auto-generate HTML links for each node on the report."
msgstr ""
"Rapordaki her düğüm için otomatik HTML bağlantıları oluşturulup "
"oluşturulmayacağı."

msgid "URL prefix path."
msgstr "URL önek yolu."

msgid "URL prefix to apply to each auto-generated HREF link."
msgstr ""
"Otomatik olarak oluşturulan her HREF bağlantısına uygulanacak URL öneki."

msgid "URL file extension"
msgstr "URL dosya uzantısı"

msgid "No file extension."
msgstr "Dosya uzantısı yok."

msgid ".html"
msgstr ".html"

msgid ".htm"
msgstr ".htm"

msgid ".shtml"
msgstr ".shtml"

msgid ".php"
msgstr ".php"

msgid ".php3"
msgstr ".php3"

msgid ".cgi"
msgstr ".cgi"

msgid "URL file name delimeter"
msgstr "URL dosya adı ayırıcı"

msgid "Remove all whitespace."
msgstr "Tüm boşlukları kaldır."

msgid "Replace whitespace with dash(-)."
msgstr "Boşlukları tire (-) ile değiştir."

msgid "Replace whitespace with underscore(_)"
msgstr "Boşlukları alt çizgi (_) ile değiştir"

msgid "What to use as file name delimiter replacing whitespace."
msgstr "Boşlukların yerine dosya adı ayırıcı olarak ne kullanılacağı."

msgid "Generations to generate HREF links"
msgstr "HREF bağlantıları oluşturmak için nesil sayısı"

msgid "The number of generations to generate HREF links."
msgstr "HREF bağlantıları oluşturmak için nesil sayısı."

msgid "Exclude persons who died before (years)"
msgstr "(Yıl) öncesinde ölen kişileri hariç tut"

msgid ""
"Whether to generate links for people who died in infancy, -1 excludes nobody."
msgstr ""
"Bebeklik döneminde ölen kişiler için bağlantı oluşturulup oluşturulmayacağı, "
"-1 hiç kimseyi hariç tutmaz."

msgid "Exclude center person"
msgstr "Merkezdeki kişiyi hariç tut"

msgid "Whether or not to generate links for center person."
msgstr "Merkezdeki kişi için bağlantı oluşturulup oluşturulmayacağı."

msgid "Exclude Spouses"
msgstr "Eşleri hariç tut"

msgid "Whether or not to generate links for spouses."
msgstr "Eşler için bağlantı oluşturulup oluşturulmayacağı."

msgid "Biography Content"
msgstr "Biyografi İçeriği"

msgid "Show biography tooltips"
msgstr "Biyografi araç ipuçlarını göster"

msgid "Whether to show biography tooltips when hovering over a node."
msgstr ""
"Bir düğümün üzerine gelindiğinde biyografi araç ipuçlarının gösterilip "
"gösterilmeyeceği."

msgid "Text Color"
msgstr "Metin Rengi"

msgid "RGB-color for biography text."
msgstr "Biyografi metni için RGB rengi."

msgid "RGB-color for biography tooltip."
msgstr "Biyografi araç ipucu için RGB rengi."

msgid "Header Font size"
msgstr "Başlık Yazı Tipi Boyutu"

msgid "The font size in pixels for biography header text."
msgstr "Biyografi başlık metni için piksel cinsinden yazı tipi boyutu."

msgid "Body Font size"
msgstr "Gövde Yazı Tipi Boyutu"

msgid "The font size in pixels for biography body text."
msgstr "Biyografi gövde metni için piksel cinsinden yazı tipi boyutu."

msgid ""
"Generates a web page with a graphical representation of descendants (SVG) "
"representedas a Collapsible Indented Tree Layout from the D3.js JavaScript "
"library."
msgstr ""
"D3.js JavaScript kütüphanesinden bir Katlanabilir Girintili Soy Ağacı Düzeni "
"olarak temsil edilen soyların grafiksel gösterimini (SVG) içeren bir web "
"sayfası oluşturur."

msgid "Ancestral Fan Chart Options"
msgstr "Soy Ağacı Yelpaze Şeması Seçenekleri"

msgid "Paternal Background Color"
msgstr "Baba Tarafı Arka Plan Rengi"

msgid "RGB-color for paternal box background."
msgstr "Baba tarafı kutusu arka planı için RGB rengi."

msgid "Maternal Background"
msgstr "Anne Tarafı Arka Planı"

msgid "RGB-color for maternal box background."
msgstr "Anne tarafı kutusu arka planı için RGB rengi."

msgid "Ancestral Collapsible Tree"
msgstr "Soy Ağacı Katlanabilir Şablonu"

msgid ""
"Generates a web page with a graphical representation of ancestors (SVG) "
"represented as a Collapsible Tree Layout from the D3.js JavaScript library."
msgstr ""
"D3.js JavaScript kütüphanesinden Katlanabilir Şablon olarak temsil edilen "
"soy ağacının grafiksel gösterimini (SVG) içeren bir web sayfası oluşturur."
