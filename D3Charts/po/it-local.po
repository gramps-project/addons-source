#, python-brace-format
msgid "Failure writing {target_path}: {message}"
msgstr "Errore durante la scrittura di {target_path}: {message}"

#, python-format
msgid "Failed to create directory structure : %s"
msgstr "Impossibile creare la struttura della directory: %s"

#, python-format
msgid "Failed to copy web files : %s"
msgstr "Impossibile copiare i file web: %s"

msgid "Include Generations"
msgstr "Includi generazioni"

msgid "Male Background Color"
msgstr "Colore di fondo degli uomini"

msgid "RGB-color for male box background."
msgstr "Colore RGB per lo sfondo dei riquadri maschili."

msgid "Female Background"
msgstr "Colore di fondo delle donne"

msgid "RGB-color for female box background."
msgstr "Colore RGB per lo sfondo dei riquadri femminili."

msgid "The destination path for generated files."
msgstr "Il percorso di destinazione per i file generati."

msgid "The destination file name for html content."
msgstr "Il nome di file di destinazione per il contenuto HTML."

msgid "Descendant Indented Tree"
msgstr "Albero indentato dei discendenti"

msgid "Ancestral Fan Chart Options"
msgstr "Opzioni grafico a ventaglio ascendenza"

msgid "Paternal Background Color"
msgstr "Colore di sfondo paterno"

msgid "RGB-color for paternal box background."
msgstr "Colore RGB per lo sfondo del riquadro paterno."

msgid "Maternal Background"
msgstr "Colore di sfondo materno"

msgid "RGB-color for maternal box background."
msgstr "Colore RGB per lo sfondo del riquadro materno."

#, python-format
msgid "See %(reference)s : %(spouse)s"
msgstr "Vedi %(reference)s : %(spouse)s"

msgid "Generating report..."
msgstr "Generazione resoconto..."

msgid "Invalid Destination Directory"
msgstr "Directory di destinazione non valida"

#, python-format
msgid ""
"Destinaton diretory %s does not exist\n"
"Do you want to attempt to create it?"
msgstr ""
"La directory di destinazione %s non esiste\n"
"Vuoi crearla?"

#, python-brace-format
msgid "Failed to create {target_path}: {message}"
msgstr "Non è stato possibile creare {target_path}: {message}"

#, python-format
msgid ""
"Destination file %s already exists.\n"
"Do you want to overwrite it?"
msgstr ""
"Il file di destinazione %s esiste già.\n"
"Vuoi sovrascriverlo?"

msgid "Default View"
msgstr "Vista predefinita"

msgid "Expand All"
msgstr "Espandi tutto"

msgid "Include contraction level"
msgstr "Includi livello di contrazione"

msgid "The number of descendant levels to contract on initial display."
msgstr ""
"Il numero di generazioni di discendenti da contrarre nella visualizzazione "
"iniziale."

msgid "The font size in pixels for each node."
msgstr "La grandezza in pixel dei caratteri per ogni nodo."

msgid "Whether to show duplicate family trees in the report."
msgstr ""
"Indica se visualizzare o meno gli alberi familiari duplicati nel resoconto."

msgid "Expanded Row Background Color"
msgstr "Colore di sfondo della riga espansa"

msgid "Include records marked private"
msgstr "Includere informazioni marcate come private"

msgid "Whether to include private objects."
msgstr "Indica se includere oggetti privati."

msgid "Include Last Name Only"
msgstr "Includi solo il cognome"

msgid "How to handle living people."
msgstr "Come trattare persone viventi."

msgid "Whether or not to include people who may have recently died."
msgstr "Includere o meno persone che possono essere morte di recente."

msgid "Navigation"
msgstr "Navigazione"

msgid "Contraction/Expansion mechanism"
msgstr "Meccanismo di Contrazione/Espansione"

msgid "Entire node."
msgstr "Nodo intero."

msgid "Where to click to expand/contract nodes."
msgstr "Dove cliccare per espandere/contrarre nodi."

msgid "Auto-generate HREF links for nodes"
msgstr "Genera automaticamente collegamenti HREF per i nodi"

msgid "Whether to auto-generate HTML links for each node on the report."
msgstr ""
"Indica se generare automaticamente collegamenti HTML per ogni nodo del "
"resoconto."

msgid "URL prefix to apply to each auto-generated HREF link."
msgstr ""
"Prefisso dell'URL da applicare ad ogni collegamento HREF generato "
"automaticamente."

msgid "No file extension."
msgstr "Nessuna estensione del file."

msgid ".html"
msgstr ".html"

msgid ".htm"
msgstr ".htm"

msgid ".shtml"
msgstr ".shtml"

msgid ".php"
msgstr ".php"

msgid ".php3"
msgstr ".php3"

msgid ".cgi"
msgstr ".cgi"

msgid "Remove all whitespace."
msgstr "Rimuovi tutti gli spazi vuoti."

msgid "Replace whitespace with dash(-)."
msgstr "Sostituisci gli spazi vuoti con il trattino (-)."

msgid "Replace whitespace with underscore(_)"
msgstr "Sostituisci gli spazi vuoti con l'underscore (_)"

msgid "Generations to generate HREF links"
msgstr "Generazioni per cui generare collegamenti HREF"

msgid "The number of generations to generate HREF links."
msgstr "Il numero di generazioni per cui generare collegamenti HREF."

msgid "Exclude center person"
msgstr "Escludi persona centrale"

msgid "Whether or not to generate links for center person."
msgstr "Generare o non generare collegamenti per la persona centrale."

msgid "Exclude Spouses"
msgstr "Esclude i coniugi"

msgid "Whether or not to generate links for spouses."
msgstr "Generare o non generare collegamenti per i coniugi."

msgid "Biography Content"
msgstr "Contenuto della biografia"

msgid "Text Color"
msgstr "Colore del testo"

msgid "RGB-color for biography text."
msgstr "Colore RGB per il testo della biografia."

msgid "Header Font size"
msgstr "Grandezza carattere dell'intestazione"

msgid "The font size in pixels for biography header text."
msgstr ""
"La grandezza in pixel dei caratteri del testo dell'intestazione della "
"biografia."

msgid "Body Font size"
msgstr "Dimensione dei caratteri del corpo del testo"

msgid "The font size in pixels for biography body text."
msgstr ""
"La dimensione in pixel dei caratteri del testo del corpo della biografia."
