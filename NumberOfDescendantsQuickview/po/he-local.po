#, python-format
msgid "Number of %s's descendants"
msgstr "מספר הצאצאים של %s"

msgid "Generation"
msgstr "דור"

msgid "Seen"
msgstr "נראה"

msgid "Outlived"
msgstr "שרד לאחר מותם"

msgid "Now alive"
msgstr "חי כיום"

#, python-format
msgid "Seen = number of descendants whose birth %s has lived to see"
msgstr "נצפו = מספר הצאצאים שאת לידתם %s זכה לראות"

#, python-format
msgid "Outlived = number of descendants who died while %s was still alive"
msgstr "שרד לאחר מותם = מספר הצאצאים שנפטרו בעוד %s היה עדיין בחיים"

msgid "Number of descendants"
msgstr "מספר צאצאים"

msgid "Shows the number of descendants of the current person"
msgstr "הצגת מספר הצאצאים של האדם הנוכחי"
