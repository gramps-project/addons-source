#, python-format
msgid "Number of %s's descendants"
msgstr "Počet potomků – %s"

msgid "Generation"
msgstr "Generace"

msgid "Seen"
msgstr "Narození za života"

msgid "Outlived"
msgstr "Zemřelí za života"

msgid "Now alive"
msgstr "Nyní žijící"

#, python-format
msgid "Seen = number of descendants whose birth %s has lived to see"
msgstr ""
"Narození za života = počet potomků, jejichž narození se osoba %s dožila"

#, python-format
msgid "Outlived = number of descendants who died while %s was still alive"
msgstr ""
"Zemřelí za života = počet potomků, kteří zemřeli, když osoba %s ještě žila"

msgid "Number of descendants"
msgstr "Počet potomků"

msgid "Shows the number of descendants of the current person"
msgstr "Zobrazí počet potomků aktuální osoby"
