#, python-format
msgid "Number of %s's descendants"
msgstr "%s の子孫の数"

msgid "Generation"
msgstr "世代"

msgid "Seen"
msgstr "生存中に会った"

msgid "Outlived"
msgstr "生き延びた"

msgid "Now alive"
msgstr "現在存命"

#, python-format
msgid "Seen = number of descendants whose birth %s has lived to see"
msgstr "生存中に会った = %s が生きて見ることができた出生子孫の数"

#, python-format
msgid "Outlived = number of descendants who died while %s was still alive"
msgstr "生き延びた = %s がまだ生きている間に死亡した子孫の数"

msgid "Number of descendants"
msgstr "子孫の数"

msgid "Shows the number of descendants of the current person"
msgstr "現在の人物の子孫の数を表示します"
