#, python-format
msgid "Number of %s's descendants"
msgstr "Numero dei discendeti di %s"

msgid "Generation"
msgstr "Generazione"

msgid "Seen"
msgstr "Visti"

msgid "Outlived"
msgstr "Sopravvissuti"

msgid "Now alive"
msgstr "Vivo adesso"

#, python-format
msgid "Seen = number of descendants whose birth %s has lived to see"
msgstr ""
"Visti = numero di discendenti di cui %s ha visto la nascita durante la sua "
"vita"

#, python-format
msgid "Outlived = number of descendants who died while %s was still alive"
msgstr ""
"Sopravvissuti = il numero di discendenti che sono deceduti mentre %s era "
"ancora vivo"

msgid "Number of descendants"
msgstr "Numero di discendenti"

msgid "Shows the number of descendants of the current person"
msgstr "Mostra il numero di discendenti della persona corrente"
