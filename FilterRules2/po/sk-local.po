msgid "Y-chromosomal inheritance of <filter>"
msgstr "Y-chromozomálna dedičnosť od <filter>"

msgid ""
"Matches recorded descendants of a filter result following Y-chromosomal "
"inheritance patterns."
msgstr ""
"Zodpovedá zaznamenaným potomkom výsledku filtra podľa vzorcov dedičnosti "
"chromozómu Y."

msgid "X-chromosomal ancestors of <person>"
msgstr "Predkovia <osoby> podľa chromozómu X"

msgid ""
"Matches ancestors of <person> following a X-chromosomal inheritance pattern."
msgstr "Zodpovedá predkom <osoby> podľa vzorca dedičnosti chromozómu X."

msgid "X-chromosomal descendants of <person>"
msgstr "Potomkovia <osoby> podľa chromozómu X"

msgid ""
"Matches descendants of <person> following a X-chromosomal inheritance "
"pattern."
msgstr "Zodpovedá potomkom <osoby> podľa vzorca dedičnosti chromozómu X."

msgid "Patrilineal progenitor of <person>"
msgstr "Patrilineárny predchodca <osoby>"

msgid "Matches the earliest recorded patrilineal ancestor father."
msgstr "Zodpovedá najstaršiemu zaznamenanému otcovi predka v otcovskej línii."

msgid "Mitochondrial inheritance of <filter>"
msgstr "Mitochondriálna dedičnosť od <filter>"

msgid ""
"Matches recorded descendants of a filter result following mitochondrial "
"inheritance patterns."
msgstr ""
"Zodpovedá zaznamenaným potomkom výsledku filtra podľa vzorcov "
"mitochondriálnej dedičnosti."

msgid "Matrilineal progenitrix of <person>"
msgstr "Matrilineárna predchodkyňa <osoby>"

msgid "Matches the earliest recorded matrilineal ancestor mother."
msgstr "Zodpovedá najskoršej zaznamenanej matrilineárnej predchodkyni."

msgid ""
"Matches all descendants of <person> following a X-chromosomal inheritance "
"pattern."
msgstr ""
"Zodpovedá všetkým potomkom <osoby> podľa vzorca dedičnosti chromozómu X."

msgid "Mitochondrial inheritance of <person>"
msgstr "Mitochondriálna dedičnosť <osoby>"

msgid ""
"Matches recorded descendants of person following mitochondrial inheritance "
"patterns."
msgstr ""
"Zodpovedá zaznamenaným potomkom osoby podľa vzorcov mitochondriálnej "
"dedičnosti."

msgid "Y-chromosomal inheritance of <person>"
msgstr "Y-chromozomálne dedičstvo osoby <person>"

msgid ""
"Matches recorded descendants of person following Y-chromosomal inheritance "
"patterns."
msgstr ""
"Zodpovedá zaznamenaným potomkom osoby podľa vzorcov dedičnosti chromozómu Y."
