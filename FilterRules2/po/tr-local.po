msgid "Y-chromosomal inheritance of <filter>"
msgstr "<Filtre>nin Y kromozomal kalıtımı"

msgid ""
"Matches recorded descendants of a filter result following Y-chromosomal "
"inheritance patterns."
msgstr ""
"Filtre sonucunun Y kromozomal kalıtım modellerini izleyen kayıtlı soyundan "
"gelenlerle eşleştirir."

msgid "X-chromosomal ancestors of <person>"
msgstr "<Kişi>nin X kromozomal ataları"

msgid ""
"Matches ancestors of <person> following a X-chromosomal inheritance pattern."
msgstr ""
"X kromozomal kalıtım modelini izleyerek <kişi>nin atalarını eşleştirir."

msgid "X-chromosomal descendants of <person>"
msgstr "<Kişi>nin X kromozomlu soyundan gelenler"

msgid ""
"Matches descendants of <person> following a X-chromosomal inheritance "
"pattern."
msgstr ""
"<Kişi>nin X kromozomuna bağlı kalıtım örüntüsünü izleyen soyundan "
"gelenlerini eşleştirir."

msgid "Patrilineal progenitor of <person>"
msgstr "<Kişi>nin baba tarafından atası"

msgid "Matches the earliest recorded patrilineal ancestor father."
msgstr "En erken kaydedilmiş baba soyundan gelen atayı eşleştirir."

msgid "Mitochondrial inheritance of <filter>"
msgstr "<Filtre>nin mitokondriyal kalıtımı"

msgid ""
"Matches recorded descendants of a filter result following mitochondrial "
"inheritance patterns."
msgstr ""
"Bir filtre sonucunun soyundan gelenlerini, mitokondriyal kalıtım modellerine "
"göre eşleştirir."

msgid "Matrilineal progenitrix of <person>"
msgstr "<Kişinin> anasoylu büyükannesi"

msgid "Matches the earliest recorded matrilineal ancestor mother."
msgstr "Kayıtlara geçen en eski anasoylu ata olan anneyle eşleştirir."

msgid ""
"Matches all descendants of <person> following a X-chromosomal inheritance "
"pattern."
msgstr ""
"X kromozomal kalıtım modelini izleyen <kişi>nin tüm soyundan gelenleriyle "
"eşleştirir."

msgid "Mitochondrial inheritance of <person>"
msgstr "<Kişi>nin mitokondriyal kalıtımı"

msgid ""
"Matches recorded descendants of person following mitochondrial inheritance "
"patterns."
msgstr ""
"Kişinin mitokondriyal kalıtım modellerini izleyen kayıtlı soyundan "
"gelenlerle eşleştirir."

msgid "Y-chromosomal inheritance of <person>"
msgstr "<Kişi>nin Y kromozomal kalıtımı"

msgid ""
"Matches recorded descendants of person following Y-chromosomal inheritance "
"patterns."
msgstr ""
"Kişinin Y kromozomal kalıtım modellerini izleyen kayıtlı soyundan gelenlerle "
"eşleştirir."
