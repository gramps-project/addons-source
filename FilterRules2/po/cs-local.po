msgid "Y-chromosomal inheritance of <filter>"
msgstr "Dědičnost chromozomu Y výsledků <filtru>"

msgid ""
"Matches recorded descendants of a filter result following Y-chromosomal "
"inheritance patterns."
msgstr ""
"Vyhledá zaznamenané potomky výsledků filtru podle schématu dědičnosti "
"chromozomu Y."

msgid "X-chromosomal ancestors of <person>"
msgstr "Předci osoby <osoba> podle dědičnosti chromozomu X"

msgid ""
"Matches ancestors of <person> following a X-chromosomal inheritance pattern."
msgstr "Vyhledá předky osoby <osoba> podle schématu dědičnosti chromozomu X."

msgid "X-chromosomal descendants of <person>"
msgstr "Potomci osoby <osoba> podle dědičnosti chromozomu X"

msgid ""
"Matches descendants of <person> following a X-chromosomal inheritance "
"pattern."
msgstr "Vyhledá potomky osoby <osoba> podle schématu dědičnosti chromozomu X."

msgid "Patrilineal progenitor of <person>"
msgstr "Praotec v otcovské linii osoby <osoba>"

msgid "Matches the earliest recorded patrilineal ancestor father."
msgstr "Vyhledá nejvzdálenějšího zaznamenaného předka v přímé otcovské linii."

msgid "Mitochondrial inheritance of <filter>"
msgstr "Mitochondriální dědičnost výsledků <filtru>"

msgid ""
"Matches recorded descendants of a filter result following mitochondrial "
"inheritance patterns."
msgstr ""
"Vyhledá zaznamenané potomky výsledků filtru podle schématu mitochondriální "
"dědičnosti."

msgid "Matrilineal progenitrix of <person>"
msgstr "Pramáti v mateřské linii osoby <osoba>"

msgid "Matches the earliest recorded matrilineal ancestor mother."
msgstr "Vyhledá nejvzdálenější zaznamenanou předkyni v přímé mateřské linii."

msgid ""
"Matches all descendants of <person> following a X-chromosomal inheritance "
"pattern."
msgstr ""
"Vyhledá všechny potomky osoby <osoba> podle schématu dědičnosti chromozomu X."

msgid "Mitochondrial inheritance of <person>"
msgstr "Mitochondriální dědičnost osoby <osoba>"

msgid ""
"Matches recorded descendants of person following mitochondrial inheritance "
"patterns."
msgstr ""
"Vyhledá zaznamenané potomky osoby podle schématu mitochondriální dědičnosti."

msgid "Y-chromosomal inheritance of <person>"
msgstr "Dědičnost chromozomu Y osoby <osoba>"

msgid ""
"Matches recorded descendants of person following Y-chromosomal inheritance "
"patterns."
msgstr ""
"Vyhledá zaznamenané potomky osoby podle schématu dědičnosti chromozomu Y."
