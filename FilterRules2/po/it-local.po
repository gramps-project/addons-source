msgid "Y-chromosomal inheritance of <filter>"
msgstr "Ereditarietà del cromosoma Y di <filtro>"

msgid ""
"Matches recorded descendants of a filter result following Y-chromosomal "
"inheritance patterns."
msgstr ""
"Abbina i discendenti registrati del risultato di un filtro secondo "
"l'ereditarietà del cromosoma Y."

msgid "X-chromosomal ancestors of <person>"
msgstr "Ascendenti per il cromosoma X di <persona>"

msgid ""
"Matches ancestors of <person> following a X-chromosomal inheritance pattern."
msgstr ""
"Abbina gli ascendenti di <persona> secondo l'ereditarietà del cromosoma X."

msgid "X-chromosomal descendants of <person>"
msgstr "Discendenti con cromosoma X di <persona>"

msgid ""
"Matches descendants of <person> following a X-chromosomal inheritance "
"pattern."
msgstr ""
"Abbina i discendenti di <persona> secondo l'ereditarietà del cromosoma X."

msgid "Patrilineal progenitor of <person>"
msgstr "Progenitore patrilineare di <persona>"

msgid "Matches the earliest recorded patrilineal ancestor father."
msgstr "Abbina il più antico antenato registrato in linea patrilineare."

msgid "Mitochondrial inheritance of <filter>"
msgstr "Ereditarietà mitocondriale di <filtro>"

msgid ""
"Matches recorded descendants of a filter result following mitochondrial "
"inheritance patterns."
msgstr ""
"Abbina i discendenti registrati del risultato di un filtro secondo "
"l'ereditarietà mitocondriale."

msgid "Matrilineal progenitrix of <person>"
msgstr "Progenitrice matrilineare di <persona>"

msgid "Matches the earliest recorded matrilineal ancestor mother."
msgstr "Abbina la più antica antenata registrata in linea matrilineare."

msgid ""
"Matches all descendants of <person> following a X-chromosomal inheritance "
"pattern."
msgstr ""
"Abbina tutti i discendenti di <persona> secondo l'ereditarietà del cromosoma "
"X."

msgid "Mitochondrial inheritance of <person>"
msgstr "Ereditarietà mitocondriale di <persona>"

msgid ""
"Matches recorded descendants of person following mitochondrial inheritance "
"patterns."
msgstr ""
"Abbina i discendenti registrati della persona secondo l'ereditarietà "
"mitocondriale."

msgid "Y-chromosomal inheritance of <person>"
msgstr "Ereditarietà del cromosoma Y di <persona>"

msgid ""
"Matches recorded descendants of person following Y-chromosomal inheritance "
"patterns."
msgstr ""
"Abbina i discendenti registrati della persona secondo l'ereditarietà del "
"cromosoma Y."
