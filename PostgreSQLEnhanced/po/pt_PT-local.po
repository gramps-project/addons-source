#, python-brace-format
msgid "Object {obj_type}:{handle} was modified by another user"
msgstr "Objecto {obj_type}:{handle} modificado por outro utilizador"

msgid "Starting migration..."
msgstr "A iniciar a migração..."

#, python-format
msgid "Migrating %s objects..."
msgstr "A migrar %s objectos..."

#, python-format, python-brace-format
msgid "Migrated %s {obj_type} objects"
msgstr "Migrados %s(obj_type) objectos"

msgid "Migration completed!"
msgstr "Migração concluída!"

msgid "Starting upgrade..."
msgstr "A iniciar a actualização..."

#, python-format
msgid "Upgrading %s objects..."
msgstr "A actualizar %s objectos..."

msgid "Creating indexes..."
msgstr "A criar índices..."

msgid "Upgrade completed!"
msgstr "Actualização concluída!"

msgid "PostgreSQL Enhanced"
msgstr "PostgreSQL Enhanced"

msgid "PostgreSQL _Enhanced Database"
msgstr "Base de dados PostgreSQL _Enhanced Database"

msgid ""
"Advanced PostgreSQL backend with JSONB storage, graph database support "
"(Apache AGE), vector similarity (pgvector), and AI/ML capabilities. For "
"advanced users. Requires PostgreSQL 15+ with extensions. Gramps Web "
"compatible."
msgstr ""
"Motor Advanced PostgreSQL com armazenamento JSONB, suporte a base de dados "
"gráfica (Apache AGE), similaridade de vector (pgvector), e capacidade AI/ML. "
"Para utilizadores avançados. Requer PostgreSQL 15+ com extensões. Compatível "
"com Gramps Web."

msgid ""
"psycopg3 is required for PostgreSQL Enhanced support. Install with: pip "
"install 'psycopg[binary]'"
msgstr ""
"psycopg3 é necessário para supoete a PostgreSQL Enhance. Instale com: pip "
"install 'psycopg[binary]'"

#, python-format
msgid ""
"psycopg3 version %(installed)s is too old. Version %(required)s or newer is "
"required."
msgstr ""
"versão do psycopg3 %(installed)s demasiado antiga. É necessária a versão "
"%(required)s ou mais recente."

msgid "Database Backend"
msgstr "Motor de base de dados"

msgid "Database module"
msgstr "Módulo de base de dados"

msgid "JSONB support"
msgstr "Suporte a JSONB"

msgid "Version warning"
msgstr "Aviso de versão"

#, python-format
msgid "PostgreSQL %(version)s is below recommended version %(recommended)s"
msgstr ""
"PostgreSQL %(version)s está abaixo da versão %(recommended)s recomendada"

msgid "Extensions"
msgstr "Extensões"

msgid "Database size"
msgstr "Tamanho da base de dados"

#, python-format
msgid "%(persons)d persons, %(families)d families, %(events)d events"
msgstr "%(persons)d indivíduos, %(families)d famílias, %(events)d eventos"

msgid "Migration manager not initialized"
msgstr "Gestor de migração não inicializado"

msgid "Enhanced queries require JSONB support"
msgstr "Consultas avançadas requerem suporte a JSONB"

msgid "Full-text search requires JSONB support or search capabilities"
msgstr ""
"Procura completa de texto requer suporte a JSONB ou capacidade de procura"

msgid "pg_trgm extension required for duplicate detection"
msgstr "extensão pg_trgm requerida para detecção duplicada"
