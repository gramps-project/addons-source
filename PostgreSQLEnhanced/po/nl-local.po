msgid "Starting migration..."
msgstr "Migratie starten…"

msgid "Migration completed!"
msgstr "Migratie voltooid!"

msgid "Starting upgrade..."
msgstr "Bijwerking starten…"

msgid "Creating indexes..."
msgstr "Indexen aanmaken…"

msgid "Upgrade completed!"
msgstr "Bijwerking voltooid!"

msgid "PostgreSQL Enhanced"
msgstr "PostgreSQL Enhanced"

msgid "PostgreSQL _Enhanced Database"
msgstr "PostgreSQL _Enhanced database"

msgid ""
"psycopg3 is required for PostgreSQL Enhanced support. Install with: pip "
"install 'psycopg[binary]'"
msgstr ""
"psycopg3 is vereist voor PostgreSQL Enhanced-ondersteuning. Installeren met: "
"pip install 'psycopg[binary]'"

#, python-format
msgid ""
"psycopg3 version %(installed)s is too old. Version %(required)s or newer is "
"required."
msgstr ""
"psycopg3 versie %(installed)s is te oud. Versie %(required)s of nieuwer is "
"vereist."

msgid "Database Backend"
msgstr "Database-backend"

msgid "Database module"
msgstr "Database-module"

msgid "JSONB support"
msgstr "JSONB-ondersteuning"

msgid "Version warning"
msgstr "Versiewaarschuwing"

#, python-format
msgid "PostgreSQL %(version)s is below recommended version %(recommended)s"
msgstr "PostgreSQL %(version)s is lager dan aanbevolen versie %(recommended)s"

msgid "Extensions"
msgstr "Extensies"

msgid "Database size"
msgstr "Databasegrootte"

#, python-format
msgid "%(persons)d persons, %(families)d families, %(events)d events"
msgstr "%(persons)d personen, %(families)d gezinnen, %(events)d gebeurtenissen"

msgid "Migration manager not initialized"
msgstr "Migratiebheer niet geïnitialiseerd"

msgid "Enhanced queries require JSONB support"
msgstr "Verbeterde zoekopdrachten vereisen JSONB-ondersteuning"

msgid "pg_trgm extension required for duplicate detection"
msgstr "pg_trgm-extensie vereist voor detectie van duplicaten"
