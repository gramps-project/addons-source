msgid "Starting migration..."
msgstr "Розпочато міграцію..."

msgid "Migration completed!"
msgstr "Міграцію завершено!"

msgid "Starting upgrade..."
msgstr "Розпочато оновлення..."

msgid "Creating indexes..."
msgstr "Створення індексів..."

msgid "Upgrade completed!"
msgstr "Оновлення завершено!"

msgid "PostgreSQL Enhanced"
msgstr "Покращений PostgreSQL"

msgid "PostgreSQL _Enhanced Database"
msgstr "Розширена база даних PostgreSQL"

msgid ""
"psycopg3 is required for PostgreSQL Enhanced support. Install with: pip "
"install 'psycopg[binary]'"
msgstr ""
"Для підтримки PostgreSQL Enhanced потрібен psycopg3. Встановіть за "
"допомогою: pip install 'psycopg[binary]'"

#, python-format
msgid ""
"psycopg3 version %(installed)s is too old. Version %(required)s or newer is "
"required."
msgstr ""
"Версія psycopg3 %(installed)s занадто стара. Потрібна версія %(required)s "
"або новіша."

msgid "Database Backend"
msgstr "Бекенд бази даних"

msgid "Database module"
msgstr "Модуль бази даних"

msgid "JSONB support"
msgstr "Підтримка JSONB"

msgid "Version warning"
msgstr "Попередження про версію"

#, python-format
msgid "PostgreSQL %(version)s is below recommended version %(recommended)s"
msgstr "PostgreSQL %(version)s нижча за рекомендовану версію %(recommended)s"

msgid "Extensions"
msgstr "Розширення"

msgid "Database size"
msgstr "Розмір бази даних"

#, python-format
msgid "%(persons)d persons, %(families)d families, %(events)d events"
msgstr "%(persons)d осіб, %(families)d сімей, %(events)d подій"

msgid "Migration manager not initialized"
msgstr "Менеджер міграції не ініціалізовано"

msgid "Enhanced queries require JSONB support"
msgstr "Розширені запити потребують підтримки JSONB"

msgid "pg_trgm extension required for duplicate detection"
msgstr "Розширення pg_trgm, необхідне для виявлення дублікатів"
