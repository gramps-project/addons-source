#, python-brace-format
msgid "Object {obj_type}:{handle} was modified by another user"
msgstr "L'oggetto {obj_type}:{handle} è stato modificato da un altro utente"

msgid "pg_trgm extension required for duplicate detection"
msgstr "Per il rilevamento dei duplicati è necessaria l'estensione pg_trgm"

msgid ""
"psycopg3 is required for PostgreSQL Enhanced support. Install with: pip "
"install 'psycopg[binary]'"
msgstr ""
"Per il supporto PostgreSQL Enhanced è necessario psycopg3. Installalo con: "
"pip install 'psycopg[binary]'"

#, python-format
msgid ""
"psycopg3 version %(installed)s is too old. Version %(required)s or newer is "
"required."
msgstr ""
"La versione psycopg3 %(installed)s è troppo vecchia. E' necessaria la "
"versione %(required)s o più recente."

msgid "Database Backend"
msgstr "Backend del database"

msgid "Database module"
msgstr "Modulo del database"

msgid "JSONB support"
msgstr "Supporto JSONB"

msgid "Version warning"
msgstr "Avviso versione"

#, python-format
msgid "PostgreSQL %(version)s is below recommended version %(recommended)s"
msgstr ""
"PostgreSQL %(version)s è inferiore alla versione consigliata %(recommended)s"

msgid "Extensions"
msgstr "Estensioni"

msgid "Database size"
msgstr "Grandezza del database"

#, python-format
msgid "%(persons)d persons, %(families)d families, %(events)d events"
msgstr "%(persons)d persone, %(families)d famiglie, %(events)d eventi"

msgid "Migration manager not initialized"
msgstr "Gestore della migrazione non inizializzato"

msgid "Enhanced queries require JSONB support"
msgstr "Le query avanzate richiedono il supporto JSONB"

msgid "Full-text search requires JSONB support or search capabilities"
msgstr ""
"La ricerca a testo completo richiede il supporto JSONB o funzionalità di "
"ricerca"

msgid "Starting migration..."
msgstr "Inizio della migrazione..."

#, python-format
msgid "Migrating %s objects..."
msgstr "Migrazione di %s oggetti..."

#, python-format, python-brace-format
msgid "Migrated %s {obj_type} objects"
msgstr "%s oggetti di tipo {obj_type} migrati"

msgid "Migration completed!"
msgstr "Migrazione completata!"

msgid "Starting upgrade..."
msgstr "Inizio dell'aggiornamento..."

#, python-format
msgid "Upgrading %s objects..."
msgstr "Aggiornamento di %s oggetti..."

msgid "Creating indexes..."
msgstr "Creazione degli indici..."

msgid "Upgrade completed!"
msgstr "Aggiornamento completato!"

msgid "PostgreSQL Enhanced"
msgstr "PostgreSQL migliorato"

msgid "PostgreSQL _Enhanced Database"
msgstr "Database PostgreSQL _Enhanced"

msgid ""
"Advanced PostgreSQL backend with JSONB storage, graph database support "
"(Apache AGE), vector similarity (pgvector), and AI/ML capabilities. For "
"advanced users. Requires PostgreSQL 15+ with extensions. Gramps Web "
"compatible."
msgstr ""
"Backend PostgreSQL avanzato con archiviazione JSONB, supporto per database a "
"grafo (Apache AGE), similarità vettoriale (pgvector) e funzionalità di IA/"
"ML. Per utenti esperti. Richiede PostgreSQL 15+ con estensioni. Compatibile "
"con Gramps Web."
