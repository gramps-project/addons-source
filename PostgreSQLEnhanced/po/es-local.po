msgstr "Migrando objetos %s…"

#, python-format, python-brace-format
msgid "Migrated %s {obj_type} objects"
msgstr "Migrando objetos %s {obj_type}"

msgid "Migration completed!"
msgstr "Migración completada."

msgid "Starting upgrade..."
msgstr "Iniciando mejora…"

#, python-format
msgid "Upgrading %s objects..."
msgstr "Mejora de objeto %s…"

msgid "Creating indexes..."
msgstr "Creando índices…"

msgid "Upgrade completed!"
msgstr "Mejora completada."

msgid "PostgreSQL Enhanced"
msgstr "PostgreSQL mejorada"

msgid "PostgreSQL _Enhanced Database"
msgstr "Base de datos Postgress _mejorada"

msgid ""
"Advanced PostgreSQL backend with JSONB storage, graph database support "
"(Apache AGE), vector similarity (pgvector), and AI/ML capabilities. For "
"advanced users. Requires PostgreSQL 15+ with extensions. Gramps Web "
"compatible."
msgstr ""
"Backend PostgreSQL avanzado con almacenamiento JSONB, admite la base de "
"datos de gráficos (Apache AGE), similitud vectorial (pgvector) y capacidades "
"AI/ML. Para usuarios avanzados. Requiere PostgreSQL 15+ con extensiones. "
"Gramps Web compatible."
