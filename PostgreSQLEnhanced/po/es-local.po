msgstr "El objeto {obj_type}:{handle} fue modificado por otro usuario"

msgid "Database module"
msgstr "Módulo de base de datos"

msgid "JSONB support"
msgstr "Admitir JSONB"

msgid "Version warning"
msgstr "Aviso de versión"

msgid "Extensions"
msgstr "Extensiones"

msgid "Database size"
msgstr "Tamaño de base de datos"

msgid "Starting migration..."
msgstr "Iniciando migración…"

#, python-format
