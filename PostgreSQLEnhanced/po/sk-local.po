#, python-brace-format
msgid "Object {obj_type}:{handle} was modified by another user"
msgstr "Objekt {obj_type}:{handle} bol modifikovaný iným používateľom"

msgid "pg_trgm extension required for duplicate detection"
msgstr "Na detekciu duplikátov je potrebné rozšírenie pg_trgm"

msgid ""
"psycopg3 is required for PostgreSQL Enhanced support. Install with: pip "
"install 'psycopg[binary]'"
msgstr ""
"psycopg3 je potrebný pre podporu PostgreSQL Enhanced. Inštalujte pomocou: "
"pip install 'psycopg[binary]'"

#, python-format
msgid ""
"psycopg3 version %(installed)s is too old. Version %(required)s or newer is "
"required."
msgstr ""
"Verzia psycopg3 %(installed)s je príliš stará. Je potrebná verzia "
"%(required)s alebo novšia."

msgid "Database Backend"
msgstr "Databázový backend"

msgid "Database module"
msgstr "Modul databázy"

msgid "JSONB support"
msgstr "Podpora JSONB"

msgid "Version warning"
msgstr "Upozornenie na verziu"

#, python-format
msgid "PostgreSQL %(version)s is below recommended version %(recommended)s"
msgstr "PostgreSQL %(version)s je nižšia ako odporúčaná verzia %(recommended)s"

msgid "Extensions"
msgstr "Rozšírenia"

msgid "Database size"
msgstr "Veľkosť databázy"

#, python-format
msgid "%(persons)d persons, %(families)d families, %(events)d events"
msgstr "%(persons)d osôb, %(families)d rodín, %(events)d udalostí"

msgid "Migration manager not initialized"
msgstr "Správca migrácie nie je inicializovaný"

msgid "Enhanced queries require JSONB support"
msgstr "Zdokonalené dotazy vyžadujú podporu JSONB"

msgid "Full-text search requires JSONB support or search capabilities"
msgstr ""
"Fulltextové vyhľadávanie vyžaduje podporu JSONB alebo schopnosti vyhľadávania"

msgid "Starting migration..."
msgstr "Začiatok migrácie..."

#, python-format
msgid "Migrating %s objects..."
msgstr "Migrovanie %s objektov..."

#, python-format, python-brace-format
msgid "Migrated %s {obj_type} objects"
msgstr "Premigrované %s {obj_type} objektov"

msgid "Migration completed!"
msgstr "Migrácia dokončená!"

msgid "Starting upgrade..."
msgstr "Začiatok aktualizácie..."

#, python-format
msgid "Upgrading %s objects..."
msgstr "Aktualizovanie %s objektov..."

msgid "Creating indexes..."
msgstr "Vytváranie registrov..."

msgid "Upgrade completed!"
msgstr "Aktualizácia dokončená!"

msgid "PostgreSQL Enhanced"
msgstr "PostgreSQL Enhanced"

msgid "PostgreSQL _Enhanced Database"
msgstr "Databáza PostgreSQL _Enhanced"

msgid ""
"Advanced PostgreSQL backend with JSONB storage, graph database support "
"(Apache AGE), vector similarity (pgvector), and AI/ML capabilities. For "
"advanced users. Requires PostgreSQL 15+ with extensions. Gramps Web "
"compatible."
msgstr ""
"Pokročilý backend PostgreSQL s ukladaním JSONB, podporou grafových databáz "
"(Apache AGE), vektorovou podobnosťou (pgvector) a funkciami umelej "
"inteligencie a strojového učenia. Určené pre pokročilých používateľov. "
"Vyžaduje PostgreSQL 15+ s rozšíreniami. Kompatibilné s Gramps Web."
