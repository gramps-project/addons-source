#, python-brace-format
msgid "Object {obj_type}:{handle} was modified by another user"
msgstr "Objekt {obj_type}:{handle} změnil jiný uživatel"

msgid "pg_trgm extension required for duplicate detection"
msgstr "Detekce duplicit vyžaduje rozšíření pg_trgm"

msgid ""
"psycopg3 is required for PostgreSQL Enhanced support. Install with: pip "
"install 'psycopg[binary]'"
msgstr ""
"Podpora PostgreSQL Enhanced vyžaduje psycopg3. Nainstalujte jej příkazem: "
"pip install 'psycopg[binary]'"

#, python-format
msgid ""
"psycopg3 version %(installed)s is too old. Version %(required)s or newer is "
"required."
msgstr ""
"Verze psycopg3 %(installed)s je příliš stará. Je vyžadována verze "
"%(required)s nebo novější."

msgid "Database Backend"
msgstr "Databázový backend"

msgid "Database module"
msgstr "Databázový modul"

msgid "JSONB support"
msgstr "Podpora JSONB"

msgid "Version warning"
msgstr "Upozornění na verzi"

#, python-format
msgid "PostgreSQL %(version)s is below recommended version %(recommended)s"
msgstr "PostgreSQL %(version)s je starší než doporučená verze %(recommended)s"

msgid "Extensions"
msgstr "Rozšíření"

msgid "Database size"
msgstr "Velikost databáze"

#, python-format
msgid "%(persons)d persons, %(families)d families, %(events)d events"
msgstr "Osoby: %(persons)d, rodiny: %(families)d, události: %(events)d"

msgid "Migration manager not initialized"
msgstr "Správce migrace není inicializován"

msgid "Enhanced queries require JSONB support"
msgstr "Rozšířené dotazy vyžadují podporu JSONB"

msgid "Full-text search requires JSONB support or search capabilities"
msgstr "Fulltextové vyhledávání vyžaduje podporu JSONB nebo funkce vyhledávání"

msgid "Starting migration..."
msgstr "Zahajování migrace..."

#, python-format
msgid "Migrating %s objects..."
msgstr "Migrování %s objektů..."

#, python-format, python-brace-format
msgid "Migrated %s {obj_type} objects"
msgstr "Migrováno %s objektů typu {obj_type}"

msgid "Migration completed!"
msgstr "Migrace dokončena!"

msgid "Starting upgrade..."
msgstr "Zahajuje se upgrade..."

#, python-format
msgid "Upgrading %s objects..."
msgstr "Aktualizováno %s objektů..."

msgid "Creating indexes..."
msgstr "Vytvářejí se indexy..."

msgid "Upgrade completed!"
msgstr "Aktualizace dokončena!"

msgid "PostgreSQL Enhanced"
msgstr "PostgreSQL Enhanced"

msgid "PostgreSQL _Enhanced Database"
msgstr "Databáze PostgreSQL _Enhanced"

msgid ""
"Advanced PostgreSQL backend with JSONB storage, graph database support "
"(Apache AGE), vector similarity (pgvector), and AI/ML capabilities. For "
"advanced users. Requires PostgreSQL 15+ with extensions. Gramps Web "
"compatible."
msgstr ""
"Pokročilý backend PostgreSQL s úložištěm JSONB, podporou grafové databáze "
"(Apache AGE), vektorové podobnosti (pgvector) a funkcemi AI/ML. Pro "
"pokročilé uživatele. Vyžaduje PostgreSQL 15+ s rozšířeními. Kompatibilní s "
"Gramps Web."
