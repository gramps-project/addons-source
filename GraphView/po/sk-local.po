msgstr "Zobrazí osoby v záložkách ako prvé v zozname výsledkov vyhľadávania."

msgid "Search"
msgstr "Hľadanie"

msgid "Select a dot file name"
msgstr "Vyberte názov bodkového súboru"

msgid "Zoom in"
msgstr "Priblížiť"

msgid "Zoom out"
msgstr "Oddialiť"

msgid "Zoom to original"
msgstr "Zväčšiť na originálnu veľkosť"

msgid "Zoom to best fit"
msgstr "Zväčšiť na optimálnu veľkosť"

