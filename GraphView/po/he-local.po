msgstr "מחיקה אדם [%s] הסרה היא ממסד־נתונים."

#, python-format
msgid "Delete family [%s]?"
msgstr "מחיקה משפחה [%s]?"

msgid "Deleting the family will remove it from the database."
msgstr "מחיקה משפחה הסרה היא ממסד־נתונים."

