msgid "Add parents"
msgstr "הוספת שותפים"

msgid "Set as home person"
msgstr "הגדרה כאדם הבית"

msgid "Show path to home person"
msgstr "הצגת נתיב לאדם הבית"

msgid "Remove from bookmarks"
msgstr "הסרת מסימניות"

msgid "Add to bookmarks"
msgstr "הוספה לסימניות"

msgid "No Events for this family"
msgstr "אין אירועים עבור זה משפחה"

msgid "Select tags for family"
msgstr "בחירה תגים עבור משפחה"

msgid "Add father"
msgstr "הוספת אב"

msgid "Add mother"
msgstr "הוספת אם"

msgid "About Graph View"
msgstr "עומד גרף מצג"

