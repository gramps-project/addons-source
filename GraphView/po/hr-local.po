msgid ""
"Show all connected persons limited by generation restrictions.\n"
"Works slow, so don't set large generation values."
msgstr ""
"Prikaži sve povezane osobe ograničene generacijskim ograničenjima.\n"
"Radi sporo, stoga nemoj postavljati velik broj generacija."

msgid "Add active person"
msgstr "Dodaj aktivnu osobu"

msgid "Call the bookmark editor"
msgstr "Otvori uređivač knjižnih oznaka"

msgid ""
"You don't have any bookmarks yet...\n"
"Try to add some frequently used persons to speedup navigation."
msgstr ""
"Još nemaš knjižnih oznaka …\n"
"Za bržu navigaciju, dodaj često korištene osobe."

msgid "No bookmarks for this graph..."
msgstr "Nema knjižnih oznaka za ovaj dijagram …"

