msgstr "人物邊框大小"

msgid "Themes"
msgstr "佈景主題"

msgid "Show animation"
msgstr "顯示動畫"

msgid "Animation speed (1..5 and 5 is the slower)"
msgstr "動畫速度 (1..5，5 最慢)"

msgid "Animation count (0..8 use 0 to turn off)"
msgstr "動畫次數（0 至 8；使用 0 關閉）"

msgid "Animation"
msgstr "動畫"

msgid "Search in all database"
msgstr "搜尋整個資料庫"

msgid "Also apply search by all database."
msgstr "也搜尋整個資料庫。"

msgid "Show person images"
msgstr "顯示人物圖片"

msgid "Show persons thumbnails in search result list."
msgstr "在搜尋結果清單中顯示人物縮圖。"

msgid "Show bookmarked first"
msgstr "優先顯示書籤人物"

msgid "Show bookmarked persons first in search result list."
msgstr "在搜尋結果清單中優先顯示已加入書籤的人物。"

msgid "Select a dot file name"
msgstr "選取 dot 檔名"

msgid "Zoom in"
msgstr "放大"

msgid "Zoom out"
msgstr "縮小"

msgid "Zoom to original"
msgstr "縮放至原始大小"

msgid "Zoom to best fit"
msgstr "縮放至最適大小"

msgid "Go to active person"
msgstr "前往目前人物"

msgid "Go to bookmark"
msgstr "前往書籤"

