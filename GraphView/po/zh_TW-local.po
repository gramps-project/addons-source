msgid "Graph View"
msgstr "關係圖檢視"

msgid "Show IDs"
msgstr "顯示 ID"

msgid "Show avatars"
msgstr "顯示頭像"

msgid "Highlight the home person"
msgstr "突顯首頁人物"

msgid "Show full dates"
msgstr "顯示完整日期"

msgid "Show places"
msgstr "顯示地點"

msgid "Vertical: Top to Bottom"
msgstr "垂直：由上至下"

msgid "Vertical: Bottom to Top"
msgstr "垂直：由下至上"

msgid "Horizontal: Left to Right"
msgstr "水平：由左至右"

msgid "Horizontal: Right to Left"
msgstr "水平：由右至左"

msgid "Time Direction"
msgstr "時間方向"

msgid "Limit number of people displayed (use 0 for unlimited)"
msgstr "限制顯示的人物數量（0 代表不限）"

