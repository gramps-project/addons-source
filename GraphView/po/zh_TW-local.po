msgstr "選取人物標籤"

msgid "Add new family"
msgstr "新增家庭"

msgid "Add parents"
msgstr "新增父母"

msgid "Set as home person"
msgstr "設為首頁人物"

msgid "Show path to home person"
msgstr "顯示前往首頁人物的路徑"

