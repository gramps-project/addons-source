msgstr "人物佈景主題"

msgid "Path color to home person"
msgstr "連往首頁人物的路徑色彩"

msgid "Font:"
msgstr "字型："

msgid "Avatars style"
msgstr "頭像樣式"

msgid "PNG files"
msgstr "PNG 檔案"

msgid "Male avatar:"
msgstr "男性頭像："

msgid "Choose male avatar"
msgstr "選擇男性頭像"

msgid "Female avatar:"
msgstr "女性頭像："

msgid "Choose female avatar"
msgstr "選擇女性頭像"

msgid "Unknown avatar:"
msgstr "性別不明頭像："

msgid "Choose Unknown avatar"
msgstr "選擇性別不明頭像"

msgid "Other avatar:"
msgstr "其他性別頭像："

msgid "Choose Other avatar"
msgstr "選擇其他性別頭像"

msgid "Active person border size"
msgstr "目前人物框線大小"

