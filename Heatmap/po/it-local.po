msgid "File path"
msgstr "Percorso del file"

msgid ""
"For the file name only english letters A-Z, a-z and numbers 0-9 as well as "
"the characters space, underline and hypen are allowed. The file name also "
"has to start and end with an alphanumeric character.The file extention "
"'.html' is added by the report."
msgstr ""
"Per il nome del file sono ammessi solo caratteri alfabetici inglesi (A-Z, a-"
"z) e numeri (0-9), oltre agli spazi, al trattino basso e al trattino. Il "
"nome del file deve inoltre iniziare e terminare con un carattere "
"alfanumerico. L'estensione “.html” viene aggiunta automaticamente dal "
"resoconto."

msgid "File name"
msgstr "Nome del file"

msgid "Start latitude"
msgstr "Latitudine di partenza"

msgid ""
"Set custom start position latitude\n"
"Default: 50.0"
msgstr ""
"Imposta la posizione della latitudine di partenza personalizzata\n"
"Predefinita: 50,0"

msgid "Start longitude"
msgstr "Longitudine di partenza"

msgid ""
"Set custom start position longitude\n"
"Default: 10.0"
msgstr ""
"Imposta la posizione della longitudine di partenza personalizzata\n"
"Predefinita: 10,0"

msgid "Start zoom"
msgstr "Ingrandimento iniziale"

msgid ""
"Set the value for the starting zoom\n"
"Default: 5"
msgstr ""
"Imposta il valore dell'ingrandimento iniziale\n"
"Predefinito: 5"

msgid "Path does not exist."
msgstr "Il percorso non esiste."

msgid "Invalid filename."
msgstr "Nome file non valido."

msgid "INFO"
msgstr "INFO"

msgid "Stamen Terrain"
msgstr "Terreno di Stamen"

msgid "Stamen Terrain (Background only)"
msgstr "Terreno di Stamen (solo sfondo)"
