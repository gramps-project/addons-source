msgid "Set Privacy Tool"
msgstr "Strumento Imposta privacy"

#, python-format
msgid "Set private: %d %s\n"
msgstr "Rendi privato: %d %s\n"

#, python-format
msgid "Not private: %d %s\n"
msgstr "Non privato: %d %s\n"

msgid "Set persons private.."
msgstr "Imposta le persone come private.."

msgid "Set events private.."
msgstr "Imposta gli eventi come privati..."

msgid "Set media private.."
msgstr "Imposta i media come privati.."

msgid "Set adresses private.."
msgstr "Imposta gli indirizzi come privati.."

msgid "Set internet objects private.."
msgstr "Imposta gli oggetti internet come privati.."

msgid ""
"The time range in years from today you want to set objects private.\n"
"'0 years' = remove privacy from all objects."
msgstr ""
"L'intervallo di tempo in anni da oggi per cui vuoi rendere privati gli "
"oggetti.\n"
"'0 anni' = rimuove la privacy da tutti gli oggetti."

msgid "Always private if no date."
msgstr "Sempre privato se senza data."

msgid "If checked, all objects without a date will also be set private."
msgstr "Se spuntato, anche tutti gli oggetti senza data verranno resi privati."

msgid "Select filter to restrict people"
msgstr "Seleziona filtro per restringere le persone"

msgid "Persons"
msgstr "Persone"

msgid "Select filter to restrict events"
msgstr "Seleziona filtro per restringere gli eventi"

msgid "Select filter to restrict medias"
msgstr "Seleziona filtro per restringere gli oggetti multimediali"

msgid "Internet type filter"
msgstr "Filtro per tipo di indirizzo internet"

msgid "E-Mail"
msgstr "E-mail"

msgid "Set all objects of the last <number> of years private."
msgstr "Rende privati tutti gli oggetti degli ultimi <numero> anni."
