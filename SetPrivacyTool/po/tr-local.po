msgid "Set Privacy Tool"
msgstr "Gizlilik Aracı Ayarla"

#, python-format
msgid "Set private: %d %s\n"
msgstr "Özel olarak ayarla: %d %s\n"

#, python-format
msgid "Not private: %d %s\n"
msgstr "Özel değil: %d %s\n"

msgid "Set persons private.."
msgstr "Kişileri özel olarak ayarla.."

msgid "Set events private.."
msgstr "Etkinlikleri özel olarak ayarla.."

msgid "Set media private.."
msgstr "Medyayı özel olarak ayarla.."

msgid "Set adresses private.."
msgstr "Adresleri özel olarak ayarla.."

msgid "Set internet objects private.."
msgstr "İnternet nesnelerini özel olarak ayarla.."

msgid ""
"The time range in years from today you want to set objects private.\n"
"'0 years' = remove privacy from all objects."
msgstr ""
"Nesneleri özel olarak ayarlamak istediğiniz tarihten itibaren yıl cinsinden "
"zaman aralığı.\n"
"'0 yıl' = tüm nesnelerin gizliliğini kaldırır."

msgid "Always private if no date."
msgstr "Tarih yoksa her zaman özel."

msgid "If checked, all objects without a date will also be set private."
msgstr ""
"İşaretlenirse, tarihi olmayan tüm nesneler de özel olarak ayarlanacaktır."

msgid "Select filter to restrict people"
msgstr "İnsanları listelemek için filtreyi seçin"

msgid "Persons"
msgstr "Kişiler"

msgid "Select filter to restrict events"
msgstr "Etkinlikleri kısıtlamak için filtre seçin"

msgid "Select filter to restrict medias"
msgstr "Medyaları kısıtlamak için filtre seçin"

msgid "Internet type filter"
msgstr "İnternet türü filtresi"

msgid "E-Mail"
msgstr "E-Posta"

msgid "Set all objects of the last <number> of years private."
msgstr "Son <sayı> yıllık tüm nesneleri özel olarak ayarlayın."
