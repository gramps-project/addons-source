msgid "Set Privacy Tool"
msgstr "Nástroj pro nastavení soukromí"

#, python-format
msgid "Set private: %d %s\n"
msgstr "Nastaveno jako soukromé: %d %s\n"

#, python-format
msgid "Not private: %d %s\n"
msgstr "Není soukromé: %d %s\n"

msgid "Set persons private.."
msgstr "Nastavování osob jako soukromých.."

msgid "Set events private.."
msgstr "Nastavování událostí jako soukromých.."

msgid "Set media private.."
msgstr "Nastavování médií jako soukromých.."

msgid "Set adresses private.."
msgstr "Nastavování adres jako soukromých.."

msgid "Set internet objects private.."
msgstr "Nastavování internetových objektů jako soukromých.."

msgid ""
"The time range in years from today you want to set objects private.\n"
"'0 years' = remove privacy from all objects."
msgstr ""
"Časové rozmezí v letech ode dneška, pro které chcete objekty označit jako "
"soukromé.\n"
"'0 let' = zrušit soukromí všech objektů."

msgid "Always private if no date."
msgstr "Bez data vždy soukromé."

msgid "If checked, all objects without a date will also be set private."
msgstr ""
"Pokud je zaškrtnuto, budou jako soukromé označeny také všechny objekty bez "
"data."

msgid "Select filter to restrict people"
msgstr "Vyberte filtr pro omezení osob"

msgid "Persons"
msgstr "Osoby"

msgid "Select filter to restrict events"
msgstr "Vyberte filtr pro omezení událostí"

msgid "Select filter to restrict medias"
msgstr "Vyberte filtr pro omezení médií"

msgid "Internet type filter"
msgstr "Filtr typu internetového odkazu"

msgid "E-Mail"
msgstr "E-mail"

msgid "Set all objects of the last <number> of years private."
msgstr "Označit všechny objekty z posledních <number> let jako soukromé."
