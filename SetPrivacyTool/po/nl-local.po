msgid "Set Privacy Tool"
msgstr "Markeer privé hulpmiddel"

#, python-format
msgid "Set private: %d %s\n"
msgstr "Privé markeren: %d %s\n"

#, python-format
msgid "Not private: %d %s\n"
msgstr "Niet privé: %d %s\n"

msgid "Set persons private.."
msgstr "Personen als privé markeren…"

msgid "Set events private.."
msgstr "Gebeurtenissen als privé markeren…"

msgid "Set media private.."
msgstr "Media als privé markeren…"

msgid "Set adresses private.."
msgstr "Adressen als privé markeren..."

msgid "Set internet objects private.."
msgstr "Internetobjecten als privé markeren..."

msgid ""
"The time range in years from today you want to set objects private.\n"
"'0 years' = remove privacy from all objects."
msgstr ""
"Het tijdsbereik in jaren vanaf vandaag dat u objecten als privé wilt "
"markeren.\n"
"'0 jaar' = privacy verwijderen van alle objecten."

msgid "Always private if no date."
msgstr "Altijd privé als er geen datum is."

msgid "If checked, all objects without a date will also be set private."
msgstr ""
"Indien geactiveerd, worden alle objecten zonder datum ook als privé "
"gemarkeerd."

msgid "Select filter to restrict people"
msgstr "Selecteer filter om aantal mensen te beperken"

msgid "Persons"
msgstr "Personen"

msgid "Select filter to restrict events"
msgstr "Selecteer een filter om het aantal gebeurtenissen te beperken"

msgid "Select filter to restrict medias"
msgstr "Selecteer een filter om het aantal media te beperken"

msgid "Internet type filter"
msgstr "Internettype filter"

msgid "E-Mail"
msgstr "E-mail"

msgid "Set all objects of the last <number> of years private."
msgstr "Alle objecten van de afgelopen <aantal> jaren als privé markeren."
