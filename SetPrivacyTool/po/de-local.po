msgid "Set Privacy Tool"
msgstr "Werkzeug zum Einrichten des Datenschutzes"

#, python-format
msgid "Set private: %d %s\n"
msgstr "Vertraulich einstellen: %d %s\n"

#, python-format
msgid "Not private: %d %s\n"
msgstr "Nicht vertraulich: %d %s\n"

msgid "Set persons private.."
msgstr "Personen als vertraulich markieren.."

msgid "Set events private.."
msgstr "Ereignisse als vertraulich markieren.."

msgid "Set media private.."
msgstr "Medium als vertraulich markieren.."

msgid "Set adresses private.."
msgstr "Markiere Adressen als vertraulich.."

msgid "Set internet objects private.."
msgstr "Markiere Internetobjekte als vertraulich.."

msgid ""
"The time range in years from today you want to set objects private.\n"
"'0 years' = remove privacy from all objects."
msgstr ""
"Der Zeitraum in Jahren ab heute, für den du Objekte als vertraulich "
"einstufen möchten.\n"
"„0 Jahre“ = Vertraulichkeit von allen Objekten entfernen."

msgid "Always private if no date."
msgstr "Immer vertraulich, wenn kein Datum angegeben ist."

msgid "If checked, all objects without a date will also be set private."
msgstr ""
"Wenn diese Option aktiviert ist, werden alle Objekte ohne Datum ebenfalls "
"als vertraulich gekennzeichnet."

msgid "Select filter to restrict people"
msgstr "Filter wählen, um Personen einzugrenzen"

msgid "Persons"
msgstr "Personen"

msgid "Select filter to restrict events"
msgstr "Filter auswählen, um Ereignisse einzugrenzen"

msgid "Select filter to restrict medias"
msgstr "Filter auswählen, um Medien einzugrenzen"

msgid "Internet type filter"
msgstr "Internet-Typ-Filter"

msgid "E-Mail"
msgstr "E-Mail"

msgid "Set all objects of the last <number> of years private."
msgstr "Alle Objekte der letzten <Anzahl> Jahre als vertraulich markieren."
