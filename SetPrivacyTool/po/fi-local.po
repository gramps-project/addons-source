msgid "Set Privacy Tool"
msgstr "Yksityisyysasetusten työkalu"

#, python-format
msgid "Set private: %d %s\n"
msgstr "Aseta yksityiseksi: %d %s\n"

#, python-format
msgid "Not private: %d %s\n"
msgstr "Ei yksityisiä: %d %s\n"

msgid "Set persons private.."
msgstr "Aseta henkilöt yksityisiksi."

msgid "Set events private.."
msgstr "Aseta tapahtumat yksityisiksi."

msgid "Set media private.."
msgstr "Aseta mediat yksityiseksi."

msgid "Set adresses private.."
msgstr "Aseta osoitteet yksityiseksi."

msgid "Set internet objects private.."
msgstr "Aseta internet-objektit yksityisiksi."

msgid ""
"The time range in years from today you want to set objects private.\n"
"'0 years' = remove privacy from all objects."
msgstr ""
"Aikaväli vuosissa nykyhetkestä alkaen, mitkä kohteet haluat asettaa "
"yksityisiksi.\n"
"'0 vuotta' = poista yksityisyys kaikista kohteista."

msgid "Always private if no date."
msgstr "Aina yksityinen, jos päivämäärää ei ole."

msgid "If checked, all objects without a date will also be set private."
msgstr "Valinta asettaa kaikki kohteet ilman päivämäärää myös yksityisiksi."

msgid "Select filter to restrict people"
msgstr "Rajoita henkilöitä valitsemalla suodatin"

msgid "Persons"
msgstr "Henkilöt"

msgid "Select filter to restrict events"
msgstr "Valitse tapahtumat käyttämällä suodinta"

msgid "Select filter to restrict medias"
msgstr "Valitse medioita käyttämällä suodinta"

msgid "Internet type filter"
msgstr "Internet-palvelun suodatin"

msgid "E-Mail"
msgstr "Sähköposti"

msgid "Set all objects of the last <number> of years private."
msgstr "Aseta kaikki viimeisen <number> vuoden kohteet yksityisiksi."
