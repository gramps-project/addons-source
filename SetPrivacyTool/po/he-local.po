msgid "Set Privacy Tool"
msgstr "הגדרת כלי פרטיות"

#, python-format
msgid "Set private: %d %s\n"
msgstr "הגדרה פרטי: %d %s\n"

#, python-format
msgid "Not private: %d %s\n"
msgstr "לא פרטי: %d %s\n"

msgid "Set persons private.."
msgstr "הגדרת אנשים כפרטיים..."

msgid "Set events private.."
msgstr "הגדרת אירועים כפרטיים..."

msgid "Set media private.."
msgstr "הגדרת מדיה כפרטית..."

msgid "Set adresses private.."
msgstr "הגדרת כתובות כפרטיות..."

msgid "Set internet objects private.."
msgstr "הגדרת עצמי מרשתת כפרטיים..."

msgid ""
"The time range in years from today you want to set objects private.\n"
"'0 years' = remove privacy from all objects."
msgstr ""
"טווח הזמן בשנים מהיום להגדרת עצמים כפרטיים.\n"
"'0 שנים' = הסרת פרטיות מכל העצמים."

msgid "Always private if no date."
msgstr "תמיד פרטי אם אין תאריך."

msgid "If checked, all objects without a date will also be set private."
msgstr "אם סומן, כל העצמים ללא תאריך יוגדרו גם הם כפרטיים."

msgid "Select filter to restrict people"
msgstr "בחירת מסנן להגבלת האנשים"

msgid "Persons"
msgstr "אנשים"

msgid "Select filter to restrict events"
msgstr "בחירת מסנן להגבלת אירועים"

msgid "Select filter to restrict medias"
msgstr "בחירת מסנן להגבלת מדיה"

msgid "Internet type filter"
msgstr "מרשתת סוג מסנן"

msgid "E-Mail"
msgstr "דואר אלקטרוני"

msgid "Set all objects of the last <number> of years private."
msgstr "הגדרת כל העצמים מ־<number> השנים האחרונות כפרטיים."
