msgid "Repositories Report Options"
msgstr "Voľby správy o repozitároch"

msgid "Produces a textual repositories report"
msgstr "Poskytuje textovú správu o repozitároch"

msgid "Repositories Report"
msgstr "Správa o repozitároch"

msgid "Internet:"
msgstr "Internet:"

msgid "Publication information:"
msgstr "Informácie o publikácii:"

msgid "Data:"
msgstr "Údaje:"

msgid "Page:"
msgstr "Strana:"

msgid "Selection with a filter"
msgstr "Výber pomocou filtra"

msgid "Include repository's urls"
msgstr "Zahrnúť URL adresy repozitára"

msgid "Whether to include urls on repository."
msgstr "Či zahrnúť URL adresy repozitára."

msgid "Include repository's address"
msgstr "Zahrnúť adresu repozitára"

msgid "Whether to include addresses on repository."
msgstr "Či zahrnúť adresy k repozitáru."

msgid "Include source's author"
msgstr "Zahrnúť autora zdroja"

msgid "Whether to include author."
msgstr "Či zahrnúť autora."

msgid "Include source's abbreviation"
msgstr "Zahrnúť skratku zdroja"

msgid "Whether to include abbreviation."
msgstr "Či zahrnúť skratku."

msgid "Include source's publication information"
msgstr "Zahrnúť informácie o publikácii zdroja"

msgid "Whether to include publication information."
msgstr "Či zahrnúť informácie o publikácii."

msgid "Include source's data"
msgstr "Zahrnúť údaje zdroja"

msgid "Whether to include keys and values."
msgstr "Či zahrnúť kľúče a hodnoty."

msgid "Whether to include notes on repositories and sources."
msgstr "Či zahrnúť poznámky k repozitárom a zdrojom."

msgid "Include media"
msgstr "Zahrnúť médiá"

msgid "Whether to include media."
msgstr "Či zahrnúť médiá."

msgid "Include citations"
msgstr "Zahrnúť citácie"

msgid "Whether to include citations on sources."
msgstr "Či zahrnúť citácie zo zdrojov."

msgid "Include private records"
msgstr "Zahrnúť súkromné záznamy"

msgid "Whether to include repositories and sources marked as private."
msgstr "Či zahrnúť repozitáre a zdroje označené ako súkromné."

msgid "Display empty values"
msgstr "Zobraziť prázdne hodnoty"

msgid "Whether to include key records with empty values."
msgstr "Či zahrnúť kľúčové záznamy s prázdnymi hodnotami."

msgid "The style used for the title of the report."
msgstr "Štýl použitý pre názov správy."

msgid "The style used for repository title."
msgstr "Štýl použitý pre názov repozitára."

msgid "The style used for each section."
msgstr "Štýl použitý pre každú sekciu."

msgid "The style used for child section."
msgstr "Štýl použitý pre sekciu detí."
