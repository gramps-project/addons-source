msgid "Repositories Report Options"
msgstr "Arkistoraportin valinnat"

msgid "Produces a textual repositories report"
msgstr "Tuottaa tekstimuotoisen arkistoluettelon"

msgid "Repositories Report"
msgstr "Arkistoraportti"

msgid "Publication information:"
msgstr "Julkaisutiedot:"

msgid "Data:"
msgstr "Data:"

