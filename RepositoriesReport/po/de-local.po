msgid "Repositories Report Options"
msgstr "Aufbewahrungsorte Bericht Optionen"

msgid "Produces a textual repositories report"
msgstr "Erstellt einen schriftlichen Aufbewahrungsortebericht"

msgid "Repositories Report"
msgstr "Aufbewahrungsortebericht"

msgid "Internet:"
msgstr "Internet:"

msgid "Publication information:"
msgstr "Veröffentlichungsinformationen:"

msgid "Data:"
msgstr "Daten:"

msgid "Page:"
msgstr "Seite:"

msgid "Selection with a filter"
msgstr "Auswahl mit einem Filter"

msgid "Include repository's urls"
msgstr "URLs des Aufbewahrungsorts einfügen"

msgid "Whether to include urls on repository."
msgstr "Ob URLs in das Aufbewahrungsort aufgenommen werden sollen."

msgid "Include repository's address"
msgstr "Aufbewahrungsortadressen aufnehmen"

msgid "Whether to include addresses on repository."
msgstr "Ob Adressen in den Aufbewahrungsort aufgenommen werden sollen."

msgid "Include source's author"
msgstr "Autor der Quelle angeben"

msgid "Whether to include author."
msgstr "Autor angeben oder nicht."

msgid "Include source's abbreviation"
msgstr "Abkürzung der Quelle angeben"

msgid "Whether to include abbreviation."
msgstr "Ob Abkürzungen aufgenommen werden sollen."

msgid "Include source's publication information"
msgstr "Angaben zur Veröffentlichung der Quelle hinzufügen"

msgid "Whether to include publication information."
msgstr "Ob Veröffentlichungsinformationen aufgenommen werden sollen."

msgid "Include source's data"
msgstr "Daten der Quelle einbeziehen"

msgid "Whether to include keys and values."
msgstr "Ob Schlüssel und Werte einbezogen werden sollen."

msgid "Whether to include notes on repositories and sources."
msgstr "Ob Notizen zu Aufbewahrungsorte und Quellen aufgenommen werden sollen."

msgid "Include media"
msgstr "Medien aufnehmen"

msgid "Whether to include media."
msgstr "Ob Medien einbezogen werden sollen."

msgid "Include citations"
msgstr "Quellenangaben einfügen"

msgid "Whether to include citations on sources."
msgstr "Ob Quellenangaben aufgenommen werden sollen."

msgid "Include private records"
msgstr "Vertrauliche Aufzeichnungen einbeziehen"

msgid "Whether to include repositories and sources marked as private."
msgstr ""
"Ob Aufbewahrungsorte und Quellen, die als vertraulich gekennzeichnet sind, "
"einbezogen werden sollen."

msgid "Display empty values"
msgstr "Leere Werte anzeigen"

msgid "Whether to include key records with empty values."
msgstr "Ob Schlüsseldatensätze mit leeren Werten einbezogen werden sollen."

msgid "The style used for the title of the report."
msgstr "Der für den Titel des Berichts verwendete Stil."

msgid "The style used for repository title."
msgstr "Der für den Titel des Aufbewahrungsorttitel verwendete Stil."

msgid "The style used for each section."
msgstr "Der für jeden Abschnitt verwendete Stil."

msgid "The style used for child section."
msgstr "Der für den Kinderabschnitt verwendete Stil."
