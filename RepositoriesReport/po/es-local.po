msgid "Repositories Report Options"
msgstr "Opciones del Informe de Repositorios"

msgid "Produces a textual repositories report"
msgstr "Produce un informe de repositorios textuales"

msgid "Repositories Report"
msgstr "Informe de Repositorios"

msgid "Publication information:"
msgstr "Información de publicación:"

msgid "Data:"
msgstr "Datos:"

msgid "Page:"
msgstr "Página:"

msgid "Selection with a filter"
msgstr "Selección con un filtro"

msgid "Include repository's urls"
msgstr "Incluir las url del repositorio"

msgid "Whether to include urls on repository."
msgstr "Ya sea para incluir los url sobre el repositorio."

msgid "Include repository's address"
msgstr "Incluir dirección del repositorio"

msgid "Whether to include addresses on repository."
msgstr "Ya sea para incluir direcciones en el repositorio."

msgid "Include source's author"
msgstr "Incluir autoría de la fuente"

msgid "Whether to include author."
msgstr "Ya sea para incluir al autor."

msgid "Include source's abbreviation"
msgstr "Incluir abreviatura de la fuente"

msgid "Whether to include abbreviation."
msgstr "Ya sea para incluir la abreviatura."

msgid "Include source's publication information"
msgstr "Incluir información de publicación de la fuente"

msgid "Whether to include publication information."
msgstr "Ya sea para incluir información de publicación."

msgid "Include source's data"
msgstr "Incluir datos de la fuente"

msgid "Whether to include keys and values."
msgstr "Ya sea para incluir claves y valores."

msgid "Whether to include notes on repositories and sources."
msgstr "Ya sea para incluir notas sobre repositorios y orígenes."

msgid "Include media"
msgstr "Incluir medios"

msgid "Whether to include media."
msgstr "Ya sea para incluir los medios."

msgid "Include citations"
msgstr "Incluir citas"

msgid "Whether to include citations on sources."
msgstr "Ya sea para incluir citas en código fuente.."

msgid "Include private records"
msgstr "Incluir registros privados"

msgid "Whether to include repositories and sources marked as private."
msgstr "Ya sea para incluir repositorios y fuentes marcadas como privadas."

msgid "Display empty values"
msgstr "Mostrar valores vacíos"

msgid "Whether to include key records with empty values."
msgstr "Ya sea para incluir registros clave con valores vacíos."

msgid "The style used for the title of the report."
msgstr "El estilo utilizado para el título del informe."

msgid "The style used for repository title."
msgstr "El estilo utilizado para título del repositorio."

msgid "The style used for each section."
msgstr "El estilo utilizado para cada sección."
