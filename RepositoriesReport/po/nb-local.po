msgid "Produces a textual repositories report"
msgstr "Lager en tekstbasert arkivrapport"

msgid "Repositories Report"
msgstr "Arkivrapport"

msgid "Publication information:"
msgstr "Publiseringsinformasjon:"

msgid "Data:"
msgstr "Data:"

msgid "Selection with a filter"
msgstr "Utvalg med et filter"

msgid "Include repository's urls"
msgstr "Inkluder arkivenes nettadresser"

msgid "Whether to include urls on repository."
msgstr "Om lenker til arkiv skal inkluderes."

msgid "Include repository's address"
msgstr "Inkluder adresse til arkivet"

msgid "Whether to include addresses on repository."
msgstr "Om adresser til arkiv skal inkluderes."

msgid "Include source's author"
msgstr "Inkluder kildens forfatter"

msgid "Whether to include author."
msgstr "Om forfatter skal tas med."

msgid "Include source's abbreviation"
msgstr "Inkluder kildens forkortelse"

msgid "Whether to include abbreviation."
msgstr "Om kortnavn skal tas med."

msgid "Include source's publication information"
msgstr "Inkluder kildens publiseringsinformasjon"

msgid "Whether to include publication information."
msgstr "Om publiseringsinformasjon skal tas med."

msgid "Include source's data"
msgstr "Inkluder kildens data"

msgid "Whether to include keys and values."
msgstr "Om nøkler og verdier skal tas med."

msgid "Whether to include notes on repositories and sources."
msgstr "Om notater for arkiver og kilder skal inkluderes."

msgid "Include media"
msgstr "Inkluder medier"

msgid "Whether to include media."
msgstr "Om mediefiler skal tas med."

msgid "Include citations"
msgstr "Inkluder siteringer"

msgid "Whether to include citations on sources."
msgstr "Om siteringer skal inkluderes i kilder."

msgid "Include private records"
msgstr "Inkluder private poster"

msgid "Whether to include repositories and sources marked as private."
msgstr "Om arkiver og kilder merket som private skal inkluderes."

msgid "Display empty values"
msgstr "Vis tomme verdier"

msgid "Whether to include key records with empty values."
msgstr "Om nøkkeloppføringer med tomme verdier skal inkluderes."

msgid "The style used for the title of the report."
msgstr "Stilen som brukes på rapportens tittel."

msgid "The style used for repository title."
msgstr "Stilen som brukes for tittelen på arkivet."

msgid "The style used for each section."
msgstr "Stilen som brukes til kapitteloverskriften."

msgid "The style used for child section."
msgstr "Stilen som brukes til delkapittel."
