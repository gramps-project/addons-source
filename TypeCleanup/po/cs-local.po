msgstr "Role u událostí"

msgid "Event Types"
msgstr "Typy událostí"

msgid "Family Relation Types"
msgstr "Typy rodinných vztahů"

msgid "Child reference Types"
msgstr "Typy odkazů na děti"

msgid "Name Origin Types"
msgstr "Typy původu příjmení"

msgid "Name Types"
msgstr "Typy jmen"

