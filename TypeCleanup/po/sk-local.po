msgid "Event Roles"
msgstr "Úlohy udalostí"

msgid "Event Types"
msgstr "Typy udalostí"

msgid "Family Relation Types"
msgstr "Typy rodinného vzťahu"

msgid "Child reference Types"
msgstr "Typy odkazov na deti"

msgid "Name Origin Types"
msgstr "Typy pôvodu mien"

msgid "Name Types"
msgstr "Typy mien"

msgid "Note Types"
msgstr "Typy poznámok"

msgid "Place Types"
msgstr "Typy miest"

msgid "Repository Types"
msgstr "Typy repozitárov"

msgid "Source Media Types"
msgstr "Typy zdrojových médií"

msgid "URL Types"
msgstr "URL typy"

msgid "Types Cleanup Tool"
msgstr "Nástroj na čistenie typov"

msgid ""
"Remove the selected type from the db.\n"
"This does not change any referenced objects."
msgstr ""
"Odstráňte vybraný typ z databázy.\n"
"Tým sa nezmenia žiadne odkazované objekty."

msgid ""
"Select a new name for the current type, prior to renaming the type in the "
"referenced objects."
msgstr ""
"Vyberte nový názov pre aktuálny typ pred premenovaním typu v odkazovaných "
"objektoch."

msgid "Rename"
msgstr "Premenovať"

msgid "Rename the selected type in all referenced objects."
msgstr "Premenovať vybraný typ vo všetkých odkazovaných objektoch."

msgid "Close the Type Cleanup Tool"
msgstr "Zatvoriť nástroj na čistenie typu"

msgid "Types"
msgstr "Typy"

msgid "Type Cleanup Tool"
msgstr "Nástroj na čistenie typu"

#, python-format
msgid "Changing type from %(old_type)s to %(new_type)s."
msgstr "Zmena typu z %(old_type)s na %(new_type)s."

msgid ""
"Removing this custom type will eliminate it from the type selection drop "
"down lists\n"
"and further runs of this tool.\n"
"\n"
"However, it will not remove it from the referenced items in the database.\n"
"If you want to change it in referenced items, use 'Rename'."
msgstr ""
"Odstránenie tohto vlastného typu ho vymaže z roletových zoznamov výberu "
"typov\n"
"a ďalších spustení tohto nástroja.\n"
"\n"
"Neodstráni ho však z odkazovaných položiek v databáze.\n"
"Ak ho chcete zmeniť v odkazovaných položkách, použite funkciu 'Premenovať'."

msgid "Type Cleanup"
msgstr "Čistenie typu"

msgid "Clean up (remove) custom types"
msgstr "Vyčistiť (odstrániť) vlastné typy"
