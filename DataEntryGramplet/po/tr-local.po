#, python-format
msgid "Gramplet Data Edit: %s"
msgstr "Gramplet Veri Düzenleme: %s"

msgid "Please open a Family Tree before adding a person."
msgstr "Lütfen kişi eklemeden önce bir Aile Ağacı açın."

msgid "Please provide a name."
msgstr "Lütfen bir ad girin."

msgid "Can't add new person."
msgstr "Yeni kişi eklenemiyor."

msgid "Please set an active person."
msgstr "Lütfen aktif bir kişi belirleyin."

msgid "Can't add new person as a parent."
msgstr "Yeni kişiyi ebeveyn olarak ekleyemezsiniz."

msgid "Please set the new person's gender."
msgstr "Lütfen yeni kişinin cinsiyetini belirleyin."

msgid "Can't add new person as a mother."
msgstr "Yeni kişiyi anne olarak ekleyemezsiniz."

msgid "Can't add new person as a father."
msgstr "Yeni kişiyi baba olarak ekleyemezsiniz."

msgid "Can't add new person as a spouse."
msgstr "Yeni kişiyi eş olarak ekleyemezsiniz."

msgid "Can't add new person as a wife."
msgstr "Yeni kişiyi karı olarak ekleyemezsiniz."

msgid "Can't add new person as a husband."
msgstr "Yeni kişiyi koca olarak ekleyemezsiniz."

msgid "Can't add new person as a sibling."
msgstr "Yeni kişiyi kardeş olarak ekleyemezsiniz."

msgid "Can't add new person as a child."
msgstr "Yeni kişiyi çocuk olarak ekleyemezsiniz."

msgid "Please set Active person."
msgstr "Lütfen Aktif kişiyi ayarlayın."

msgid "Can't add new person as a spouse to no one."
msgstr "Yeni kişiyi hiç kimsenin eşi olarak ekleyemezsiniz."

msgid "Please set gender on Active or new person."
msgstr "Lütfen Aktif veya yeni kişinin cinsiyetini ayarlayın."

msgid "Same genders on Active and new person."
msgstr "Aktif ve yeni kişinin cinsiyetleri aynı olmalı."

msgid "Please set gender on Active person."
msgstr "Lütfen Aktif kişinin cinsiyetini ayarlayın."
