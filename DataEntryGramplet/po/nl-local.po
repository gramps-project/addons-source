msgid "Data Entry Gramplet"
msgstr "Gegevensinvoer Gramplet"

msgid "Gramplet for quick data entry"
msgstr "Gramplet om snel gegevens in te voeren"

msgid "Active person"
msgstr "Actief persoon"

msgid "Family:"
msgstr "Familie:"

msgid "Sources?"
msgstr "Bronnen?"

msgid "Surname, Given"
msgstr "Achternaam, voornaam"

msgid "Save"
msgstr "Opslaan"

msgid "Abandon"
msgstr "Annuleren"

msgid "New person"
msgstr "Nieuwe persoon"

msgid "Add relation"
msgstr "Relatie toevoegen"

msgid "No relation to active person"
msgstr "Geen relatie met actieve persoon"

msgid "Add as a Parent"
msgstr "Als ouder toevoegen"

msgid "Add as a Mother"
msgstr "Als moeder toevoegen"

msgid "Add as a Father"
msgstr "Als vader toevoegen"

msgid "Add as a Spouse"
msgstr "Als partner toevoegen"

msgid "Add as a Wife"
msgstr "Als vrouw toevoegen"

msgid "Add as a Husband"
msgstr "Als echtgenoot toevoegen"

msgid "Add as a Sibling"
msgstr "Als broer/zus toevoegen"

msgid "Add as a Child"
msgstr "Als kind toevoegen"

msgid "Copy Active Data"
msgstr "Kopieer actieve gegevens"

msgid "in"
msgstr "in"

msgid "No Family Tree is open."
msgstr "Geen stamboom geopend."

msgid "Please open a Family Tree to edit data."
msgstr "Open een stamboom om gegevens te bewerken."

#, python-format
msgid "Gramplet Data Edit: %s"
msgstr "Gramplet-gegevens bewerken: %s"

msgid "Please open a Family Tree before adding a person."
msgstr "Open een stamboom voordat u een persoon toevoegt."

msgid "Please provide a name."
msgstr "Geef een naam op."

msgid "Can't add new person."
msgstr "Kan geen nieuwe persoon toevoegen."

msgid "Please set an active person."
msgstr "Stel een actieve persoon in."

msgid "Can't add new person as a parent."
msgstr "Kan geen nieuwe persoon toevoegen als ouder."

msgid "Please set the new person's gender."
msgstr "Stel het geslacht van de nieuwe persoon in."

msgid "Can't add new person as a mother."
msgstr "Kan geen nieuwe persoon toevoegen als moeder."

msgid "Can't add new person as a father."
msgstr "Kan geen nieuwe persoon toevoegen als vader."

msgid "Can't add new person as a spouse."
msgstr "Kan geen nieuwe persoon toevoegen als partner."

msgid "Can't add new person as a wife."
msgstr "Kan geen nieuwe persoon toevoegen als vrouw."

msgid "Can't add new person as a husband."
msgstr "Kan geen nieuwe persoon toevoegen als echtgenoot."

msgid "Can't add new person as a sibling."
msgstr "Kan geen nieuwe persoon toevoegen als broer/zus."

msgid "Can't add new person as a child."
msgstr "Kan geen nieuwe persoon toevoegen als kind."

msgid "Please set Active person."
msgstr "Stel actieve persoon in."

msgid "Can't add new person as a spouse to no one."
msgstr "Kan geen nieuwe persoon toevoegen als partner van niemand."

msgid "Please set gender on Active or new person."
msgstr "Een geslacht voor de actieve of nieuwe persoon kiezen."

msgid "Same genders on Active and new person."
msgstr "Dezelfde geslachten op actieve en nieuwe persoon."

msgid "Please set gender on Active person."
msgstr "Stel geslacht in op actieve persoon."
