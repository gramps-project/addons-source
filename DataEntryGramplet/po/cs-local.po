msgid "Data Entry Gramplet"
msgstr "Gramplet pro zadávání údajů"

msgid "Gramplet for quick data entry"
msgstr "Gramplet pro rychlé zadávání údajů"

msgid "Active person"
msgstr "Aktivní osoba"

msgid "Family:"
msgstr "Rodina:"

msgid "Sources?"
msgstr "Prameny?"

msgid "Surname, Given"
msgstr "Příjmení, křestní jméno"

msgid "Save"
msgstr "Uložit"

msgid "Abandon"
msgstr "Zahodit změny"

msgid "New person"
msgstr "Nová osoba"

msgid "Add relation"
msgstr "Přidat vztah"

msgid "No relation to active person"
msgstr "Bez vazby na aktivní osobu"

msgid "Add as a Parent"
msgstr "Přidat jako rodiče"

msgid "Add as a Mother"
msgstr "Přidat jako matku"

msgid "Add as a Father"
msgstr "Přidat jako otce"

msgid "Add as a Spouse"
msgstr "Přidat jako manžela/manželku"

msgid "Add as a Wife"
msgstr "Přidat jako manželku"

msgid "Add as a Husband"
msgstr "Přidat jako manžela"

msgid "Add as a Sibling"
msgstr "Přidat jako sourozence"

msgid "Add as a Child"
msgstr "Přidat jako dítě"

msgid "Copy Active Data"
msgstr "Kopírovat údaje aktivní osoby"

msgid "No Family Tree is open."
msgstr "Není otevřen žádný rodinný strom."

msgid "Please open a Family Tree to edit data."
msgstr "Chcete-li upravovat údaje, otevřete rodokmen."

#, python-format
msgid "Gramplet Data Edit: %s"
msgstr "Úprava údajů v Grampletu: %s"

msgid "Please open a Family Tree before adding a person."
msgstr "Před přidáním osoby otevřete rodokmen."

msgid "Please provide a name."
msgstr "Zadejte jméno."

msgid "Can't add new person."
msgstr "Nelze přidat novou osobu."

msgid "Please set an active person."
msgstr "Vyberte aktivní osobu."

msgid "Can't add new person as a parent."
msgstr "Nelze přidat novou osobu jako rodiče."

msgid "Please set the new person's gender."
msgstr "Zadejte pohlaví nové osoby."

msgid "Can't add new person as a mother."
msgstr "Nelze přidat novou osobu jako matku."

msgid "Can't add new person as a father."
msgstr "Nelze přidat novou osobu jako otce."

msgid "Can't add new person as a spouse."
msgstr "Nelze přidat novou osobu jako manžela/manželku."

msgid "Can't add new person as a wife."
msgstr "Nelze přidat novou osobu jako manželku."

msgid "Can't add new person as a husband."
msgstr "Nelze přidat novou osobu jako manžela."

msgid "Can't add new person as a sibling."
msgstr "Nelze přidat novou osobu jako sourozence."

msgid "Can't add new person as a child."
msgstr "Nelze přidat novou osobu jako dítě."

msgid "Please set Active person."
msgstr "Vyberte aktivní osobu."

msgid "Can't add new person as a spouse to no one."
msgstr "Bez aktivní osoby nelze přidat novou osobu jako manžela/manželku."

msgid "Please set gender on Active or new person."
msgstr "Zadejte pohlaví aktivní nebo nové osoby."

msgid "Same genders on Active and new person."
msgstr "Aktivní i nová osoba mají stejné pohlaví."

msgid "Please set gender on Active person."
msgstr "Zadejte pohlaví aktivní osoby."
