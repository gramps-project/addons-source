msgid "Database Differences Report"
msgstr "Resoconto sulle differenze tra gli archivi"

msgid "Differences between Database and File"
msgstr "Differenze tra database e file"

msgid "No differences"
msgstr "Nessuna differenza"

msgid "Missing items in File that are added in Database"
msgstr "Elementi mancanti nel file che sono stati aggiunti nel database"

#, python-format
msgid "Missing %s: %s"
msgstr "Mancante %s: %s"

msgid "Nothing missing"
msgstr "Non manca niente"

msgid "Added items in File that are missing in Database"
msgstr "Elementi aggiunti nel file che non sono presenti nel database"

#, python-format
msgid "Added %s: %s "
msgstr "Aggiunto %s: %s "

msgid "Nothing added"
msgstr "Non è stato aggiunto niente"

msgid "Family Tree file"
msgstr "File dell'albero genealogico"

msgid "Select a .gpkg or .gramps file"
msgstr "Seleziona un file .gpkg o .gramps"

msgid "Show items that are different"
msgstr "Mostra gli elementi che sono diversi"

msgid "Include items that are different"
msgstr "Includi gli elementi che sono diversi"

msgid "Show items missing from file"
msgstr "Mostra gli elementi che mancano dal file"

msgid "Include items not in file but in database"
msgstr "Includi gli elementi che non sono nel file ma che sono nel database"

msgid "Show items added in file"
msgstr "Mostra gli elementi aggiunti al file"

msgid "Include items in file but not in database"
msgstr "Includi gli elementi che sono nel file ma che non sono nel database"

msgid "Compares an external database with the current one."
msgstr "Confronta un database esterno con quello corrente."
