msgid "Database Differences Report"
msgstr "Raport różnic w bazie danych"

msgid "Differences between Database and File"
msgstr "Różnice między bazą danych a plikiem"

msgid "No differences"
msgstr "Brak różnic"

msgid "Missing items in File that are added in Database"
msgstr "Elementy brakujące w pliku, które zostały dodane w bazie danych"

#, python-format
msgid "Missing %s: %s"
msgstr "Brakuje %s: %s"

msgid "Nothing missing"
msgstr "Nic nie brakuje"

msgid "Added items in File that are missing in Database"
msgstr "Elementy dodane w pliku, które brakują w bazie danych"

#, python-format
msgid "Added %s: %s "
msgstr "Dodano %s: %s "

msgid "Nothing added"
msgstr "Nic nie dodano"

msgid "Family Tree file"
msgstr "Plik drzewa genealogicznego"

msgid "Select a .gpkg or .gramps file"
msgstr "Wybierz plik .gpkg lub .gramps"

msgid "Show items that are different"
msgstr "Pokaż elementy, które są różne"

msgid "Include items that are different"
msgstr "Uwzględnij elementy, które są różne"

msgid "Show items missing from file"
msgstr "Pokaż elementy brakujące w pliku"

msgid "Include items not in file but in database"
msgstr "Uwzględnij elementy, które nie ma w pliku, ale są w bazie danych"

msgid "Show items added in file"
msgstr "Pokaż elementy dodane w pliku"

msgid "Include items in file but not in database"
msgstr "Uwzględnij elementy, które są w pliku, ale nie ma ich w bazie danych"

msgid "Compares an external database with the current one."
msgstr "Porównuje zewnętrzną bazę danych z bieżącą."
