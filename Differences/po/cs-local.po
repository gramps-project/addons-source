msgid "Database Differences Report"
msgstr "Sestava rozdílů databází"

msgid "Differences between Database and File"
msgstr "Rozdíly mezi databází a souborem"

msgid "No differences"
msgstr "Žádné rozdíly"

msgid "Missing items in File that are added in Database"
msgstr "Položky přidané v databázi, které chybějí v souboru"

#, python-format
msgid "Missing %s: %s"
msgstr "Chybí záznam (%s): %s"

msgid "Nothing missing"
msgstr "Nic nechybí"

msgid "Added items in File that are missing in Database"
msgstr "Položky přidané v souboru, které chybějí v databázi"

#, python-format
msgid "Added %s: %s "
msgstr "Přidáno %s: %s "

msgid "Nothing added"
msgstr "Nic nepřidáno"

msgid "Family Tree file"
msgstr "Soubor rodokmenu"

msgid "Select a .gpkg or .gramps file"
msgstr "Vyberte soubor .gpkg nebo .gramps"

msgid "Show items that are different"
msgstr "Zobrazit odlišné položky"

msgid "Include items that are different"
msgstr "Zahrnout odlišné položky"

msgid "Show items missing from file"
msgstr "Zobrazit položky chybějící v souboru"

msgid "Include items not in file but in database"
msgstr "Zahrnout položky, které nejsou v souboru, ale jsou v databázi"

msgid "Show items added in file"
msgstr "Zobrazit položky přidané v souboru"

msgid "Include items in file but not in database"
msgstr "Zahrnout položky, které jsou v souboru, ale nejsou v databázi"

msgid "Compares an external database with the current one."
msgstr "Porovná externí databázi se současnou."
