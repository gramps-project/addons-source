msgid "Database Differences Report"
msgstr "דוח הבדלים במסד־נתונים"

msgid "Differences between Database and File"
msgstr "הבדלים בין מסד־נתונים לקובץ"

msgid "No differences"
msgstr "אין הבדלים"

msgid "Missing items in File that are added in Database"
msgstr "פריטים שחסרים בקובץ ונוספו למסד־נתונים"

#, python-format
msgid "Missing %s: %s"
msgstr "חסר %s: %s"

msgid "Nothing missing"
msgstr "לא חסר דבר"

msgid "Added items in File that are missing in Database"
msgstr "פריטים שנוספו בקובץ וחסרים במסד־הנתונים"

#, python-format
msgid "Added %s: %s "
msgstr "נוסף %s: %s "

msgid "Nothing added"
msgstr "לא נוסף דבר"

msgid "Family Tree file"
msgstr "אילן־יוחסין קובץ"

msgid "Select a .gpkg or .gramps file"
msgstr "בחירת קובץ ‎.gpkg או ‎.gramps"

msgid "Show items that are different"
msgstr "הצגת פריטים ששונים"

msgid "Include items that are different"
msgstr "הכללת פריטים ששונים"

msgid "Show items missing from file"
msgstr "הצגת פריטים חסר מקובץ"

msgid "Include items not in file but in database"
msgstr "הכללת פריטים שאינם בקובץ אך נמצאים במסד־הנתונים"

msgid "Show items added in file"
msgstr "הצגת פריטים שנוספו בקובץ"

msgid "Include items in file but not in database"
msgstr "הכללת פריטים שנמצאים בקובץ אך לא במסד־הנתונים"

msgid "Compares an external database with the current one."
msgstr "השוואת מסד־נתונים חיצוני למסד־הנתונים הנוכחי."
