msgid "Detailed Descendant Report With All Images"
msgstr "全画像付き詳細子孫レポート"

msgid ""
"Produces a detailed descendant report with all images and optional todo list."
msgstr ""
"すべての画像とオプションのToDoリストを含む詳細な子孫レポートを生成します。"

#, python-format
msgid "%(date)s, %(place)s"
msgstr "%(date)s、%(place)s"

#, python-format
msgid "%(date)s"
msgstr "%(date)s"

#, python-format
msgid "%(place)s"
msgstr "%(place)s"

#, python-format
msgid "%(event_name)s: %(event_text)s"
msgstr "%(event_name)s: %(event_text)s"

#, python-format
msgid "%(name_kind)s: %(name)s%(endnotes)s"
msgstr "%(name_kind)s: %(name)s%(endnotes)s"

#, python-format
msgid "%(type)s: %(value)s"
msgstr "%(type)s: %(value)s"

msgid "List children"
msgstr "子供を一覧表示"

msgid "Add descendant reference in child list"
msgstr "子供リストに子孫参照を追加"

msgid "Include TODO notes"
msgstr "TODOメモを含める"

msgid "Whether to include TODO notes."
msgstr "TODOメモを含めるかどうか。"

msgid "The style used for the title of the page."
msgstr "ページのタイトルに使用されるスタイル。"

msgid "The style used for the children list."
msgstr "子供リストに使用されるスタイル。"

msgid "The style used for the first personal entry."
msgstr "最初の個人エントリに使用されるスタイル。"

msgid "The style used for the More About header and for headers of mates."
msgstr "「詳細」ヘッダーと配偶者のヘッダーに使用されるスタイル。"

msgid "The style used for additional detail data."
msgstr "追加の詳細データに使用されるスタイル。"

msgid "The style used for image labels."
msgstr "画像ラベルに使用されるスタイル。"

msgid "A style used for image captions."
msgstr "画像のキャプションに使用されるスタイル。"
