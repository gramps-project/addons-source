msgid "Family Sheet"
msgstr "Rodinný list"

msgid ""
"Produces a family sheet showing full information about a person and his/her "
"partners and children."
msgstr ""
"Vytvoří rodinný list se všemi informacemi o osobě jejích partnerech a dětech."

#, python-format
msgid "Address (%(date)s): %(location)s"
msgstr "Adresa (%(date)s): %(location)s"

#, python-format
msgid "Address: %(location)s"
msgstr "Adresa: %(location)s"

#, python-format
msgid "; %(type)s: %(value)s"
msgstr ";%(type)s: %(value)s"

msgid "Source references:"
msgstr "Odkazy na zdroje:"

#, python-format
msgid ", page %s"
msgstr ", strana %s"

msgid "Notes:"
msgstr "Poznámky:"

#, python-format
msgid "on %(ymd_date)s"
msgstr "%(ymd_date)s"

#, python-format
msgid "in %(ym_date)s"
msgstr "%(ym_date)s"

#, python-format
msgid "in %(y_date)s"
msgstr "%(y_date)s"

#, python-format
msgid "on %(placeholder)s"
msgstr "%(placeholder)s"

#, python-format
msgid "on %(placeholder)s (%(partial)s)"
msgstr "%(placeholder)s %(partial)s"

#, python-format
msgid "in %(place)s"
msgstr "%(place)s"

msgid "Center person"
msgstr "Ústřední osoba"

msgid "Print sheets for"
msgstr "Vytisknout listy pro"

msgid "Center person only"
msgstr "Pouze ústřední osoba"

msgid "Center person and all descendants"
msgstr "Ústřední osoba se všemi potomky"

msgid "Whether to include descendants, and which ones."
msgstr "Zda zahrnout potomky a které."

msgid "Replace first name with call name"
msgstr "Nahradit křestní jméno volacím jménem"

msgid "Underline call name in first name / add call name to first name"
msgstr ""
"Podtrhnout volací jméno v křestním jménu / přidat volací jméno ke křestnímu "
"jménu"

msgid "Print placeholders for missing information"
msgstr "Zobrazit prázdné pole při chybějících udajích"

msgid "The basic style used for the text display"
msgstr "Základní styl použitý na zobrazení textu"

msgid "The style used for the page key on the top"
msgstr "Styl použitý pro klávesu stránky nahoře"

msgid "The style used for names"
msgstr "Styl použitý pro jména"

msgid "The style used for numbers"
msgstr "Styl použitý pro čísla"

msgid "The style used for footnotes (notes and source references)"
msgstr "Styl použitý pro poznámky pod čarou (poznámky a odkazy na zdroje)"
