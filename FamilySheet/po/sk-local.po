msgid "Family Sheet"
msgstr "Rodinný list"

msgid ""
"Produces a family sheet showing full information about a person and his/her "
"partners and children."
msgstr ""
"Vytvorí rodinný list s úplnými informáciami o osobe a jej partneroch a "
"deťoch."

#, python-format
msgid "→ %s"
msgstr "→ %s"

#, python-format
msgid "Address (%(date)s): %(location)s"
msgstr "Adresa (%(date)s): %(location)s"

#, python-format
msgid "Address: %(location)s"
msgstr "Adresa: %(location)s"

#, python-format
msgid "; %(type)s: %(value)s"
msgstr "; %(type)s: %(value)s"

msgid "Source references:"
msgstr "Odkazy na zdroje:"

#, python-format
msgid ", page %s"
msgstr ", strana %s"

msgid "Notes:"
msgstr "Poznámky:"

#, python-format
msgid "on %(ymd_date)s"
msgstr "%(ymd_date)s"

#, python-format
msgid "in %(ym_date)s"
msgstr "v/vo %(ym_date)s"

#, python-format
msgid "in %(y_date)s"
msgstr "v/vo %(y_date)s"

#, python-format
msgid "on %(placeholder)s"
msgstr "%(placeholder)s"

#, python-format
msgid "on %(placeholder)s (%(partial)s)"
msgstr "%(placeholder)s (%(partial)s)"

#, python-format
msgid "in %(place)s"
msgstr "v/vo %(place)s"

msgid "Center person"
msgstr "Ústredná osoba"

msgid "The person whose partners and children are printed"
msgstr "Osoba, ktorej partneri a deti sú zobrazené"

msgid "Print sheets for"
msgstr "Vytlačiť listy pre"

msgid "Center person only"
msgstr "Iba ústredná osoba"

msgid "Center person and descendants in side branches"
msgstr "Ústredná osoba a potomkovia v bočných vetvách"

msgid "Center person and all descendants"
msgstr "Ústredná osoba so všetkými potomkami"

msgid "Whether to include descendants, and which ones."
msgstr "Či zahrnúť potomkov a ktorých."

msgid "Replace first name with call name"
msgstr "Nahradiť krstné meno volacím menom"

msgid "Underline call name in first name / add call name to first name"
msgstr ""
"Podčiarknuť volacie meno v krstnom mene / pridať volacie meno ku krstnému "
"menu"

msgid "Whether to include call name, and how."
msgstr "Či zahrnúť volacie meno a ako."

msgid "Print placeholders for missing information"
msgstr "Zobraziť prázdne políčka pri chýbajúcich údajoch"

msgid "The basic style used for the text display"
msgstr "Základný štýl použitý na zobrazenie textu"

msgid "The style used for the page key on the top"
msgstr "Štýl použitý pre kláves stránky v hornej časti"

msgid "The style used for names"
msgstr "Štýl použitý pre mená"

msgid "The style used for numbers"
msgstr "Štýl použitý pre čísla"

msgid "The style used for footnotes (notes and source references)"
msgstr "Štýl použitý pre poznámky pod čiarou (poznámky a odkazy na zdroje)"
