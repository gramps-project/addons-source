msgid "Family Sheet"
msgstr "Foglio famiglia"

msgid ""
"Produces a family sheet showing full information about a person and his/her "
"partners and children."
msgstr ""
"Genera un foglio di famiglia che riporta tutte le informazioni relative a "
"una persona, ai suoi coniugi, e ai suoi figli."

#, python-format
msgid "→ %s"
msgstr "→ %s"

#, python-format
msgid "Address (%(date)s): %(location)s"
msgstr "Indirizzo (%(date)s): %(location)s"

#, python-format
msgid "Address: %(location)s"
msgstr "Indirizzo: %(location)s"

#, python-format
msgid "; %(type)s: %(value)s"
msgstr "; %(type)s: %(value)s"

msgid "Source references:"
msgstr "Riferimenti fonte:"

#, python-format
msgid ", page %s"
msgstr ", pagina %s"

msgid "Notes:"
msgstr "Note:"

#, python-format
msgid "on %(ymd_date)s"
msgstr "il %(ymd_date)s"

#, python-format
msgid "in %(ym_date)s"
msgstr "il %(ym_date)s"

#, python-format
msgid "in %(y_date)s"
msgstr "nel %(y_date)s"

#, python-format
msgid "on %(placeholder)s"
msgstr "in %(placeholder)s"

#, python-format
msgid "on %(placeholder)s (%(partial)s)"
msgstr "in %(placeholder)s (%(partial)s)"

#, python-format
msgid "in %(place)s"
msgstr "in %(place)s"

msgid "Center person"
msgstr "Persona centrale"

msgid "The person whose partners and children are printed"
msgstr "La persona i cui partner e figli sono stampati"

msgid "Print sheets for"
msgstr "Stampa foglio per"

msgid "Center person only"
msgstr "Solo la persona centrale"

msgid "Center person and descendants in side branches"
msgstr "La persona centrale e i discendenti nei rami collaterali"

msgid "Center person and all descendants"
msgstr "La persona centrale e tutti i discendenti"

msgid "Whether to include descendants, and which ones."
msgstr "Indica se includere discendenti, e quali includere."

msgid "Replace first name with call name"
msgstr "Sostituisci il nome con lo pseudonimo"

msgid "Underline call name in first name / add call name to first name"
msgstr "Sottolinea lo pseudonimo nel nome / aggiungi lo pseudonimo al nome"

msgid "Whether to include call name, and how."
msgstr "Indica se includere lo pseudonimo, e come."

msgid "Print placeholders for missing information"
msgstr "Stampa un segnaposto per le informazioni mancanti"

msgid "The basic style used for the text display"
msgstr "Lo stile di base utilizzato per la visualizzazione del testo"

msgid "The style used for the page key on the top"
msgstr "Lo stile usato per il titolo della pagina in alto"

msgid "The style used for names"
msgstr "Lo stile usato per i nomi"

msgid "The style used for numbers"
msgstr "Lo stile usato per i numeri"

msgid "The style used for footnotes (notes and source references)"
msgstr "Lo stile usato per le note a pie di pagina (riferimenti note e fonte)"
