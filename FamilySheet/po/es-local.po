msgid "Family Sheet"
msgstr "Hoja Familiar"

msgid ""
"Produces a family sheet showing full information about a person and his/her "
"partners and children."
msgstr ""
"Produce una hoja de familia que muestra información completa sobre una "
"persona y sus parejas e hijos."

#, python-format
msgid "Address (%(date)s): %(location)s"
msgstr "Dirección (%(date)s): %(location)s"

#, python-format
msgid "Address: %(location)s"
msgstr "Dirección: %(location)s"

#, python-format
msgid "; %(type)s: %(value)s"
msgstr "; %(type)s: %(value)s"

msgid "Source references:"
msgstr "Preferencias de la fuente:"

#, python-format
msgid ", page %s"
msgstr ", página %s"

msgid "Notes:"
msgstr "Notas:"

#, python-format
msgid "on %(ymd_date)s"
msgstr "el %(ymd_date)s"

#, python-format
msgid "in %(ym_date)s"
msgstr "en %(ym_date)s"

#, python-format
msgid "in %(y_date)s"
msgstr "en %(y_date)s"

#, python-format
msgid "on %(placeholder)s"
msgstr "sobre %(placeholder)s"

#, python-format
msgid "on %(placeholder)s (%(partial)s)"
msgstr "sobre %(placeholder)s %(partial)s"

#, python-format
msgid "in %(place)s"
msgstr "interno a %(place)s"

msgid "Center person"
msgstr "Centrar persona"

msgid "The person whose partners and children are printed"
msgstr "La persona cuyos compañeros e hijos son impresos"

msgid "Print sheets for"
msgstr "Hojas de impresión para"

msgid "Center person only"
msgstr "Solo persona del centro"

msgid "Center person and descendants in side branches"
msgstr "Persona y descendientes centrales en ramas laterales"

msgid "Center person and all descendants"
msgstr "Persona central y todos los descendientes"

msgid "Whether to include descendants, and which ones."
msgstr "Si para incluir descendientes, y cuáles."

msgid "Replace first name with call name"
msgstr "Reemplazar nombre de pila por apelativo"

msgid "Underline call name in first name / add call name to first name"
msgstr ""
"Subrayar nombre de llamada interna al nombre de pila / agregar nombre de "
"llamada al nombre de pila"

msgid "Whether to include call name, and how."
msgstr "Si o no incluir llamada por el nombre, y cómo."

msgid "Print placeholders for missing information"
msgstr "Declara nombre de posición para información ausente"

msgid "The basic style used for the text display"
msgstr "El estilo básico utilizado para el texto de pantalla"

msgid "The style used for the page key on the top"
msgstr "El estilo utilizado para la tecla de página en la parte superior"

msgid "The style used for names"
msgstr "El estilo usado para los nombres"

msgid "The style used for numbers"
msgstr "El estilo usado para los números"

msgid "The style used for footnotes (notes and source references)"
msgstr "El estilo usado para las notas al pie (notas y referencias a fuentes)"
