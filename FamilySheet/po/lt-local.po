msgid "Family Sheet"
msgstr "Šeimos lapas"

msgid ""
"Produces a family sheet showing full information about a person and his/her "
"partners and children."
msgstr ""
"Sudaro šeimos lapą, kuriame pateikiama išsami informacija apie asmenį, jo "
"partnerius ir vaikus."

msgid "Notes:"
msgstr "Pastabos:"

msgid "Center person"
msgstr "Centrinis asmuo"

msgid "Center person only"
msgstr "Tik centrinis asmuo"

msgid "Center person and descendants in side branches"
msgstr "Centrinis asmuo ir palikuonys šoninėse šakose"

msgid "Center person and all descendants"
msgstr "Centrinis asmuo ir visi palikuonys"

msgid "Whether to include descendants, and which ones."
msgstr "Ar įtraukti palikuonis ir kuriuos."

msgid "Whether to include call name, and how."
msgstr "Ar įtraukti kreipinį ir kaip."

msgid "The basic style used for the text display"
msgstr "Pagrindinis teksto rodymo stilius"

msgid "The style used for names"
msgstr "Vardams naudojamas stilius"

msgid "The style used for numbers"
msgstr "Skaičiams naudojamas stilius"
