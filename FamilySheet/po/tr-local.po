msgid "Family Sheet"
msgstr "Aile Formu"

msgid ""
"Produces a family sheet showing full information about a person and his/her "
"partners and children."
msgstr ""
"Kişi ve eşleri ile çocukları hakkında eksiksiz bilgi içeren bir aile bilgi "
"formu oluşturur."

#, python-format
msgid "→ %s"
msgstr "→ %s"

#, python-format
msgid "Address (%(date)s): %(location)s"
msgstr "Adres (%(date)s): %(location)s"

#, python-format
msgid "Address: %(location)s"
msgstr "Adres: %(location)s"

#, python-format
msgid "; %(type)s: %(value)s"
msgstr "; %(type)s: %(value)s"

msgid "Source references:"
msgstr "Kaynak referansları:"

#, python-format
msgid ", page %s"
msgstr ", sayfa %s"

msgid "Notes:"
msgstr "Notlar:"

#, python-format
msgid "on %(ymd_date)s"
msgstr "%(ymd_date)s tarihinde"

#, python-format
msgid "in %(ym_date)s"
msgstr "%(ym_date)s tarihinde"

#, python-format
msgid "in %(y_date)s"
msgstr "%(y_date)s tarihinde"

#, python-format
msgid "on %(placeholder)s"
msgstr "%(placeholder)s üzerinde"

#, python-format
msgid "on %(placeholder)s (%(partial)s)"
msgstr "%(placeholder)s (%(partial)s) üzerinde"

#, python-format
msgid "in %(place)s"
msgstr "%(place)s yerinde"

msgid "Center person"
msgstr "Merkezdeki kişi"

msgid "The person whose partners and children are printed"
msgstr "Partnerleri ve çocukları yazdırılmış olan kişi"

msgid "Print sheets for"
msgstr "Yazdırma sayfaları için"

msgid "Center person only"
msgstr "Sadece merkezdeki kişi"

msgid "Center person and descendants in side branches"
msgstr "Yan dallarda merkez kişi ve soyundan gelenler"

msgid "Center person and all descendants"
msgstr "Merkezdeki kişi ve tüm soyundan gelenler"

msgid "Whether to include descendants, and which ones."
msgstr ""
"Soyundan gelenlerin dahil edilip edilmeyeceği ve hangilerinin dahil "
"edileceği."

msgid "Replace first name with call name"
msgstr "İlk adı çağrı adıyla değiştirin"

msgid "Underline call name in first name / add call name to first name"
msgstr "İlk addaki çağrı adının altını çiz/çağrı adını ilk ada ekle"

msgid "Whether to include call name, and how."
msgstr "Çağrı adının eklenip eklenmeyeceği ve nasıl ekleneceği."

msgid "Print placeholders for missing information"
msgstr "Eksik bilgiler için yer tutucular yazdırın"

msgid "The basic style used for the text display"
msgstr "Metin görüntüleme için kullanılan temel stil"

msgid "The style used for the page key on the top"
msgstr "Üstteki sayfa anahtarı için kullanılan stil"

msgid "The style used for names"
msgstr "Adlar için kullanılan stil"

msgid "The style used for numbers"
msgstr "Sayılar için kullanılan stil"

msgid "The style used for footnotes (notes and source references)"
msgstr "Dipnotlar (notlar ve kaynak referansları) için kullanılan stil"
