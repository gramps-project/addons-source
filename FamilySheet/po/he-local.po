msgid "Family Sheet"
msgstr "גליון משפחה"

msgid ""
"Produces a family sheet showing full information about a person and his/her "
"partners and children."
msgstr "הפקת גיליון משפחה שמציג מידע מלא על אדם, על זוגאיו ועל ילדיו."

#, python-format
msgid "→ %s"
msgstr "← %s"

#, python-format
msgid "Address (%(date)s): %(location)s"
msgstr "כתובת (%(date)s): %(location)s"

#, python-format
msgid "Address: %(location)s"
msgstr "כתובת: %(location)s"

#, python-format
msgid "; %(type)s: %(value)s"
msgstr "; %(type)s: %(value)s"

msgid "Source references:"
msgstr "אזכורי מקור:"

#, python-format
msgid ", page %s"
msgstr ", עמוד %s"

msgid "Notes:"
msgstr "הערות:"

#, python-format
msgid "on %(ymd_date)s"
msgstr "ב־%(ymd_date)s"

#, python-format
msgid "in %(ym_date)s"
msgstr "ב־%(ym_date)s"

#, python-format
msgid "in %(y_date)s"
msgstr "ב־%(y_date)s"

#, python-format
msgid "on %(placeholder)s"
msgstr "ב־%(placeholder)s"

#, python-format
msgid "on %(placeholder)s (%(partial)s)"
msgstr "ב־%(placeholder)s (%(partial)s)"

#, python-format
msgid "in %(place)s"
msgstr "בתוך %(place)s"

msgid "Center person"
msgstr "אדם מרכזי"

msgid "The person whose partners and children are printed"
msgstr "אדם ששמו שותפים וילדים מודפס"

msgid "Print sheets for"
msgstr "הדפסת גיליונות עבור"

msgid "Center person only"
msgstr "אדם מרכזי בלבד"

msgid "Center person and descendants in side branches"
msgstr "מרכוז האדם והצאצאים בענפים צדדיים"

msgid "Center person and all descendants"
msgstr "אדם מרכזי וכל הצאצאים"

msgid "Whether to include descendants, and which ones."
msgstr "האם לכלול צאצאים, וש ב."

msgid "Replace first name with call name"
msgstr "החלפת שם פרטי בשם מקובל"

msgid "Underline call name in first name / add call name to first name"
msgstr "הדגשת שם קריאה בשם הפרטי / הוספת שם קריאה לשם הפרטי"

msgid "Whether to include call name, and how."
msgstr "האם לכלול שם קריאה, ובאיזה אופן."

msgid "Print placeholders for missing information"
msgstr "הצגת שומרי־מקום למידע חסר"

msgid "The basic style used for the text display"
msgstr "הסגנון הבסיסי שמשמש להצגת המלל"

msgid "The style used for the page key on the top"
msgstr "הסגנון ששימש את מפתח העמוד מעלה"

msgid "The style used for names"
msgstr "הסגנון שמשמש לשמות"

msgid "The style used for numbers"
msgstr "הסגנון שמשמש למספרים"

msgid "The style used for footnotes (notes and source references)"
msgstr "הסגנון שמשמש להערות שוליים (הערות והפניות למקורות)"
