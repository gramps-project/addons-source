msgid ""
"Produces a family sheet showing full information about a person and his/her "
"partners and children."
msgstr ""
"Tworzy arkusz rodziny pokazujący pełne informacje o osobie oraz jej "
"partnerach i dzieciach."

#, python-format
msgid "Address (%(date)s): %(location)s"
msgstr "Adres (%(date)s): %(location)s"

#, python-format
msgid "Address: %(location)s"
msgstr "Adres: %(location)s"

msgid "Source references:"
msgstr "Źródła:"

#, python-format
msgid ", page %s"
msgstr ", strona %s"

msgid "Notes:"
msgstr "Uwagi:"

#, python-format
msgid "on %(ymd_date)s"
msgstr "dnia %(ymd_date)s"

#, python-format
msgid "in %(ym_date)s"
msgstr "w %(ym_date)s"

#, python-format
msgid "in %(y_date)s"
msgstr "w %(y_date)s"

#, python-format
msgid "on %(placeholder)s"
msgstr "dnia %(placeholder)s"

#, python-format
msgid "on %(placeholder)s (%(partial)s)"
msgstr "dnia %(placeholder)s (%(partial)s)"

#, python-format
msgid "in %(place)s"
msgstr "w %(place)s"

msgid "Center person"
msgstr "Osoba główna"

msgid "The person whose partners and children are printed"
msgstr "Osoba, której partnerzy i dzieci zostaną wydrukowane"

msgid "Print sheets for"
msgstr "Drukuj arkusze dla"

msgid "Center person only"
msgstr "Tylko osoba główna"

msgid "Center person and descendants in side branches"
msgstr "Osoba główna i potomkowie w liniach bocznych"

msgid "Center person and all descendants"
msgstr "Osoba główna i wszyscy potomkowie"

msgid "Whether to include descendants, and which ones."
msgstr "Określa, czy i których potomków uwzględnić."

msgid "Replace first name with call name"
msgstr "Zastąp imię imieniem zwyczajowym"

msgid "Underline call name in first name / add call name to first name"
msgstr "Podkreśl imię zwyczajowe w imieniu / dodaj imię zwyczajowe do imienia"

msgid "Whether to include call name, and how."
msgstr "Określa, czy i jak uwzględnić imię zwyczajowe."

msgid "Print placeholders for missing information"
msgstr "Drukuj symbole zastępcze dla brakujących informacji"

msgid "The basic style used for the text display"
msgstr "Podstawowy styl używany do wyświetlania tekstu"

msgid "The style used for the page key on the top"
msgstr "Styl używany dla klucza strony u góry"

msgid "The style used for names"
msgstr "Styl używany dla imion i nazwisk"

msgid "The style used for numbers"
msgstr "Styl używany dla numerów"

msgid "The style used for footnotes (notes and source references)"
msgstr "Styl używany dla przypisów (uwagi i źródła)"
