msgid "Number of ancestors"
msgstr "מספר אבות קדמונים"

msgid "Shows the number of ancestors of the current person"
msgstr "הצגת מספר האבות של האדם הנוכחי"

#, python-format
msgid "Number of %s's ancestors"
msgstr "מספר האבות של %s"

msgid "Generation"
msgstr "דור"

msgid "Found"
msgstr "נמצא"

msgid "Theoretical"
msgstr "תיאורטי"

