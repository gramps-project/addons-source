msgid "This Day in Family History"
msgstr "Tento den v rodinné historii"

msgid ""
"A configurable program that shows you the connected events from your family "
"tree that match today's day and month."
msgstr ""
"Nastavitelný program, který zobrazuje události spojené s osobami a rodinami "
"ve vašem rodokmenu, jejichž den a měsíc odpovídají dnešku."

msgid "Database is not open, can't check history right now."
msgstr "Databáze není otevřená, rodinnou historii nyní nelze prohlížet."

msgid "... nothing happened!  Check again tomorrow!"
msgstr "... nic se nestalo! Podívejte se znovu zítra!"

msgid "Report only living tree members"
msgstr "Zobrazovat jen žijící osoby z rodokmenu"

msgid "Show these events"
msgstr "Zobrazovat tyto události"

msgid "Sort by "
msgstr "Řadit podle "

msgid "Sort in ascending order?"
msgstr "Řadit vzestupně?"

