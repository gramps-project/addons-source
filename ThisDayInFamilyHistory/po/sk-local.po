msgid "This Day in Family History"
msgstr "Tento deň v rodinnej histórii"

msgid ""
"A configurable program that shows you the connected events from your family "
"tree that match today's day and month."
msgstr ""
"Konfigurovateľný program, ktorý vám zobrazí pripojené udalosti z vášho "
"rodinného stromu, ktoré zodpovedajú dnešnému dňu a mesiacu."

msgid "Database is not open, can't check history right now."
msgstr ""
"Databáza nie je otvorená, momentálne nie je možné skontrolovať históriu."

#, python-format
msgid "On %(date)s in family history ...\n"
msgstr "Dňa %(date)s v rodinnej histórii ...\n"

msgid "... nothing happened!  Check again tomorrow!"
msgstr "... sa nič nestalo!  Skontrolujte znova zajtra!"

msgid "Report only living tree members"
msgstr "Hlásiť iba žijúcich členov stromu"

msgid "Show these events"
msgstr "Zobraziť tieto udalosti"

msgid "Sort by "
msgstr "Zoradiť podľa "

msgid "Sort in ascending order?"
msgstr "Zoradiť vzostupne?"

