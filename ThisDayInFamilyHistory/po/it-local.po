msgid "This Day in Family History"
msgstr "Questo giorno nella storia della famiglia"

msgid ""
"A configurable program that shows you the connected events from your family "
"tree that match today's day and month."
msgstr ""
"Un programma configurabile che mostra gli eventi collegati del tuo albero "
"genealogico che coincidono con il giorno e il mese di oggi."

msgid "Database is not open, can't check history right now."
msgstr ""
"Il database non è aperto, impossibile controllare la storia in questo "
"momento."

#, python-format
msgid "On %(date)s in family history ...\n"
msgstr "Il %(date)s nella storia della famiglia ...\n"

msgid "... nothing happened!  Check again tomorrow!"
msgstr "... non è successo niente!  Controlla di nuovo domani!"

msgid "Report only living tree members"
msgstr "Riporta solo i membri dell'albero in vita"

msgid "Show these events"
msgstr "Mostra questi eventi"

msgid "Sort by "
msgstr "Ordina per "

msgid "Sort in ascending order?"
msgstr "Ordinare in ordine crescente?"

