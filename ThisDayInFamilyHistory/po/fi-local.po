msgid "This Day in Family History"
msgstr "Tämä päivä sukuhistoriassa"

msgid ""
"A configurable program that shows you the connected events from your family "
"tree that match today's day and month."
msgstr ""
"Konfiguroitava ohjelma, joka näyttää sukupuusi tähän päivään ja kuukauteen "
"osuvat tapahtumat."

msgid "Database is not open, can't check history right now."
msgstr "Tietokanta ei ole auki, historiaa ei voi tarkistaa juuri nyt."

#, python-format
msgid "On %(date)s in family history ...\n"
msgstr "Sukuhistoriassa päivänä %(date)s ...\n"

msgid "... nothing happened!  Check again tomorrow!"
msgstr "... mitään ei tapahtunut! Tarkista huomenna uudelleen!"

