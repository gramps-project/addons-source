msgid "Pedigree Chart"
msgstr "Dijagram porijekla"

msgid "Alternate version of the traditional pedigree chart."
msgstr "Alternativni prikaz uobičajenog dijagrama porijekla."

#, python-format
msgid "Pedigree Chart for %s"
msgstr "Dijagram porijekla za %s"

#, python-format
msgid "Page %d"
msgstr "Stranica %d"

msgid "Show Mother/Father captions"
msgstr "Prikaži opise za majku/oca"

msgid "Show the title of mother or father beside each ancestor's box."
msgstr "Prikaži naslov za majku ili oca pored svakog okvira pretka."

msgid "Show page numbers"
msgstr "Prikaži brojeve stranica"

msgid "Add a footer on every page with the page number and date printed."
msgstr "Dodaj podnožje na svaku stranicu s brojem stranice i datumom ispisa."

msgid "The basic style used for the title display."
msgstr "Osnovni stil za prikaz naslova."

msgid "Style used for names (only for PDF document and PostScript)."
msgstr "Sitl korišten za imena (samo za PDF i PostScript datoteke)."

msgid "Style used for labels and captions."
msgstr "Sitl korišten za etikete i opise."
