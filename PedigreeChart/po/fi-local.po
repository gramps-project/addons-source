msgid "Pedigree Chart"
msgstr "Sukutaulu"

msgid "Alternate version of the traditional pedigree chart."
msgstr "Vaihtoehtoinen versio perinteisestä sukutaulukosta."

#, python-format
msgid "Pedigree Chart for %s"
msgstr "Sukupuukaavio henkilölle %s"

#, python-format
msgid "Page %d"
msgstr "Sivu %d"

msgid "Show Mother/Father captions"
msgstr "Näytä äidin/isän kuvatekstit"

msgid "Show the title of mother or father beside each ancestor's box."
msgstr "Näytä äidin tai isän nimi kunkin esi-isän laatikon vieressä."

msgid "Show page numbers"
msgstr "Näytä sivunumerot"

msgid "Add a footer on every page with the page number and date printed."
msgstr ""
"Lisätään jokaiselle sivulle alatunniste, johon tulostetaan sivunumero ja "
"päivämäärä."

msgid "The basic style used for the title display."
msgstr "Otsikossa käytettävä perustyyli."

msgid "Style used for names (only for PDF document and PostScript)."
msgstr "Nimien tyyli (vain PDF-dokumenteille ja PostScriptille)."

msgid "Style used for labels and captions."
msgstr "Otsikoiden ja kuvatekstien tyyli."
