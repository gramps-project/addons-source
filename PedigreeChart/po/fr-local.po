msgstr "Arbre graphique de %s"

#, python-format
msgid "Page %d"
msgstr "Page %d"

msgid "Show Mother/Father captions"
msgstr "Afficher les en-têtes Mère/Père"

msgid "Show the title of mother or father beside each ancestor's box."
msgstr "Afficher la mère et le père à côté de l'aire de l'ascendant."

msgid "Add a footer on every page with the page number and date printed."
msgstr ""
"Ajoute un pied de page à chaque page avec le numéro et la date de la page "
"imprimés."

msgid "The basic style used for the title display."
msgstr "Le style de base pour afficher le titre."

