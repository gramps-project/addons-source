msgid "Pedigree Chart"
msgstr "Cuadro Pedigree"

msgid "Alternate version of the traditional pedigree chart."
msgstr "Versión alternativa del cuadro de pedigree adicional."

#, python-format
msgid "Pedigree Chart for %s"
msgstr "Cuadro de Pedigree para %s"

#, python-format
msgid "Page %d"
msgstr "Página %d"

msgid "Show Mother/Father captions"
msgstr "Mostrar subtítulos madre/padre"

msgid "Show the title of mother or father beside each ancestor's box."
msgstr ""
"Muestra el título de la madre o el padre junto a cada caja de ancestro."

msgid "Show page numbers"
msgstr "Muestra números de página"

msgid "Add a footer on every page with the page number and date printed."
msgstr ""
"Añada un pie de página en cada página con el número de página y la fecha "
"impreso."

msgid "The basic style used for the title display."
msgstr "El estilo básico utilizado para la pantalla del título."
