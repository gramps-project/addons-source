msgid "Pedigree Chart"
msgstr "Soyağacı Grafiği"

msgid "Alternate version of the traditional pedigree chart."
msgstr "Geleneksel soyağacı grafiğinin alternatif sürümü."

#, python-format
msgid "Pedigree Chart for %s"
msgstr "%s için Soyağacı Grafiği"

#, python-format
msgid "Page %d"
msgstr "Sayfa %d"

msgid "Show Mother/Father captions"
msgstr "Anne/Baba unvanlarını göster"

msgid "Show the title of mother or father beside each ancestor's box."
msgstr "Her atanın kutusunun yanında anne veya babanın unvanını göster."

msgid "Show page numbers"
msgstr "Sayfa numaralarını göster"

msgid "Add a footer on every page with the page number and date printed."
msgstr ""
"Her sayfaya sayfa numarası ve yazdırılan tarihle birlikte bir altbilgi "
"ekleyin."

msgid "The basic style used for the title display."
msgstr "Başlık gösterimi için kullanılan temel stil."

msgid "Style used for names (only for PDF document and PostScript)."
msgstr "Adlar için kullanılan stil (yalnızca PDF belgesi ve PostScript için)."

msgid "Style used for labels and captions."
msgstr "Etiketler ve başlıklar için kullanılan stil."
