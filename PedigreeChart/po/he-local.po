msgid "Pedigree Chart"
msgstr "אילן־יוחסין תרשים"

msgid "Alternate version of the traditional pedigree chart."
msgstr "גרסה חלופית של תרשים אילן־היוחסין המסורתי."

#, python-format
msgid "Pedigree Chart for %s"
msgstr "אילן־יוחסין תרשים עבור %s"

#, python-format
msgid "Page %d"
msgstr "עמוד %d"

msgid "Show Mother/Father captions"
msgstr "הצגת אם/אב כיתובים"

msgid "Show the title of mother or father beside each ancestor's box."
msgstr "הצגת כותרת של אם או אב לצד כל אב של תיבה."

msgid "Show page numbers"
msgstr "הצגת מספרי עמוד"

msgid "Add a footer on every page with the page number and date printed."
msgstr "הוספה סיומת עמוד על כל עמוד עם עמוד מספר ותאריך שהודפס."

msgid "The basic style used for the title display."
msgstr "הסגנון הבסיסי ששימש למצג כותרת."

msgid "Style used for names (only for PDF document and PostScript)."
msgstr "סגנון שמשמש לשמות (רק עבור מסמך PDF ו־PostScript)."

msgid "Style used for labels and captions."
msgstr "סגנון שמשמש עבור תוויות וכיתובים."
