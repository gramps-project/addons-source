msgid "Pedigree Chart"
msgstr "Ahnentafeldiagramm"

msgid "Alternate version of the traditional pedigree chart."
msgstr "Alternative Version der traditionellen Ahnentafel."

#, python-format
msgid "Pedigree Chart for %s"
msgstr "Ahnentafeldiagramm für %s"

#, python-format
msgid "Page %d"
msgstr "Seite %d"

msgid "Show Mother/Father captions"
msgstr "Beschriftungen für Mutter/Vater anzeigen"

msgid "Show the title of mother or father beside each ancestor's box."
msgstr "Zeigee den Titel von Mutter oder Vater neben jedem Vorfahrenfeld an."

msgid "Show page numbers"
msgstr "Seitenzahlen anzeigen"

msgid "Add a footer on every page with the page number and date printed."
msgstr ""
"Auf jeder Seite eine Fußzeile mit der Seitenzahl und dem Datum hinzufügen."

msgid "The basic style used for the title display."
msgstr "Der für die Titelanzeige verwendete Grundstil."

msgid "Style used for names (only for PDF document and PostScript)."
msgstr "Für Namen verwendeter Stil (nur für PDF-Dokumente und PostScript)."

msgid "Style used for labels and captions."
msgstr "Stil für Beschriftungen und Bildunterschriften."
