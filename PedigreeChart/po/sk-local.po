msgid "Pedigree Chart"
msgstr "Diagram rodokmeňa"

msgid "Alternate version of the traditional pedigree chart."
msgstr "Alternatívna verzia tradičného diagramu rodokmeňa."

#, python-format
msgid "Pedigree Chart for %s"
msgstr "Diagram rodokmeňa pre %s"

#, python-format
msgid "Page %d"
msgstr "Stránka %d"

msgid "Show Mother/Father captions"
msgstr "Zobraziť popisky matky/otca"

msgid "Show the title of mother or father beside each ancestor's box."
msgstr "Zobrazí označenie matky alebo otca vedľa každého rámika predka."

msgid "Show page numbers"
msgstr "Zobraziť čísla strán"

msgid "Add a footer on every page with the page number and date printed."
msgstr "Pridá pätu na každej strane s číslom strany a dátumom tlače."

msgid "The basic style used for the title display."
msgstr "Základný štýl používaný pre zobrazenie názvu."

msgid "Style used for labels and captions."
msgstr "Štýl použitý pre značky a popisky."
