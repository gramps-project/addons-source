msgid "Pedigree Chart"
msgstr "Schéma vývodu z předků"

msgid "Alternate version of the traditional pedigree chart."
msgstr "Alternativní verze tradičního schématu vývodu z předků."

#, python-format
msgid "Pedigree Chart for %s"
msgstr "Schéma vývodu z předků – %s"

#, python-format
msgid "Page %d"
msgstr "Strana %d"

msgid "Show Mother/Father captions"
msgstr "Zobrazit popisky Matka/Otec"

msgid "Show the title of mother or father beside each ancestor's box."
msgstr "Zobrazit označení matky nebo otce vedle rámečku každého předka."

msgid "Show page numbers"
msgstr "Zobrazit čísla stran"

msgid "Add a footer on every page with the page number and date printed."
msgstr "Na každou stranu přidat zápatí s vytištěným číslem strany a datem."

msgid "The basic style used for the title display."
msgstr "Základní styl použitý pro zobrazení názvu."

msgid "Style used for names (only for PDF document and PostScript)."
msgstr "Styl použitý pro jména (pouze pro dokumenty PDF a PostScript)."

msgid "Style used for labels and captions."
msgstr "Styl použitý pro štítky a popisky."
