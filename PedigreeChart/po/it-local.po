msgid "Pedigree Chart"
msgstr "Tavola genealogica"

msgid "Alternate version of the traditional pedigree chart."
msgstr "Versione alternativa della tradizionale tavola genealogica."

#, python-format
msgid "Pedigree Chart for %s"
msgstr "Tavola genealogica di %s"

#, python-format
msgid "Page %d"
msgstr "Pagina %d"

msgid "Show Mother/Father captions"
msgstr "Mostra le didascalie madre/padre"

msgid "Show the title of mother or father beside each ancestor's box."
msgstr ""
"Mostra il titolo di madre o padre accanto al riquadro di ogni ascendente."

msgid "Show page numbers"
msgstr "Mostra i numeri delle pagine"

msgid "Add a footer on every page with the page number and date printed."
msgstr ""
"Aggiungi su ogni pagina un piè di pagina con il numero di pagina e la data "
"di stampa."

msgid "The basic style used for the title display."
msgstr "Lo stile di base usato per la visualizzazione del titolo."

msgid "Style used for names (only for PDF document and PostScript)."
msgstr "Stile usato per i nomi (solo per documenti PDF e PostScript)."

msgid "Style used for labels and captions."
msgstr "Lo stile usato per etichette e didascalie."
