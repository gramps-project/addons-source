msgstr "Uključi slike osoba u čvorištima."

#, python-format
msgid "Person %s does not have both a paternal and a maternal grandparent"
msgstr "Osoba „%s” nema očeve niti majčine djedove i bake"

msgid "Grandparent family spacing"
msgstr "Razmak obitelji djedova i baka"

msgid "Extra spacing of grandparent families (mm)"
msgstr "Dodatni razmak za obitelji djedova i baka (mm)"

msgid "First spouse left"
msgstr "Prvi supružnik lijevo"

msgid ""
"Always put first of multiple spouses on the left. This can help reduce line-"
"crossings with multiple marriages."
msgstr ""
"Uvijek prikaži prvog od više supružnika na lijevu stranu. To može pomoći u "
"smanjenju križanja linija kod višestrukih brakova."
