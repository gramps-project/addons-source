msgstr "Stablo djedova i baka, koristeći LaTeX genealogytree"

msgid "Sandclock Tree"
msgstr "Stablo u obliku pješčanog sata"

msgid "Sandclock tree using LaTeX genealogytree"
msgstr "Stablo u obliku pješčanog sata, koristeći LaTeX genealogytree"

msgid "Sandclock Tree for a Family"
msgstr "Stablo u obliku pješčanog sata za obitelj"

msgid "Sandclock tree for a family using LaTeX genealogytree"
msgstr ""
"Stablo u obliku pješčanog sata za obitelj, koristeći LaTeX genealogytree"

msgid "The center family for the report"
msgstr "Središnja obitelj za izvještaj"

msgid "Generations up"
msgstr "Generacije gore"

msgid "Generations down"
msgstr "Generacije dolje"

