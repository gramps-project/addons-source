msgstr "Incluye imágenes de personas en los nodos."

#, python-format
msgid "Person %s does not have both a paternal and a maternal grandparent"
msgstr "La persona %s no tiene un abuelo paterno y materno"

msgid "Grandparent family spacing"
msgstr "Espaciado de la familia del abuelo"

msgid "Extra spacing of grandparent families (mm)"
msgstr "Espaciado adicional de las familias abuelos (mm)"

msgid "First spouse left"
msgstr "Primer cónyuge izquierdo"

msgid ""
"Always put first of multiple spouses on the left. This can help reduce line-"
"crossings with multiple marriages."
msgstr ""
"Poner siempre primero de múltiples cónyuges a la izquierda. Esto puede "
"ayudar a reducir los cruces de líneas con múltiples matrimonios."
