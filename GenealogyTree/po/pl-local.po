msgid "Ancestor tree using LaTeX genealogytree"
msgstr "Drzewo przodków przy użyciu LaTeX genealogytree"

msgid "Descendant tree using LaTeX genealogytree"
msgstr "Drzewo potomków przy użyciu LaTeX genealogytree"

msgid "Grandparent Tree"
msgstr "Drzewo dziadków"

msgid "Grandparent tree using LaTeX genealogytree"
msgstr "Drzewo dziadków przy użyciu LaTeX genealogytree"

msgid "Sandclock Tree"
msgstr "Drzewo klepsydra"

msgid "Sandclock tree using LaTeX genealogytree"
msgstr "Drzewo klepsydra przy użyciu LaTeX genealogytree"

msgid "Sandclock Tree for a Family"
msgstr "Drzewo klepsydra dla rodziny"

msgid "Sandclock tree for a family using LaTeX genealogytree"
msgstr "Drzewo klepsydra dla rodziny przy użyciu LaTeX genealogytree"

msgid "The center family for the report"
msgstr "Centralna rodzina dla raportu"

msgid "Generations up"
msgstr "Pokolenia w górę"

msgid "Generations down"
msgstr "Pokolenia w dół"

msgid "Include siblings"
msgstr "Dołącz rodzeństwo"

msgid "Include siblings of ancestors."
msgstr "Dołącz rodzeństwo przodków."

msgid "Include images"
msgstr "Dołącz zdjęcia"

msgid "Include images of people in the nodes."
msgstr "Dołącz zdjęcia osób w węzłach drzewa."

#, python-format
msgid "Person %s does not have both a paternal and a maternal grandparent"
msgstr "Osoba %s nie ma dziadków zarówno ze strony ojca, jak i matki"

msgid "Grandparent family spacing"
msgstr "Odstępy między rodzinami dziadków"

msgid "Extra spacing of grandparent families (mm)"
msgstr "Dodatkowe odstępy między rodzinami dziadków (mm)"

msgid "First spouse left"
msgstr "Pierwszy małżonek po lewej"

msgid ""
"Always put first of multiple spouses on the left. This can help reduce line-"
"crossings with multiple marriages."
msgstr ""
"Zawsze umieszczaj pierwszego z wielu małżonków po lewej stronie. Pomoże to "
"ograniczyć krzyżowanie się linii w przypadku wielu małżeństw."
