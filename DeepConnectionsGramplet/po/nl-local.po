msgid "Deep Connections Gramplet"
msgstr "Verre verwanten gramplet"

msgid "Gramplet showing a deep relationship between active and home people"
msgstr ""
"De gramplet toont de relatie tussen de actieve persoon en verre verwanten"

msgid "Deep Connections"
msgstr "Verre relaties"

msgid "⏸ Pause"
msgstr "⏸ Pauze"

msgid "Pause the current search"
msgstr "Huidige zoekopdracht pauzeren"

msgid "▶ Continue"
msgstr "▶ Doorgaan"

msgid "Continue searching for more relations"
msgstr "Verder zoeken naar meer relaties"

msgid "📋 Copy"
msgstr "📋 Kopiëren"

msgid "Copy selected people to clipboard"
msgstr "Geselecteerde personen naar klembord kopiëren"

msgid "🗑 Clear"
msgstr "🗑 Wissen"

msgid "Clear all results and reset"
msgstr "Alle resultaten wissen en herstellen"

msgid "Ready to search"
msgstr "Klaar om te zoeken"

#, python-brace-format
msgid ""
"Search Depth: {depth} | People Processed: {processed} | Queue Size: "
"{queue_size}"
msgstr ""
"Zoekdiepte: {depth} | Verwerkte personen: {processed} | Wachtrij: "
"{queue_size}"

msgid "mentioned in note"
msgstr "vermeld in opmerking"

msgid "Note on Family"
msgstr "Opmerking over familie"

msgid "sibling"
msgstr "broer/zus"

msgid "Note on Parent Family"
msgstr "Opmerking over ouders"

#, python-format
msgid "%s (association)"
msgstr "%s (convectie)"

msgid "Note on Person"
msgstr "Opmerking over persoon"

#, python-format
msgid ""
"\n"
"   %s of "
msgstr ""
"\n"
"   %s van "

msgid "Error: No Home Person set"
msgstr "Fout: Geen centrale persoon ingesteld"

msgid "No Active Person set."
msgstr "Geen actieve persoon ingesteld."

msgid "Error: No Active Person set"
msgstr "Fout: Geen actieve persoon ingesteld"

msgid "Initializing search..."
msgstr "Zoekopdracht initialiseren…"

msgid "Looking for relationship between\n"
msgstr "Gezocht naar de relatie tussen\n"

#, python-format
msgid "  <b>%s</b> (Home Person) and\n"
msgstr "  <b>%s</b> (centrale persoon) en\n"

#, python-format
msgid "  <b>%s</b> (Active Person)...\n"
msgstr "  <b>%s</b> (actieve persoon)...\n"

msgid "Searching for connections..."
msgstr "Zoeken naar connecties..."

#, python-format
msgid ""
"Found relation #%d: \n"
"   "
msgstr ""
"Vond relatie #%d: \n"
"   "

msgid ""
"Paused.\n"
"Press Continue to search for additional relations.\n"
msgstr ""
"Gepauzeerd.\n"
"Druk op Doorgaan om naar aanvullende relaties te zoeken.\n"

msgid "Paused - Press Continue to search for more relations"
msgstr "Gepauzeerd - Druk Doorgaan om meer relaties te zoeken"

#, python-format
msgid ""
"\n"
"Search completed. %d relation paths found."
msgstr ""
"\n"
"Zoeken voltooid. %d connecties gevonden."

msgid "Search completed - {} relation paths found"
msgstr "Zoeken voltooid. {} connecties gevonden."

msgid "Error during search: {}"
msgstr "Fout bij het zoeken: {}"

msgid "Resuming search..."
msgstr "Zoeken hervatten..."

msgid "Search interrupted by user"
msgstr "Zoekopdracht onderbroken door gebruiker"
