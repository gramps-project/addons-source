msgid ""
"Search Depth: {depth} | People Processed: {processed} | Queue Size: "
"{queue_size}"
msgstr ""
"Profundidad de búsqueda: {depth} | Personas procesadas: {processed} | Tamaño "
"de la cola: {queue_size}"

