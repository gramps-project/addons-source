msgid "Deep Connections Gramplet"
msgstr "Gramplet Ligações profundas"

msgid "Gramplet showing a deep relationship between active and home people"
msgstr ""
"Gramplet que mostra um parentesco profundo entre o indivíduo activo e o "
"indivíduo inicial"

msgid "Deep Connections"
msgstr "Ligações profundas"

msgid "⏸ Pause"
msgstr "⏸ Pausa"

msgid "Pause the current search"
msgstr "Pausar a procura actual"

msgid "▶ Continue"
msgstr "▶ Continuar"

msgid "Continue searching for more relations"
msgstr "Continuar a procurar mais parentescos"

msgid "📋 Copy"
msgstr "📋 Copiar"

msgid "Copy selected people to clipboard"
msgstr "Copiar indivíduos seleccionados para a memória"

msgid "🗑 Clear"
msgstr "🗑 Limpar"

msgid "Clear all results and reset"
msgstr "Limpar os resultados e repor"

msgid "Ready to search"
msgstr "Pronto a procurar"

#, python-brace-format
msgid ""
"Search Depth: {depth} | People Processed: {processed} | Queue Size: "
"{queue_size}"
msgstr ""
"Profundidade da procura: {depth} | Indivíduos processados: {processed} | "
"Tamanho da fila: {queue_size}"

msgid "mentioned in note"
msgstr "mencionado na nota"

msgid "Note on Family"
msgstr "Nota da família"

msgid "sibling"
msgstr "irmão"

msgid "Note on Parent Family"
msgstr "Nota da família-mãe"

