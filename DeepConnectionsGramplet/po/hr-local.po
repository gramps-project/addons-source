msgid "Deep Connections Gramplet"
msgstr "Duboke veze – Gramplet"

msgid "Gramplet showing a deep relationship between active and home people"
msgstr "Gramplet prikazuje duboku vezu između aktivne i glavne osobe"

msgid "Deep Connections"
msgstr "Duboke veze"

msgid "⏸ Pause"
msgstr "⏸ Zaustavi"

msgid "Pause the current search"
msgstr "Zaustavi trenutačnu pretragu"

msgid "▶ Continue"
msgstr "▶ Nastavi"

msgid "Continue searching for more relations"
msgstr "Nastavi tražiti još veza"

msgid "📋 Copy"
msgstr "📋 Kopiraj"

msgid "Copy selected people to clipboard"
msgstr "Kopiraj odabrane osobe u međuspremnik"

msgid "🗑 Clear"
msgstr "🗑 Izbriši"

msgid "Clear all results and reset"
msgstr "Izbriši sve rezultate i resetiraj"

msgid "Ready to search"
msgstr "Spremno za pretragu"

msgid "mentioned in note"
msgstr "naveden/a u zabilješki"

msgid "Note on Family"
msgstr "Zabilješka o obitelji"

msgid "sibling"
msgstr "brat/sestra"

msgid "Note on Parent Family"
msgstr "Zabilješka o obitelji roditelja"

