msgid "Deep Connections Gramplet"
msgstr "Gramplet för långa släktskap"

msgid "Gramplet showing a deep relationship between active and home people"
msgstr "Gramplet visande ett lång släktskap mellan aktiv och hem person"

msgid "Deep Connections"
msgstr "Långa släktskap"

msgid "⏸ Pause"
msgstr "⏸ Paus"

msgid "Pause the current search"
msgstr "Pausa den aktuella sökningen"

msgid "▶ Continue"
msgstr "▶ Fortsätt"

msgid "Continue searching for more relations"
msgstr "Fortsätt söka efter fler relationer"

msgid "📋 Copy"
msgstr "📋 Kopiera"

msgid "Copy selected people to clipboard"
msgstr "Kopiera valda personer till urklipp"

msgid "🗑 Clear"
msgstr "🗑 Rensa"

msgid "Clear all results and reset"
msgstr "Rensa alla resultat och återställ"

msgid "Ready to search"
msgstr "Klar för att söka"

#, python-brace-format
msgid ""
"Search Depth: {depth} | People Processed: {processed} | Queue Size: "
"{queue_size}"
msgstr ""
"Sökdjup: {depth} | Bearbetade personer: {processed} | Köstorlek: {queue_size}"

msgid "mentioned in note"
msgstr "nämns i anteckningen"

msgid "Note on Family"
msgstr "Anteckning för familj"

msgid "sibling"
