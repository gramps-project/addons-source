msgid ""
"Found relation #%d: \n"
"   "
msgstr ""
"Beziehung #%d gefunden: \n"
"   "

msgid ""
"Paused.\n"
"Press Continue to search for additional relations.\n"
msgstr ""
"Angehalten.\n"
"Klicke auf Weiter, um nach weiteren Beziehungen zu suchen.\n"

msgid "Paused - Press Continue to search for more relations"
msgstr "Angehalten – Klicke auf Weiter, um nach weiteren Beziehungen zu suchen"

