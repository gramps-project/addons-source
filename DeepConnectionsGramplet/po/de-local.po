msgid "Deep Connections Gramplet"
msgstr "Tiefe Verbindungen Gramplet"

msgid "Gramplet showing a deep relationship between active and home people"
msgstr ""
"Gramplet, das eine tiefe Beziehung zwischen aktiver und Hauptperson zeigt"

msgid "Deep Connections"
msgstr "Tiefe Verbindungen"

msgid "⏸ Pause"
msgstr "⏸ Pause"

msgid "Pause the current search"
msgstr "Aktuelle Suche pausieren"

msgid "▶ Continue"
msgstr "▶ Fortsetzen"

msgid "Continue searching for more relations"
msgstr "Weiter nach weiteren Beziehungen suchen"

msgid "📋 Copy"
msgstr "📋 Kopieren"

msgid "Copy selected people to clipboard"
msgstr "Ausgewählte Personen in die Zwischenablage kopieren"

msgid "🗑 Clear"
msgstr "🗑 Löschen"

msgid "Clear all results and reset"
msgstr "Alle Ergebnisse löschen und zurücksetzen"

msgid "Ready to search"
msgstr "Bereit für die Suche"

#, python-brace-format
msgid ""
"Search Depth: {depth} | People Processed: {processed} | Queue Size: "
"{queue_size}"
msgstr ""
"Suchtiefe: {depth} | Verarbeitete Personen: {processed} | "
"Warteschlangengröße: {queue_size}"

msgid "mentioned in note"
msgstr "In Notiz erwähnt"

msgid "Note on Family"
msgstr "Notiz zur Familie"

msgid "sibling"
msgstr "Geschwister"

msgid "Note on Parent Family"
msgstr "Notiz zur Elternfamilie"

#, python-format
msgid "%s (association)"
msgstr "%s (Assoziation)"

msgid "Note on Person"
msgstr "Notiz zur Person"

#, python-format
msgid ""
"\n"
"   %s of "
msgstr ""
"\n"
"   %s von "

msgid "Error: No Home Person set"
msgstr "Fehler: Keine Hauptperson festgelegt"

msgid "No Active Person set."
msgstr "Keine aktive Person festgelegt."

msgid "Error: No Active Person set"
msgstr "Fehler: Keine aktive Person festgelegt"

msgid "Initializing search..."
msgstr "Suche wird initialisiert..."

msgid "Looking for relationship between\n"
msgstr "Suche nach Beziehung zwischen\n"

#, python-format
msgid "  <b>%s</b> (Home Person) and\n"
msgstr "  <b>%s</b> (Hauptperson) und\n"

#, python-format
msgid "  <b>%s</b> (Active Person)...\n"
msgstr "  <b>%s</b> (Aktive Person)...\n"

msgid "Searching for connections..."
msgstr "Nach Verbindungen suchen..."

