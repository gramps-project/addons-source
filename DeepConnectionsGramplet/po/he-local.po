msgid "Deep Connections Gramplet"
msgstr "גרמפלט חיבורים עמוקים"

msgid "Gramplet showing a deep relationship between active and home people"
msgstr "גרמפלט שמציג קשר־קרבה עמוקים בין אדם הבית לאדם הפעיל"

msgid "Deep Connections"
msgstr "חיבורים עמוקים"

msgid "⏸ Pause"
msgstr "⏸ השהיה"

msgid "Pause the current search"
msgstr "השהיית החיפוש הנוכחי"

msgid "▶ Continue"
msgstr "▶ המשך"

msgid "Continue searching for more relations"
msgstr "המשך חיפוש קשרי־קרבה נוספים"

msgid "📋 Copy"
msgstr "📋 העתקה"

msgid "Copy selected people to clipboard"
msgstr "העתקת האנשים שנבחרו ללוח־גזירים"

msgid "🗑 Clear"
msgstr "🗑 ניקוי"

msgid "Clear all results and reset"
msgstr "ניקוי כל התוצאות ושיצוב"

msgid "Ready to search"
msgstr "מוכן לחיפוש"

#, python-brace-format
msgid ""
"Search Depth: {depth} | People Processed: {processed} | Queue Size: "
"{queue_size}"
msgstr ""
"עומק חיפוש: {depth} | אנשים שעובדו: {processed} | גודל תור: {queue_size}"

msgid "mentioned in note"
msgstr "אזכור בהערה"

msgid "Note on Family"
msgstr "הערת משפחה"

msgid "sibling"
msgstr "אחאי"

msgid "Note on Parent Family"
msgstr "הערה על משפחת הורה"

#, python-format
msgid "%s (association)"
msgstr "%s (תסמיך)"

msgid "Note on Person"
msgstr "הערת אדם"

#, python-format
msgid ""
"\n"
"   %s of "
msgstr ""
"\n"
"   %s של "

msgid "Error: No Home Person set"
msgstr "שגיאה: לא הוגדר אדם בית"

msgid "No Active Person set."
msgstr "לא הוגדר 'אדם פעיל'."

msgid "Error: No Active Person set"
msgstr "שגיאה: לא הוגדר אדם פעיל"

msgid "Initializing search..."
msgstr "מאתחל חיפוש..."

msgid "Looking for relationship between\n"
msgstr "חיפוש קשרי קרבה בין\n"

#, python-format
msgid "  <b>%s</b> (Home Person) and\n"
msgstr "  <b>%s</b> (אדם הבית) ו\n"

#, python-format
msgid "  <b>%s</b> (Active Person)...\n"
msgstr "  <b>%s</b> (האדם הפעיל)...\n"

msgid "Searching for connections..."
msgstr "מחפש קשרים..."

#, python-format
msgid ""
"Found relation #%d: \n"
"   "
msgstr ""
"נמצא #%d:  קשר משפחה \n"
"   "

msgid ""
"Paused.\n"
"Press Continue to search for additional relations.\n"
msgstr ""
"מושהה.\n"
"נא ללחוץ על 'להמשיך לחפש' לקשרי־קרבה נוספים.\n"

msgid "Paused - Press Continue to search for more relations"
msgstr "מושהה - יש להקיש המשך כדי לחפש קשרי־קרבה נוספים"

#, python-format
msgid ""
"\n"
"Search completed. %d relation paths found."
msgstr ""
"\n"
"החיפוש הושלם. נמצאו %d נתיבי קשרי־קרבה."

msgid "Search completed - {} relation paths found"
msgstr "החיפוש הושלם - נמצאו {} נתיבי קשרי־קרבה"

msgid "Error during search: {}"
msgstr "שגיאה במהלך חיפוש: {}"

msgid "Resuming search..."
msgstr "מחדש חיפוש..."

msgid "Search interrupted by user"
msgstr "החיפוש הופסק על ידי המשתמש"
