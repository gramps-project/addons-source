msgid ""
"Found relation #%d: \n"
"   "
msgstr ""
"Nalezen vztah č. %d: \n"
"   "

msgid ""
"Paused.\n"
"Press Continue to search for additional relations.\n"
msgstr ""
"Pozastaveno.\n"
"Stisknutím Pokračovat vyhledáte další vztahy.\n"

msgid "Paused - Press Continue to search for more relations"
msgstr "Pozastaveno – stisknutím Pokračovat vyhledáte další vztahy"

msgid "Error: No Home Person set"
msgstr "Chyba: není nastavena výchozí osoba"

