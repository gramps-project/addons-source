#, python-brace-format
msgid ""
"Search Depth: {depth} | People Processed: {processed} | Queue Size: "
"{queue_size}"
msgstr ""
"Hloubka hledání: {depth} | Zpracované osoby: {processed} | Velikost fronty: "
"{queue_size}"

#, python-format
msgid ""
"\n"
"   %s of "
msgstr ""
"\n"
"   %s; ve vztahu k osobě: "

