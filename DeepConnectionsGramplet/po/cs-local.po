msgid "Deep Connections Gramplet"
msgstr "Gramplet vzdálených vazeb"

msgid "Gramplet showing a deep relationship between active and home people"
msgstr "Gramplet zobrazující vzdálené vazby mezi aktivní a výchozí osobou"

msgid "Deep Connections"
msgstr "Vzdálené vazby"

msgid "sibling"
msgstr "sourozenec"

msgid "mentioned in note"
msgstr "zmínka v poznámce"

#, python-format
msgid "%s (association)"
msgstr "%s (asociace)"

msgid "⏸ Pause"
msgstr "⏸ Pozastavit"

msgid "Pause the current search"
msgstr "Pozastavit aktuální hledání"

msgid "▶ Continue"
msgstr "▶ Pokračovat"

msgid "Continue searching for more relations"
msgstr "Pokračovat v hledání dalších vztahů"

msgid "📋 Copy"
msgstr "📋 Kopírovat"

msgid "Copy selected people to clipboard"
msgstr "Kopírovat vybrané osoby do schránky"

msgid "🗑 Clear"
msgstr "🗑 Vymazat"

msgid "Clear all results and reset"
msgstr "Vymazat všechny výsledky a obnovit výchozí stav"

