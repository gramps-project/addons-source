msgid "Deep Connections Gramplet"
msgstr "ディープコネクション グランプレット"

msgid "Gramplet showing a deep relationship between active and home people"
msgstr "アクティブな人とホームパーソンの間の深い関係を表示するグランプレット"

msgid "Deep Connections"
msgstr "ディープコネクション"

msgid "⏸ Pause"
msgstr "⏸ 一時停止"

msgid "Pause the current search"
msgstr "現在の検索を一時停止"

msgid "▶ Continue"
msgstr "▶ 続行"

msgid "Continue searching for more relations"
msgstr "より多くの関係を検索し続ける"

msgid "📋 Copy"
msgstr "📋 コピー"

msgid "Copy selected people to clipboard"
msgstr "選択した人物をクリップボードにコピー"

msgid "🗑 Clear"
msgstr "🗑 クリア"

msgid "Clear all results and reset"
msgstr "すべての結果をクリアしてリセット"

msgid "Ready to search"
msgstr "検索準備完了"

#, python-brace-format
msgid ""
"Search Depth: {depth} | People Processed: {processed} | Queue Size: "
"{queue_size}"
msgstr ""
"検索深度: {depth} | 処理済み人物: {processed} | キューサイズ: {queue_size}"

msgid "mentioned in note"
msgstr "メモ内で言及"

msgid "Note on Family"
msgstr "家族に関するメモ"

msgid "sibling"
msgstr "兄弟姉妹"

msgid "Note on Parent Family"
msgstr "親家族に関するメモ"

#, python-format
msgid "%s (association)"
msgstr "%s (関連付け)"

msgid "Note on Person"
msgstr "人物に関するメモ"

#, python-format
msgid ""
"\n"
"   %s of "
msgstr ""
"\n"
"   %s の "

msgid "Error: No Home Person set"
msgstr "エラー: ホームパーソンが設定されていません"

msgid "No Active Person set."
msgstr "アクティブな人が設定されていません。"

msgid "Error: No Active Person set"
msgstr "エラー: アクティブな人物が設定されていません"

msgid "Initializing search..."
msgstr "検索を初期化中..."

msgid "Looking for relationship between\n"
msgstr "間の関係を検索中\n"

#, python-format
msgid "  <b>%s</b> (Home Person) and\n"
msgstr "  <b>%s</b> (ホームパーソン) と\n"

#, python-format
msgid "  <b>%s</b> (Active Person)...\n"
msgstr "  <b>%s</b> (アクティブな人)...\n"

msgid "Searching for connections..."
msgstr "接続を検索中..."

#, python-format
msgid ""
"Found relation #%d: \n"
"   "
msgstr ""
"関係 #%d を発見: \n"
"   "

msgid ""
"Paused.\n"
"Press Continue to search for additional relations.\n"
msgstr ""
"一時停止中。\n"
"続行を押して追加の関係を検索します。\n"

msgid "Paused - Press Continue to search for more relations"
msgstr "一時停止中 - 続行を押してより多くの関係を検索"

#, python-format
msgid ""
"\n"
"Search completed. %d relation paths found."
msgstr ""
"\n"
"検索が完了しました。%d 件の関係パスが見つかりました。"

msgid "Search completed - {} relation paths found"
msgstr "検索完了 - {} 件の関係パスが見つかりました"

msgid "Error during search: {}"
msgstr "検索中にエラーが発生しました: {}"

msgid "Resuming search..."
msgstr "検索を再開しています..."

msgid "Search interrupted by user"
msgstr "ユーザーによって検索が中断されました"
