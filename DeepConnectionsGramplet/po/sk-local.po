msgid "Deep Connections Gramplet"
msgstr "Gramplet Hlboké vzťahy"

msgid "Gramplet showing a deep relationship between active and home people"
msgstr "Gramplet zobrazujúci hlboký vzťah medzi aktívnymi a domovskými osobami"

msgid "Deep Connections"
msgstr "Hlbšie vzťahy"

msgid "⏸ Pause"
msgstr "⏸ Pozastaviť"

msgid "Pause the current search"
msgstr "Pozastavte aktuálne vyhľadávanie"

msgid "▶ Continue"
msgstr "▶ Pokračovať"

msgid "Continue searching for more relations"
msgstr "Pokračujte vo vyhľadávaní ďalších vzťahov"

msgid "📋 Copy"
msgstr "📋 Kopírovať"

msgid "Copy selected people to clipboard"
msgstr "Kopírujte vybraných ľudí do schránky"

msgid "🗑 Clear"
msgstr "🗑 Vyčistiť"

msgid "Clear all results and reset"
msgstr "Vyčistí všetky výsledky a resetuje"

msgid "Ready to search"
msgstr "Pripravený na vyhľadávanie"

#, python-brace-format
msgid ""
"Search Depth: {depth} | People Processed: {processed} | Queue Size: "
"{queue_size}"
msgstr ""
"Hĺbka vyhľadávania: {depth} | Spracovaných osôb: {processed} | Veľkosť "
"fronty: {queue_size}"

msgid "mentioned in note"
msgstr "spomenutý/á v poznámke"

msgid "Note on Family"
msgstr "Poznámka k rodine"

msgid "sibling"
msgstr "súrodenec"

msgid "Note on Parent Family"
msgstr "Poznámka k rodičovskej rodine"

#, python-format
msgid "%s (association)"
msgstr "%s (asociácia)"

msgid "Note on Person"
msgstr "Poznámka k osobe"

#, python-format
msgid ""
"\n"
"   %s of "
msgstr ""
"\n"
"   %s osoby "

msgid "Error: No Home Person set"
msgstr "Chyba: Nie je nastavená domovská osoba"

msgid "No Active Person set."
msgstr "Nie je nastavená aktívna osoba."

msgid "Error: No Active Person set"
msgstr "Chyba: Nie je nastavená aktívna osoba"

msgid "Initializing search..."
msgstr "Inicializácia vyhľadávania..."

msgid "Looking for relationship between\n"
msgstr "Vyhľadávanie vzťahu medzi\n"

#, python-format
msgid "  <b>%s</b> (Home Person) and\n"
msgstr "  <b>%s</b> (Domovská osoba) a\n"

#, python-format
msgid "  <b>%s</b> (Active Person)...\n"
msgstr "  <b>%s</b> (Aktívna osoba)...\n"

msgid "Searching for connections..."
msgstr "Vyhľadávanie prepojení..."

#, python-format
msgid ""
"Found relation #%d: \n"
"   "
msgstr ""
"Nájdený vzťah #%d: \n"
"   "

msgid ""
"Paused.\n"
"Press Continue to search for additional relations.\n"
msgstr ""
"Pozastavené.\n"
"Pre hľadanie dodatočných vzťahov stlačte Pokračovať.\n"

msgid "Paused - Press Continue to search for more relations"
msgstr "Pozastavené - Pre hľadanie ďalšich vzťahov stlačte Pokračovať."

#, python-format
msgid ""
"\n"
"Search completed. %d relation paths found."
msgstr ""
"\n"
"Hľadanie ukončené. Nájdené vzťahové cesty v počte %d."

msgid "Search completed - {} relation paths found"
msgstr "Hľadanie ukončené - nájdené vzťahové cesty {}"

msgid "Error during search: {}"
msgstr "Chyba počas vyhľadávania: {}"

msgid "Resuming search..."
msgstr "Pokračovanie vo vyhľadávaní..."

msgid "Search interrupted by user"
msgstr "Vyhľadávanie prerušené používateľom"
