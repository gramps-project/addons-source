msgid "⏸ Pause"
msgstr "⏸ Pausa"

msgid "Pause the current search"
msgstr "Metti in pausa la ricerca attuale"

msgid "▶ Continue"
msgstr "▶ Continua"

msgid "Continue searching for more relations"
msgstr "Continua a cercare altre relazioni"

msgid "📋 Copy"
msgstr "📋 Copia"

msgid "Copy selected people to clipboard"
msgstr "Copiare la persona selezionata negli appunti"

msgid "🗑 Clear"
msgstr "🗑 Pulisci"

msgid "Clear all results and reset"
msgstr "Pulisce tutti i risultati e reimposta"

msgid "Ready to search"
msgstr "Pronto per cercare"

#, python-brace-format
msgid ""
"Search Depth: {depth} | People Processed: {processed} | Queue Size: "
"{queue_size}"
msgstr ""
"Profondità della ricerca: {depth} | Persone elaborate: {processed} | "
"Dimensione della coda: {queue_size}"

msgid "mentioned in note"
msgstr "menzionato nelle note"

msgid "Note on Family"
msgstr "Nota sulla famiglia"

msgid "sibling"
msgstr "fratello o sorella"

msgid "Note on Parent Family"
msgstr "Nota sulla famiglia dei genitori"

