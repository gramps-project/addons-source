msgid "Avatar Generator Tool"
msgstr "Avatar Oluşturma Aracı"

msgid "A tool to add avatar pictures to your family tree"
msgstr "Aile ağacınıza avatar resimleri eklemek için bir araç"

msgid "single image mode"
msgstr "tek resim modu"

msgid "Choose how many images you'd like to use."
msgstr "Kullanmak istediğiniz resim sayısını seçin."

msgid "Image for people with unknown gender."
msgstr "Cinsiyeti bilinmeyen kişiler için resim."

msgid "Image for males."
msgstr "Erkekler için resim."

msgid "Image for females"
msgstr "Kadınlar için resim"

msgid "Select filter to restrict people"
msgstr "İnsanları listelemek için filtreyi seçin"

msgid "Remove images from people"
msgstr "Kişilerden resimleri kaldır"

msgid "Remove selected image(s)."
msgstr "Seçilen resim(ler)i kaldır."

msgid "Avatar Generator"
msgstr "Avatar Oluşturucu"

msgid "Remove avatar images..."
msgstr "Avatar resimlerini kaldır..."

msgid "INFO"
msgstr "BİLGİ"

msgid "No media was removed."
msgstr "Hiçbir medya kaldırılmadı."

msgid "{} media references were removed from {} persons."
msgstr "{} kişiden {} medya referansı kaldırıldı."

msgid ""
"\n"
"{} HandleError occured, but were ignored."
msgstr ""
"\n"
"{} HandleError hatası oluştu, ancak göz ardı edildi."

msgid "Add avatar images..."
msgstr "Avatar resimleri ekle..."

msgid "{} avatar images were sucessfully added."
msgstr "{} avatar resmi başarıyla eklendi."

msgid "There was no avatar image to add. "
msgstr "Eklenecek avatar resmi yoktu. "

msgid "All persons already had one."
msgstr "Tüm kişilerin zaten bir avatarı vardı."
