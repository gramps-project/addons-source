msgid "Avatar Generator Tool"
msgstr "Nástroj pro vytváření avatarů"

msgid "A tool to add avatar pictures to your family tree"
msgstr "Nástroj pro přidávání obrázků avatarů do rodokmenu"

msgid "single image mode"
msgstr "režim jednoho obrázku"

msgid "Choose how many images you'd like to use."
msgstr "Vyberte, kolik obrázků chcete použít."

msgid "Image for people with unknown gender."
msgstr "Obrázek pro osoby neznámého pohlaví."

msgid "Image for males."
msgstr "Obrázek pro muže."

msgid "Image for females"
msgstr "Obrázek pro ženy"

msgid "Select filter to restrict people"
msgstr "Vyberte filtr pro omezení osob"

msgid "Remove images from people"
msgstr "Odebrat osobám obrázky"

msgid "Remove selected image(s)."
msgstr "Odebrat vybrané obrázky."

msgid "Avatar Generator"
msgstr "Generátor avatarů"

msgid "Remove avatar images..."
msgstr "Odebírání obrázků avatarů..."

msgid "INFO"
msgstr "INFORMACE"

msgid "No media was removed."
msgstr "Nebyla odebrána žádná média."

#, python-brace-format
msgid "{} media references were removed from {} persons."
msgstr "Počet odebraných odkazů na média: {}; počet osob: {}."

#, python-brace-format
msgid ""
"\n"
"{} HandleError occured, but were ignored."
msgstr ""
"\n"
"Počet ignorovaných chyb HandleError: {}."

msgid "Add avatar images..."
msgstr "Přidávání obrázků avatarů..."

#, python-brace-format
msgid "{} avatar images were sucessfully added."
msgstr "Počet úspěšně přidaných obrázků avatarů: {}."

msgid "There was no avatar image to add. "
msgstr "Nebyl k dispozici žádný obrázek avataru k přidání. "

msgid "All persons already had one."
msgstr "Všechny osoby už jeden měly."
