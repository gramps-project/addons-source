msgid "Avatar Generator Tool"
msgstr "Narzędzie generatora awatarów"

msgid "A tool to add avatar pictures to your family tree"
msgstr ""
"Narzędzie do dodawania obrazów awatarów do Twojego drzewa genealogicznego"

msgid "single image mode"
msgstr "tryb pojedynczego obrazu"

msgid "Choose how many images you'd like to use."
msgstr "Wybierz, ile obrazów chcesz użyć."

msgid "Image for people with unknown gender."
msgstr "Obraz dla osób o nieznanej płci."

msgid "Image for males."
msgstr "Obraz reprezentujący mężczyzn."

msgid "Image for females"
msgstr "Obraz reprezentujący kobiety"

msgid "Select filter to restrict people"
msgstr "Wybierz filtr, aby ograniczyć listę osób"

msgid "Remove images from people"
msgstr "Usuń obrazy przypisane do osób"

msgid "Remove selected image(s)."
msgstr "Usuń wybrany(-e) obraz(y)."

msgid "Avatar Generator"
msgstr "Generator awatarów"

msgid "Remove avatar images..."
msgstr "Usuwanie obrazów awatarów..."

msgid "INFO"
msgstr "Informacje"

msgid "No media was removed."
msgstr "Żaden nośnik nie został usunięty."

#, python-brace-format
msgid "{} media references were removed from {} persons."
msgstr "usunięto {} odwołań do mediów od {} osób."

#, python-brace-format
msgid ""
"\n"
"{} HandleError occured, but were ignored."
msgstr ""
"\n"
"{} HandleError wystąpił ale został zignorowany."

msgid "Add avatar images..."
msgstr "Dodaj obrazy awatarów..."

#, python-brace-format
msgid "{} avatar images were sucessfully added."
msgstr "Pomyślnie dodano {} obrazów awatarów."

msgid "There was no avatar image to add. "
msgstr "Nie było obrazu awatara do dodania. "

msgid "All persons already had one."
msgstr "Wszystkie osoby już miały awatar."
