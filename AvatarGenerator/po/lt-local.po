msgid "Avatar Generator Tool"
msgstr "Personažo kūrimo įrankis"

msgid "A tool to add avatar pictures to your family tree"
msgstr "Įrankis, skirtas personažo nuotraukoms pridėti prie šeimos medžio"

msgid "single image mode"
msgstr "vieno atvaizdo veiksena"

msgid "Choose how many images you'd like to use."
msgstr "Pasirinkite, kiek atvaizdų norite naudoti."

msgid "Image for people with unknown gender."
msgstr "Atvaizdas asmenims su nežinoma lytimi."

msgid "Image for males."
msgstr "Atvaizdas vyrams"

msgid "Image for females"
msgstr "Atvaizdas moterims"

msgid "Select filter to restrict people"
msgstr "Pasirinkite filtrą asmenų apribojimui"

msgid "Remove images from people"
msgstr "Pašalinti asmenų atvaizdus"

msgid "Remove selected image(s)."
msgstr "Pašalinti pasirinktus atvaizdus."

msgid "Avatar Generator"
msgstr "Personažo kūrimas"

msgid "Remove avatar images..."
msgstr "Pašalinti personažo atvaizdus..."

msgid "{} media references were removed from {} persons."
msgstr "{} medijos nuorodos buvo pašalintos iš {} asmenų."

msgid ""
"\n"
"{} HandleError occured, but were ignored."
msgstr ""
"\n"
"Įvyko {} HandleError klaida, bet buvo nepaisoma."

msgid "Add avatar images..."
msgstr "Pridėti personažo atvaizdus..."

msgid "{} avatar images were sucessfully added."
msgstr "{} personažo atvaizdai buvo sėkmingai pridėti."

msgid "There was no avatar image to add. "
msgstr "Pridėjimui nėra jokio personažo atvaizdo. "

msgid "All persons already had one."
msgstr "Visi asmenys po vieną jau turėjo."
