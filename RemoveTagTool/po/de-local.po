msgstr "FEHLER"

msgid "Add/Remove"
msgstr "Hinzufügen/Entfernen"

msgid "Add or remove tags from objects."
msgstr "Etiketten zu Objekten hinzufügen oder entfernen."

msgid "Add Tags"
msgstr "Etiketten hinzufügen"

msgid "Remove Tags"
msgstr "Etiketten entfernen"

msgid "General options"
msgstr "Allgemeine Optionen"

msgid "Choose a category."
msgstr "Wähle eine Kategorie aus."

msgid "Choose Tag"
msgstr "Etikett auswählen"

msgid "Choose a tag to remove."
msgstr "Wähle ein Etikett zum Entfernen aus."

