msgid "All %s"
msgstr "Alle %s"

msgid "Add/Remove Tag Tool"
msgstr "Hinzufügen/Entfernen von Etiketten-Werkzeug"

msgid ""
"Unable to run the tool. Please check if your database contains tags, filters "
"and objects."
msgstr ""
"Das Werkzeug kann nicht ausgeführt werden. Bitte überprüfe, ob deine "
"Datenbank Etiketten, Filter und Objekte enthält."

msgid "WARNING"
msgstr "WARNUNG"

#, python-format
msgid "No %s objects were found in database."
msgstr "Es wurden keine %s-Objekte in der Datenbank gefunden."

msgid "Process tags..."
msgstr "Verarbeite Etiketten..."

msgid "added"
msgstr "hinzugefügt"

msgid "removed"
msgstr "entfernt"

#, python-brace-format
msgid "Tag '{}' was {} to {} {} objects.\n"
msgstr "Das Etikett „{}“ war {} zu {} {} Objekten.\n"

