msgid "The Tool requires at least one tag to execute."
msgstr "このツールを実行するには少なくとも1つのタグが必要です。"

msgid "ERROR"
msgstr "エラー"

msgid "Add/Remove"
msgstr "追加/削除"

msgid "Add or remove tags from objects."
msgstr "オブジェクトにタグを追加または削除します。"

msgid "Add Tags"
msgstr "タグを追加"

msgid "Remove Tags"
msgstr "タグを削除"

msgid "General options"
msgstr "全般オプション"

msgid "Choose a category."
msgstr "カテゴリを選択してください。"

msgid "Choose Tag"
msgstr "タグを選択"

msgid "Choose a tag to remove."
msgstr "削除するタグを選択してください。"

msgid "Persons"
msgstr "人物"

msgid "Filter options"
msgstr "フィルターオプション"

#, python-format
msgid "All %s"
msgstr "すべての %s"

msgid "Add/Remove Tag Tool"
msgstr "タグ追加/削除ツール"

msgid ""
"Unable to run the tool. Please check if your database contains tags, filters "
"and objects."
msgstr ""
"ツールを実行できません。データベースにタグ、フィルター、オブジェクトが含まれ"
"ているか確認してください。"

msgid "WARNING"
msgstr "警告"

#, python-format
msgid "No %s objects were found in database."
msgstr "データベースに %s オブジェクトが見つかりませんでした。"

msgid "Process tags..."
msgstr "タグを処理中..."

msgid "added"
msgstr "追加されました"

msgid "removed"
msgstr "削除されました"

msgid "Tag '{}' was {} to {} {} objects.\n"
msgstr "タグ '{}' は {} 個の {} オブジェクトに {} されました。\n"

msgid "INFO"
msgstr "INFO"

msgid "Add or remove a tag from groups of people, events, etc."
msgstr "人物、イベントなどのグループにタグを追加または削除します。"
