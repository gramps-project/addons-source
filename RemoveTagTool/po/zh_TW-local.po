msgid "The Tool requires at least one tag to execute."
msgstr "執行此工具至少需要一個標籤。"

msgid "ERROR"
msgstr "錯誤"

msgid "Add/Remove"
msgstr "新增／移除"

msgid "Add or remove tags from objects."
msgstr "為物件新增或移除標籤。"

msgid "Add Tags"
msgstr "新增標籤"

msgid "Remove Tags"
msgstr "移除標籤"

msgid "General options"
msgstr "一般選項"

msgid "Choose a category."
msgstr "選擇類別。"

