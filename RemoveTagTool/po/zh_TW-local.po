msgstr "新增／移除標籤工具"

msgid ""
"Unable to run the tool. Please check if your database contains tags, filters "
"and objects."
msgstr "無法執行此工具。請檢查您的資料庫是否包含標籤、篩選器和物件。"

msgid "WARNING"
msgstr "警告"

