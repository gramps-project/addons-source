msgid "The Tool requires at least one tag to execute."
msgstr "הכלי דורש תג אחד לפחות להפעלה."

msgid "ERROR"
msgstr "שגיאה"

msgid "Add/Remove"
msgstr "הוספה/הסרה"

msgid "Add or remove tags from objects."
msgstr "הוספה או הסרה של תגים מעצמים."

msgid "Add Tags"
msgstr "הוספה תגים"

msgid "Remove Tags"
msgstr "הסרה תגים"

msgid "General options"
msgstr "אפשרויות כלליות"

msgid "Choose a category."
msgstr "בחירת סוג־אב."

msgid "Choose Tag"
msgstr "בתירת תג"

msgid "Choose a tag to remove."
msgstr "בחירת תג להסרה."

msgid "Persons"
msgstr "אנשים"

msgid "Filter options"
msgstr "אפשרויות סינון"

#, python-format
msgid "All %s"
msgstr "כל %s"

msgid "Add/Remove Tag Tool"
msgstr "כלי הוספה/הסרה של תג"

msgid ""
"Unable to run the tool. Please check if your database contains tags, filters "
"and objects."
msgstr ""
"לא ניתן להריץ את הכלי. נא לבדוק אם מסד־הנתונים מכיל תגים, מסננים ועצמים."

msgid "WARNING"
msgstr "אזהרה"

#, python-format
msgid "No %s objects were found in database."
msgstr "אין %s עצמים היו נמצאו במסד־נתונים."

msgid "Process tags..."
msgstr "עיבוד תגים..."

msgid "added"
msgstr "נוסף"

msgid "removed"
msgstr "הוסר"

msgid "Tag '{}' was {} to {} {} objects.\n"
msgstr "התג '{}' היה {} ל־{} {} עצמים.\n"

msgid "INFO"
msgstr "מידע"

msgid "Add or remove a tag from groups of people, events, etc."
msgstr "הוספה או הסרה של תג מקבוצות אנשים, אירועים ועוד."
