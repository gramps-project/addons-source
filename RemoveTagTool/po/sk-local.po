msgid "The Tool requires at least one tag to execute."
msgstr "Nástroj vyžaduje na spustenie aspoň jeden štítok."

msgid "ERROR"
msgstr "CHYBA"

msgid "Add/Remove"
msgstr "Pridať/Odstrániť"

msgid "Add or remove tags from objects."
msgstr "Pridajte alebo odstráňte štítky z objektov."

msgid "Add Tags"
msgstr "Pridať štítky"

msgid "Remove Tags"
msgstr "Odstrániť štítky"

msgid "General options"
msgstr "Všeobecné voľby"

msgid "Choose a category."
msgstr "Vyberte kategóriu."

msgid "Choose Tag"
msgstr "Vybrať štítok"

msgid "Choose a tag to remove."
msgstr "Vyberte štítok na odstránenie."

msgid "Persons"
msgstr "Osoby"

msgid "Filter options"
msgstr "Voľby filtra"

#, python-format
msgid "All %s"
msgstr "Všetky %s"

msgid "Add/Remove Tag Tool"
msgstr "Nástroj na pridanie/odstránenie štítkov"

msgid ""
"Unable to run the tool. Please check if your database contains tags, filters "
"and objects."
msgstr ""
"Nástroj sa nedá spustiť. Skontrolujte, či vaša databáza obsahuje štítky, "
"filtre a objekty."

msgid "WARNING"
msgstr "UPOZORNENIE"

#, python-format
msgid "No %s objects were found in database."
msgstr "V databáze neboli nájdené žiadne objekty %s."

msgid "Process tags..."
msgstr "Spracovanie štítkov..."

msgid "added"
msgstr "pridané"

msgid "removed"
msgstr "odstránené"

msgid "Tag '{}' was {} to {} {} objects.\n"
msgstr "Štítok '{}' bol {} k {} {} objektom.\n"

msgid "INFO"
msgstr "INFO"

msgid "Add or remove a tag from groups of people, events, etc."
msgstr "Pridajte alebo odstráňte štítok zo skupín ľudí, udalostí atď."
