msgid "The Tool requires at least one tag to execute."
msgstr "Ke spuštění nástroje je potřeba alespoň jeden štítek."

msgid "ERROR"
msgstr "CHYBA"

msgid "Add/Remove"
msgstr "Přidat/Odebrat"

msgid "Add or remove tags from objects."
msgstr "Přidat nebo odebrat štítky objektům."

msgid "Add Tags"
msgstr "Přidat štítky"

msgid "Remove Tags"
msgstr "Odebrat štítky"

msgid "General options"
msgstr "Obecné možnosti"

msgid "Choose a category."
msgstr "Vyberte kategorii."

msgid "Choose Tag"
msgstr "Vybrat štítek"

msgid "Choose a tag to remove."
msgstr "Vyberte štítek, který chcete odebrat."

msgid "Persons"
msgstr "Osoby"

msgid "Filter options"
msgstr "Nastavení filtrů"

#, python-format
msgid "All %s"
msgstr "Vše: %s"

msgid "Add/Remove Tag Tool"
msgstr "Nástroj pro přidávání a odstraňování štítků"

msgid ""
"Unable to run the tool. Please check if your database contains tags, filters "
"and objects."
msgstr ""
"Nástroj nelze spustit. Zkontrolujte, zda databáze obsahuje štítky, filtry a "
"objekty."

msgid "WARNING"
msgstr "VAROVÁNÍ"

#, python-format
msgid "No %s objects were found in database."
msgstr "V databázi nebyly nalezeny žádné objekty %s."

msgid "Process tags..."
msgstr "Zpracovat štítky..."

msgid "added"
msgstr "přidán"

msgid "removed"
msgstr "odebrán"

#, python-brace-format
msgid "Tag '{}' was {} to {} {} objects.\n"
msgstr "Štítek '{}' byl {} u objektů (počet: {}, typ: {}).\n"

msgid "INFO"
msgstr "INFORMACE"

msgid "Add or remove a tag from groups of people, events, etc."
msgstr "Přidat nebo odebrat štítek skupinám osob, událostí atd."
