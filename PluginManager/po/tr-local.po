msgid "Plugin Manager Enhanced"
msgstr "Gelişmiş Eklenti Yöneticisi"

msgid "An Addon/Plugin Manager with several additional capabilities"
msgstr "Çeşitli ek yeteneklere sahip bir Eklenti/Yazılım Eklentisi Yöneticisi"

msgid "Plugin Manager - Enhanced"
msgstr "Eklenti Yöneticisi - Gelişmiş"

msgid ""
"Enter search words to filter the addons.\n"
"All the words must be present somewhere in the row or\n"
"the addon filename to be included in the search.\n"
"Word case and order is ignored."
msgstr ""
"Eklentileri filtrelemek için arama kelimeleri girin.\n"
"Aramaya dahil edilecek tüm kelimelerin satırda veya\n"
"eklenti dosya adında bir yerde bulunması gerekir.\n"
"Kelime büyük/küçük harf ve sıra dikkate alınmaz."

msgid "Search..."
msgstr "Ara..."

msgid "Restart..."
msgstr "Yeniden başlat..."

msgid ""
"Please Restart Gramps so that your addon changes can be safely completed."
msgstr ""
"Eklenti değişikliklerinizin güvenli bir şekilde tamamlanabilmesi için lütfen "
"Gramps'i yeniden başlatın."

#, python-format
msgid "Error removing the '%s' directory, The uninstall may have failed"
msgstr ""
"'%s' dizinini kaldırmada hata oluştu, Kaldırma işlemi başarısız olmuş "
"olabilir"

msgid ""
"'*' items are supplied by 3rd party authors,\n"
"<s>strikeout</s> items are hidden"
msgstr ""
"'*' ile işaretlenen öğeler üçüncü taraf geliştiriciler tarafından sağlanır,\n"
"<s>üstü çizili</s> öğeler gizlidir"

msgid "Hide"
msgstr "Gizle"

msgid "Show hidden items"
msgstr "Gizli öğeleri göster"

msgid "Show Built-in items"
msgstr "Yerleşik öğeleri göster"

msgid "* indicates 3rd party addon"
msgstr "* 3. taraf eklentisini gösterir"

msgid "Plugins"
msgstr "Eklentiler"

msgid "Unhide"
msgstr "Gizliliği kaldır"

msgid "Uninstall"
msgstr "Kaldır"

msgid "*Available"
msgstr "*Kullanılabilir"

msgid "Built-in"
msgstr "Yerleşik"

msgid "*Installed"
msgstr "*Yüklü"

msgid "Update Available"
msgstr "Güncelleme mevcut"
