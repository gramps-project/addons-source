msgid "Plugin Manager Enhanced"
msgstr "Rozšířený správce zásuvných modulů"

msgid "An Addon/Plugin Manager with several additional capabilities"
msgstr "Správce rozšíření a zásuvných modulů s několika dalšími možnostmi"

msgid "Plugin Manager - Enhanced"
msgstr "Správce zásuvných modulů – rozšířený"

msgid ""
"Enter search words to filter the addons.\n"
"All the words must be present somewhere in the row or\n"
"the addon filename to be included in the search.\n"
"Word case and order is ignored."
msgstr ""
"Zadejte hledaná slova pro filtrování rozšíření.\n"
"Všechna slova musí být obsažena někde v řádku nebo\n"
"v názvu souboru rozšíření, aby bylo zahrnuto do výsledků.\n"
"Na velikosti písmen ani pořadí slov nezáleží."

msgid "Search..."
msgstr "Hledat..."

msgid "Restart..."
msgstr "Restartovat..."

msgid ""
"Please Restart Gramps so that your addon changes can be safely completed."
msgstr "Restartujte Gramps, aby mohly být bezpečně dokončeny změny rozšíření."

#, python-format
msgid "Error removing the '%s' directory, The uninstall may have failed"
msgstr "Chyba při odstraňování adresáře '%s'; odinstalace se možná nezdařila"

msgid ""
"'*' items are supplied by 3rd party authors,\n"
"<s>strikeout</s> items are hidden"
msgstr ""
"Položky označené '*' pocházejí od autorů třetích stran,\n"
"<s>přeškrtnuté</s> položky jsou skryté"

msgid "Hide"
msgstr "Skrýt"

msgid "Show hidden items"
msgstr "Zobrazit skryté položky"

msgid "Show Built-in items"
msgstr "Zobrazit vestavěné položky"

msgid "* indicates 3rd party addon"
msgstr "* označuje rozšíření třetí strany"

msgid "Plugins"
msgstr "Zásuvné moduly"

msgid "Unhide"
msgstr "Zobrazit"

msgid "Uninstall"
msgstr "Odinstalovat"

msgid "*Available"
msgstr "*Dostupné"

msgid "Built-in"
msgstr "Vestavěné"

msgid "*Installed"
msgstr "*Nainstalované"

msgid "Update Available"
msgstr "Je dostupná aktualizace"
