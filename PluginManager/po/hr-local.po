msgid "Plugin Manager Enhanced"
msgstr "Upravljač za dodatake (prošireni)"

msgid "An Addon/Plugin Manager with several additional capabilities"
msgstr "Upravljač za dodatke s nekolicinom dodatnih funkcija"

msgid "Plugin Manager - Enhanced"
msgstr "Upravljač za dodatke – Prošireni"

msgid ""
"Enter search words to filter the addons.\n"
"All the words must be present somewhere in the row or\n"
"the addon filename to be included in the search.\n"
"Word case and order is ignored."
msgstr ""
"Upiši tražene izraze za filtriranje dodataka.\n"
"Da bi se uključile u pretragu, sve se riječi moraju nalaziti negdje\n"
"u retku imenu datoteke dodatka. Veličina slova i redoslijed riječi\n"
"se zanemaruju."

msgid "Search..."
msgstr "Traži …"

msgid "Restart..."
msgstr "Ponovo pokreni Gramps …"

msgid ""
"Please Restart Gramps so that your addon changes can be safely completed."
msgstr ""
"Ponovo pokreni Gramps kako bi se tvoje promjene u dodacima mogle sigurno "
"završiti."

#, python-format
msgid "Error removing the '%s' directory, The uninstall may have failed"
msgstr ""
"Greška prilikom uklanjanja direktorija „%s”. Deinstaliranje možda nije "
"uspjelo"

msgid ""
"'*' items are supplied by 3rd party authors,\n"
"<s>strikeout</s> items are hidden"
msgstr ""
"Stavke s oznakom „*” su dodaci treće strane,\n"
"<s>precrtane</s> stavke su skrivene"

msgid "Hide"
msgstr "Sakrij"

msgid "Show hidden items"
msgstr "Prikaži skrivene stavke"

msgid "Show Built-in items"
msgstr "Prikaži ugrađene stavke"

msgid "* indicates 3rd party addon"
msgstr "* ukazuje na dodatak treće strane"

msgid "Plugins"
msgstr "Dodaci"

msgid "Unhide"
msgstr "Prikaži"

msgid "Uninstall"
msgstr "Deinstaliraj"

msgid "*Available"
msgstr "*Dostupno"

msgid "Built-in"
msgstr "Ugrađeno"

msgid "*Installed"
msgstr "*Instalirano"

msgid "Update Available"
msgstr "Dostupna je nova verzija"
