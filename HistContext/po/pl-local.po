msgid "Historical Context"
msgstr "Kontekst historyczny"

msgid "Lists relevant historical events during the lifetime of a Person"
msgstr "Wyświetla istotne wydarzenia historyczne z okresu życia osoby"

msgid "Rows starting with this in the text column will be hidden "
msgstr "Wiersze zaczynające się od tego tekstu będą ukryte "

msgid "Use filter "
msgstr "Użyj filtra "

msgid "Show outside life span "
msgstr "Pokaż poza okresem życia "

msgid "Use full dates"
msgstr "Użyj pełnych dat"

msgid "Foreground color items in lifespan"
msgstr "Kolor pierwszego planu elementów w okresie życia"

msgid "Background color items in lifespan"
msgstr "Kolor tła elementów w okresie życia"

msgid "Foreground color items outside lifespan"
msgstr "Kolor pierwszego planu elementów poza okresem życia"

msgid "Background color items outside lifespan"
msgstr "Kolor tła elementów poza okresem życia"

msgid "Select from files"
msgstr "Wybierz z plików"

msgid "Invalid date "
msgstr "Nieprawidłowa data "

msgid " in line: "
msgstr " w linii: "

msgid "Error:"
msgstr "Błąd:"

msgid ": line does not contain four sections separated by semicolons in : \""
msgstr ": linia nie zawiera czterech sekcji oddzielonych średnikami w: \""

msgid "Cannot open URL: "
msgstr "Nie można otworzyć adresu URL: "

msgid "Double click row to follow link"
msgstr "Kliknij dwukrotnie wiersz, aby przejść do łącza"
