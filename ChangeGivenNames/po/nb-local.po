msgid "Fix Capitalization of Given Names"
msgstr "Rett store og små bokstaver i fornavn"

msgid ""
"Searches the entire database and attempts to fix capitalization of the given "
"names."
msgstr ""
"Søker gjennom hele databasen og forsøker å rette store og små bokstaver i "
"fornavnene."

msgid "manual|Fix_Capitalization_of_Given_Names..."
msgstr "manual|Fix_Capitalization_of_Given_Names..."

msgid "Checking Given Names"
msgstr "Kontrollerer fornavn"

msgid "Searching given names"
msgstr "Søker etter fornavn"

msgid "Affected Names"
msgstr "Berørte navn"

msgid ""
"Below is a list of the given names that \n"
"Gramps can convert to correct capitalization. \n"
"Select the names you wish Gramps to convert. "
msgstr ""
"Nedenfor er en liste over fornavn som \n"
"Gramps kan endre til riktig bruk av store og små bokstaver. \n"
"Velg navnene du vil at Gramps skal endre. "

msgid "Edit selection"
msgstr "Rediger utvalg"
