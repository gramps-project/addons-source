msgid "Ancestor"
msgstr "אב קדמון"

msgid "The ancestor from which to start the line"
msgstr "האב שממנו יש להתחיל את הקו"

msgid "Descendent"
msgstr "צאצא"

msgid "The descendent to which to build the line"
msgstr "צאצא לש ללבנות שורה"

msgid "The style used for the title of the page."
msgstr "הסגנון שמשמש בכותרת העמוד."

msgid "The style used for the title of a line."
msgstr "הסגנון ששימש לכותרת קו."

#, python-format
msgid "%(line)s. line:"
msgstr "%(line)s. קו:"

#, python-format
msgid "Lines of Descendency from %(ancestor)s to %(descendent)s"
msgstr "קווים של צאצאים מ־%(ancestor)s ל־%(descendent)s"

msgid "Lines of Descendency Report"
msgstr "קווים של צאצאים דוח"

msgid ""
"Prints out all descendency lines from a given ancestor to a given descendent "
"in text."
msgstr "הדפסת כל קווי הצאצאות מאב נתון לצאצא נתון במלל."
