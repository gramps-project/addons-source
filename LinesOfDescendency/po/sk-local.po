msgid "Ancestor"
msgstr "Predok"

msgid "The ancestor from which to start the line"
msgstr "Predok, od ktorého sa má začať línia"

msgid "Descendent"
msgstr "Potomok"

msgid "The descendent to which to build the line"
msgstr "Potomok, ku ktorému sa má línia zostaviť"

msgid "The style used for the title of the page."
msgstr "Štýl použitý pre titul strany."

msgid "The style used for the title of a line."
msgstr "Štýl použitý pre názov línie."

#, python-format
msgid "%(line)s. line:"
msgstr "%(line)s. línia:"

#, python-format
msgid "Lines of Descendency from %(ancestor)s to %(descendent)s"
msgstr "Línie potomkov od %(ancestor)s k %(descendent)s"

msgid "Lines of Descendency Report"
msgstr "Správa o líniách potomkov"

msgid ""
"Prints out all descendency lines from a given ancestor to a given descendent "
"in text."
msgstr ""
"Vytlačí všetky línie potomkov od zadaného predka k zadanému potomkovi vo "
"formáte textu."
