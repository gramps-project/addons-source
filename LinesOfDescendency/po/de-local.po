msgid "Ancestor"
msgstr "Vorfahre"

msgid "The ancestor from which to start the line"
msgstr "Der Vorfahr, von dem aus die Linie beginnt"

msgid "Descendent"
msgstr "Nachkomme"

msgid "The descendent to which to build the line"
msgstr "Der Nachkomme, zu dem die Linie aufgebaut werden soll"

msgid "The style used for the title of the page."
msgstr "Der für den Titel der Seite verwendete Stil."

msgid "The style used for the title of a line."
msgstr "Der Stil, der für den Titel einer Linie verwendet wird."

#, python-format
msgid "%(line)s. line:"
msgstr "%(line)s. Linie:"

#, python-format
msgid "Lines of Descendency from %(ancestor)s to %(descendent)s"
msgstr "Abstammungslinien von %(ancestor)s zu %(descendent)s"

msgid "Lines of Descendency Report"
msgstr "Abstammungslinienbericht"

msgid ""
"Prints out all descendency lines from a given ancestor to a given descendent "
"in text."
msgstr ""
"Druckt alle Abstammungslinien von einem bestimmten Vorfahren zu einem "
"bestimmten Nachkommen in Textform aus."
