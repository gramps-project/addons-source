msgid "Ancestor"
msgstr "Esivanhempi"

msgid "The ancestor from which to start the line"
msgstr "Esi-isä, josta linja aloitetaan"

msgid "Descendent"
msgstr "Jälkeläinen"

msgid "The descendent to which to build the line"
msgstr "Jälkeläinen, johon linja rakennetaan"

msgid "The style used for the title of the page."
msgstr "Sivun otsikossa käytetty tyyli."

msgid "The style used for the title of a line."
msgstr "Viivan nimessä käytetty tyyli."

#, python-format
msgid "%(line)s. line:"
msgstr "%(line)s. linja:"

#, python-format
msgid "Lines of Descendency from %(ancestor)s to %(descendent)s"
msgstr "Polveutumislinjat henkilöiden %(ancestor)s ja %(descendent)s välillä"

msgid "Lines of Descendency Report"
msgstr "Jäleläislinjojen raportti"

msgid ""
"Prints out all descendency lines from a given ancestor to a given descendent "
"in text."
msgstr ""
"Tulostaa kaikki jälkeläislinjat tietystä esi-isästä tiettyyn jälkeläiseen "
"tekstinä."
