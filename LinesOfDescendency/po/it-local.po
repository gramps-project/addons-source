msgid "Ancestor"
msgstr "Ascendente"

msgid "The ancestor from which to start the line"
msgstr "L'ascendente da cui far partire la linea"

msgid "Descendent"
msgstr "Discendente"

msgid "The descendent to which to build the line"
msgstr "Il discendente verso cui costruire la linea"

msgid "The style used for the title of the page."
msgstr "Lo stile usato per il titolo della pagina."

msgid "The style used for the title of a line."
msgstr "Lo stile usato per il titolo di una linea."

#, python-format
msgid "%(line)s. line:"
msgstr "%(line)s. linea:"

#, python-format
msgid "Lines of Descendency from %(ancestor)s to %(descendent)s"
msgstr "Linea di discendenza da %(ancestor)s a %(descendent)s"

msgid "Lines of Descendency Report"
msgstr "Resoconto sulle linee di discendenza"

msgid ""
"Prints out all descendency lines from a given ancestor to a given descendent "
"in text."
msgstr ""
"Stampa come testo tutte le linee di discendenza da un certo ascendente a un "
"certo discendente."
