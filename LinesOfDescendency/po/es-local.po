msgid "Ancestor"
msgstr "Ancestro"

msgid "The ancestor from which to start the line"
msgstr "El antepasado a partir del cual iniciar el linaje"

msgid "Descendent"
msgstr "Descendiente"

msgid "The descendent to which to build the line"
msgstr "El descendiente al cual construir el linaje"

msgid "The style used for the title of the page."
msgstr "El estilo utilizado para el título de la página."

msgid "The style used for the title of a line."
msgstr "El estilo utilizado para el título de un linaje."

#, python-format
msgid "%(line)s. line:"
msgstr "%(line)s. linaje:"

#, python-format
msgid "Lines of Descendency from %(ancestor)s to %(descendent)s"
msgstr "Linaje de Descendencia desde %(ancestor)s hasta %(descendent)s"

msgid "Lines of Descendency Report"
msgstr "Líneas de Informe de Descendiente"

msgid ""
"Prints out all descendency lines from a given ancestor to a given descendent "
"in text."
msgstr ""
"Declara fuera todas del líneas descendientes desde un ancestro dado hasta un "
"descendiente dado dentro del texto."
