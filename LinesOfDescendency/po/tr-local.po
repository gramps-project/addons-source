msgid "Ancestor"
msgstr "Atalar"

msgid "The ancestor from which to start the line"
msgstr "Soyun başlangıç noktası olan atası"

msgid "Descendent"
msgstr "Soyundan gelen"

msgid "The descendent to which to build the line"
msgstr "Soyundan gelen ağacını oluşturmak için kullanılacak torun"

msgid "The style used for the title of the page."
msgstr "Sayfa başlığı için kullanılan stil."

msgid "The style used for the title of a line."
msgstr "Bir satırın başlığı için kullanılan stil."

#, python-format
msgid "%(line)s. line:"
msgstr "%(line)s. satır:"

#, python-format
msgid "Lines of Descendency from %(ancestor)s to %(descendent)s"
msgstr "%(ancestor)s > %(descendent)s uzanan soy hatları"

msgid "Lines of Descendency Report"
msgstr "Soy Kütüğü Raporu"

msgid ""
"Prints out all descendency lines from a given ancestor to a given descendent "
"in text."
msgstr ""
"Belirtilen bir atadan belirtilen bir toruna kadar uzanan tüm soy hatlarını "
"metin olarak yazdırır."
