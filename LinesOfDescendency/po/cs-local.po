msgid "Ancestor"
msgstr "Předek"

msgid "The ancestor from which to start the line"
msgstr "Předek, od kterého má linie začínat"

msgid "Descendent"
msgstr "Potomek"

msgid "The descendent to which to build the line"
msgstr "Potomek, ke kterému má linie vést"

msgid "The style used for the title of the page."
msgstr "Styl použitý pro nadpis stránky."

msgid "The style used for the title of a line."
msgstr "Styl použitý pro název linie."

#, python-format
msgid "%(line)s. line:"
msgstr "%(line)s. linie:"

#, python-format
msgid "Lines of Descendency from %(ancestor)s to %(descendent)s"
msgstr "Linie potomků: %(ancestor)s → %(descendent)s"

msgid "Lines of Descendency Report"
msgstr "Sestava linií potomků"

msgid ""
"Prints out all descendency lines from a given ancestor to a given descendent "
"in text."
msgstr ""
"Textově vypíše všechny linie potomků od daného předka k danému potomkovi."
