msgid "People related to <filter>"
msgstr "Osoby spokrewnione z <filtr>"

msgid "Matches people who are related to anybody matched by a person filter"
msgstr "Dopasowuje osoby spokrewnione z każdym, kto pasuje do filtru osób"

msgid "People separated less than <N> degrees of <person>"
msgstr "Osoby oddalone o mniej niż <N> stopni od <osoby>"

msgid "Filter rule that matches relatives by degrees of separation"
msgstr "Reguła filtru dopasowująca krewnych według stopni oddalenia"

msgid "Source matching parameters"
msgstr "Źródło dopasowujące parametry"

msgid "Matches Sources with values containing the chosen parameters"
msgstr "Dopasowuje źródła z wartościami zawierającymi wybrane parametry"

msgid "People with multiple parent records"
msgstr "Osoby z wielokrotnymi zapisami rodziców"

msgid "Matches people who have more than one set of parents"
msgstr "Dopasowuje osoby mające więcej niż jedną parę rodziców"

msgid "Match associations of <person filter>"
msgstr "Dopasuj powiązania <filtr osób>"

msgid "Does NOT match with selected Role"
msgstr "NIE pasuje do wybranej roli"

msgid "Finds the items that don't have event Roles of the selected type."
msgstr "Znajduje elementy, które nie mają ról wydarzeń wybranego typu."

msgid "Inverse"
msgstr "Odwrócenie"

msgid "People with events with the <role>"
msgstr "Osoby z wydarzeniami o roli <role>"

msgid "Matches people with an event with a selected role"
msgstr "Dopasowuje osoby z wydarzeniami o wybranej roli"

msgid "Families with events with the <role>"
msgstr "Rodziny z wydarzeniami o roli <role>"

msgid "Matches families with an event with a selected role"
msgstr "Dopasowuje rodziny z wydarzeniami o wybranej roli"

msgid "Events of families matching a <family filter>"
msgstr "Wydarzenia rodzin pasujących do <filtr rodzin>"

msgid "Families matching <event filter>"
msgstr "Rodziny pasujące do <filtr wydarzeń>"

msgid "Matches families that are matched by an event filter"
msgstr "Dopasowuje rodziny spełniające warunki filtru wydarzeń"

msgid "Matches families matched by an event filter"
msgstr "Dopasowuje rodziny spełniające warunki filtru wydarzeń"

msgid "Number of degrees of separation from person."
msgstr "Liczba stopni oddalenia od osoby."

msgid "Degrees:"
msgstr "Stopnie:"

msgid "People with <count> of <event>"
msgstr "Osoby z <liczba> wystąpień <wydarzenie>"

msgid "Matches persons which have events of given type and number."
msgstr "Dopasowuje osoby mające wydarzenia danego typu i liczby."

msgid "Include Children"
msgstr "Włącz dzieci"

msgid "Include the children in the matching families."
msgstr "Dołącz dzieci do pasujących rodzin."

msgid "Include Parents"
msgstr "Dołącz rodziców"

msgid "Include the parents in the matching families."
msgstr "Dołącz rodziców do pasujących rodzin."

msgid "Family Filter name:"
msgstr "Nazwa filtru rodzin:"

msgid "People who are part of families matching <filter>"
msgstr "Osoby będące częścią rodzin pasujących do <filtr>"

msgid "Filter people by their age at death"
msgstr "Filtruj osoby według wieku w chwili śmierci"

msgid "Filter rule that matches people by their age at death"
msgstr "Reguła filtru dopasowująca osoby według wieku w chwili śmierci"

msgid "Multiple Parents Filter"
msgstr "Filtr wielokrotnych rodziców"

msgid "People with events with a selected role"
msgstr "Osoby z wydarzeniami o wybranej roli"

msgid "Families with events with a selected role"
msgstr "Rodziny z wydarzeniami o wybranej roli"

msgid "The active Person"
msgstr "Aktywna osoba"

msgid "Matches sources with a particular value"
msgstr "Dopasowuje źródła o określonej wartości"

msgid "Active person"
msgstr "Aktywna osoba"

msgid "Matches the active person"
msgstr "Dopasowuje się do aktywnej osoby"

msgid "Age in years at person's death."
msgstr "Wiek w latach w chwili śmierci osoby."

msgid "Age:"
msgstr "Wiek:"
