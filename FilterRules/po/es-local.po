msgid "People related to <filter>"
msgstr "Personas relacionadas con <filtro>"

msgid "Matches people who are related to anybody matched by a person filter"
msgstr ""
"Encuentra personas que estén relacionadas con cualquier persona que haya "
"sido seleccionada mediante un filtro de personas"

msgid "People separated less than <N> degrees of <person>"
msgstr "Persona menos separada que <N> grados de <persona>"

msgid "Filter rule that matches relatives by degrees of separation"
msgstr "Regla de filtro que coincide relativas por grados de separación"

msgid "Source matching parameters"
msgstr "Origen coincide con parámetros"

msgid "Matches Sources with values containing the chosen parameters"
msgstr "Coincide Orígenes con valores conteniendo los parámetros elegidos"

msgid "People with multiple parent records"
msgstr "Persona con múltiples registros antecesores"

msgid "Matches people who have more than one set of parents"
msgstr "Coincide gente quien tenga más de un conjunto de parientes"

msgid "Match associations of <person filter>"
msgstr "Asociaciones coincidente de <filtro de persona>"

msgid "Does NOT match with selected Role"
msgstr "NO coincide con Rol seleccionado"

msgid "Finds the items that don't have event Roles of the selected type."
msgstr ""
"Encuentra los elementos que no tienen Roles de evento del tipo seleccionado."

msgid "Inverse"
msgstr "Inverso"

msgid "People with events with the <role>"
msgstr "Gente con eventos con el <rol>"

msgid "Matches people with an event with a selected role"
msgstr "Personas coinciden con un evento con un rol seleccionado"

msgid "Families with events with the <role>"
msgstr "Familias con eventos con el <rol>"

msgid "Matches families with an event with a selected role"
msgstr "Coinciden familias con un evento con un rol seleccionado"

msgid "Events of families matching a <family filter>"
msgstr "Eventos de familias que coinciden un <filtro familia>"

msgid "Families matching <event filter>"
msgstr "Familias coincidiendo con <filtro de evento>"

msgid "Matches families that are matched by an event filter"
msgstr "Familias coinciden eso son coincidentes por un filtro de evento"

msgid "Matches families matched by an event filter"
msgstr "Coincidencias de familias coincididas por un filtro de evento"

msgid "Number of degrees of separation from person."
msgstr "Número de grados de separación desde la persona."

msgid "Degrees:"
msgstr "Grados:"

msgid "People with <count> of <event>"
msgstr "Persona con <contador> de <evento>"

msgid "Matches persons which have events of given type and number."
msgstr ""
"Coincide con personas las cuales tienen eventos de tipo y número dados."

msgid "Include Children"
msgstr "Incluir Hijos"

msgid "Include the children in the matching families."
msgstr "Incluye a los hijos en las coincidencias de familias."

msgid "Include Parents"
msgstr "Incluir antecesores"

msgid "Include the parents in the matching families."
msgstr "Incluya los antecesores en la coincidencia de familias."

msgid "Family Filter name:"
msgstr "Nombre del filtro de familia:"

msgid "People who are part of families matching <filter>"
msgstr "Personas que son parte de las familias que coinciden con <filtro>"

msgid "Filter people by their age at death"
msgstr "Filtro de gente por su edad en la defunción"

msgid "Filter rule that matches people by their age at death"
msgstr "Regla de filtro que coincida gente por su edad en la defunción"

msgid "Multiple Parents Filter"
msgstr "Filtro de Múltiples Ancestros"

msgid "People with events with a selected role"
msgstr "Personas con eventos con un rol seleccionado"

msgid "Families with events with a selected role"
msgstr "Familias con eventos con un rol seleccionado"

msgid "The active Person"
msgstr "La Persona activa"

msgid "Matches sources with a particular value"
msgstr "Coinciden orígenes con un valor particular"

msgid "Active person"
msgstr "Persona activa"

msgid "Matches the active person"
msgstr "Coincide la persona activa"

msgid "Age in years at person's death."
msgstr "Edad en años en defunción de la persona."

msgid "Age:"
msgstr "Edad:"
