msgstr ""
"Trova gli elementi che non hanno ruoli negli eventi del tipo selezionato."

msgid "Inverse"
msgstr "Inverso"

msgid "People with events with the <role>"
msgstr "Persone con eventi con <ruolo>"

msgid "Matches people with an event with a selected role"
msgstr "Abbina le persone con un evento con il ruolo selezionato"

msgid "Families with events with the <role>"
msgstr "Famiglie con eventi con <ruolo>"

msgid "Matches families with an event with a selected role"
msgstr "Abbina le famiglie con un evento con il ruolo selezionato"

msgid "Events of families matching a <family filter>"
