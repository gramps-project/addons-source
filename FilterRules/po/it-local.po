msgstr "Abbina i genitori del filtro famiglia"

msgid "Matches sources with a particular value"
msgstr "Abbina le fonti con un determinato valore"

msgid "Events from people with role"
msgstr "Eventi delle persone con ruolo"

msgid "Matches event of people filter with role"
msgstr "Abbina gli eventi del filtro persone con ruolo"

msgid "Active person"
msgstr "Persona attiva"

msgid "Matches the active person"
msgstr "Corrisponde alla persona attiva"

msgid "Age in years at person's death."
msgstr "Età in anni al decesso di una persona."

msgid "Age:"
msgstr "Età:"
