msgid "People related to <filter>"
msgstr "Persone imparentate con <filtro>"

msgid "Matches people who are related to anybody matched by a person filter"
msgstr ""
"Abbina le persone imparentate con chiunque sia selezionato da un filtro "
"persone"

msgid "Retrieving all sub-filter matches"
msgstr "Recupero di tutte le corrispondenze dei sottofiltri"

msgid "People separated less than <N> degrees of <person>"
msgstr "Persone separate da meno di <N> gradi da <persona>"

msgid "Filter rule that matches relatives by degrees of separation"
msgstr "Regola di filtro che abbina i parenti in base ai gradi di separazione"

msgid "Role:"
msgstr "Ruolo:"

msgid "Persons with events matching the <event filter> with role"
msgstr "Persone con eventi che corrispondono al <filtro eventi> con ruolo"

msgid "People from event with role"
msgstr "Persone dell'evento con ruolo"

msgid "Matches people of event filter with role"
msgstr "Abbina le persone del filtro eventi con ruolo"

msgid "Source matching parameters"
msgstr "Parametri di corrispondenza delle fonti"

msgid "Matches Sources with values containing the chosen parameters"
msgstr "Abbina le fonti con valori che contengono i parametri scelti"

msgid "People with multiple parent records"
msgstr "Persone con registri genitore multipli"

