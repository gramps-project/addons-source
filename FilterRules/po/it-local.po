msgstr "Persone con <numero> di <evento>"

msgid "Matches persons which have events of given type and number."
msgstr "Abbina le persone che hanno eventi del tipo e del numero indicati."

msgid "Include Children"
msgstr "Includere figli/e"

msgid "Include the children in the matching families."
msgstr "Includi i figli nelle famiglie corrispondenti."

msgid "Include Parents"
msgstr "Includere genitori"

