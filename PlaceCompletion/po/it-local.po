msgstr "Nessuna conversione lat/lon"

msgid "All in degree notation"
msgstr "Tutto in notazione in gradi"

msgid "All in decimal notation"
msgstr "Tutto in notazione decimale"

msgid "Correct -50° in 50°S"
msgstr "Correggi -50° in 50°S"

