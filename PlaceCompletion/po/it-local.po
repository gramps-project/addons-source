msgid "Doing Place changes"
msgstr "Modifica dei luoghi in corso"

msgid "No place record was modified."
msgstr "Nessun record di luogo è stato modificato."

msgid "1 place record was modified."
msgstr "È stato modificato 1 record di luogo."

#, python-format
msgid "%d place records were modified."
msgstr "Sono stati modificati %d record di luogo."

msgid "Change places"
msgstr "Modifica i luoghi"

msgid "The selected file is a directory, not a file."
msgstr "Il file selezionato è una directory, non un file."

msgid "The file you want to access is not a regular file."
msgstr "Il file a cui vuoi accedere non è un file normale."

msgid "The file does not exist."
msgstr "Il file non esiste."

msgid "Problem reading file"
msgstr "Problema nella lettura del file"

