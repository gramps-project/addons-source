msgid "PlaceCompletion"
msgstr "OrtVervollständigung"

msgid ""
"Provides a browsable list of selected places, with possibility to complete/"
"parse/set the attribute fields."
msgstr ""
"Bietet eine durchsuchbare Liste ausgewählter Orte mit der Möglichkeit, die "
"Attributfelder zu vervollständigen/zu analysieren/festzulegen."

msgid ""
"Place Completion by parsing, file lookup and batch setting of place "
"attributes"
msgstr ""
"Ortsvervollständigung durch Analysieren, Dateisuche und Stapeleinstellung "
"von Ortsattributen"

msgid "Error in PlaceCompletion.py"
msgstr "Fehler in PlaceCompletion.py"

msgid "Non existing group used in get"
msgstr "Nicht vorhandene Gruppe in get verwendet"

#, python-format
msgid "PlaceCompletion is unable to create %s %s"
msgstr "OrtVervollständigung kann %s %s nicht erstellen"

msgid "Places tool"
msgstr "Ortewerkzeug"

msgid "Missing regex groups in match lat/lon"
msgstr "Fehlende reguläre Ausdrücke-Gruppen in Übereinstimmung Breite/Länge"

#, python-format
msgid ""
"Regex groups %(lat)s and %(lon)s must be present in lat/lon match. Quiting"
msgstr ""
"Regulärer Ausdruck Gruppen %(lat)s und %(lon)s müssen in Länge/Breite "
"Gegenstück vorhanden sein. Abbruch"

msgid "Non valid regex for match lat/lon"
msgstr ""
"Ungültiger regulärer Ausdruck für die Übereinstimmung von Breiten- und "
"Längengrad"

msgid "Non valid regular expression given to find lat/lon. Quiting."
msgstr ""
"Ungültiger regulärer Ausdruck zur Ermittlung von Breiten- und Längengrad "
"angegeben. Abbruch."

