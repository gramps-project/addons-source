msgstr "Agregado nacimiento en base a %(evidence)s, de %(name)s"

#, python-format
msgid "Added birth event based on %s"
msgstr "Agregado nacimiento en base a %s"

msgid "Estimated birth date"
msgstr "Fecha de nacimiento estimada"

#, python-format
msgid "Added death event based on %(evidence)s, from %(person)s"
msgstr "Agregada defunción en base a %(evidence)s, de %(person)s"

#, python-format
msgid "Added death event based on %s"
msgstr "Agregada defunción en base a %s"

msgid "Estimated death date"
msgstr "Fecha de defunción estimada"

