msgid "Select filter to restrict people"
msgstr "Seleccione filtro para restringir las personas"

msgid "Calculated Date Estimates"
msgstr "Estimaciones de las fechas calculadas"

msgid "Source to remove and/or add"
msgstr "Fuente a eliminar y/o agregar"

msgid ""
"Remove calculated events, notes, and source; occurs immediately on Execute"
msgstr ""
"La eliminación de los eventos, notas y fuentes calculados; sucede "
"inmediatamente al ejecutar"

msgid "Do not add birth events"
msgstr "No agregar nacimientos"

msgid "Add a birth events with or without estimated dates"
msgstr "Agregar evento de nacimiento con o sin fechas estimadas"

msgid "Do not add death events"
msgstr "No agregar defunciones"

msgid "Add death events with or without estimated dates"
msgstr "Agregar eventos de defunción con o sin fechas estimadas"

msgid "Maximum age"
msgstr "Edad máxima"

msgid "Maximum age that one can live to"
msgstr "Edad máxima de una persona"

msgid "Maximum age difference between siblings"
msgstr "Diferencia máxima de edad entre hermanos"

msgid "Average years between two generations"
msgstr "Distancia media en años entre dos generaciones"

msgid "Estimated Dates"
msgstr "Fechas estimadas"

msgid "Approximate (about)"
msgstr "Aproximadamente"

msgid "Extremes (after and before)"
msgstr "Extremos (antes y después)"

msgid "Dates on events are either about or after/before"
msgstr "Las fechas de los eventos son anteriores o posteriores a los mismos"

msgid "Calculate Estimated Dates"
msgstr "Calcular fechas estimadas"

msgid "Select All"
msgstr "Seleccionar todo"

msgid "Select None"
msgstr "No seleccionar nada"

msgid "Toggle Selection"
msgstr "Alternar selección"

msgid "Add Selected Events"
msgstr "Añadir eventos seleccionados"

msgid "Remove Events, Notes, and Source and Reselect Data"
msgstr "Eliminar eventos, notas y fuentes y volver a seleccionar datos"

msgid "Reselect Data"
msgstr "Reseleccionar datos"

msgid "Are you sure you want to reselect data?"
msgstr "¿Confirma que quiere reseleccionar los datos?"

msgid "Run Select Again"
msgstr "Volver a ejecutar la selección"

msgid "Evidence"
msgstr "Evidencia"

msgid "Relative"
msgstr "Pariente"

msgid "Processing...\n"
msgstr "Procesando...\n"

msgid "Removing old estimations... "
msgstr "Eliminando estimaciones antiguas... "

