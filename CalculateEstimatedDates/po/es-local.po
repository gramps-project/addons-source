msgid "Removing '%s'..."
msgstr "Quitando «%s»…"

msgid "done!\n"
msgstr "¡Hecho!\n"

msgid ""
"Selecting... \n"
"\n"
msgstr ""
"Seleccionando… \n"
"\n"

msgid "Selecting... "
msgstr "Seleccionando… "

#, python-format
msgid "Adding events '%s'..."
msgstr "Añadiendo eventos «%s»…"

#, python-format
