msgid "Sync Associations"
msgstr "Sincronizza associazioni"

msgid ""
"Traverses the Person list for all Associations that are bi-directional and "
"adds any which are missing to the Associated Person."
msgstr ""
"Esamina l'elenco delle persone alla ricerca di tutte le associazioni "
"bidirezionali, e aggiunge alla persona associata quelle che mancano."

#, python-format
msgid "Add %s reciprocal association"
msgstr "Aggiungi %s associazioni reciproche"

msgid "{} Reciprocal associations created"
msgstr "{} associazioni reciproche create"

msgid "All reciprocal associations exist, none created"
msgstr "Tutte le associazioni reciproche esistono, nessuna creata"

msgid "No existing associations, so no reciprocal ones needed"
msgstr "Nessuna associazione esistente, quindi non ne serve nessuna reciproca"
