msgid "Sync Associations"
msgstr "Synchronizácia asociácií"

msgid ""
"Traverses the Person list for all Associations that are bi-directional and "
"adds any which are missing to the Associated Person."
msgstr ""
"Prechádza zoznam osôb a hľadá všetky obojsmerné asociácie a pridáva tie, "
"ktoré chýbajú, k asociovanej osobe."

#, python-format
msgid "Add %s reciprocal association"
msgstr "Pridať %s recipročnú asociáciu"

msgid "{} Reciprocal associations created"
msgstr "Boli vytvorené recipročné asociácie: {}"

msgid "All reciprocal associations exist, none created"
msgstr "Všetky recipročné asociácie už existujú, žiadne neboli vytvorené"

msgid "No existing associations, so no reciprocal ones needed"
msgstr ""
"Nie sú žiadne existujúce asociácie, takže nie sú potrebné žiadne recipročné"
