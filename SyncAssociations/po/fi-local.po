msgid "Sync Associations"
msgstr "Synkronoi liitokset"

msgid ""
"Traverses the Person list for all Associations that are bi-directional and "
"adds any which are missing to the Associated Person."
msgstr ""
"Etsii henkilöluettelosta kaksisuuntaiset yhteydet ja lisää puuttuvat "
"yhteydet liitettyyn henkilöön."

#, python-format
msgid "Add %s reciprocal association"
msgstr "Lisää %s keskinäinen liitos"

msgid "{} Reciprocal associations created"
msgstr "{} Keskinäiset yhteydet luotu"

msgid "All reciprocal associations exist, none created"
msgstr "Kaikki keskinäiset yhteydet on jo olemassa, uusia ei luotu"

msgid "No existing associations, so no reciprocal ones needed"
msgstr "Yhteyksiä ei ollut, joten keskinäisiä yhteyksiä ei tarvittu"
