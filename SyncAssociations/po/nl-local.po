msgid "Sync Associations"
msgstr "Connecties synchroniseren"

msgid ""
"Traverses the Person list for all Associations that are bi-directional and "
"adds any which are missing to the Associated Person."
msgstr ""
"Doorloopt de lijst met personen voor alle connecties die bidirectioneel zijn "
"en voegt alle ontbrekende toe aan de geassocieerde persoon."

#, python-format
msgid "Add %s reciprocal association"
msgstr "%s wederzijdse connectie toevoegen"

msgid "{} Reciprocal associations created"
msgstr "{} Wederzijdse connecties aangemaakt"

msgid "All reciprocal associations exist, none created"
msgstr "Alle wederzijdse connecties bestaan, geen aangemaakt"

msgid "No existing associations, so no reciprocal ones needed"
msgstr "Geen bestaande connecties, dus geen wederzijdse nodig"
