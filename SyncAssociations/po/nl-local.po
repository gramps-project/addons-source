msgid "Sync Associations"
msgstr "Relaties synchroniseren"

msgid ""
"Traverses the Person list for all Associations that are bi-directional and "
"adds any which are missing to the Associated Person."
msgstr ""
"Doorloopt de lijst met personen voor alle relaties die bidirectioneel zijn "
"en voegt alle ontbrekende toe aan de gerelateerde persoon."

#, python-format
msgid "Add %s reciprocal association"
msgstr "%s wederzijdse relatie toevoegen"

#, python-brace-format
msgid "{} Reciprocal associations created"
msgstr "{} Wederzijdse relaties aangemaakt"

msgid "All reciprocal associations exist, none created"
msgstr "Alle wederzijdse relaties bestaan, geen aangemaakt"

msgid "No existing associations, so no reciprocal ones needed"
msgstr "Geen bestaande relaties, dus geen wederzijdse nodig"
