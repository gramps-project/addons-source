msgid "https://www.gramps-project.org/wiki/index.php/Photo_Tagging_Gramplet"
msgstr "https://www.gramps-project.org/wiki/index.php/Photo_Tagging_Gramplet"

msgid "Replace existing references to the person being assigned without asking"
msgstr "Bez dotazu nahradit existující odkazy na přiřazovanou osobu"

msgid "Face detection"
msgstr "Detekce obličejů"

msgid "Minimum face width (px)"
msgstr "Minimální šířka obličeje (px)"

msgid "Minimum face height (px)"
msgstr "Minimální výška obličeje (px)"

msgid "Detect faces inside existing boxes"
msgstr "Rozpoznávat obličeje uvnitř existujících rámečků"

msgid "Sensitivity (1 min .. 20 max)"
msgstr "Citlivost (1 min. .. 20 max.)"

msgid "Add Person"
msgstr "Přidat osobu"

msgid "Clear Reference"
msgstr "Odebrat odkaz"

msgid "Remove Selection"
msgstr "Odstranit výběr"

msgid "Edit referenced Person"
msgstr "Upravit odkazovanou osobu"

msgid "Zoom In"
msgstr "Přiblížit"

msgid "Zoom Out"
msgstr "Oddálit"

msgid "Detect faces"
msgstr "Rozpoznat obličeje"

msgid "Detect faces (OpenCV module required)"
msgstr "Rozpoznat obličeje (vyžaduje modul OpenCV)"

msgid "XMP Region Name"
msgstr "Název oblasti XMP"

msgid "Set as active person"
msgstr "Nastavit jako aktivní osobu"

msgid "_Select"
msgstr "_Vybrat"

#, python-brace-format
msgid "Replace to {0}"
msgstr "Nahradit osobou: {0}"

msgid "Detecting faces..."
msgstr "Detekují se obličeje..."

msgid "Detection finished"
msgstr "Rozpoznávání dokončeno"

#, python-brace-format
msgid "Another region of this image is associated with {name}. Remove it?"
msgstr "Další oblast tohoto obrázku je spojena s osobou: {name}. Odstranit ji?"

#, python-brace-format
msgid ""
"{count} other regions of this image are associated with {name}. Remove them?"
msgstr ""
"Další oblasti tohoto obrázku (počet: {count}) jsou spojeny s osobou: {name}. "
"Odstranit je?"

#, python-format
msgid "Male person|Dead at %s"
msgstr "Zemřel ve věku %s"

#, python-format
msgid "Female person|Dead at %s"
msgstr "Zemřela ve věku %s"

#, python-format
msgid "Unknown gender person|Dead at %s"
msgstr "Úmrtí ve věku %s"

msgid "Photo Tagging"
msgstr "Označování osob na fotografiích"

msgid "Gramplet for tagging people in photos"
msgstr "Gramplet pro označování osob na fotografiích"
