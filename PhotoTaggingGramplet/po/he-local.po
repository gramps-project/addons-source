msgid "https://www.gramps-project.org/wiki/index.php/Photo_Tagging_Gramplet"
msgstr "https://www.gramps-project.org/wiki/index.php/Photo_Tagging_Gramplet"

msgid "Replace existing references to the person being assigned without asking"
msgstr "החלפת אזכורים קיימות לאדם שהוקצה ללא שאלה מקדימה"

msgid "Face detection"
msgstr "זיהוי פנים"

msgid "Minimum face width (px)"
msgstr "רוחב פנים מזערי (פיקסל)"

msgid "Minimum face height (px)"
msgstr "גובה פנים מזערי (פיקסל)"

msgid "Detect faces inside existing boxes"
msgstr "זיהוי פנים בתוך תיבות קיימות"

msgid "Sensitivity (1 min .. 20 max)"
msgstr "רגישות (1 מזערי.. 20 מרבי)"

msgid "Add Person"
msgstr "הוספת אדם"

msgid "Clear Reference"
msgstr "ניקוי אזכור"

msgid "Remove Selection"
msgstr "הסרת פריטים שנבחרו"

msgid "Edit referenced Person"
msgstr "עריכת אדם מאוזכר"

msgid "Zoom In"
msgstr "התקרבות"

msgid "Zoom Out"
msgstr "התרחקות"

msgid "Detect faces"
msgstr "זיהוי פנים"

msgid "Detect faces (OpenCV module required)"
msgstr "זיהוי פנים (נדרש פרקן OpenCV)"

msgid "XMP Region Name"
msgstr "שם אזור XMP"

msgid "Set as active person"
msgstr "הגדרה כאדם הפעיל"

msgid "_Select"
msgstr "_בחירה"

#, python-brace-format
msgid "Replace to {0}"
msgstr "החלפה ל־ {0}"

msgid "Detecting faces..."
msgstr "מתבצע זיהוי פנים..."

msgid "Detection finished"
msgstr "הזיהוי הסתיים"

#, python-brace-format
msgid "Another region of this image is associated with {name}. Remove it?"
msgstr "אזור אחר של תמונה זו משויכת ל־{name}. האם להסיר אותו?"

#, python-brace-format
msgid ""
"{count} other regions of this image are associated with {name}. Remove them?"
msgstr "{count} אזורים אחרים של תמונה זו משויכים ל־{name}. האם להסירם?"

#, python-format
msgid "Male person|Dead at %s"
msgstr "זכר אדם|נפטר ב־%s"

#, python-format
msgid "Female person|Dead at %s"
msgstr "נקבה אדם|נפטר ב־%s"

#, python-format
msgid "Unknown gender person|Dead at %s"
msgstr "לא ידוע מגדר אדם|נפטר ב־%s"

msgid "Photo Tagging"
msgstr "תיוג תמונה"

msgid "Gramplet for tagging people in photos"
msgstr "גרמפלט לתיוג אנשים בתמונות"
