msgstr "Vymazať odkaz"

msgid "Remove Selection"
msgstr "Odstrániť výber"

msgid "Edit referenced Person"
msgstr "Upraviť odkazovanú osobu"

msgid "Zoom In"
msgstr "Zväčšiť"

msgid "Zoom Out"
msgstr "Zmenšiť"

msgid "Detect faces"
msgstr "Detekovať tváre"

msgid "Detect faces (OpenCV module required)"
msgstr "Detekovať tváre (vyžaduje sa modul OpenCV)"

