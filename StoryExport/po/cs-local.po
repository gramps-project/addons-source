msgid "Select the person whose story to generate, then try again."
msgstr "Vyberte osobu, jejíž příběh chcete vygenerovat, a zkuste to znovu."

msgid "Couldn't generate the story"
msgstr "Příběh se nepodařilo vygenerovat"

msgid "Story saved"
msgstr "Příběh byl uložen"

#, python-format
msgid ""
"%(count)d slides saved to %(path)s.\n"
"\n"
"Open it in the Gramps Connect Story Viewer: https://dsblank.github.io/gramps-"
"connect-stories/"
msgstr ""
"Uloženo do %(path)s (počet snímků: %(count)d).\n"
"\n"
"Soubor otevřete v Gramps Connect Story Viewer: https://dsblank.github.io/"
"gramps-connect-stories/"

msgid "_Open in Browser"
msgstr "_Otevřít v prohlížeči"

msgid "Story"
msgstr "Příběh"

msgid "Generate Story"
msgstr "Vygenerovat příběh"

msgid "Generate the story of:"
msgstr "Generovat příběh:"

#, python-format
msgid "Family: %s"
msgstr "Rodina: %s"

msgid "Include families"
msgstr "Zahrnout rodiny"

msgid ""
"Also draw on this person's own families: a spouse's and children's births "
"and deaths, and their parents' and siblings'."
msgstr ""
"Zahrnout také vlastní rodiny této osoby: narození a úmrtí partnera či "
"partnerky a dětí i jejích rodičů a sourozenců."

msgid "Include each person's own birth and death in this family's story:"
msgstr "Zahrnout vlastní narození a úmrtí každé osoby do příběhu této rodiny:"

msgid "Include living people (and photos they appear in)"
msgstr "Zahrnout žijící osoby (a fotografie, na kterých se vyskytují)"

msgid "Stories (*.story.zip)"
msgstr "Příběhy (*.story.zip)"

msgid ""
"This family is marked private. To generate its story, check \"Include data "
"marked private\"."
msgstr ""
"Tato rodina je označena jako soukromá. Pro vygenerování jejího příběhu "
"zaškrtněte „Zahrnout soukromé záznamy“."

#, python-format
msgid ""
"%s is marked private. To generate their story, check \"Include data marked "
"private\"."
msgstr ""
"Osoba %s je označena jako soukromá. Pro vygenerování jejího příběhu "
"zaškrtněte „Zahrnout soukromé záznamy“."

#, python-format
msgid ""
"%s is probably living. To generate their story, check \"Include living "
"people\"."
msgstr ""
"Osoba %s pravděpodobně žije. Pro vygenerování jejího příběhu zaškrtněte "
"„Zahrnout žijící osoby“."

#, python-format
msgid "%(who)s was born"
msgstr "%(who)s se narodil/a"

#, python-format
msgid "%(who)s was stillborn"
msgstr "%(who)s se narodil/a mrtvý/á"

#, python-format
msgid "%(who)s was baptized"
msgstr "%(who)s byl/a pokřtěn/a"

#, python-format
msgid "%(who)s was christened"
msgstr "%(who)s byl/a pokřtěn/a"

#, python-format
msgid "%(who)s was blessed"
msgstr "%(who)s byl/a požehnán/a"

#, python-format
msgid "%(who)s was confirmed"
msgstr "%(who)s byl/a biřmován/a"

#, python-format
msgid "%(who)s took First Communion"
msgstr "%(who)s přijal/a první svaté přijímání"

#, python-format
msgid "%(who)s celebrated their Bar Mitzvah"
msgstr "%(who)s slavil/a svou bar micvu"

#, python-format
msgid "%(who)s celebrated their Bas Mitzvah"
msgstr "%(who)s slavil/a svou bat micvu"

#, python-format
msgid "%(who)s was adopted"
msgstr "%(who)s byl/a adoptován/a"

#, python-format
msgid "%(who)s graduated"
msgstr "%(who)s absolvoval/a"

#, python-format
msgid "%(who)s was awarded a degree"
msgstr "%(who)s získal/a titul"

#, python-format
msgid "%(who)s emigrated"
msgstr "%(who)s emigroval/a"

#, python-format
msgid "%(who)s immigrated"
msgstr "%(who)s imigroval/a"

#, python-format
msgid "%(who)s was naturalized"
msgstr "%(who)s byl/a naturalizován/a"

#, python-format
msgid "%(who)s was ordained"
msgstr "%(who)s byl/a vysvěcen/a"

#, python-format
msgid "%(who)s was elected"
msgstr "%(who)s byl/a zvolen/a"

#, python-format
msgid "%(who)s retired"
msgstr "%(who)s odešel/odešla do důchodu"

#, python-format
msgid "%(who)s died"
msgstr "%(who)s zemřel/a"

#, python-format
msgid "%(who)s was buried"
msgstr "%(who)s byl/a pohřben/a"

#, python-format
msgid "%(who)s was cremated"
msgstr "%(who)s byl/a zpopelněn/a"

#, python-format
msgid "%(who)s had their estate probated"
msgstr "Byla ověřena závěť (%(who)s)"

#, python-format
msgid "%(who)s were married"
msgstr "%(who)s: sňatek"

#, python-format
msgid "%(who)s had their banns read"
msgstr "%(who)s: vyhlášení ohlášek"

#, python-format
msgid "%(who)s signed a marriage contract"
msgstr "%(who)s: podpis manželské smlouvy"

#, python-format
msgid "%(who)s took out a marriage license"
msgstr "%(who)s: získání povolení ke sňatku"

#, python-format
msgid "%(who)s agreed a marriage settlement"
msgstr "%(who)s: uzavření manželské majetkové dohody"

#, python-format
msgid "%(who)s were engaged"
msgstr "%(who)s: zásnuby"

#, python-format
msgid "%(who)s were divorced"
msgstr "%(who)s: rozvod"

#, python-format
msgid "%(who)s filed for divorce"
msgstr "%(who)s podal/a žádost o rozvod"

#, python-format
msgid "%(who)s had their marriage annulled"
msgstr "%(who)s: jejich manželství bylo anulováno"

#, python-format
msgid "%(who)s were recorded in the census"
msgstr "%(who)s: záznam ve sčítání lidu"

#, python-format
msgid "%(who)s lived"
msgstr "%(who)s: bydliště"

#, python-format
msgid "%(names)s and %(last)s"
msgstr "%(names)s a %(last)s"

#, python-format
msgid "%(type)s (%(role)s)"
msgstr "%(type)s (%(role)s)"

#, python-format
msgid "%(type)s of %(who)s"
msgstr "%(type)s (%(who)s)"

#, python-format
msgid "%(who)s took part in this %(type)s as %(role)s"
msgstr "%(who)s: účast (událost: %(type)s; role: %(role)s)"

#, python-format
msgid "%(moment)s on %(date)s"
msgstr "%(moment)s dne %(date)s"

#, python-format
msgid "%(moment)s in %(date)s"
msgstr "%(moment)s (%(date)s)"

#, python-format
msgid "%(moment)s %(date)s"
msgstr "%(moment)s %(date)s"

#, python-format
msgid "%(moment)s in %(place)s"
msgstr "%(moment)s (místo: %(place)s)"

#, python-format
msgid "%d moment"
msgid_plural "%d moments"
msgstr[0] "%d moment"
msgstr[1] "%d momenty"
msgstr[2] "%d momentů"

msgid "This person isn't included with the chosen privacy settings."
msgstr "Tato osoba není zahrnuta podle zvolených nastavení soukromí."

#, python-format
msgid "%s has no events to build a story from."
msgstr "%s nemá žádné události, ze kterých by se dal vytvořit příběh."

#, python-format
msgid "The Story of %s"
msgstr "Příběh: %s"

#, python-format
msgid "%(moments)s from %(name)s's recorded life."
msgstr "Ze zaznamenaného života: %(name)s (%(moments)s)."

msgid "This family isn't included with the chosen privacy settings."
msgstr "Tato rodina není zahrnuta podle zvolených nastavení soukromí."

msgid "this family"
msgstr "tato rodina"

msgid ""
"This family has no events to build a story from: not on the family itself, "
"and no births or deaths recorded for its members."
msgstr ""
"Tato rodina nemá žádné události pro vytvoření příběhu: ani v samotné rodině, "
"ani není zaznamenáno narození či úmrtí jejích členů."

#, python-format
msgid "%(moments)s from the life of %(couple)s and %(children)s."
msgstr "Ze života rodiny: %(couple)s a %(children)s (%(moments)s)."

#, python-format
msgid "their child"
msgid_plural "their %(count)d children"
msgstr[0] "dítě"
msgstr[1] "%(count)d děti"
msgstr[2] "%(count)d dětí"

#, python-format
msgid "%(moments)s from the life of %(couple)s."
msgstr "Ze života: %(couple)s (%(moments)s)."

#, python-format
msgid "Family %s"
msgstr "Rodina %s"

msgid ""
"Generates the story of a person or a family (.story.zip): a slideshow of "
"their events with dates, places and photos, for the Gramps Connect Story "
"Viewer"
msgstr ""
"Vygeneruje příběh osoby nebo rodiny (.story.zip): prezentaci jejich událostí "
"s daty, místy a fotografiemi pro Gramps Connect Story Viewer"
