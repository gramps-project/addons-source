msgid "%(names)s and %(last)s"
msgstr "%(names)s en %(last)s"

#, python-format
msgid "%(type)s (%(role)s)"
msgstr "%(type)s (%(role)s)"

#, python-format
msgid "%(type)s of %(who)s"
msgstr "%(type)s vam %(who)s"

#, python-format
msgid "%(who)s took part in this %(type)s as %(role)s"
msgstr "%(who)s naam deel in dit %(type)s als %(role)s"

