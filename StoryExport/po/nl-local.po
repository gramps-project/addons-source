msgid "%(moment)s on %(date)s"
msgstr "%(moment)s op %(date)s"

#, python-format
msgid "%(moment)s in %(date)s"
msgstr "%(moment)s in %(date)s"

#, python-format
msgid "%(moment)s %(date)s"
msgstr "%(moment)s %(date)s"

#, python-format
msgid "%(moment)s in %(place)s"
msgstr "%(moment)s in %(place)s"

#, python-format
msgid "%d moment"
msgid_plural "%d moments"
msgstr[0] "%d moment"
msgstr[1] "%d momenten"

msgid "This person isn't included with the chosen privacy settings."
msgstr "Deze persoon is niet inbegrepen bij de gekozen privacy-instellingen."

#, python-format
msgid "%s has no events to build a story from."
msgstr "%s heeft geen gebeurtenissen om een verhaal van op te bouwen."

#, python-format
msgid "The Story of %s"
msgstr "Het verhaal van %s"

#, python-format
msgid "%(moments)s from %(name)s's recorded life."
msgstr "%(moments)s uit het gedocumenteerde leven van %(name)s's."

msgid "This family isn't included with the chosen privacy settings."
msgstr "Dit gezin is niet inbegrepen bij de gekozen privacy-instellingen."

msgid "this family"
msgstr "dit gezin"

msgid ""
"This family has no events to build a story from: not on the family itself, "
"and no births or deaths recorded for its members."
msgstr ""
"Dit gezin heeft geen gebeurtenissen waaruit een verhaal kan worden "
"opgebouwd: niet over het gezin zelf en er zijn ook geen geboorten of "
"sterfgevallen geregistreerd voor haar leden."

#, python-format
msgid "%(moments)s from the life of %(couple)s and %(children)s."
msgstr "%(moments)s uit het leven van %(couple)s en %(children)s."

#, python-format
msgid "their child"
msgid_plural "their %(count)d children"
msgstr[0] "hun kind"
msgstr[1] "hun %(count)d kinderen"

#, python-format
msgid "%(moments)s from the life of %(couple)s."
msgstr "%(moments)s uit het leven van %(couple)s."

#, python-format
msgid "Family %s"
msgstr "Gezin %s"

msgid ""
"Generates the story of a person or a family (.story.zip): a slideshow of "
"their events with dates, places and photos, for the Gramps Connect Story "
"Viewer"
msgstr ""
"Genereert het verhaal van een persoon of een gezin (.story.zip): een "
"diavoorstelling van hun evenementen met data, plaatsen en foto's, voor de "
"Gramps Connect Story Viewer"
