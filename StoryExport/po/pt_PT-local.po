msgid "%(who)s emigrated"
msgstr "%(who)s emigrou"

#, python-format
msgid "%(who)s immigrated"
msgstr "%(who)s imigrou"

#, python-format
msgid "%(who)s was naturalized"
msgstr "%(who)s foi naturalizado"

#, python-format
msgid "%(who)s was ordained"
msgstr "%(who)s foi ordenado"

#, python-format
