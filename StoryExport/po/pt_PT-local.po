msgstr "%(who)s fez a primeira comunhão"

#, python-format
msgid "%(who)s celebrated their Bar Mitzvah"
msgstr "%(who)s teve o Bar Mitzvah"

#, python-format
msgid "%(who)s celebrated their Bas Mitzvah"
msgstr "%(who)s teve o Bas Mitzvah"

