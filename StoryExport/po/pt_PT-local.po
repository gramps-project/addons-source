msgstr "%(who)s fizeram convenção ante-nupcial"

#, python-format
msgid "%(who)s were engaged"
msgstr "%(who)s foram noivos"

#, python-format
msgid "%(who)s were divorced"
msgstr "%(who)s divorciaram-se"

#, python-format
msgid "%(who)s filed for divorce"
msgstr "%(who)s pediram o divórcio"

#, python-format
msgid "%(who)s had their marriage annulled"
msgstr "%(who)s tiveram o casamento anulado"

#, python-format
msgid "%(who)s were recorded in the census"
msgstr "%(who)s constaram no censo"

#, python-format
msgid "%(who)s lived"
msgstr "%(who)s viveram"

#, python-format
msgid "%(names)s and %(last)s"
msgstr "%(names)s e %(last)s"

#, python-format
msgid "%(type)s (%(role)s)"
msgstr "%(type)s (%(role)s)"

#, python-format
msgid "%(type)s of %(who)s"
msgstr "%(type)s de %(who)s"

#, python-format
msgid "%(who)s took part in this %(type)s as %(role)s"
msgstr "%(who)s participou em %(type)s como %(role)s"

#, python-format
msgid "%(moment)s on %(date)s"
msgstr "%(moment)s em %(date)s"

#, python-format
msgid "%(moment)s in %(date)s"
msgstr "%(moment)s em %(date)s"

#, python-format
msgid "%(moment)s %(date)s"
msgstr "%(moment)s, %(date)s"

#, python-format
msgid "%(moment)s in %(place)s"
msgstr "%(moment)s em %(place)s"

#, python-format
msgid "%d moment"
msgid_plural "%d moments"
msgstr[0] "%d momento"
msgstr[1] "%d momentos"

msgid "This person isn't included with the chosen privacy settings."
msgstr ""
"Este indivíduo não está incluído nas definições de privacidade escolhidas."

#, python-format
msgid "%s has no events to build a story from."
msgstr "%s não tem eventos para construir uma história."

#, python-format
msgid "The Story of %s"
msgstr "Biografia de %s"

#, python-format
msgid "%(moments)s from %(name)s's recorded life."
msgstr "%(moments)s da vida de %(name)s."

msgid "This family isn't included with the chosen privacy settings."
msgstr ""
"Esta família não está incluída nas definições de privacidade escolhidas."

msgid "this family"
msgstr "esta família"

msgid ""
"This family has no events to build a story from: not on the family itself, "
"and no births or deaths recorded for its members."
msgstr ""
"Esta família não tem eventos para construir uma história: nem sobre si "
"própria, nem nascimentos ou óbitos dos seus membros."

#, python-format
msgid "%(moments)s from the life of %(couple)s and %(children)s."
msgstr "%(moments)s da vida de %(couple)s e %(children)s."

#, python-format
msgid "their child"
msgid_plural "their %(count)d children"
msgstr[0] "o seu filho"
msgstr[1] "os seus %(count)d filhos"

#, python-format
msgid "%(moments)s from the life of %(couple)s."
msgstr "%(moments)s da vida de %(couple)s."

#, python-format
msgid "Family %s"
msgstr "Família %s"

msgid ""
"Generates the story of a person or a family (.story.zip): a slideshow of "
"their events with dates, places and photos, for the Gramps Connect Story "
"Viewer"
msgstr ""
"Gera a história individual ou familiar (.story.zip): um diaporama dos seus "
"eventos com datas, locais e fotografias, para o Gramps Connect Story Viewer"
