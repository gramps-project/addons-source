msgstr "%(who)s foi sepultado"

#, python-format
msgid "%(who)s was cremated"
msgstr "%(who)s foi cremado"

#, python-format
msgid "%(who)s had their estate probated"
msgstr "%(who)s teve herança sucessória"

#, python-format
msgid "%(who)s were married"
msgstr "%(who)s foram casados"

#, python-format
msgid "%(who)s had their banns read"
msgstr "%(who)s tiveram os banhos lidos"

#, python-format
msgid "%(who)s signed a marriage contract"
msgstr "%(who)s fizeram contrato matrimonial"

#, python-format
msgid "%(who)s took out a marriage license"
msgstr "%(who)s tiraram licença de casamento"

#, python-format
