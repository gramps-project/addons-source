msgid "Select the person whose story to generate, then try again."
msgstr "Seleziona la persona di cui generare la storia, poi riprova."

msgid "Couldn't generate the story"
msgstr "Impossibile generare la storia"

msgid "Story saved"
msgstr "Storia salvata"

#, python-format
msgid ""
"%(count)d slides saved to %(path)s.\n"
"\n"
"Open it in the Gramps Connect Story Viewer: https://dsblank.github.io/gramps-"
"connect-stories/"
msgstr ""
"%(count)d diapositive salvate in %(path)s.\n"
"\n"
"Aprila con Gramps Connect Story Viewer: https://dsblank.github.io/gramps-"
"connect-stories/"

msgid "_Open in Browser"
msgstr "_Apri nel browser"

msgid "Story"
msgstr "Storia"

msgid "Generate Story"
msgstr "Genera storia"

msgid "Generate the story of:"
msgstr "Genera la storia di:"

#, python-format
msgid "Family: %s"
msgstr "Famiglia: %s"

msgid "Include families"
msgstr "Includi le famiglie"

msgid ""
"Also draw on this person's own families: a spouse's and children's births "
"and deaths, and their parents' and siblings'."
msgstr ""
"Usa anche le famiglie della persona: nascite e morti di coniuge e figli, e "
"di genitori, fratelli e sorelle."

msgid "Include each person's own birth and death in this family's story:"
msgstr "Includi nella storia di questa famiglia la nascita e la morte di:"

msgid "Include living people (and photos they appear in)"
msgstr "Includi le persone viventi (e le foto in cui compaiono)"

msgid "Stories (*.story.zip)"
msgstr "Storie (*.story.zip)"

msgid ""
"This family is marked private. To generate its story, check \"Include data "
"marked private\"."
msgstr ""
"Questa famiglia è marcata come privata. Per generarne la storia, seleziona "
"\"Includere i dati marcati come privati\"."

#, python-format
msgid ""
"%s is marked private. To generate their story, check \"Include data marked "
"private\"."
msgstr ""
"%s è una persona marcata come privata. Per generarne la storia, seleziona "
"\"Includere i dati marcati come privati\"."

#, python-format
msgid ""
"%s is probably living. To generate their story, check \"Include living "
"people\"."
msgstr ""
"%s è probabilmente una persona vivente. Per generarne la storia, seleziona "
"\"Includi le persone viventi\"."

#, python-format
msgid "%(who)s was born"
msgstr "%(who)s nasce"

#, python-format
msgid "%(who)s was stillborn"
msgstr "%(who)s nasce senza vita"

#, python-format
msgid "%(who)s was baptized"
msgstr "%(who)s riceve il battesimo"

#, python-format
msgid "%(who)s was christened"
msgstr "%(who)s riceve il battesimo"

#, python-format
msgid "%(who)s was blessed"
msgstr "%(who)s riceve la benedizione"

#, python-format
