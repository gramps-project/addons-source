msgid "Failed writing "
msgstr "Échec d'écriture "

msgid "Year of Birth of Center Person"
msgstr "Année de naissance de la personne centrale"

msgid "The year of birth of the center person. Estimate a year if unknown"
msgstr ""
"L'année de naissance de la personne centrale. Estimez une année si inconnue"

msgid "Destination directory"
msgstr "Répertoire de destination"

msgid "Path for generated files"
msgstr "Le répertoire de destination pour les fichiers générés"

msgid "The destination file name for html content."
msgstr "Le nom du fichier de destination pour le contenu HTML."

msgid "Default Age"
msgstr "Âge par défaut"

msgid "Default age of parent when child is born with unknown year of birth"
msgstr ""
"Âge par défaut du parent lorsque l 'enfant n'a pas d'année de naissance "
"connue"

msgid "What to show"
msgstr "Que montrer"

msgid "Show GrampsID"
msgstr "Montrer l'ID Gramps"

msgid "Show GrampsID on top right of the box"
msgstr "Montrer l'ID Gramps en haut à droite de la boîte"

msgid "Optimize"
msgstr "Optimiser"

msgid "Use as little space in horizontal direction as possible"
msgstr "Utilise aussi peu d’espace dans la direction horizontale que possible"

msgid "Box background color for male person"
msgstr "Couleur de fond du cadre pour un homme"

msgid "Box background color for female person"
msgstr "Couleur d'arrière-plan des individus féminins"

msgid "Number of pixel per year"
msgstr "Nombre de pixel par année"

msgid "How many pixel height is one year?"
msgstr "Quelle est la hauteur en pixels d’une année ?"

msgid "How many pixel are unused besides the most left and most right boxes?"
msgstr ""
"Combien de pixels sont inutilisés en dehors des cases la plus à gauche et la "
"plus à droite ?"

msgid "Width of a box in pixel"
msgstr "Largeur du cadre en pixels"

msgid "Width of the box of a person in pixel"
msgstr "Largeur du cadre d'individu en pixels"

msgid "Horizontal space between boxes in pixel"
msgstr "Espace horizontal entre les cadres en pixel"

msgid "Timeline Pedigree Report"
msgstr "Rapport généalogique chronologique"

msgid ""
"Creates an HTML webpage that uses JavaScript to show a pedigree block "
"diagram arranged vertically by birth date"
msgstr ""
"Crée une page Web HTML qui utilise JavaScript pour afficher un diagramme "
"d'ascendance disposé verticalement par date de naissance"
