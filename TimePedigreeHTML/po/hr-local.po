msgid "Failed writing "
msgstr "Neuspjelo pisanje "

msgid "Year of Birth of Center Person"
msgstr "Godina rođenja središnje osobe"

msgid "The year of birth of the center person. Estimate a year if unknown"
msgstr "Godina rođenja središnje osobe. Procijeni godinu ako je nepoznata"

msgid "Destination directory"
msgstr "Odredišna mapa"

msgid "Path for generated files"
msgstr "Staza za generirane datoteke"

msgid "The destination file name for html content."
msgstr "Ime datoteke za html sadržaj."

msgid "Default Age"
msgstr "Zadana dob"

msgid "Default age of parent when child is born with unknown year of birth"
msgstr "Zadana dob roditelja kada se dijete rodi s nepoznatom godinom rođenja"

msgid "What to show"
msgstr "Što prikazati"

msgid "Show GrampsID"
msgstr "Prikaži Gramps ID"

msgid "Show GrampsID on top right of the box"
msgstr "Prikaži Gramps ID gore desno u okviru"

msgid "Optimize"
msgstr "Optimiraj"

msgid "Use as little space in horizontal direction as possible"
msgstr "Koristi što manje prostora u vodoravnom smjeru"

msgid "Male Box Color"
msgstr "Boja okvira za muške osobe"

msgid "Box background color for male person"
msgstr "Boja pozadine okvira za muške osobe"

msgid "Female Box Color"
msgstr "Boja okvira za ženske osobe"

msgid "Box background color for female person"
msgstr "Boja pozadine okvira za ženske osobe"

msgid "Number of pixel per year"
msgstr "Broj piksela po godini"

msgid "How many pixel height is one year?"
msgstr "Koliko piksela ima jedna godina?"

msgid "Offset X Coordinate"
msgstr "Odmak X koordinate"

msgid "Offset Y Coordinate"
msgstr "Odmak Y koordinate"

msgid "Width of a box in pixel"
msgstr "Širina polja u pikselima"

msgid "Width of the box of a person in pixel"
msgstr "Širina polja osobe u pikselima"

msgid "Horizontal space between boxes in pixel"
msgstr "Vodoravni razmak između polja u pikselima"

msgid "Minimum horizontal space between 2 boxes in pixel"
msgstr "Najmanji vodoravni razmak između dva polja u pikselima"

msgid "Length of vertical part of a line in pixel"
msgstr "Duljina okomitog dijela linije u pikselima"

msgid "Timeline Pedigree Report"
msgstr "Izveštaj vremenske crte porijekla"

msgid ""
"Creates an HTML webpage that uses JavaScript to show a pedigree block "
"diagram arranged vertically by birth date"
msgstr ""
"Stvara HTML web stranicu koja koristi JavaScript za prikaz blok dijagrama "
"porijekla poredanog okomito po datumu rođenja"
