msgid "Generate PDF Forms"
msgstr "Gerar formulários PDF"

msgid ""
"Generate blank fillable PDF forms: census/event forms or Ahnentafel pedigree "
"charts."
msgstr ""
"Criar formulários PDF em branco para preenchimento: recenseamento/eventos ou "
"tabelas genealógicas (Ahnentafel)."

msgid "Import Fillable PDF Forms"
msgstr "Importar formulários PDF preenchíveis"

msgid ""
"Import genealogy data from a PDF form. Send the PDF template to others to "
"fill out and return."
msgstr ""
"Importar dados genealógicos a partir de um formulário em PDF. Enviar o "
"modelo em PDF a outras pessoas para que o preencham e o devolvam."

msgid "Form addon required"
msgstr "É necessário a extensão Formulário"

msgid ""
"The Form addon must be installed to import Form PDF files.\n"
"Please install the Form addon and restart Gramps."
msgstr ""
"É necessário instalar a extensão Formulário para importar ficheiros PDF de "
"formulários.\n"
"Por favor, instale-a e reinicie o Gramps."

msgid "Not a Form PDF"
msgstr "Não é formulário PDF"

msgid "The _form_id field is missing or empty."
msgstr "O campo _form_id está em falta ou vazio."

msgid "Unknown form ID"
msgstr "ID de formulário desconhecida"

#, python-format
msgid ""
"Form ID '%(id)s' is not recognised by the Form addon.\n"
"Known IDs: %(known)s"
msgstr ""
"A ID do formulário «%(id)s» não é reconhecida pela extensão Formulário.\n"
"IDs conhecidas: %(known)s"

#, python-format
msgid "Import Form PDF: %s"
msgstr "Importar de PDF: %s"

msgid "Census / Event Form"
msgstr "Formulário de censo/evento"

msgid "Ahnentafel Pedigree Chart"
msgstr "Árvore de costados Ahnentafel"

msgid "Output file:"
msgstr "Ficheiro de saída:"

msgid "Browse…"
msgstr "Navegar…"

msgid "Open PDF after generating"
msgstr "Abrir PDF após gerar"

msgid "Generate"
msgstr "Gerar"

msgid "Form:"
msgstr "Formulário:"

msgid "Rows:"
msgstr "Linhas:"

msgid "(Rows only affect multi-row sections such as census household lists.)"
msgstr ""
"(As linhas só afectam secções com várias linhas, como as listas de famílias "
"do recenseamento)"

msgid "Generations:"
msgstr "Gerações:"

msgid "Includes subject plus up to 5 ancestor generations (2–32 people)."
msgstr ""
"Inclui o indivíduo em questão e até 5 gerações de antepassados (2 a 32 "
"pessoas)."

msgid "Save PDF as…"
msgstr "Gravar PDF como…"

msgid "Save"
msgstr "Gravar"

msgid "PDF files"
msgstr "Ficheiros PDF"

msgid "No output file"
msgstr "Sem ficheiro de saída"

msgid "Please specify an output file path."
msgstr "Por favor, defina o caminho do ficheiro de saída."

msgid "No form selected"
msgstr "Nada seleccionado"

msgid "Please select a census form."
msgstr "Por favor, seleccione um formulário de censos."

msgid "Form not found"
msgstr "Formulário não encontrado"

msgid "Generation failed"
msgstr "A geração falhou"

msgid "PDF generated"
msgstr "PDF gerado"

msgid ""
"The pypdf package is required to import PDF pedigree forms.\n"
"Install it with:  pip install pypdf"
msgstr ""
"É necessário o pacote pypdf para importar formulários de costados em PDF.\n"
"Instale-o com:  pip install pypdf"

#, python-format
msgid "Could not open PDF file: %s"
msgstr "Impossível abrir o ficheiro PDF: %s"

msgid "Add media reference: PDF import"
msgstr "Adicionar referência de ficheiro: importação de PDF"

msgid "PDF import: no data found"
msgstr "Importação de PDF: não foram encontrados dados"

msgid ""
"No names were found in the pedigree form.\n"
"\n"
"Fill in the form fields and try again."
msgstr ""
"Não foram encontrados nomes no formulário de costados.\n"
"\n"
"Preencha os campos do formulário e tente novamente."

msgid "Bad references in PDF import"
msgstr "Más referências na importação do PDF"

msgid "PDF import error"
msgstr "Erro de importação do PDf"

msgid "Form importer unavailable"
msgstr "Importador de formulários indisponível"

msgid "importformpdf.py is missing from the PDFForms addon directory."
msgstr "importformpdf.py está em falta na pasta da extensão PDFForms."

msgid "PDF import: unrecognized format"
msgstr "Importação de PDF: formato não reconhecido"

#, python-format
msgid ""
"No Gramps form ID found in '%s'.\n"
"\n"
"Only PDFs generated by Gramps (pedigree or form templates) can be imported."
msgstr ""
"Não foi encontrado nenhum ID de formulário do Gramps em «%s».\n"
"\n"
"Só é possível importar PDFs gerados pelo Gramps (modelos de árvore "
"genealógica ou de formulários)."
