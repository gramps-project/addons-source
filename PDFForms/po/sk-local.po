msgid "Generate PDF Forms"
msgstr "Vygenerovať formuláre PDF"

msgid ""
"Generate blank fillable PDF forms: census/event forms or Ahnentafel pedigree "
"charts."
msgstr ""
"Generujte prázdne vyplniteľné formuláre PDF: formuláre sčítania ľudu/"
"udalostí alebo diagramy rodokmeňa typu Ahnentafel."

msgid "Import Fillable PDF Forms"
msgstr "Importovať vyplniteľné PDF formuláre"

msgid ""
"Import genealogy data from a PDF form. Send the PDF template to others to "
"fill out and return."
msgstr ""
"Importujte genealogické údaje z formulára PDF. Odošlite šablónu PDF iným "
"osobám na vyplnenie a vrátenie."

msgid "Form addon required"
msgstr "Je požadovaný doplnok Formulár"

msgid ""
"The Form addon must be installed to import Form PDF files.\n"
"Please install the Form addon and restart Gramps."
msgstr ""
"Na import súborov PDF Formulár je potrebné nainštalovať doplnok Formulár.\n"
"Prosím, nainštalujte doplnok Formulár a reštartujte Gramps."

msgid "Not a Form PDF"
msgstr "Nie je to Formulár PDF"

msgid "The _form_id field is missing or empty."
msgstr "Chýba pole _form_id alebo je prázdne."

msgid "Unknown form ID"
msgstr "Neznáme ID formulára"

#, python-format
msgid ""
"Form ID '%(id)s' is not recognised by the Form addon.\n"
"Known IDs: %(known)s"
msgstr ""
"Formulár ID '%(id)s' nie je rozpoznaný doplnkom Formulár.\n"
"Známe ID: %(known)s"

#, python-format
msgid "Import Form PDF: %s"
msgstr "Importovať Formulár PDF: %s"

msgid "Census / Event Form"
msgstr "Sčítanie ľudu / Formulár udalosti"

msgid "Ahnentafel Pedigree Chart"
msgstr "Diagram rodokmeňa Ahnentafel"

msgid "Output file:"
msgstr "Výstupný súbor:"

msgid "Browse…"
msgstr "Prehliadať…"

msgid "Open PDF after generating"
msgstr "Otvoriť PDF po vygenerovaní"

msgid "Generate"
msgstr "Generovať"

msgid "Form:"
msgstr "Formulár:"

msgid "Rows:"
msgstr "Riadky:"

msgid "(Rows only affect multi-row sections such as census household lists.)"
msgstr ""
"(Riadky ovplyvňujú iba viacriadkové sekcie, napríklad zoznamy domácností v "
"sčítaní ľudu.)"

msgid "Generations:"
msgstr "Generácie:"

msgid "Includes subject plus up to 5 ancestor generations (2–32 people)."
msgstr "Obsahuje subjekt plus maximálne 5 generácií predkov (2–32 ľudí)."

msgid "Save PDF as…"
msgstr "Uložiť PDF ako…"

msgid "Save"
msgstr "Uložiť"

msgid "PDF files"
msgstr "Súbory PDF"

msgid "No output file"
msgstr "Žiadny výstupný súbor"

msgid "Please specify an output file path."
msgstr "Prosím, špecifikujte cestu k výstupnému súboru."

msgid "No form selected"
msgstr "Nevybraný žiadny formulár"

msgid "Please select a census form."
msgstr "Prosím, vyberte sčítací formulár."

msgid "Form not found"
msgstr "Formulár nenájdený"

msgid "Generation failed"
msgstr "Generovanie zlyhalo"

msgid "PDF generated"
msgstr "Vygenerované PDF"

msgid ""
"The pypdf package is required to import PDF pedigree forms.\n"
"Install it with:  pip install pypdf"
msgstr ""
"Na import rodokmeňových formulárov vo formáte PDF je potrebný balík pypdf.\n"
"Nainštalujte ho pomocou:  pip install pypdf"

#, python-format
msgid "Could not open PDF file: %s"
msgstr "Nepodarilo sa otvoriť súbor PDF: %s"

msgid "Add media reference: PDF import"
msgstr "Pridať odkaz na médiá: Import PDF"

msgid "PDF import: no data found"
msgstr "Import PDF: neboli nájdené žiadne údaje"

msgid ""
"No names were found in the pedigree form.\n"
"\n"
"Fill in the form fields and try again."
msgstr ""
"V rodokmeňovom formulári neboli nájdené žiadne mená.\n"
"\n"
"Vyplňte polia formulára a skúste to znova."

msgid "Bad references in PDF import"
msgstr "Chybné referencie pri importe z PDF"

msgid "PDF import error"
msgstr "Chyba pri importe PDF"

msgid "Form importer unavailable"
msgstr "Importér formulárov nie je k dispozícii"

msgid "importformpdf.py is missing from the PDFForms addon directory."
msgstr "Súbor importformpdf.py chýba v adresári doplnku PDFForms."

msgid "PDF import: unrecognized format"
msgstr "Import PDF: nerozpoznaný formát"

#, python-format
msgid ""
"No Gramps form ID found in '%s'.\n"
"\n"
"Only PDFs generated by Gramps (pedigree or form templates) can be imported."
msgstr ""
"V '%s' nebolo nájdené žiadne ID formulára Gramps.\n"
"\n"
"Importovať je možné iba PDF súbory (šablóny rodokmeňov alebo formulárov) "
"vygenerované programom Gramps."
