msgid "Generate PDF Forms"
msgstr "Generovat formuláře PDF"

msgid ""
"Generate blank fillable PDF forms: census/event forms or Ahnentafel pedigree "
"charts."
msgstr ""
"Vytvářet prázdné vyplnitelné formuláře PDF: formuláře sčítání lidu/událostí "
"nebo schémata vývodu z předků Ahnentafel."

msgid "Import Fillable PDF Forms"
msgstr "Importovat vyplnitelné formuláře PDF"

msgid ""
"Import genealogy data from a PDF form. Send the PDF template to others to "
"fill out and return."
msgstr ""
"Importovat genealogické údaje z formuláře PDF. Pošlete šablonu PDF ostatním "
"k vyplnění a vrácení."

msgid "Form addon required"
msgstr "Je vyžadováno rozšíření Form"

msgid ""
"The Form addon must be installed to import Form PDF files.\n"
"Please install the Form addon and restart Gramps."
msgstr ""
"Pro import souborů PDF rozšíření Form musí být toto rozšíření "
"nainstalované.\n"
"Nainstalujte rozšíření Form a restartujte Gramps."

msgid "Not a Form PDF"
msgstr "Nejde o PDF rozšíření Form"

msgid "The _form_id field is missing or empty."
msgstr "Pole _form_id chybí nebo je prázdné."

msgid "Unknown form ID"
msgstr "Neznámé ID formuláře"

#, python-format
msgid ""
"Form ID '%(id)s' is not recognised by the Form addon.\n"
"Known IDs: %(known)s"
msgstr ""
"Rozšíření Form nerozpoznalo ID formuláře '%(id)s'.\n"
"Známá ID: %(known)s"

#, python-format
msgid "Import Form PDF: %s"
msgstr "Import PDF rozšíření Form: %s"

msgid "Census / Event Form"
msgstr "Formulář sčítání lidu / události"

msgid "Ahnentafel Pedigree Chart"
msgstr "Schéma vývodu z předků Ahnentafel"

msgid "Output file:"
msgstr "Výstupní soubor:"

msgid "Browse…"
msgstr "Procházet…"

msgid "Open PDF after generating"
msgstr "Otevřít PDF po vytvoření"

msgid "Generate"
msgstr "Vygenerovat"

msgid "Form:"
msgstr "Formulář:"

msgid "Rows:"
msgstr "Řádky:"

msgid "(Rows only affect multi-row sections such as census household lists.)"
msgstr ""
"(Řádky ovlivňují pouze víceřádkové oddíly, například seznamy domácností při "
"sčítání lidu.)"

msgid "Generations:"
msgstr "Generace:"

msgid "Includes subject plus up to 5 ancestor generations (2–32 people)."
msgstr "Zahrnuje subjekt plus až 5 generací předků (2–32 osob)."

msgid "Save PDF as…"
msgstr "Uložit PDF jako…"

msgid "Save"
msgstr "Uložit"

msgid "PDF files"
msgstr "Soubory PDF"

msgid "No output file"
msgstr "Chybí výstupní soubor"

msgid "Please specify an output file path."
msgstr "Zadejte cestu k výstupnímu souboru."

msgid "No form selected"
msgstr "Není vybrán formulář"

msgid "Please select a census form."
msgstr "Vyberte formulář sčítání lidu."

msgid "Form not found"
msgstr "Formulář nebyl nalezen"

msgid "Generation failed"
msgstr "Generování se nezdařilo"

msgid "PDF generated"
msgstr "PDF vygenerováno"

msgid ""
"The pypdf package is required to import PDF pedigree forms.\n"
"Install it with:  pip install pypdf"
msgstr ""
"Pro import formulářů vývodu z předků v PDF je vyžadován balíček pypdf.\n"
"Nainstalujte jej příkazem:  pip install pypdf"

#, python-format
msgid "Could not open PDF file: %s"
msgstr "Nelze otevřít soubor PDF: %s"

msgid "Add media reference: PDF import"
msgstr "Přidat odkaz na médium: import PDF"

msgid "PDF import: no data found"
msgstr "Import PDF: nebyly nalezeny žádné údaje"

msgid ""
"No names were found in the pedigree form.\n"
"\n"
"Fill in the form fields and try again."
msgstr ""
"Ve formuláři vývodu z předků nebyla nalezena žádná jména.\n"
"\n"
"Vyplňte pole formuláře a zkuste to znovu."

msgid "Bad references in PDF import"
msgstr "Neplatné odkazy při importu PDF"

msgid "PDF import error"
msgstr "Chyba importu PDF"

msgid "Form importer unavailable"
msgstr "Importér formulářů není dostupný"

msgid "importformpdf.py is missing from the PDFForms addon directory."
msgstr "V adresáři rozšíření PDFForms chybí soubor importformpdf.py."

msgid "PDF import: unrecognized format"
msgstr "Import PDF: nerozpoznaný formát"

#, python-format
msgid ""
"No Gramps form ID found in '%s'.\n"
"\n"
"Only PDFs generated by Gramps (pedigree or form templates) can be imported."
msgstr ""
"V souboru '%s' nebylo nalezeno ID formuláře Gramps.\n"
"\n"
"Importovat lze pouze PDF vytvořená programem Gramps (vývody z předků nebo "
"šablony formulářů)."
