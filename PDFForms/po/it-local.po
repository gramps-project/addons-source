msgid "Generate PDF Forms"
msgstr "Genera moduli PDF"

msgid ""
"Generate blank fillable PDF forms: census/event forms or Ahnentafel pedigree "
"charts."
msgstr ""
"Genera moduli PDF compilabili vuoti: moduli di censimento/evento o tavole "
"genealogiche Ahnentafel."

msgid "Import Fillable PDF Forms"
msgstr "Importa moduli PDF compilabili"

msgid ""
"Import genealogy data from a PDF form. Send the PDF template to others to "
"fill out and return."
msgstr ""
"Importa dati genealogici da un modulo PDF. Invia il modello PDF ad altre "
"persone perché lo compilino e lo rimandino."

msgid "Form addon required"
msgstr "Richiesto l'addon Form"

msgid ""
"The Form addon must be installed to import Form PDF files.\n"
"Please install the Form addon and restart Gramps."
msgstr ""
"Per importare i file PDF di Form deve essere installato l'addon Form.\n"
"Installa l'addon Form e riavvia Gramps."

msgid "Not a Form PDF"
msgstr "Non è un modulo PDF"

msgid "The _form_id field is missing or empty."
msgstr "Il campo _form_id è mancante o vuoto."

msgid "Unknown form ID"
msgstr "ID modulo sconosciuto"

#, python-format
msgid ""
"Form ID '%(id)s' is not recognised by the Form addon.\n"
"Known IDs: %(known)s"
msgstr ""
"L'ID del modulo '%(id)s' non è riconosciuto dall'addon Form.\n"
"ID conosciuti: %(known)s"

#, python-format
msgid "Import Form PDF: %s"
msgstr "Importa modulo PDF: %s"

msgid "Census / Event Form"
msgstr "Modulo di censimento / evento"

msgid "Ahnentafel Pedigree Chart"
msgstr "Tavola genealogica Ahnentafel"

msgid "Output file:"
msgstr "File di output:"

msgid "Browse…"
msgstr "Sfoglia…"

msgid "Open PDF after generating"
msgstr "Apri il PDF dopo la generazione"

msgid "Generate"
msgstr "Genera"

msgid "Form:"
msgstr "Modulo:"

msgid "Rows:"
msgstr "Righe:"

msgid "(Rows only affect multi-row sections such as census household lists.)"
msgstr ""
"(Le righe riguardano solo le sezioni con più righe, come gli elenchi dei "
"nuclei familiari del censimento.)"

msgid "Generations:"
msgstr "Generazioni:"

msgid "Includes subject plus up to 5 ancestor generations (2–32 people)."
msgstr ""
"Includi il soggetto più fino generazioni di ascendenti (da 2 a 32 persone)."

msgid "Save PDF as…"
msgstr "Salva PDF come…"

msgid "Save"
msgstr "Salva"

msgid "PDF files"
msgstr "File PDF"

msgid "No output file"
msgstr "Nessun file di output"

msgid "Please specify an output file path."
msgstr "Specificare il percorso di un file di output."

msgid "No form selected"
msgstr "Nessun modulo selezionato"

msgid "Please select a census form."
msgstr "Seleziona un modulo di censimento."

msgid "Form not found"
msgstr "Modulo non trovato"

msgid "Generation failed"
msgstr "Generazione non riuscita"

msgid "PDF generated"
msgstr "PDF generato"

msgid ""
"The pypdf package is required to import PDF pedigree forms.\n"
"Install it with:  pip install pypdf"
msgstr ""
"Per importare i moduli genealogici PDF è necessario il pacchetto pypdf.\n"
"Installalo con:  pip install pypdf"

#, python-format
msgid "Could not open PDF file: %s"
msgstr "Impossibile aprire il file: %s"

msgid "Add media reference: PDF import"
msgstr "Aggiungi riferimento multimediale: importazione PDF"

msgid "PDF import: no data found"
msgstr "Importazione PDF: nessun dato trovato"

msgid ""
"No names were found in the pedigree form.\n"
"\n"
"Fill in the form fields and try again."
msgstr ""
"Nel modulo genealogico non è stato trovato nessun nome.\n"
"\n"
"Compila i campi del modulo e riprova."

msgid "Bad references in PDF import"
msgstr "Riferimenti errati nell'importazione PDF"

msgid "PDF import error"
msgstr "Errore nell'importazione PDF"

msgid "Form importer unavailable"
msgstr "Importatore di moduli non disponibile"

msgid "importformpdf.py is missing from the PDFForms addon directory."
msgstr "Nella cartella dell'addon PDFForms manca importformpdf.py."

msgid "PDF import: unrecognized format"
msgstr "Importazione PDF: formato non riconosciuto"

#, python-format
msgid ""
"No Gramps form ID found in '%s'.\n"
"\n"
"Only PDFs generated by Gramps (pedigree or form templates) can be imported."
msgstr ""
"Nessun ID di modulo Gramps trovato in '%s'.\n"
"\n"
"Si possono importare solo i PDF generati da Gramps (modelli genealogici o di "
"modulo)."
