msgid "Generate PDF Forms"
msgstr "Luo PDF-lomakkeet"

msgid ""
"Generate blank fillable PDF forms: census/event forms or Ahnentafel pedigree "
"charts."
msgstr ""
"Luo täytettäviä PDF-lomakkeita: laskenta-/tapahtumalomakkeita tai "
"sukutauluja."

msgid "Import Fillable PDF Forms"
msgstr "Tuo PDF-lomakkeita"

msgid ""
"Import genealogy data from a PDF form. Send the PDF template to others to "
"fill out and return."
msgstr ""
"Tuo sukututkimustietoja PDF-lomakkeelta. Lähetä PDF-lomake muille "
"täytettäväksi ja palautettavaksi."

msgid "Form addon required"
msgstr "Lomake-lisäosa vaaditaan"

msgid ""
"The Form addon must be installed to import Form PDF files.\n"
"Please install the Form addon and restart Gramps."
msgstr ""
"Lomake-lisäosa on asennettava PDF-lomaketiedostojen tuomiseksi.\n"
"Asenna lomake-lisäosa ja käynnistä Gramps uudelleen."

msgid "Not a Form PDF"
msgstr "Ei ole PDF-lomake"

msgid "The _form_id field is missing or empty."
msgstr "_form_id -kenttä puuttuu tai on tyhjä."

msgid "Unknown form ID"
msgstr "Tuntematon lomakkeen ID"

#, python-format
msgid ""
"Form ID '%(id)s' is not recognised by the Form addon.\n"
"Known IDs: %(known)s"
msgstr ""
"Lomake-lisäosa ei tunnista lomaketunnusta '%(id)s'.\n"
"Tunnetut tunnukset: %(known)s"

#, python-format
msgid "Import Form PDF: %s"
msgstr "Tuotava PDF-lomake: %s"

msgid "Census / Event Form"
msgstr "Väestönlaskenta- / tapahtumalomake"

msgid "Output file:"
msgstr "Tulostustiedosto:"

msgid "Browse…"
msgstr "Selaa…"

msgid "Open PDF after generating"
msgstr "Avaa PDF luonnin jälkeen"

msgid "Generate"
msgstr "Muodosta"

msgid "Form:"
msgstr "Lomake:"

msgid "Rows:"
msgstr "Rivit:"

msgid "(Rows only affect multi-row sections such as census household lists.)"
msgstr ""
"(Rivit tarvitaan vain monirivisiin kohtiin, kuten väestönlaskennan "
"kotitalousluetteloihin.)"

msgid "Generations:"
msgstr "Sukupolvet:"

msgid "Includes subject plus up to 5 ancestor generations (2–32 people)."
msgstr ""
"Sisältää kohteen sekä enintään viisi esivanhempien sukupolvea (2–32 "
"henkilöä)."

msgid "Save PDF as…"
msgstr "Tallenna PDF nimellä…"

msgid "Save"
msgstr "Tallenna"

msgid "PDF files"
msgstr "PDF-tiedostot"

msgid "No output file"
msgstr "Ei tulostiedostoa"

msgid "Please specify an output file path."
msgstr "Anna tulostetiedoston polku."

msgid "No form selected"
msgstr "Ei valittua lomaketta"

msgid "Please select a census form."
msgstr "Valitse väestönlaskentalomake."

msgid "Form not found"
msgstr "Lomaketta ei löytynyt"

msgid "Generation failed"
msgstr "Generointi ei onnistunut"

msgid "PDF generated"
msgstr "PDF valmistui"

msgid ""
"The pypdf package is required to import PDF pedigree forms.\n"
"Install it with:  pip install pypdf"
msgstr ""
"PDF-muotoisten sukutaululomakkeiden tuontiin tarvitaan pypdf-paketti.\n"
"Asenna se komennolla: pip install pypdf"

#, python-format
msgid "Could not open PDF file: %s"
msgstr "PDF-tiedostoa ei voitu avata: %s"

msgid "Add media reference: PDF import"
msgstr "Lisää mediaviite: PDF-tuonti"

msgid "PDF import: no data found"
msgstr "PDF-tuonti: tietoja ei löytynyt"

msgid ""
"No names were found in the pedigree form.\n"
"\n"
"Fill in the form fields and try again."
msgstr ""
"Sukupuulomakkeesta ei löytynyt nimiä.\n"
"\n"
"Täytä lomakkeen kentät ja yritä uudelleen."

msgid "Bad references in PDF import"
msgstr "Virheellisiä viitteitä PDF-tuonnissa"

msgid "PDF import error"
msgstr "PDF-tiedoston tuontivirhe"

msgid "Form importer unavailable"
msgstr "Lomakkeen tuonti ei ole saatavilla"

msgid "importformpdf.py is missing from the PDFForms addon directory."
msgstr "PDFForms-lisäosien hakemistosssa ei ole importformpdf.py-ohjelmaa."

msgid "PDF import: unrecognized format"
msgstr "PDF-tuonti: tunnistamaton muoto"

#, python-format
msgid ""
"No Gramps form ID found in '%s'.\n"
"\n"
"Only PDFs generated by Gramps (pedigree or form templates) can be imported."
msgstr ""
"Grampsin lomaketunnusta ei löytynyt kohteesta '%s'.\n"
"\n"
"Vain Grampsin luomia PDF-tiedostoja (sukupuu tai lomakepohjat) voidaan tuoda."
