msgid "Generate PDF Forms"
msgstr "PDF-formulieren genereren"

msgid ""
"Generate blank fillable PDF forms: census/event forms or Ahnentafel pedigree "
"charts."
msgstr ""
"Lege invulbare PDF-formulieren aanmaken: volkstelling-/evenementformulieren "
"of Ahnentafel-stamboomkaarten."

msgid "Import Fillable PDF Forms"
msgstr "Ingevulde PDF-formulieren importeren"

msgid ""
"Import genealogy data from a PDF form. Send the PDF template to others to "
"fill out and return."
msgstr ""
"Genealogische gegevens uit een PDF-formulier importeren. Stuur anderen het "
"PDF-formulier om in te vullen en terug te sturen."

msgid "Form addon required"
msgstr "Formulier-toevoeging vereist"

msgid ""
"The Form addon must be installed to import Form PDF files.\n"
"Please install the Form addon and restart Gramps."
msgstr ""
"De Formulier-toevoeging moet worden geïnstalleerd om PDF-formulierbestanden "
"te importeren.\n"
"Installeer de Formulier-toevoeging en start Gramps opnieuw."

msgid "Not a Form PDF"
msgstr "Geen PDF-formulier"

msgid "The _form_id field is missing or empty."
msgstr "Het veld _form_id ontbreekt of is leeg."

msgid "Unknown form ID"
msgstr "Onbekend Formulier-ID"

#, python-format
msgid ""
"Form ID '%(id)s' is not recognised by the Form addon.\n"
"Known IDs: %(known)s"
msgstr ""
"Formulier-ID '%(id)s' wordt niet herkend door de Formulier-toevoeging.\n"
"Bekende ID's: %(known)s"

#, python-format
msgid "Import Form PDF: %s"
msgstr "PDF-formulier importeren: %s"

msgid "Census / Event Form"
msgstr "Volkstelling- / Gebeurtenisformulier"

msgid "Ahnentafel Pedigree Chart"
msgstr "Ahnentafel Kwartierstaatdiagram"

msgid "Output file:"
msgstr "Uitvoerbestand:"

msgid "Browse…"
msgstr "Bladeren…"

msgid "Open PDF after generating"
msgstr "Gegenereerde PDF openen"

msgid "Generate"
msgstr "Genereer"

msgid "Form:"
msgstr "Formulier:"

msgid "Rows:"
msgstr "Rijen:"

msgid "(Rows only affect multi-row sections such as census household lists.)"
msgstr ""
"(Rijen hebben alleen invloed op secties met meerdere rijen, zoals "
"volkstellingen.)"

msgid "Generations:"
msgstr "Generaties:"

msgid "Includes subject plus up to 5 ancestor generations (2–32 people)."
msgstr "Inclusief onderwerp plus max. 5 vooroudergeneraties (2–32 personen)."

msgid "Save PDF as…"
msgstr "PDF opslaan als…"

msgid "Save"
msgstr "Opslaan"

msgid "PDF files"
msgstr "PDF-bestanden"

msgid "No output file"
msgstr "Geen uitvoerbestand"

msgid "Please specify an output file path."
msgstr "Geef een pad op voor het uitvoerbestand."

msgid "No form selected"
msgstr "Geen formulier geselecteerd"

msgid "Please select a census form."
msgstr "Selecteer een volkstellingsformulier."

msgid "Form not found"
msgstr "Formulier niet gevonden"

msgid "Generation failed"
msgstr "Genereren is mislukt"

msgid "PDF generated"
msgstr "PDF gegenereerd"

msgid ""
"The pypdf package is required to import PDF pedigree forms.\n"
"Install it with:  pip install pypdf"
msgstr ""
"Het pypdf-pakket is vereist om PDF-stamboomformulieren te importeren.\n"
"Installeer het met:  pip install pypdf"

#, python-format
msgid "Could not open PDF file: %s"
msgstr "Kan PDF-bestand niet openen: %s"

msgid "Add media reference: PDF import"
msgstr "Media referentie toevoegen: PDF-import"

msgid "PDF import: no data found"
msgstr "PDF-import: geen gegevens gevonden"

msgid ""
"No names were found in the pedigree form.\n"
"\n"
"Fill in the form fields and try again."
msgstr ""
"In de stamboomvorm zijn geen namen aangetroffen.\n"
"\n"
"Vul de formuliervelden in en probeer het opnieuw."

msgid "Bad references in PDF import"
msgstr "Onjuiste verwijzingen in PDF-import"

msgid "PDF import error"
msgstr "Fout bij PDF-import"

msgid "Form importer unavailable"
msgstr "Geen importeur beschikbaar"

msgid "importformpdf.py is missing from the PDFForms addon directory."
msgstr "importformpdf.py ontbreekt in de toevoegingenmap van PDFForms."

msgid "PDF import: unrecognized format"
msgstr "PDF-import: niet-herkend formaat"

#, python-format
msgid ""
"No Gramps form ID found in '%s'.\n"
"\n"
"Only PDFs generated by Gramps (pedigree or form templates) can be imported."
msgstr ""
"Geen Gramps-formulier-ID gevonden in '%s'.\n"
"\n"
"Alleen PDF's gegenereerd door Gramps (stamboom- of formuliersjablonen) "
"kunnen worden geïmporteerd."
