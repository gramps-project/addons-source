msgid "Form addon required"
msgstr "Potreban je dodatak „Obrazac”"

msgid ""
"The Form addon must be installed to import Form PDF files.\n"
"Please install the Form addon and restart Gramps."
msgstr ""
"Za uvoz PDF datoteka s obrascima, dodatak „Obrazac” mora biti instaliran.\n"
"Instaliraj dodatak „Obrazac” i ponovo pokreni Gramps."

msgid "Not a Form PDF"
msgstr "Nije PDF obrazac"

msgid "The _form_id field is missing or empty."
msgstr "Polje _form_id nedostaje ili je prazno."

msgid "Unknown form ID"
msgstr "Nepoznat ID obrasca"

#, python-format
msgid ""
"Form ID '%(id)s' is not recognised by the Form addon.\n"
"Known IDs: %(known)s"
msgstr ""
"Dodatak „Obrasci” ne prepoznaje ID obrasca „%(id)s”.\n"
"Poznati ID-ovi: %(known)s"

#, python-format
msgid "Import Form PDF: %s"
msgstr "Uvezi PDF obrazac: %s"

msgid "Browse…"
msgstr "Pregledaj …"

msgid "Open PDF after generating"
msgstr "Otvori PDF nakon generiranja"

msgid "Generate"
msgstr "Generiraj"

msgid "Form:"
msgstr "Obrazac:"

msgid "Rows:"
msgstr "Redci:"

msgid "(Rows only affect multi-row sections such as census household lists.)"
msgstr ""
"(Redci utječu samo na odjeljke s više redaka, kao što su popisi kućanstava u "
"popisu stanovništva.)"

msgid "Generations:"
msgstr "Generacije:"

msgid "Includes subject plus up to 5 ancestor generations (2–32 people)."
msgstr "Uključuje dotičnu osobu plus do 5 generacija predaka (2 do 32 osobe)."

msgid "Save PDF as…"
msgstr "Spremi PDF kao …"

msgid "Save"
msgstr "Spremi"

msgid "PDF files"
msgstr "PDF datoteke"

msgid "No output file"
msgstr "Nema datoteke rezultata"

msgid "Please specify an output file path."
msgstr "Odredi stazu za datoteke rezultata."

msgid "No form selected"
msgstr "Nijedan obrazac nije odabran"

msgid "Please select a census form."
msgstr "Odaberi jedan obrazac za popis stanovništva."

msgid "Form not found"
msgstr "Obrazac nije pronađen"

msgid "Generation failed"
msgstr "Generiranje nije uspjelo"

msgid "PDF generated"
msgstr "PDF je generiran"

msgid ""
"The pypdf package is required to import PDF pedigree forms.\n"
"Install it with:  pip install pypdf"
msgstr ""
"Za uvoz PDF obrazaca porijekla potreban je paket pypdf.\n"
"Instaliraj ga pomoću naredbe: pip install pypdf"

#, python-format
msgid "Could not open PDF file: %s"
msgstr "Nije bilo moguće otvoriti PDF datoteku: %s"

msgid "Add media reference: PDF import"
msgstr "Dodaj reference medija: PDF uvoz"

msgid "PDF import: no data found"
msgstr "Uvoz PDF-a: nije pronađen nijedan podatak"

msgid "Bad references in PDF import"
msgstr "Loše reference u PDF uvozu"

msgid "PDF import error"
msgstr "Greška pri uvozu PDF-a"

msgid "Form importer unavailable"
msgstr "Uvoznik obrazaca nije dostupan"

msgid "importformpdf.py is missing from the PDFForms addon directory."
msgstr "Datoteka „importformpdf.py” nedostaje u direktoriju dodataka PDFForms."

msgid "PDF import: unrecognized format"
msgstr "Uvoz PDF-a: neprepoznati format"

#, python-format
msgid ""
"No Gramps form ID found in '%s'.\n"
"\n"
"Only PDFs generated by Gramps (pedigree or form templates) can be imported."
msgstr ""
"ID Gramps obrasca nije pronađen u „%s”.\n"
"\n"
"Uvesti se mogu samo PDF-ovi koje je generirao Gramps (porijeklo ili "
"predlošci obrazaca)."
