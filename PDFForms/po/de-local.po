msgid "Generate PDF Forms"
msgstr "PDF-Formulare erstellen"

msgid ""
"Generate blank fillable PDF forms: census/event forms or Ahnentafel pedigree "
"charts."
msgstr ""
"Erstellt leere, ausfüllbare PDF-Formulare: Volkszählungs-/"
"Ereignisseformulare oder Ahnentafeln."

msgid "Import Fillable PDF Forms"
msgstr "Ausfüllbare PDF-Formulare importieren"

msgid ""
"Import genealogy data from a PDF form. Send the PDF template to others to "
"fill out and return."
msgstr ""
"Importe von Genealogie-Daten aus einem PDF-Formular. Sende die PDF-Vorlage "
"an andere, damit diese sie ausfüllen und zurücksenden können."

msgid "Form addon required"
msgstr "Formularerweiterung erforderlich"

msgid ""
"The Form addon must be installed to import Form PDF files.\n"
"Please install the Form addon and restart Gramps."
msgstr ""
"Zum Importieren von Formular-PDF-Dateien muss die Formular-Erweiterung "
"installiert sein.\n"
"Bitte installiere die Formular-Erweiterung und starte Gramps neu."

msgid "Not a Form PDF"
msgstr "Kein PDF-Formular"

msgid "The _form_id field is missing or empty."
msgstr "Das Feld „_form_id“ fehlt oder ist leer."

msgid "Unknown form ID"
msgstr "Unbekannte Formular-ID"

#, python-format
msgid ""
"Form ID '%(id)s' is not recognised by the Form addon.\n"
"Known IDs: %(known)s"
msgstr ""
"Die Formular-ID „%(id)s“ wird von der Formular-Erweiterung nicht erkannt.\n"
"Bekannte IDs: %(known)s"

#, python-format
msgid "Import Form PDF: %s"
msgstr "PDF-Formular importieren: %s"

msgid "Census / Event Form"
msgstr "Formular für Volkszählung / Ereignis"

msgid "Ahnentafel Pedigree Chart"
msgstr "Ahnentafel Stammbaum"

msgid "Output file:"
msgstr "Ausgabedatei:"

msgid "Browse…"
msgstr "Durchsuchen…"

msgid "Open PDF after generating"
msgstr "PDF nach der Erstellung öffnen"

msgid "Generate"
msgstr "Generieren"

msgid "Form:"
msgstr "Formular:"

msgid "Rows:"
msgstr "Zeilen:"

msgid "(Rows only affect multi-row sections such as census household lists.)"
msgstr ""
"(Zeilen betreffen nur mehrzeilige Abschnitte wie beispielsweise "
"Volkszählungslisten.)"

msgid "Generations:"
msgstr "Generationen:"

msgid "Includes subject plus up to 5 ancestor generations (2–32 people)."
msgstr ""
"Umfasst die betreffende Person sowie bis zu fünf Vorfahren-Generationen (2–"
"32 Personen)."

msgid "Save PDF as…"
msgstr "PDF speichern unter…"

msgid "Save"
msgstr "Speichern"

msgid "PDF files"
msgstr "PDF-Dateien"

msgid "No output file"
msgstr "Keine Ausgabedatei"

msgid "Please specify an output file path."
msgstr "Bitte gib einen Pfad für die Ausgabedatei an."

msgid "No form selected"
msgstr "Es wurde kein Formular ausgewählt"

msgid "Please select a census form."
msgstr "Bitte wähle ein Volkszählungsformular aus."

msgid "Form not found"
msgstr "Formular nicht gefunden"

msgid "Generation failed"
msgstr "Die Generierung ist fehlgeschlagen"

msgid "PDF generated"
msgstr "PDF erstellt"

msgid ""
"The pypdf package is required to import PDF pedigree forms.\n"
"Install it with:  pip install pypdf"
msgstr ""
"Zum Importieren von PDF-Stammbaumformularen ist das pypdf-Paket "
"erforderlich.\n"
"Installiere es mit:  pip install pypdf"

#, python-format
msgid "Could not open PDF file: %s"
msgstr "PDF-Datei konnte nicht geöffnet werden: %s"

msgid "Add media reference: PDF import"
msgstr "Medienreferenz hinzufügen: PDF-Import"

msgid "PDF import: no data found"
msgstr "PDF-Import: Keine Daten gefunden"

msgid ""
"No names were found in the pedigree form.\n"
"\n"
"Fill in the form fields and try again."
msgstr ""
"Im Stammbaumformular wurden keine Namen gefunden.\n"
"\n"
"Fülle die Formularfelder aus und versuche es erneut."

msgid "Bad references in PDF import"
msgstr "Fehlerhafte Verweise im PDF-Import"

msgid "PDF import error"
msgstr "Fehler beim PDF-Import"

msgid "Form importer unavailable"
msgstr "Formularimporteur nicht verfügbar"

msgid "importformpdf.py is missing from the PDFForms addon directory."
msgstr ""
"Die Datei „importformpdf.py“ fehlt im Verzeichnis der PDFForms-Erweiterung."

msgid "PDF import: unrecognized format"
msgstr "PDF-Import: Unbekanntes Format"

#, python-format
msgid ""
"No Gramps form ID found in '%s'.\n"
"\n"
"Only PDFs generated by Gramps (pedigree or form templates) can be imported."
msgstr ""
"In „%s“ wurde keine Gramps-Formular-ID gefunden.\n"
"\n"
"Es können nur von Gramps erstellte PDF-Dateien (Stammbaum- oder "
"Formularvorlagen) importiert werden."
