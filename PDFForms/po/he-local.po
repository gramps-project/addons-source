msgid "Generate PDF Forms"
msgstr "יצירת טופסי PDF"

msgid ""
"Generate blank fillable PDF forms: census/event forms or Ahnentafel pedigree "
"charts."
msgstr ""
"הפקת טופסי PDF ריקים שניתנים למילוי: טופסי מפקד/אירוע או תרשימי יוחסין מסוג "
"אהננטפל."

msgid "Import Fillable PDF Forms"
msgstr "ייבוא טופסי PDF שניתנים למילוי"

msgid ""
"Import genealogy data from a PDF form. Send the PDF template to others to "
"fill out and return."
msgstr "ייבוא נתוני יוחסין מטופס PDF. שליחת תבנית PDF לאחרים למילוי ולהחזרה."

msgid "Form addon required"
msgstr "נדרש תוסף הטפסים"

msgid ""
"The Form addon must be installed to import Form PDF files.\n"
"Please install the Form addon and restart Gramps."
msgstr ""
"יש להתקין את תוסף הטפסים כדי לייבא קובצי PDF של טפסים.\n"
"יש להתקין את תוסף הטפסים ולשתחל את גרמפס."

msgid "Not a Form PDF"
msgstr "אינו PDF של טופס"

msgid "The _form_id field is missing or empty."
msgstr "השדה _form_id חסר או ריק."

msgid "Unknown form ID"
msgstr "מזהה טופס לא ידוע"

#, python-format
msgid ""
"Form ID '%(id)s' is not recognised by the Form addon.\n"
"Known IDs: %(known)s"
msgstr ""
"מזהה הטופס '%(id)s' אינו מזוהה על ידי תוסף הטפסים.\n"
"מזהים ידועים: %(known)s"

#, python-format
msgid "Import Form PDF: %s"
msgstr "ייבוא טופס PDF: %s"

msgid "Census / Event Form"
msgstr "טופס מפקד / אירוע"

msgid "Ahnentafel Pedigree Chart"
msgstr "תרשים יוחסין אהננטפל"

msgid "Output file:"
msgstr "פלט קובץ:"

msgid "Browse…"
msgstr "דפדוף…"

msgid "Open PDF after generating"
msgstr "פתיחת PDF לאחר ההפקה"

msgid "Generate"
msgstr "לחולל"

msgid "Form:"
msgstr "טופס:"

msgid "Rows:"
msgstr "שורות:"

msgid "(Rows only affect multi-row sections such as census household lists.)"
msgstr ""
"(שורות משפיעות רק על מקטעים מרובי־שורות כגון רשימות משקי בית במפקד אוכלוסין.)"

msgid "Generations:"
msgstr "דורות:"

msgid "Includes subject plus up to 5 ancestor generations (2–32 people)."
msgstr "כולל כפוף פלוס ל־5 אב דורות (2–32 אנשים)."

msgid "Save PDF as…"
msgstr "שמירת PDF בשם…"

msgid "Save"
msgstr "שמירה"

msgid "PDF files"
msgstr "קובצי PDF"

msgid "No output file"
msgstr "אין קובץ פלט"

msgid "Please specify an output file path."
msgstr "נא לציין נתיב קובץ פלט."

msgid "No form selected"
msgstr "אין טופס שנבחר"

msgid "Please select a census form."
msgstr "נא לבחור טופס מפקד."

msgid "Form not found"
msgstr "טופס לא נמצאו"

msgid "Generation failed"
msgstr "דור נכשל"

msgid "PDF generated"
msgstr "קובץ PDF נוצר"

msgid ""
"The pypdf package is required to import PDF pedigree forms.\n"
"Install it with:  pip install pypdf"
msgstr ""
"חבילת pypdf נדרשת לייבוא טופסי אילן־יוחסין מ־PDF.\n"
"התקנה באמצעות:  pip install pypdf"

#, python-format
msgid "Could not open PDF file: %s"
msgstr "לא ניתן לפתוח קובץ PDF: %s"

msgid "Add media reference: PDF import"
msgstr "הוספת הפניית מדיה: ייבוא PDF"

msgid "PDF import: no data found"
msgstr "ייבוא PDF: לא נמצאו נתונים"

msgid ""
"No names were found in the pedigree form.\n"
"\n"
"Fill in the form fields and try again."
msgstr ""
"לא נמצאו שמות בטופס היוחסין.\n"
"\n"
"יש למלא את שדות הטופס ולנסות שוב."

msgid "Bad references in PDF import"
msgstr "הפניות שגויות בייבוא PDF"

msgid "PDF import error"
msgstr "שגיאת ייבוא PDF"

msgid "Form importer unavailable"
msgstr "יבואן הטפסים אינו זמין"

msgid "importformpdf.py is missing from the PDFForms addon directory."
msgstr "הקובץ importformpdf.py חסר במחיצת התוסף PDFForms."

msgid "PDF import: unrecognized format"
msgstr "ייבוא PDF: תסדיר בלתי מזוהה"

#, python-format
msgid ""
"No Gramps form ID found in '%s'.\n"
"\n"
"Only PDFs generated by Gramps (pedigree or form templates) can be imported."
msgstr ""
"לא נמצא מזהה טופס גרמפס ב־'%s'.\n"
"\n"
"אפשר לייבא רק קובצי PDF שנוצרו בגרמפס (תבניות אילן־יוחסין או טפסים)."
