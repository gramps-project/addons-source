msgid "Failure writing {target_path}: {message}"
msgstr "{target_path} yazılırken hata oluştu: {message}"

msgid "No central person selected"
msgstr "Seçili merkezi kişi yok"

msgid "Unknown time direction"
msgstr "Zaman yönü bilinmiyor"

msgid "author"
msgstr "Yazar"

msgid "publication_info"
msgstr "Yayın_bilgisi"

msgid "abbreviation"
msgstr "Kısaltma"

msgid "volume"
msgstr "Cilt"

msgid "of"
msgstr "<"

msgid "the chart type runs out of bounds"
msgstr "Grafik türü sınırların dışına çıkıyor"

