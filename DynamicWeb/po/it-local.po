msgid "Descending tree"
msgstr "Albero dei discendenti"

#, python-format
msgid "%(type)s: %(value)s"
msgstr "%(type)s: %(value)s"

#, python-format
msgid "(m. %s)"
msgstr "(spos. %s)"

msgid "Click on the map to show it full-screen"
msgstr "Fai clic sulla mappa per mostrarla a schermo intero"

msgid "Maximize"
msgstr "Massimizza"

msgid "Media Type"
msgstr "Tipo oggetti multimediali"

msgid "No matching records found"
msgstr "Nessuna informazione di registro corrispondente trovata"

msgid "SVG tree configuration"
msgstr "Configurazione albero SVG"

msgid "Search:"
msgstr "Cerca:"

msgid "Select the number of ascending generations"
msgstr "Seleziona il numero di generazioni di ascendenti"

msgid "Select the number of descending generations"
msgstr "Seleziona il numero di generazioni di discendenti"

msgid "Show duplicates"
msgstr "Mostra i duplicati"

msgid "Surnames Index"
msgstr "Indice dei cognomi"

msgid "Used for family"
msgstr "Usato per famiglia"

msgid "Used for media"
msgstr "Usato per oggetto multimediale"

msgid "Used for person"
msgstr "Usato per persona"

msgid "Used for place"
msgstr "Usato per luogo"

msgid "Used for source"
msgstr "Usato per fonte"

msgid "Web Link"
msgstr "Collegamento web"

#, python-format
msgid "Unable to copy web site template files from \"%(path)s\""
msgstr "Impossibile copiare i file di tipo modello di sito web da \"%(path)s\""

msgid "The title of the web site"
msgstr "Il titolo del sito web"

msgid "Select filter to restrict people that appear on web site"
msgstr ""
"Seleziona un filtro per restringere le persone che appariranno nel sito web"

msgid "Include records marked private"
msgstr "Includere informazioni marcate come private"

msgid "Whether to include private objects"
msgstr "Indica se includere gli oggetti privati"

msgid "Include Last Name Only"
msgstr "Includi solo il cognome"

msgid "Whether to export notes in the web pages"
msgstr "Indica se esportare le note nelle pagine web"

msgid "Whether or not to include the Repository Pages."
msgstr "Indica se includere le pagine degli archivi delle fonti."

msgid "Include images and media"
msgstr "Includi immagini e media"

msgid "Whether to include images and media in the web pages"
msgstr "Se includere immagini e oggetti multimediali nelle pagine web"

msgid "Whether to print the notes type in the notes text"
msgstr "Indica se stampare o meno il tipo di note nel testo delle note"

msgid "Print place pages"
msgstr "Stampa le pagine dei luoghi"

msgid "Whether to show pages for the places"
msgstr "Indica se visualizzare o meno le pagine per i luoghi"

msgid "Google map API key"
msgstr "Chiavi API di Google Maps"

msgid "The API key used for the Google map"
msgstr "La chiave dell'API usata per Google map"

msgid "Whether or not to include family pages"
msgstr "Indica se includere o meno le pagine delle famiglie"

msgid "Whether to show the last modification time in the pages footer"
msgstr ""
"Indica se visualizzare o meno l'ora di ultima modifica nel piè di pagina "
"delle pagine"

msgid "Whether to hide the Gramps ID"
msgstr "Indica se nascondere o meno l'ID Gramps"

msgid "Table"
msgstr "Tabella"

msgid "The default format for the surnames index"
msgstr "Il formato standard per l'indice dei cognomi"

msgid "The default format for the sources index"
msgstr "Il formato standard per l'indice delle fonti"

msgid "Whether to generate an index page for families"
msgstr "Indica se generare o meno una pagina di indice per le famiglie"

msgid "Whether to include a column showing the media path"
msgstr ""
"Indica se includere o meno una colonna che mostra il percorso dell'oggetto "
"multimediale"

msgid ""
"The maximum number of generations to include in the ancestor and descendant "
"trees and graphs"
msgstr ""
"Il numero massimo di generazioni da includere negli alberi e nei grafici di "
"ascendenti e discendenti"

msgid "Theme"
msgstr "Tema"

msgid "A note to be used for the custom page content.\n"
msgstr "Una nota da usare per il contenuto personalizzato della pagina.\n"

msgid "Pages selection"
msgstr "Seleziona pagine"
