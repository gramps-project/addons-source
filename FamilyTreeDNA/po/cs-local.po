msgstr "Import FamilyTree DNA"

#, python-brace-format
msgid ""
"{} Associations with DNA data created. {} haplogroup Attributes created \n"
msgstr ""
"Vytvořeno {} asociací s daty DNA. Vytvořeno {} atributů haploskupiny \n"

msgid "No Family Finder File specified"
msgstr "Není zadán soubor Family Finder"

msgid "No Segment File specified"
msgstr "Není zadán soubor segmentů"

msgid "No Associations found in FTdna Notes. No haplogroup Attributes created."
msgstr ""
"V poznámkách FTdna nebyly nalezeny žádné asociace. Nebyly vytvořeny žádné "
"atributy haploskupin."

#, python-format
