msgid "Family Finder Tool"
msgstr "Nástroj Family Finder"

msgid "Enter FTDNA Family Finder Filename:"
msgstr "Zadejte název souboru FTDNA Family Finder:"

msgid "Enter FTDNA Chromosome Segment Filename:"
msgstr "Zadejte název souboru chromozomových segmentů FTDNA:"

msgid "Import Haplogroups"
msgstr "Importovat haploskupiny"

msgid "FTDNA Note string :"
msgstr "Text poznámky FTDNA:"

