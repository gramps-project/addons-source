msgid "Family Finder Tool"
msgstr "Family Finder ツール"

msgid "Enter FTDNA Family Finder Filename:"
msgstr "FTDNAファミリーファインダーのファイル名を入力してください:"

msgid "Enter FTDNA Chromosome Segment Filename:"
msgstr "FTDNA染色体セグメントファイル名を入力してください:"

msgid "Import Haplogroups"
msgstr "Haplogroups のインポート"

msgid "FTDNA Note string :"
msgstr "FTDNA メモ文字列 :"

msgid "Shared Citation ID :"
msgstr "共有引用 ID :"

msgid "Active Person : "
msgstr "アクティブな人 : "

msgid "Import data from Family Finder files"
msgstr "Family Finderファイルからデータをインポートする"

msgid "Close the Family Finder Tool"
msgstr "ファミリーファインダーツールを閉じる"

msgid "Read Help manual"
msgstr "ヘルプマニュアルを読む"

msgid "FamilyTree DNA Import"
msgstr "家系図 DNA のインポート"

msgid ""
"{} Associations with DNA data created. {} haplogroup Attributes created \n"
msgstr ""
"{} 個のDNAデータとの関連付けが作成されました。 {} 個のhaplogroup属性が作成さ"
"れました \n"

msgid "No Family Finder File specified"
msgstr "ファミリーファインダーファイルが指定されていません"

msgid "No Segment File specified"
msgstr "セグメント ファイルが指定されていません"

msgid "No Associations found in FTdna Notes. No haplogroup Attributes created."
msgstr ""
"FTdnaノートに関連付けが見つかりませんでした。haplogroup属性は作成されませんで"
"した。"

#, python-format
msgid "Add %s haplogroup attribute"
msgstr "%s haplogroup属性を追加"

#, python-format
msgid "Add %s DNA Association"
msgstr "%s DNA関連付けを追加"

#, python-format
msgid "Create Note for %s DNA Association"
msgstr "%s DNA関連付けのメモを作成"

#, python-format
msgid "Add Note to %s DNA Association"
msgstr "%s DNA関連付けにメモを追加"

#, python-format
msgid "Create Source Citation for %s DNA Association"
msgstr "%s DNA関連付けのソース引用を作成"

#, python-format
msgid "Create Citation for %s DNA Association"
msgstr "%s DNA関連付けの引用を作成"

#, python-format
msgid "Add Citation to %s DNA Association"
msgstr "%s DNA関連付けに引用を追加"

msgid "FamilyTree DNA"
msgstr "家系図 DNA"

msgid "Tool to import FamilyFinder DNA data from Family Tree"
msgstr "家系図からFamilyFinder DNAデータをインポートするツール"
