msgid "FamilyTree DNA"
msgstr "DNK rodoslova"

msgid "Tool to import FamilyFinder DNA data from Family Tree"
msgstr "Alat za uvoz FamilyFinder DNK podataka od Family Tree stranice"

msgid "Family Finder Tool"
msgstr "Alat za pronalaženje obitelji"

msgid "Enter FTDNA Family Finder Filename:"
msgstr "Upiši ime FTDNA datoteke pronalazača obitelji:"

msgid "Enter FTDNA Chromosome Segment Filename:"
msgstr "Upiši ime FTDNA datoteke segmenata kromosoma:"

msgid "Import Haplogroups"
msgstr "Uvezi haplogrupe"

msgid "FTDNA Note string :"
msgstr "FTDNA zabilješka:"

msgid "Shared Citation ID :"
msgstr "Dijeljeni ID citata:"

msgid "Active Person : "
msgstr "Aktivna osoba: "

msgid "Import data from Family Finder files"
msgstr "Uvezi podatake iz Family Finder datoteka"

msgid "Close the Family Finder Tool"
msgstr "Zatvori alat za pronalaženje obitelji"

msgid "Read Help manual"
msgstr "Pročitaj priručnik za pomoć"

msgid "FamilyTree DNA Import"
msgstr "Uvoz DNK-a rodoslova"

msgid ""
"{} Associations with DNA data created. {} haplogroup Attributes created \n"
msgstr ""
"Broj stvorenih veza s DNK podacima: {}. Broj stvorenih atributa haplogrupe: "
"{} \n"

msgid "No Family Finder File specified"
msgstr "Nije navedena datoteka za pronalaženje obitelji"

msgid "No Segment File specified"
msgstr "Nije navedena datoteka segmenata"

msgid "No Associations found in FTdna Notes. No haplogroup Attributes created."
msgstr ""
"Nisu pronađene veze u FTdna bilješkama. Svojstva haplogrupe nisu stvoreni."

#, python-format
msgid "Add %s haplogroup attribute"
msgstr "Dodaj %s svojstvo haplogrupe"

#, python-format
msgid "Add %s DNA Association"
msgstr "Dodaj %s DNK vezu"

#, python-format
msgid "Create Note for %s DNA Association"
msgstr "Stvori bilješku za %s DNK vezu"

#, python-format
msgid "Add Note to %s DNA Association"
msgstr "Dodaj bilješku u %s DNK vezu"

#, python-format
msgid "Create Source Citation for %s DNA Association"
msgstr "Stvori citat izvora za %s DNK vezu"

#, python-format
msgid "Create Citation for %s DNA Association"
msgstr "Stvori citat za %s DNK vezu"

#, python-format
msgid "Add Citation to %s DNA Association"
msgstr "Dodaj citat u %s DNK vezu"
