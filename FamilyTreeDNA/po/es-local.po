msgid "FamilyTree DNA"
msgstr "ADN del Árbol Familiar"

msgid "Tool to import FamilyFinder DNA data from Family Tree"
msgstr ""
"Herramienta para importar datos del ADN de FamilyFinder desde el Árbol "
"Familiar"

msgid "Family Finder Tool"
msgstr "Herramienta de Family Finder"

msgid "Enter FTDNA Family Finder Filename:"
msgstr "Introduzca el nombre del archivo de Family Finder FTDNA:"

msgid "Enter FTDNA Chromosome Segment Filename:"
msgstr "Introduzca el nombre de archivo del Segmento del Cromosoma FTDNA:"

msgid "Import Haplogroups"
msgstr "Importar Haplogrupos"

msgid "FTDNA Note string :"
msgstr "Cadena de Nota FTDNA :"

msgid "Shared Citation ID :"
msgstr "ID de cita compartida :"

msgid "Active Person : "
msgstr "Persona activa : "

msgid "Import data from Family Finder files"
msgstr "Importar datos desde archivos de Family Finder"

msgid "Close the Family Finder Tool"
msgstr "Cierra la Herramienta Family Finder"

msgid "Read Help manual"
msgstr "Lea el manual de Ayuda"

msgid "FamilyTree DNA Import"
msgstr "Importar ADN de FamilyTree"

msgid ""
"{} Associations with DNA data created. {} haplogroup Attributes created \n"
msgstr ""
"{} Asociaciones con datos de ADN creada. {} Atributos de haplogrupo "
"creados \n"

msgid "No Family Finder File specified"
msgstr "Ningún archivo de Family Finder específico"

msgid "No Segment File specified"
msgstr "No se ha especificado Ningún Archivo"

msgid "No Associations found in FTdna Notes. No haplogroup Attributes created."
msgstr ""
"No se ha encontrar ninguna de las Asociaciones en Notas FTdna. Ningún "
"Atributo de grupo haplo creado."

