msgstr "Crea Nota para Asociación %s de ADN"

#, python-format
msgid "Add Note to %s DNA Association"
msgstr "Agrega Nota a Asociación ADN %s"

#, python-format
msgid "Create Source Citation for %s DNA Association"
msgstr "Crea Cita Origen para Asociación %s de ADN"

#, python-format
msgid "Create Citation for %s DNA Association"
msgstr "Crea Cita para Asociación %s ADN"

#, python-format
