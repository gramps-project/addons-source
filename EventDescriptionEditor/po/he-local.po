msgid "Event Description Editor"
msgstr "עורך תיאור אירועים"

msgid "Search substring..."
msgstr "חיפוש מחרוזת משנה..."

msgid "INFO"
msgstr "מידע"

#, python-format
msgid "%s event descriptions of %s events were changed."
msgstr "תיאורי אירוע של %s מתוך %s אירועים שונו."

msgid "Find"
msgstr "חיפוש"

msgid "Replace"
msgstr "החלפה"

msgid "Replace substring only"
msgstr "החלפת תת־מחרוזת בלבד"

msgid ""
"If True only the substring will be replaced, otherwise the whole description "
"will be deleted and replaced by the new one."
msgstr ""
"אם הערך True, רק תת־המחרוזת תוחלף; אחרת, כל התיאור יימחק ויוחלף בתיאור החדש."

msgid "Allow regex"
msgstr "לאפשר ביטוי רגיל (regex)"

msgid "Allow regular expressions."
msgstr "לאפשר ביטויים סדירים."

msgid ""
"A tool to find and replace a string in event description of multiple events."
msgstr "כלי לאיתור והחלפת מחרוזת בתיאור אירוע של אירועים מרובים."
