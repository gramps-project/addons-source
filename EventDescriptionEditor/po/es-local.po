msgid "Event Description Editor"
msgstr "Editor de descripciones de eventos"

msgid "Search substring..."
msgstr "Buscar subcadena…"

msgid "INFO"
msgstr "INF."

#, python-format
msgid "%s event descriptions of %s events were changed."
msgstr "%s de descripciones de evento de %s eventos eran cambiados."

msgid "Find"
msgstr "Buscar"

msgid "Replace"
msgstr "Reemplazar"

msgid "Replace substring only"
msgstr "Solo reemplace sub‐cadenas"

msgid ""
"If True only the substring will be replaced, otherwise the whole description "
"will be deleted and replaced by the new one."
msgstr ""
"Si es cierto (True) la subcadena será remplazada, en otro caso la "
"descripción completa será eliminada y remplazada por uno nuevo."

msgid "Allow regex"
msgstr "Concede exreg"

msgid "Allow regular expressions."
msgstr "Concede expresiones regulares."

msgid ""
"A tool to find and replace a string in event description of multiple events."
msgstr ""
"Una herramienta para encontrar y reemplazar una cadena perteneciente a una "
"descripción del evento de múltiples eventos."
