msgid "Event Description Editor"
msgstr "Редактор описания событий"

msgid "Search substring..."
msgstr "Поиск подстроки"

msgid "INFO"
msgstr "ИНФОРМАЦИЯ"

#, python-format
msgid "%s event descriptions of %s events were changed."
msgstr "Было изменено %s описаний событий в %s событиях."

msgid "Find"
msgstr "Найти"

msgid "Replace"
msgstr "Заменить"

msgid "Replace substring only"
msgstr "Заменить только подстроку"

msgid ""
"If True only the substring will be replaced, otherwise the whole description "
"will be deleted and replaced by the new one."
msgstr ""
"Если установлено, то будет заменена только подстрока, иначе будет удалено "
"всё описание и заменено новым."

msgid ""
"A tool to find and replace a string in event description of multiple events."
msgstr "Инструмент для поиска и замены строк в описании нескольких событий."
