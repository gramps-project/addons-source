msgid "Event Description Editor"
msgstr "Editor popisu událostí"

msgid "Search substring..."
msgstr "Hledá se podřetězec..."

msgid "INFO"
msgstr "INFORMACE"

#, python-format
msgid "%s event descriptions of %s events were changed."
msgstr "Počet změněných popisů událostí: %s; celkový počet událostí: %s."

msgid "Find"
msgstr "Najít"

msgid "Replace"
msgstr "Nahradit"

msgid "Replace substring only"
msgstr "Nahradit pouze podřetězec"

msgid ""
"If True only the substring will be replaced, otherwise the whole description "
"will be deleted and replaced by the new one."
msgstr ""
"Pokud je zapnuto, nahradí se pouze podřetězec. Jinak se celý popis smaže a "
"nahradí novým."

msgid "Allow regex"
msgstr "Povolit regulární výrazy"

msgid "Allow regular expressions."
msgstr "Povolit regulární výrazy."

msgid ""
"A tool to find and replace a string in event description of multiple events."
msgstr "Nástroj pro vyhledání a nahrazení řetězce v popisech více událostí."
