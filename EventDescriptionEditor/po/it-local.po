msgid "Event Description Editor"
msgstr "Editor descrizione evento"

msgid "Search substring..."
msgstr "Ricerca sottostringa..."

msgid "INFO"
msgstr "INFO"

#, python-format
msgid "%s event descriptions of %s events were changed."
msgstr "%s descrizioni di eventi di %s eventi sono state modificate."

msgid "Find"
msgstr "Trova"

msgid "Replace"
msgstr "Sostituzioni"

msgid "Replace substring only"
msgstr "Sostituisci solo la sottostringa"

msgid ""
"If True only the substring will be replaced, otherwise the whole description "
"will be deleted and replaced by the new one."
msgstr ""
"Se vero, verrà sostituita solo la sottostringa, altrimenti l'intera "
"descrizione verrà eliminata e sostituita da quella nuova."

msgid "Allow regex"
msgstr "Permetti espressione regolare"

msgid "Allow regular expressions."
msgstr "Permette le espressioni reegolari."

msgid ""
"A tool to find and replace a string in event description of multiple events."
msgstr ""
"Uno strumento per cercare e sostituire una stringa nella descrizione di "
"eventi multipli."
