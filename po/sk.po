#: WebSearch/info_panel.py:108
msgid "## 🧩 About WebSearch"
msgstr "## 🧩 O WebSearch"

#: WebSearch/info_panel.py:111
msgid ""
"WebSearch is a Gramplet for Gramps that helps you search genealogy-related "
"websites."
msgstr ""
"WebSearch je gramplet pre Gramps, ktorý vám pomáha vyhľadávať webové sídla "
"súvisiace s genealógiou."

#: WebSearch/info_panel.py:117
msgid ""
"It supports CSV-based link templates, AI-assisted site discovery, and direct "
"integration with notes and attributes."
msgstr ""
"Podporuje šablóny odkazov založené na CSV, vyhľadávanie webových stránok s "
"pomocou umelej inteligencie a priamu integráciu s poznámkami a atribútmi."

#: WebSearch/info_panel.py:125
msgid "## ⚙️ System Information"
msgstr "## ⚙️ Informácie o systéme"

#: WebSearch/info_panel.py:128
msgid "🔻 **Missing:** `qrcode`"
msgstr "🔻 **Chýba:** `qrcode`"

#: WebSearch/info_panel.py:130
msgid "ℹ️ This Python library is not available in your system."
msgstr "ℹ️ Táto knižnica Python nie je vo vašom systéme k dispozícii."

#: WebSearch/info_panel.py:133
msgid "Without it, QR code generation will not work."
msgstr "Bez nej nebude fungovať generovanie QR kódov."

#: WebSearch/info_panel.py:136
msgid "💡 Usually installed with: `pip install qrcode[pil]`"
msgstr "💡 Zvyčajne sa inštaluje pomocou: `pip install qrcode[pil]`"

#: WebSearch/info_panel.py:140 WebSearch/info_panel.py:162
#: WebSearch/info_panel.py:181
msgid ""
"*Note: Some operating systems or environments may require alternative "
"installation methods.*"
msgstr ""
"*Poznámka: Niektoré operačné systémy alebo prostredia môžu vyžadovať "
"alternatívne metódy inštalácie.*"

#: WebSearch/info_panel.py:147
msgid "🔻 **Missing:** `openai`"
msgstr "🔻 **Chýba:** `openai`"

#: WebSearch/info_panel.py:149
msgid "ℹ️ This library is required for accessing OpenAI-based features."
msgstr "ℹ️ Táto knižnica je potrebná na prístup k funkciám založeným na OpenAI."

#: WebSearch/info_panel.py:153
msgid ""
"Without it, AI-generated site suggestions and place history will be disabled."
msgstr ""
"Bez nej budú návrhy stránok generované umelou inteligenciou a história "
"miesta deaktivované."

#: WebSearch/info_panel.py:158
msgid "💡 Usually installed with: `pip install openai`"
msgstr "💡 Zvyčajne sa inštaluje pomocou: `pip install openai`"

#: WebSearch/info_panel.py:169
msgid "🔻 **Missing:** `requests`"
msgstr "🔻 **Chýba:** `requests`"

#: WebSearch/info_panel.py:171
msgid "ℹ️ This library is used to communicate with web APIs."
msgstr "ℹ️ Táto knižnica sa používa na komunikáciu s webovými API."

#: WebSearch/info_panel.py:174
msgid "Without it, external data sources may not be accessible."
msgstr "Bez nej môžu byť externé zdroje údajov nedostupné."

#: WebSearch/info_panel.py:177
msgid "💡 Usually installed with: `pip install requests`"
msgstr "💡 Zvyčajne sa inštaluje pomocou: `pip install requests`"

