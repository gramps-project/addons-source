msgid "## ⚙️ System Information"
msgstr "## ⚙️ Informácie o systéme"

#: WebSearch/info_panel.py:128
msgid "🔻 **Missing:** `qrcode`"
msgstr "🔻 **Chýba:** `qrcode`"

#: WebSearch/info_panel.py:130
msgid "ℹ️ This Python library is not available in your system."
msgstr "ℹ️ Táto knižnica Python nie je vo vašom systéme k dispozícii."

#: WebSearch/info_panel.py:133
msgid "Without it, QR code generation will not work."
msgstr "Bez nej nebude fungovať generovanie QR kódov."

#: WebSearch/info_panel.py:136
msgid "💡 Usually installed with: `pip install qrcode[pil]`"
msgstr "💡 Zvyčajne sa inštaluje pomocou: `pip install qrcode[pil]`"

