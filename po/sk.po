#: EditExifMetadata/editexifmetadata.py:1135
#: EditExifMetadata/editexifmetadata.py:1147
msgid "Edit Image Exif Metadata"
msgstr "Úprava Exif metadát obrázku"

#: EditExifMetadata/editexifmetadata.gpr.py:31
msgid "Gramplet to view, edit, and save image Exif metadata"
msgstr "Gramplet na zobrazenie, úpravu a uloženie Exif metadát obrázka"

#: EditExifMetadata/editexifmetadata.gpr.py:35
msgid "Edit Exif Metadata"
msgstr "Upraviť Exif metadáta"

#: EditExifMetadata/editexifmetadata.py:135
msgid "<-- Image Types -->"
msgstr "<-- Typy obrázkov -->"

#: EditExifMetadata/editexifmetadata.py:158
msgid ""
"Warning:  Changing this entry will update the Media object title field in "
"Gramps not Exiv2 metadata."
msgstr ""
"Upozornenie:   Zmena tejto položky aktualizuje pole názvu objektu média v "
"Gramps, nie Exiv2 metadáta."

#: EditExifMetadata/editexifmetadata.py:161
msgid "Provide a short description for this image."
msgstr "Poskytnite krátky popis pre tento obrázok."

#: EditExifMetadata/editexifmetadata.py:163
msgid ""
"Enter the Artist/ Author of this image.  The person's name or the company "
"who is responsible for the creation of this image."
msgstr ""
"Zadajte umelca/autora tohto obrázku.   Meno osoby alebo spoločnosti, ktorá "
"je zodpovedná za jeho vytvorenie."

#: EditExifMetadata/editexifmetadata.py:167
msgid "Enter the copyright information for this image. \n"
msgstr "Zadajte informácie o autorských právach k tomuto obrázku. \n"

#: EditExifMetadata/editexifmetadata.py:169
msgid ""
"The original date/ time when the image was first created/ taken as in a "
"photograph.\n"
"Example: 1830-01-1 09:30:59"
msgstr ""
"Pôvodný dátum/ čas, keď bol obrázok prvýkrát vytvorený/ vyfotený ako "
"fotografia.\n"
"Príklad: 1830-01-1 09:30:59"

#: EditExifMetadata/editexifmetadata.py:173
msgid ""
"This is the date/ time that the image was last changed/ modified.\n"
"Example: 2011-05-24 14:30:00"
msgstr ""
"Toto je dátum/ čas, keď bol obrázok naposledy zmenený/ upravený.\n"
"Príklad: 2011-05-24 14:30:00"

#: EditExifMetadata/editexifmetadata.py:176
msgid ""
"Enter the Latitude GPS coordinates for this image,\n"
"Example: -43.722965, -43:43:22, 38° 38′ 03″ N"
msgstr ""
"Zadajte zemepisnú šírku GPS súradníc pre tento obrázok,\n"
"Príklad: -43.722965, -43:43:22, 38° 38′ 03″ S"

#: EditExifMetadata/editexifmetadata.py:179
msgid ""
"Enter the Longitude GPS coordinates for this image,\n"
"Example: -10.396378, -10:23:46, 105° 6′ 6″ W"
msgstr ""
"Zadajte zemepisnú dĺžku GPS súradníc pre tento obrázok,\n"
"Príklad: -10.396378, -10:23:46, 105° 6′ 6″ Z"

#: EditExifMetadata/editexifmetadata.py:182
msgid ""
"This is the measurement of Above or Below Sea Level.  It is measured in "
"meters.  Example: 200.558, -200.558"
msgstr ""
"Toto je meranie nad alebo pod hladinou mora.   Meria sa v metroch.   "
"Príklad: 200.558, -200.558"

#: EditExifMetadata/editexifmetadata.py:191
msgid ""
"Displays the Gramps Wiki Help page for 'Edit Image Exif Metadata' in your "
"web browser."
msgstr ""
"Vo vašom webovom prehliadači zobrazí stránku pomocníka Gramps Wiki s témou "
"'Úprava Exif metadát obrázku'."

#: EditExifMetadata/editexifmetadata.py:194
msgid ""
"This will open up a new window to allow you to edit/ modify this image's "
"Exif metadata.\n"
"  It will also allow you to be able to Save the modified metadata."
msgstr ""
"Otvorí nové okno, ktoré vám umožní upraviť/ modifikovať Exif metadáta tohto "
"obrázku.\n"
"Tiež vám umožní uložiť upravené metadáta."

#: EditExifMetadata/editexifmetadata.py:198
msgid "Will produce a Popup window showing a Thumbnail Viewing Area"
msgstr "Vytvorí sa vyskakovacie okno zobrazujúce oblasť prezerania miniatúr"

#: EditExifMetadata/editexifmetadata.py:201
msgid ""
"Select from a drop- down box the image file type that you would like to "
"convert your non- Exiv2 compatible media object to."
msgstr ""
"Vyberte z rozbaľovacieho menu typ súboru obrázku, na ktorý chcete "
"konvertovať váš mediálny objekt nekompatibilný s Exiv2."

#: EditExifMetadata/editexifmetadata.py:205
msgid ""
"If your image is not of an image type that can have Exif metadata read/ "
"written to/from, convert it to a type that can?"
msgstr ""
"Ak váš obrázok nie je typu, ktorý môže mať Exif metadáta čítané/ zapisované, "
"konvertovať ho na typ, ktorý môže?"

#: EditExifMetadata/editexifmetadata.py:209
msgid ""
"WARNING:  This will completely erase all Exif metadata from this image!  Are "
"you sure that you want to do this?"
msgstr ""
"UPOZORNENIE:   Toto úplne vymaže všetky Exif metadáta z tohto obrázku! Ste "
"si istí, že to chcete urobiť?"

