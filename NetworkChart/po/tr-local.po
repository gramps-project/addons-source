msgid "File exists. Overwrite?"
msgstr "Dosya mevcut. Üzerine yazılsın mı?"

msgid "created"
msgstr "oluşturuldu"

msgid "last_written"
msgstr "son_yazılan"

msgid "Main"
msgstr "Ana"

msgid "Orthogonal (right angles in connectors)"
msgstr "Ortogonal (bağlantılarda dik açılar)"

msgid "Straight (no right angles in connectors)"
msgstr "Düz (bağlantı noktalarında dik açılar yok)"

msgid "Curved (curved and straight connectors)"
msgstr "Kavisli (kavisli ve düz bağlantı elemanları)"

msgid "Default (Orthogonal)"
msgstr "Varsayılan (Ortogonal)"

msgid "Select the graph line connector format."
msgstr "Grafik çizgi bağlantı biçimini seçin."

msgid "Top to Bottom"
msgstr "Yukarıdan Aşağıya"

msgid "Left to Right"
msgstr "Soldan Sağa"

msgid "Bottom to Top"
msgstr "Aşağıdan Yukarıya"

msgid "Right to Left"
msgstr "Sağdan Sola"

msgid "Default (Top to Bottom)"
msgstr "Varsayılan (Yukarıdan Aşağıya)"

msgid "Select the graph direction."
msgstr "Grafik yönünü seçin."

msgid "URL Style"
msgstr "URL Stili"

msgid "Include URLs from database."
msgstr "Veritabanından URL adreslerini dahil et."

msgid "Dynamic URL = Prefix + GrampID + Suffix"
msgstr "Dinamik URL = Önek + GrampsID + Sonek"

msgid "Static URL = Prefix"
msgstr "Statik URL = Önek"

msgid "Don't include URLs"
msgstr "URL adreslerini dahil etme"

msgid "Default (include)"
msgstr "Varsayılan (dahil et)"

msgid "Select URL style."
msgstr "URL stilini seçin."

msgid "URL Prefix,Suffix"
msgstr "URL Önek, Sonek"

msgid ""
"Enter the Prefix,Suffix (use comma)\n"
"for dynamically generated URLs.\n"
"URL = Prefix + GrampsID + Suffix."
msgstr ""
"Dinamik olarak oluşturulan URL adresleri için\n"
"Önek ve Soneki girin (virgül kullanın).\n"
"URL = Önek + GrampsID + Sonek."

msgid "Enter Font Name"
msgstr "Yazı Tipi Adını Girin"

msgid ""
"Enter the primary font style for the chart.\n"
"Must already be installed.\n"
"White Rabbit can be obtained from\n"
"https://www.fontsquirrel.com/fonts/white-rabbit"
msgstr ""
"Grafik için birincil yazı tipi stilini girin.\n"
"Zaten yüklü olmalıdır.\n"
"White Rabbit yazı tipi şu adresten edinilebilir:\n"
"https://www.fontsquirrel.com/fonts/white-rabbit"

msgid "Spacing (inch)"
msgstr "Aralık (inç)"

msgid ""
"Enter the seperation distance between \"Generations\" in inches (0.1-5.0)."
msgstr ""
"\"Nesiller\" arasındaki ayırma mesafesini inç cinsinden girin (0,1-5,0)."

msgid "Enter Chart Title"
msgstr "Grafik Başlığını Girin"

msgid "Set the title of the chart."
msgstr "Grafiğin başlığını ayarlayın."

msgid "Default (svg)"
msgstr "Varsayılan (svg)"

msgid ""
"svg - Scalable Vector Graphics file.\n"
"pdf - Adobe Portable Document Format.\n"
msgstr ""
"svg - Ölçeklenebilir Vektör Grafikleri dosyası.\n"
"pdf - Adobe Taşınabilir Belge Biçimi.\n"

msgid "The destination folder for generated files."
msgstr "Oluşturulan dosyaların hedef klasörü."

msgid "network"
msgstr "ağ"

msgid "The filename for the generated svg network chart."
msgstr "Oluşturulan svg ağ grafiğinin dosya adı."

msgid "Different node shapes/edges for gender."
msgstr "Cinsiyete göre farklı düğüm şekilleri/kenarları."

msgid "Node differences for gender."
msgstr "Cinsiyete göre düğüm farklılıkları."

msgid "Male Background"
msgstr "Erkek Arka Planı"

msgid "RGB-color for male box background."
msgstr "Erkek kutusu arka planı için RGB rengi."

msgid "Male Background Alpha"
msgstr "Erkek Arka Planı Alfa"

msgid "Alpha for Male box background (transparent=0, solid=255)."
msgstr "Erkek kutusu arka planı için alfa değeri (şeffaf=0, dolu=255)."

msgid "Male Box Edge"
msgstr "Erkek Kutusu Kenarı"

msgid "RGB-color for Male box edge."
msgstr "Erkek kutusu kenarı için RGB rengi."

msgid "Female Background"
msgstr "Kadın Arka Planı"

msgid "RGB-color for Female box background."
msgstr "Kadın kutusu arka planı için RGB rengi."

msgid "Female Background Alpha"
msgstr "Kadın Arka Planı Alfa"

msgid "Alpha for Female box background (transparent=0, solid=255)."
msgstr "Kadın kutusu arka planı için alfa değeri (şeffaf=0, dolu=255)."

msgid "Female Box Edge"
msgstr "Kadın Kutusu Kenarı"

msgid "RGB-color for Female box edge."
msgstr "Kadın kutusu kenarı için RGB rengi."

msgid "Other Background"
msgstr "Diğer Arka Plan"

msgid "RGB-color for other box background."
msgstr "Diğer kutu arka planı için RGB rengi."

msgid "Other Background Alpha"
msgstr "Diğer Arka Plan Alfa"

msgid "Alpha for Other box background (transparent=0, solid=255)."
msgstr "Diğer kutu arka planı için alfa değeri (şeffaf=0, dolu=255)."

msgid "Family Connector Line"
msgstr "Aile Bağlantı Çizgisi"

msgid "RGB-color for family connector line."
msgstr "Aile bağlantı çizgisi için RGB rengi."

msgid "Marriage Connector Line"
msgstr "Evlilik Bağlantı Çizgisi"

msgid "RGB-color for marriage connector line."
msgstr "Evlilik bağlantı çizgisi için RGB rengi."

msgid "Highlight Connector Line"
msgstr "Vurgulanmış Bağlantı Çizgisi"

msgid ""
"RGB-color for the highlighted path between two individuals.  If the "
"graph.inverts, reverse the order to change."
msgstr ""
"İki kişi arasındaki vurgulanmış yol için RGB rengi.  Grafik tersine "
"çevrilirse, değiştirmek için sırayı tersine çevirin."

msgid "Trim Box Edge"
msgstr "Kırpılmış Kutu Kenarı"

msgid "RGB-color for box edge that has been trimmed."
msgstr "Kırpılmış kutu kenarı için RGB rengi."

msgid "Remove color background on all nodes."
msgstr "Tüm düğümlerdeki renk arka planını kaldırın."

msgid "Removes color background for individuals (nodes) on chart."
msgstr "Grafikteki bireyler (düğümler) için renkli arka planı kaldırır."

msgid ""
"Enter year to start\n"
"rounding birthday\n"
"to year only"
msgstr ""
"Doğum gününü yalnızca\n"
"yıla yuvarlamaya başlamak\n"
"için yılı girin"

msgid ""
"Birthdays after this year are represented by the year only.  Invalid entries "
"will be ignored."
msgstr ""
"Bu yıldan sonraki doğum günleri yalnızca yıl ile temsil edilir.  Geçersiz "
"girişler yok sayılacaktır."

msgid "Round birthday to year after year entered (above)."
msgstr "Girilen yıldan sonraki doğum gününü yıla yuvarlayın (yukarıda)."

msgid "Represent birthday by year only."
msgstr "Doğum gününü yalnızca yıl olarak göster."

msgid ""
"Enter year to start\n"
"rounding marriage\n"
"date to year only"
msgstr ""
"Evlilik tarihinin yalnızca\n"
"yıla yuvarlanmaya\n"
"başlanması için yılı girin"

msgid ""
"Marriages after this year are represented bythe year only. Invalid entries "
"will be ignored."
msgstr ""
"Bu yıldan sonraki evlilikler yalnızca yıl ile temsil edilir. Geçersiz "
"girişler yok sayılacaktır."

msgid "Round marriage to year after year entered (above)."
msgstr "Girilen yıla göre evlilik yılını yuvarla (yukarıda)."

msgid "Represent marriage by year only."
msgstr "Evliliği yalnızca yıla göre gösterin."

msgid ""
"Attempts to remove middle names.  Only works for entries with birth year in "
"the record."
msgstr ""
"İkinci adları kaldırmayı dener.  Yalnızca kayıtta doğum yılı bulunan "
"girdilerde çalışır."

msgid "Remove middle names."
msgstr "İkinci adları kaldır."

msgid "Allow inclusion of private records in chart."
msgstr "Grafiğe özel kayıtların dahil edilmesine izin ver."

msgid "Trim"
msgstr "Kırp"

msgid "Trim descendants"
msgstr "Soyundan gelenleri kırp"

msgid "All descendants (children) of selected individuals will not be shown."
msgstr ""
"Seçilen kişilerin tüm soyundan gelenleri (çocukları) gösterilmeyecektir."

msgid "Enable trimming of descendants."
msgstr "Soyundan gelenlerin kırpılmasını etkinleştir."

msgid ""
"You must enter valid person(s) before \n"
"enabling trimming of descendants from tree."
msgstr ""
"Ağaçta soyundan gelenlerin kırpılmasını\n"
"etkinleştirmeden önce geçerli kişi(leri) girmelisiniz."

msgid "Trim ancestors"
msgstr "Ataları kırpın"

msgid "All ancestors (parents) of selected individuals will not be shown."
msgstr "Seçilen kişilerin tüm ataları (ebeveynleri) gösterilmeyecektir."

msgid "Enable trimming of ancestors."
msgstr "Ataların kırpılmasını etkinleştir."

msgid "Enable trimming of ancestors from tree."
msgstr "Ağaçtan ataların kırpılmasını etkinleştir."

msgid "Enable trim groups."
msgstr "Grupları kırpmayı etkinleştirin."

msgid ""
"Remove groups less than Min Group Size.  Automatic\n"
"for databases with more than 1500 individuals."
msgstr ""
"En Küçük Grup Boyutu değerinden küçük grupları kaldır.\n"
"1500'den fazla kişi içeren veritabanları için otomatik olarak uygulanır."

msgid "Min Group Size"
msgstr "En Küçük Grup Boyutu"

msgid ""
"Enter the minimum size group to display.\n"
"Value may be 2 or greater."
msgstr ""
"Gösterilecek en küçük grup boyutunu girin.\n"
"Değer 2 veya daha büyük olabilir."

msgid ""
"Select Start and\n"
"End Individuals in\n"
"displayed path(s).\n"
"Select two"
msgstr ""
"Görüntülenen yol(lar)daki\n"
"başlangıç ve bitiş\n"
"kişilerini seçin.\n"
"İki kişi seçin"

msgid ""
"Starting and ending person for displayed path(s).\n"
"Select two people"
msgstr ""
"Görüntülenen yol(lar) için başlangıç ve bitiş kişisi.\n"
"İki kişi seçin"

msgid "Highlight path(s)"
msgstr "Yol(lar)ı vurgula"

msgid "Direct"
msgstr "Doğrudan"

msgid "Any"
msgstr "Herhangi bir"

msgid "Default (None)"
msgstr "Varsayılan (Yok)"

msgid ""
"None - Don't highlight paths.\n"
"Direct - Highlight direct descendant/ancestor paths.\n"
"Any - Highlight any path(s) including direct or indirect."
msgstr ""
"Yok - Yolları vurgulamayın.\n"
"Doğrudan - Doğrudan soyundan gelen/ata yollarını vurgula.\n"
"Herhangi bir - Doğrudan veya dolaylı dahil olmak üzere herhangi bir yolu "
"vurgula."

msgid "Show only path(s)"
msgstr "Yalnızca yol(lar)ı göster"

msgid "Default (none)"
msgstr "Varsayılan (yok)"

msgid ""
"None - Don't show paths only.\n"
"Direct - Show only direct descendant/ancestor paths.\n"
"Any - Show only path(s) direct or indirect."
msgstr ""
"Yok - Yalnızca yolları gösterme.\n"
"Doğrudan - Yalnızca doğrudan soyundan gelen/ata yollarını göster.\n"
"Herhangi bir - Yalnızca doğrudan veya dolaylı yol(lar)ı göster."

msgid "Select person at center of selection radius in graph."
msgstr "Grafikteki seçim yarıçapının merkezindeki kişiyi seçin."

msgid ""
"Max connections\n"
"from center"
msgstr ""
"Merkezden en\n"
"fazla bağlantı"

msgid ""
"Enter the maximum number of connections allowed from\n"
"the center person.  Value may be 1 or greater."
msgstr ""
"Merkez kişiden izin verilen en fazla bağlantı sayısını girin.\n"
"Değer 1 veya daha büyük olabilir."

msgid "Limit graph to max connections from center."
msgstr "Grafiği merkezden en fazla bağlantı sayısıyla sınırla."

msgid "Display up to max connections from central person."
msgstr "Merkez kişiden en fazla bağlantı sayısına kadar görüntüle."

msgid "Highlight central person in graph."
msgstr "Grafikte merkez kişiyi vurgula."

msgid "Add yellow color background to central person."
msgstr "Merkez kişiye sarı arka plan rengi ekle."

msgid "Use database handle instead of GrampID id in URLs."
msgstr ""
"URL adreslerinde GrampsID kimliği yerine veritabanı tanıtıcısını (handle) "
"kullan."

msgid ""
"Use database handle instead of the gramps id for URLs.\n"
"The handle should never change whereas gramps ids can."
msgstr ""
"URL adrslerinde Gramps kimliği yerine veritabanı tanıtıcısını (handle) "
"kullan.\n"
"Tanıtıcı (handle) hiçbir zaman değişmemelidir; oysa Gramps kimlikleri "
"değişebilir."

msgid "Confirm overwrite file."
msgstr "Dosyanın üzerine yazmayı onayla."

msgid "Enable/disable confirmation of file overwrite."
msgstr "Dosyanın üzerine yazma onayını etkinleştir/devre dışı bırak."

msgid "Network Chart"
msgstr "Ağ Grafiği"

msgid "Generates a family network chart."
msgstr "Bir aile ağacı grafiği oluşturur."
