msgid "Network Chart"
msgstr "Netzwerkdiagramm"

msgid "Generates a family network chart."
msgstr "Erzeugt ein Familiennetzwerkdiagramm."

msgid "File exists. Overwrite?"
msgstr "Datei existiert. Überschreiben?"

msgid "created"
msgstr "erstellt"

msgid "last_written"
msgstr "zuletzt_geschrieben"

msgid "Main"
msgstr "Haupt"

msgid "Orthogonal (right angles in connectors)"
msgstr "Orthogonal (rechte Winkel in Verbindungen)"

msgid "Straight (no right angles in connectors)"
msgstr "Gerade (keine rechten Winkel in den Verbindungen)"

msgid "Curved (curved and straight connectors)"
msgstr "Gebogen (gebogene und gerade Verbindungen)"

msgid "Default (Orthogonal)"
msgstr "Standard (orthogonal)"

msgid "Select the graph line connector format."
msgstr "Wähle das Format für die Verbindungslinie des Diagramms aus."

msgid "Top to Bottom"
msgstr "Von oben nach unten"

msgid "Left to Right"
msgstr "Von links nach rechts"

msgid "Bottom to Top"
msgstr "Von unten nach oben"

msgid "Right to Left"
msgstr "Von rechts nach links"

msgid "Default (Top to Bottom)"
msgstr "Standard (von oben nach unten)"

msgid "Select the graph direction."
msgstr "Wähle die Richtung des Diagramms aus."

msgid "URL Style"
msgstr "URL-Stil"

msgid "Include URLs from database."
msgstr "URLs aus der Datenbank einfügen."

msgid "Dynamic URL = Prefix + GrampID + Suffix"
msgstr "Dynamische URL = Präfix + GrampID + Suffix"

msgid "Static URL = Prefix"
msgstr "Statische URL = Präfix"

msgid "Don't include URLs"
msgstr "Keine URLs aufnehmen"

msgid "Default (include)"
msgstr "Standard (einschließen)"

msgid "Select URL style."
msgstr "URL-Stil auswählen."

msgid "URL Prefix,Suffix"
msgstr "URL-Präfix, Suffix"

msgid ""
"Enter the Prefix,Suffix (use comma)\n"
"for dynamically generated URLs.\n"
"URL = Prefix + GrampsID + Suffix."
msgstr ""
"Gib das Präfix und Suffix (mit Komma)\n"
"für dynamisch generierte URLs ein.\n"
"URL = Präfix + GrampsID + Suffix."

msgid "Enter Font Name"
msgstr "Schriftartname eingeben"

msgid ""
"Enter the primary font style for the chart.\n"
"Must already be installed.\n"
"White Rabbit can be obtained from\n"
"https://www.fontsquirrel.com/fonts/white-rabbit"
msgstr ""
"Gib den primären Schriftstil für das Diagramm ein.\n"
"Muss bereits installiert sein.\n"
"White Rabbit kann unter folgender Adresse heruntergeladen werden:\n"
"https://www.fontsquirrel.com/fonts/white-rabbit"

msgid "Spacing (inch)"
msgstr "Abstand (Zoll)"

msgid ""
"Enter the seperation distance between \"Generations\" in inches (0.1-5.0)."
msgstr "Gib den Abstand zwischen den „Generationen” in Zoll (0,1–5,0) ein."

msgid "Enter Chart Title"
msgstr "Diagrammtitel eingeben"

msgid "Set the title of the chart."
msgstr "Lege den Titel des Diagramms fest."

msgid "Default (svg)"
msgstr "Standard (svg)"

msgid ""
"svg - Scalable Vector Graphics file.\n"
"pdf - Adobe Portable Document Format.\n"
msgstr ""
"svg - Scalable Vector Graphics file.\n"
"pdf - Adobe Portable Document Format.\n"

msgid "The destination folder for generated files."
msgstr "Der Zielordner für generierte Dateien."

msgid "network"
msgstr "Netzwerk"

msgid "The filename for the generated svg network chart."
msgstr "Der Dateiname für das generierte svg-Netzdiagramm."

msgid "Different node shapes/edges for gender."
msgstr "Unterschiedliche Knotenformen/Kanten für Geschlecht."

msgid "Node differences for gender."
msgstr "Knotenunterschiede für die Geschlechter."

msgid "Male Background"
msgstr "Männlicher Hintergrund"

msgid "RGB-color for male box background."
msgstr "RGB-Hintergrundfarbe für männliche Box."

msgid "Male Background Alpha"
msgstr "Männlicher Hintergrund Alpha"

msgid "Alpha for Male box background (transparent=0, solid=255)."
msgstr ""
"Alpha für Hintergrund der männlichen Box (transparent=0, undurchsichtig=255)."

msgid "Male Box Edge"
msgstr "Männliche Boxkante"

msgid "RGB-color for Male box edge."
msgstr "RGB-Farbe für den Rand der männlichen Box."

msgid "Female Background"
msgstr "Hintergrund weiblich"

msgid "RGB-color for Female box background."
msgstr "RGB-Hintergrundfarbe für weibliche Box."

msgid "Female Background Alpha"
msgstr "Weiblicher Hintergrund Alpha"

msgid "Alpha for Female box background (transparent=0, solid=255)."
msgstr ""
"Alpha für Hintergrund der weiblichen Box (transparent=0, undurchsichtig=255)."

msgid "Female Box Edge"
msgstr "Rand der weiblichen Box"

msgid "RGB-color for Female box edge."
msgstr "RGB-Farbe für den Rand der weiblichen Box."

msgid "Other Background"
msgstr "Andere Hintergrund"

msgid "RGB-color for other box background."
msgstr "RGB-Hintergrundfarbe für andere Box."

msgid "Other Background Alpha"
msgstr "Andere Hintergrund Alpha"

msgid "Alpha for Other box background (transparent=0, solid=255)."
msgstr ""
"Alpha für Hintergrund von anderer Box Hintergrund (transparent=0, "
"undurchsichtig=255)."

msgid "Family Connector Line"
msgstr "Familieverbindungslinie"

msgid "RGB-color for family connector line."
msgstr "RGB-Farbe für die Verbindungslinie der Familie."

msgid "Marriage Connector Line"
msgstr "Eheverbindungslinie"

msgid "RGB-color for marriage connector line."
msgstr "RGB-Farbe für die Ehe-Verbindungslinie."

msgid "Highlight Connector Line"
msgstr "Verbindungslinie hervorheben"

msgid ""
"RGB-color for the highlighted path between two individuals.  If the "
"graph.inverts, reverse the order to change."
msgstr ""
"RGB-Farbe für den hervorgehobenen Pfad zwischen zwei Personen.  Wenn sich "
"das Diagramm umkehrt, kehre die Reihenfolge um, um die Änderung vorzunehmen."

msgid "Trim Box Edge"
msgstr "Kastenrand beschneiden"

msgid "RGB-color for box edge that has been trimmed."
msgstr "RGB-Farbe für Boxenrand, der gekürzt wurde."

msgid "Remove color background on all nodes."
msgstr "Hintergrundfarbe aller Knoten entfernen."

msgid "Removes color background for individuals (nodes) on chart."
msgstr ""
"Entfernt den farbigen Hintergrund für einzelne Elemente (Knoten) im Diagramm."

msgid ""
"Enter year to start\n"
"rounding birthday\n"
"to year only"
msgstr ""
"Gib das Startjahr ein,\n"
"um den Geburtstag \n"
"auf das Jahr zu runden"

msgid ""
"Birthdays after this year are represented by the year only.  Invalid entries "
"will be ignored."
msgstr ""
"Geburtstage nach diesem Jahr werden nur mit der Jahreszahl angegeben.  "
"Ungültige Eingaben werden ignoriert."

msgid "Round birthday to year after year entered (above)."
msgstr "Runde Geburtstag zu Jahr nach eingegebenem Jahr (oben)."

msgid "Represent birthday by year only."
msgstr "Geburtstag nur nach Jahr angeben."

msgid ""
"Enter year to start\n"
"rounding marriage\n"
"date to year only"
msgstr ""
"Gib das Jahr ein, ab dem\n"
"das Heiratsdatum auf das \n"
"Jahr gerundet werden soll"

msgid ""
"Marriages after this year are represented bythe year only. Invalid entries "
"will be ignored."
msgstr ""
"Eheschließungen nach diesem Jahr werden nur durch die Jahreszahl "
"dargestellt. Ungültige Einträge werden ignoriert."

msgid "Round marriage to year after year entered (above)."
msgstr "Runde Ehe zu Jahr nach eingegebenem Jahr (oben)."

msgid "Represent marriage by year only."
msgstr "Darstellung der Ehen nur nach Jahr."

msgid ""
"Attempts to remove middle names.  Only works for entries with birth year in "
"the record."
msgstr ""
"Versuche, Mittelnamen zu entfernen.  Funktioniert nur bei Einträgen, bei "
"denen das Geburtsjahr in der Aufzeichnung angegeben ist."

msgid "Remove middle names."
msgstr "Mittlere Namen entfernen."

msgid "Allow inclusion of private records in chart."
msgstr "Erlaubt die Aufnahme vertraulicher Daten in das Diagramm."

msgid "Trim"
msgstr "Beschneiden"

msgid "Trim descendants"
msgstr "Nachkommen beschneiden"

msgid "All descendants (children) of selected individuals will not be shown."
msgstr "Alle Nachkommen (Kinder) ausgewählter Personen werden nicht angezeigt."

msgid "Enable trimming of descendants."
msgstr "Beschneiden von Nachkommen aktivieren."

msgid ""
"You must enter valid person(s) before \n"
"enabling trimming of descendants from tree."
msgstr ""
"Du musst gültige Personen eingeben, bevor du das Entfernen \n"
"von Nachkommen aus dem Stammbaum aktivieren kannst."

msgid "Trim ancestors"
msgstr "Vorfahren beschneiden"

msgid "All ancestors (parents) of selected individuals will not be shown."
msgstr "Alle Vorfahren (Eltern) ausgewählter Personen werden nicht angezeigt."

msgid "Enable trimming of ancestors."
msgstr "Beschneiden von Vorfahren aktivieren."

msgid "Enable trimming of ancestors from tree."
msgstr "Beschneiden von Vorfahren aus dem Stammbaum aktivieren."

msgid "Enable trim groups."
msgstr "Beschnittgruppen aktivieren."

msgid ""
"Remove groups less than Min Group Size.  Automatic\n"
"for databases with more than 1500 individuals."
msgstr ""
"Gruppen entfernen, die kleiner als die Mindestgruppengröße sind.  \n"
"Automatisch für Datenbanken mit mehr als 1500 Personen."

msgid "Min Group Size"
msgstr "Mindestgruppengröße"

msgid ""
"Enter the minimum size group to display.\n"
"Value may be 2 or greater."
msgstr ""
"Gib die Mindestgröße der anzuzeigenden Gruppe ein.\n"
"Der Wert kann 2 oder größer sein."

msgid ""
"Select Start and\n"
"End Individuals in\n"
"displayed path(s).\n"
"Select two"
msgstr ""
"Wähle Start und\n"
"Endpersonen in\n"
"angezeigten Pfad(en).\n"
"Wähle zwei"

msgid ""
"Starting and ending person for displayed path(s).\n"
"Select two people"
msgstr ""
"Start- und Endperson für angezeigte(n) Pfad(e).\n"
"Wähle zwei Personen aus"

msgid "Highlight path(s)"
msgstr "Pfad(e) hervorheben"

msgid "Direct"
msgstr "Direkt"

msgid "Any"
msgstr "Beliebig"

msgid "Default (None)"
msgstr "Standard (Keine)"

msgid ""
"None - Don't highlight paths.\n"
"Direct - Highlight direct descendant/ancestor paths.\n"
"Any - Highlight any path(s) including direct or indirect."
msgstr ""
"Keine - Pfade werden nicht hervorgehoben.\n"
"Direkt - Hebt direkte Pfade von Nachfahren/Ahnen hervor.\n"
"Alle - Alle Pfade hervorheben, einschließlich direkter oder indirekter Pfade."

msgid "Show only path(s)"
msgstr "Nur Pfad(e) anzeigen"

msgid "Default (none)"
msgstr "Standard (keine)"

msgid ""
"None - Don't show paths only.\n"
"Direct - Show only direct descendant/ancestor paths.\n"
"Any - Show only path(s) direct or indirect."
msgstr ""
"Keine - Keine nur Pfade anzeigen.\n"
"Direkt - Zeigt nur direkte Nachkommen- / Vorfahrenpfade an.\n"
"Beliebig - Nur direkte oder indirekte Pfad(e) anzeigen."

msgid "Select person at center of selection radius in graph."
msgstr "Wähle die Person im Zentrum des Auswahlradius im Diagramm aus."

msgid ""
"Max connections\n"
"from center"
msgstr ""
"Maximale Verbindungen\n"
"vom Zentrum aus"

msgid ""
"Enter the maximum number of connections allowed from\n"
"the center person.  Value may be 1 or greater."
msgstr ""
"Gib die maximale Anzahl der von der zentralen Person zugelassenen\n"
"Verbindungen ein.  Der Wert kann 1 oder größer sein."

msgid "Limit graph to max connections from center."
msgstr "Diagramm auf maximale Verbindungen vom Zentrum aus beschränken."

msgid "Display up to max connections from central person."
msgstr "Anzeige der maximalen Verbindungen einer zentralen Person."

msgid "Highlight central person in graph."
msgstr "Zentrale Person im Diagramm hervorheben."

msgid "Add yellow color background to central person."
msgstr "Gelben Hintergrund zur zentralen Person hinzufügen."

msgid "Use database handle instead of GrampID id in URLs."
msgstr "Verwende in URLs anstelle der GrampID-ID einen Datenbank-Handle."

msgid ""
"Use database handle instead of the gramps id for URLs.\n"
"The handle should never change whereas gramps ids can."
msgstr ""
"Verwende für URLs den Datenbank-Handle anstelle der Gramps-ID.\n"
"Der Handle sollte sich niemals ändern, während Gramps-IDs sich ändern können."

msgid "Confirm overwrite file."
msgstr "Datei überschreiben bestätigen."

msgid "Enable/disable confirmation of file overwrite."
msgstr "Bestätigung beim Überschreiben von Dateien aktivieren/deaktivieren."
