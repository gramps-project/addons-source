msgid "File exists. Overwrite?"
msgstr "Súbor existuje. Prepísať ho?"

msgid "created"
msgstr "vytvorený"

msgid "last_written"
msgstr "posledný_zápis"

msgid "Main"
msgstr "Hlavné"

msgid "Orthogonal (right angles in connectors)"
msgstr "Ortogonálne (pravoúhle spojky)"

msgid "Straight (no right angles in connectors)"
msgstr "Rovné (bez pravoúhlych spojok)"

msgid "Curved (curved and straight connectors)"
msgstr "Zakrivené (zakrivené a rovné spojky)"

msgid "Default (Orthogonal)"
msgstr "Predvolené (ortogonálne)"

msgid "Select the graph line connector format."
msgstr "Vyberte formát spojok v diagrame."

msgid "Top to Bottom"
msgstr "Zhora nadol"

msgid "Left to Right"
msgstr "Zľava doprava"

msgid "Bottom to Top"
msgstr "Zdola nahor"

msgid "Right to Left"
msgstr "Sprava doľava"

msgid "Default (Top to Bottom)"
msgstr "Predvolené (zhora nadol)"

msgid "Select the graph direction."
msgstr "Vyberte smer diagramu."

msgid "URL Style"
msgstr "Štýl URL"

msgid "Include URLs from database."
msgstr "Zahrnúť URL z databázy."

msgid "Dynamic URL = Prefix + GrampID + Suffix"
msgstr "Dynamická URL = predpona + GrampID + prípona"

msgid "Static URL = Prefix"
msgstr "Statická URL = predpona"

msgid "Don't include URLs"
msgstr "Nezahrnúť URL adresy"

msgid "Default (include)"
msgstr "Predvolené (zahrnúť)"

msgid "Select URL style."
msgstr "Vyberte štýl URL."

msgid "URL Prefix,Suffix"
msgstr "Predpona a prípona URL"

msgid ""
"Enter the Prefix,Suffix (use comma)\n"
"for dynamically generated URLs.\n"
"URL = Prefix + GrampsID + Suffix."
msgstr ""
"Zadajte predponu a príponu (oddeľte ich čiarkou)\n"
"pre dynamicky generované URL adresy.\n"
"URL = predpona + GrampsID + prípona."

msgid "Enter Font Name"
msgstr "Názov písma"

msgid ""
"Enter the primary font style for the chart.\n"
"Must already be installed.\n"
"White Rabbit can be obtained from\n"
"https://www.fontsquirrel.com/fonts/white-rabbit"
msgstr ""
"Zadajte primárny štýl písma pre diagram.\n"
"Musí byť už nainštalované.\n"
"White Rabbit je možné stiahnuť z\n"
"https://www.fontsquirrel.com/fonts/white-rabbit"

msgid "Spacing (inch)"
msgstr "Rozostup (palce)"

msgid ""
"Enter the seperation distance between \"Generations\" in inches (0.1-5.0)."
msgstr "Zadajte vzdialenosť medzi „generáciami“ v palcoch (0,1–5,0)."

msgid "Enter Chart Title"
msgstr "Názov diagramu"

msgid "Set the title of the chart."
msgstr "Nastavte názov diagramu."

msgid "Default (svg)"
msgstr "Predvolené (svg)"

msgid ""
"svg - Scalable Vector Graphics file.\n"
"pdf - Adobe Portable Document Format.\n"
msgstr ""
"svg – súbor Scalable Vector Graphics.\n"
"pdf – Adobe Portable Document Format.\n"

msgid "The destination folder for generated files."
msgstr "Cieľová zložka pre generované súbory."

msgid "network"
msgstr "sieť"

msgid "The filename for the generated svg network chart."
msgstr "Názov súboru pre generovaný sieťový diagram vo formáte svg."

msgid "Different node shapes/edges for gender."
msgstr "Rozdielne tvary uzlov/okrajov podľa pohlavia."

msgid "Node differences for gender."
msgstr "Rozdiely uzlov podľa pohlavia."

msgid "Male Background"
msgstr "Pozadie muža"

msgid "RGB-color for male box background."
msgstr "RGB-farba pre pozadie rámika pre mužov."

msgid "Male Background Alpha"
msgstr "Priehľadnosť pozadia muža"

msgid "Alpha for Male box background (transparent=0, solid=255)."
msgstr "Priehľadnosť pre pozadie rámika muža (priehľadné=0, plné=255)."

msgid "Male Box Edge"
msgstr "Okraj rámika muža"

msgid "RGB-color for Male box edge."
msgstr "RGB-farba pre okraj rámika muža."

msgid "Female Background"
msgstr "Pozadie pre ženy"

msgid "RGB-color for Female box background."
msgstr "RGB-farba pre pozadie rámika ženy."

msgid "Female Background Alpha"
msgstr "Priehľadnosť pozadia ženy"

msgid "Alpha for Female box background (transparent=0, solid=255)."
msgstr "Priehľadnosť pre pozadie rámika ženy (priehľadné=0, plné=255)."

msgid "Female Box Edge"
msgstr "Okraj rámika ženy"

msgid "RGB-color for Female box edge."
msgstr "RGB-farba pre okraj rámika ženy."

msgid "Other Background"
msgstr "Iné pozadie"

msgid "RGB-color for other box background."
msgstr "RGB-farba pre pozadie ostatných rámikov."

msgid "Other Background Alpha"
msgstr "Priehľadnosť iného pozadia"

msgid "Alpha for Other box background (transparent=0, solid=255)."
msgstr "Priehľadnosť pre pozadie iných rámikov (priehľadné=0, plné=255)."

msgid "Family Connector Line"
msgstr "Spojovacia čiara rodiny"

msgid "RGB-color for family connector line."
msgstr "RGB-farba pre spojovaciu čiaru rodiny."

msgid "Marriage Connector Line"
msgstr "Spojovacia čiara manželstva"

msgid "RGB-color for marriage connector line."
msgstr "RGB-farba pre spojovaciu čiaru manželstva."

msgid "Highlight Connector Line"
msgstr "Zvýrazniť spojovaciu čiaru"

msgid ""
"RGB-color for the highlighted path between two individuals.  If the "
"graph.inverts, reverse the order to change."
msgstr ""
"RGB-farba pre zvýraznenú cestu medzi dvoma jedincami.  Ak sa diagram "
"invertuje, obráťte poradie na zmenu."

msgid "Trim Box Edge"
msgstr "Okraj orezaného rámika"

msgid "RGB-color for box edge that has been trimmed."
msgstr "RGB-farba pre okraj rámika, ktorý bol orezaný."

msgid "Remove color background on all nodes."
msgstr "Odstrániť farebné pozadie na všetkých uzloch."

msgid "Removes color background for individuals (nodes) on chart."
msgstr "Odstráni farebné pozadie pre jedincov (uzly) v diagrame."

msgid ""
"Enter year to start\n"
"rounding birthday\n"
"to year only"
msgstr ""
"Začiatok zaokrúhľovania\n"
"dátumu narodenia\n"
"len na rok"

msgid ""
"Birthdays after this year are represented by the year only.  Invalid entries "
"will be ignored."
msgstr ""
"Dátumy narodenia po tomto roku sú reprezentované iba rokom.   Neplatné "
"záznamy budú ignorované."

msgid "Round birthday to year after year entered (above)."
msgstr "Zaokrúhliť dátum narodenia na rok po zadanom roku (nahor)."

msgid "Represent birthday by year only."
msgstr "Reprezentovať dátum narodenia len podľa roku."

msgid ""
"Enter year to start\n"
"rounding marriage\n"
"date to year only"
msgstr ""
"Začiatok zaokrúhľovania\n"
"dátumu manželstva\n"
"len na rok"

msgid ""
"Marriages after this year are represented bythe year only. Invalid entries "
"will be ignored."
msgstr ""
"Dátumy manželstva po tomto roku sú reprezentované iba rokom. Neplatné "
"záznamy budú ignorované."

msgid "Round marriage to year after year entered (above)."
msgstr "Zaokrúhliť dátum manželstva na rok po zadanom roku (nahor)."

msgid "Represent marriage by year only."
msgstr "Reprezentuje manželstvo len podľa roku."

msgid ""
"Attempts to remove middle names.  Only works for entries with birth year in "
"the record."
msgstr ""
"Pokúsi sa odstrániť prostredné mená.  Funguje len pre položky s rokom "
"narodenia v zázname."

msgid "Remove middle names."
msgstr "Odstrániť prostredné mená."

msgid "Allow inclusion of private records in chart."
msgstr "Povoliť zahrnutie súkromných záznamov do diagramu."

msgid "Trim"
msgstr "Orezanie"

msgid "Trim descendants"
msgstr "Orezať potomkov"

msgid "All descendants (children) of selected individuals will not be shown."
msgstr "Všetci potomkovia (deti) vybraných jedincov sa nebudú zobrazovať."

msgid "Enable trimming of descendants."
msgstr "Povoliť orezávanie potomkov."

msgid ""
"You must enter valid person(s) before \n"
"enabling trimming of descendants from tree."
msgstr ""
"Musíte zadať platnú(é) osobu(y) pred \n"
"umožnením orezávania potomkov zo stromu."

msgid "Trim ancestors"
msgstr "Orezať predkov"

msgid "All ancestors (parents) of selected individuals will not be shown."
msgstr "Všetci predkovia (rodičia) vybraných jedincov sa nebudú zobrazovať."

msgid "Enable trimming of ancestors."
msgstr "Povoliť orezávanie predkov."

msgid "Enable trimming of ancestors from tree."
msgstr "Umožní orezávanie predkov zo stromu."

msgid "Enable trim groups."
msgstr "Povoliť orezanie skupín."

msgid ""
"Remove groups less than Min Group Size.  Automatic\n"
"for databases with more than 1500 individuals."
msgstr ""
"Odstráni skupiny menšie ako minimálna veľkosť skupiny.  Automaticky\n"
"pre databázy s viac ako 1500 jedincami."

msgid "Min Group Size"
msgstr "Minimálna veľkosť skupiny"

msgid ""
"Enter the minimum size group to display.\n"
"Value may be 2 or greater."
msgstr ""
"Zadajte minimálnu veľkosť skupiny, ktorá sa má zobraziť.\n"
"Hodnota môže byť 2 alebo viac."

msgid ""
"Select Start and\n"
"End Individuals in\n"
"displayed path(s).\n"
"Select two"
msgstr ""
"Vyberte počiatočných a\n"
"koncových jedincov v\n"
"zobrazených cestách.\n"
"Vyberte dvoch"

msgid ""
"Starting and ending person for displayed path(s).\n"
"Select two people"
msgstr ""
"Počiatočná a koncová osoba pre zobrazenú(-é) cestu(-y).\n"
"Vyberte dve osoby"

msgid "Highlight path(s)"
msgstr "Zvýrazniť cestu(-y)"

msgid "Direct"
msgstr "Priame"

msgid "Any"
msgstr "Akékoľvek"

msgid "Default (None)"
msgstr "Predvolené (žiadne)"

msgid ""
"None - Don't highlight paths.\n"
"Direct - Highlight direct descendant/ancestor paths.\n"
"Any - Highlight any path(s) including direct or indirect."
msgstr ""
"Žiadne – nezvýrazní cesty.\n"
"Priame – zvýrazní priame cesty potomkov/predkov.\n"
"Akékoľvek – zvýrazní akúkoľvek cestu(-y), vrátane priamych alebo nepriamych."

msgid "Show only path(s)"
msgstr "Zobraziť len cestu(-y)"

msgid "Default (none)"
msgstr "Predvolené (žiadne)"

msgid ""
"None - Don't show paths only.\n"
"Direct - Show only direct descendant/ancestor paths.\n"
"Any - Show only path(s) direct or indirect."
msgstr ""
"Žiadne - nezobrazí iba cesty.\n"
"Priame - zobrazí len priame cesty potomkov/predkov.\n"
"Ľubovoľné - zobrazí len priame alebo nepriame cesty."

msgid "Select person at center of selection radius in graph."
msgstr "Vyberte osobu v strede okruhu výberu v diagrame."

msgid ""
"Max connections\n"
"from center"
msgstr ""
"Maximum spojení\n"
"od stredu"

msgid ""
"Enter the maximum number of connections allowed from\n"
"the center person.  Value may be 1 or greater."
msgstr ""
"Zadajte maximálny počet povolených spojení od\n"
"hlavnej osoby.  Hodnota môže byť 1 alebo vyššia."

msgid "Limit graph to max connections from center."
msgstr "Obmedzí diagram na maximálny počet spojení od stredu."

msgid "Display up to max connections from central person."
msgstr "Zobrazí maximálny počet spojení od hlavnej osoby."

msgid "Highlight central person in graph."
msgstr "Zvýrazniť hlavnú osobu v diagrame."

msgid "Add yellow color background to central person."
msgstr "Pridať žltú farbu pozadia k hlavnej osobe."

msgid "Use database handle instead of GrampID id in URLs."
msgstr "Použiť identifikátor databázy namiesto Gramps ID v URL adresách."

msgid ""
"Use database handle instead of the gramps id for URLs.\n"
"The handle should never change whereas gramps ids can."
msgstr ""
"Použite databázový identifikátor namiesto Gramps ID v URL adresách.\n"
"Identifikátor databázy by sa nemal nikdy meniť, zatiaľ čo identifikátory "
"Gramps sa meniť môžu."

msgid "Confirm overwrite file."
msgstr "Potvrdiť prepísanie súboru."

msgid "Enable/disable confirmation of file overwrite."
msgstr "Zapnúť/vypnúť potvrdzovanie prepísania súboru."

msgid "Network Chart"
msgstr "Sieťový diagram"

msgid "Generates a family network chart."
msgstr "Vygeneruje sieťový rodinný diagram."
