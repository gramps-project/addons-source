msgid "Media Verify Tool"
msgstr "Nástroj pro kontrolu médií"

msgid "Moved/Renamed Files"
msgstr "Přesunuté/přejmenované soubory"

msgid "Missing Files"
msgstr "Chybějící soubory"

msgid "Duplicate Files"
msgstr "Duplicitní soubory"

msgid "Extra Files"
msgstr "Soubory navíc"

msgid "No md5 Generated"
msgstr "Bez vygenerovaného MD5"

msgid "Errors"
msgstr "Chyby"

msgid "Close the Media Verify Tool"
msgstr "Zavřít nástroj pro kontrolu médií"

msgid "Generate"
msgstr "Vygenerovat"

msgid "Generate md5 hashes for media objects"
msgstr "Vygenerovat kontrolní součty MD5 pro objekty médií"

msgid "Verify"
msgstr "Ověřit"

msgid "Check media paths and report missing, duplicate and extra files"
msgstr ""
"Zkontrolovat cesty k médiím a vypsat chybějící, duplicitní soubory a soubory "
"navíc"

msgid "Export the results to a text file"
msgstr "Exportovat výsledky do textového souboru"

msgid "Fix"
msgstr "Opravit"

msgid "Fix media paths of moved and renamed files"
msgstr "Opravit cesty k médiím u přesunutých a přejmenovaných souborů"

msgid "Verify Gramps media using md5 hashes"
msgstr "Ověřit média v Gramps pomocí kontrolních součtů MD5"

msgid "Files"
msgstr "Soubory"

msgid "Export results to a text file"
msgstr "Exportovat výsledky do textového souboru"

#, python-format
msgid "Error when writing the report: %s"
msgstr "Chyba při zápisu přehledu: %s"

msgid "Generating media hashes"
msgstr "Generování kontrolních součtů médií"

msgid "Set media hashes"
msgstr "Nastavit kontrolní součty médií"

msgid ""
"Media path not set.  You must set the \"Base path for relative media paths\" "
"in the Preferences."
msgstr ""
"Cesta k médiím není nastavena. V předvolbách musíte nastavit položku "
"„Výchozí cesta k médiím“."

msgid "Finding files"
msgstr "Vyhledávání souborů"

msgid "Checking paths"
msgstr "Kontrolují se cesty"

msgid "Fixing file paths"
msgstr "Opravování cest k souborům"

msgid "Fix media paths"
msgstr "Opravit cesty k médiím"

msgid "Media Verify"
msgstr "Ověření médií"

msgid "Verify that media is present in the correct path"
msgstr "Ověřit, zda jsou média dostupná na správné cestě"
