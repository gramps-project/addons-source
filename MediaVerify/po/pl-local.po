msgid "Media Verify Tool"
msgstr "Narzędzie weryfikacji multimediów"

msgid "Moved/Renamed Files"
msgstr "Przeniesione/przemianowane pliki"

msgid "Missing Files"
msgstr "Brakujące pliki"

msgid "Duplicate Files"
msgstr "Duplikaty plików"

msgid "Extra Files"
msgstr "Dodatkowe pliki"

msgid "No md5 Generated"
msgstr "Nie wygenerowano sumy md5"

msgid "Errors"
msgstr "Błędy"

msgid "Close the Media Verify Tool"
msgstr "Zamknij narzędzie weryfikacji multimediów"

