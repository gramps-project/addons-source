msgstr "Generuj sumy kontrolne md5 dla obiektów multimedialnych"

msgid "Verify"
msgstr "Weryfikuj"

msgid "Check media paths and report missing, duplicate and extra files"
msgstr ""
"Sprawdź ścieżki multimediów i zgłoś brakujące, zduplikowane i dodatkowe pliki"

msgid "Export"
msgstr "Eksportuj"

msgid "Export the results to a text file"
msgstr "Eksportuj wyniki do pliku tekstowego"

msgid "Fix"
msgstr "Napraw"

msgid "Fix media paths of moved and renamed files"
msgstr "Napraw ścieżki multimediów dla przeniesionych i przemianowanych plików"

msgid "Verify Gramps media using md5 hashes"
msgstr "Weryfikuj multimedia Gramps używając sum kontrolnych md5"

msgid "Files"
msgstr "Pliki"

msgid "Export results to a text file"
msgstr "Eksportuj wyniki do pliku tekstowego"

#, python-format
msgid "Error when writing the report: %s"
msgstr "Błąd podczas zapisywania raportu: %s"

msgid "Generating media hashes"
msgstr "Generowanie sum kontrolnych multimediów"

msgid "Set media hashes"
msgstr "Ustaw sumy kontrolne multimediów"

msgid ""
"Media path not set.  You must set the \"Base path for relative media paths\" "
"in the Preferences."
msgstr ""
"Ścieżka multimediów nie została ustawiona. Musisz ustawić \"Ścieżkę bazową "
"dla względnych ścieżek multimediów\" w Preferencjach."

msgid "Fixing file paths"
msgstr "Naprawianie ścieżek plików"

msgid "Fix media paths"
msgstr "Napraw ścieżki multimediów"

msgid "Media Verify"
msgstr "Weryfikacja multimediów"

msgid "Verify that media is present in the correct path"
msgstr "Sprawdź, czy multimedia znajdują się we właściwej ścieżce"
