msgid "Media Verify Tool"
msgstr "Nástroj na overenie médií"

msgid "Moved/Renamed Files"
msgstr "Presunuté/premenované súbory"

msgid "Missing Files"
msgstr "Chýbajúce súbory"

msgid "Duplicate Files"
msgstr "Duplicitné súbory"

msgid "Extra Files"
msgstr "Nadbytočné súbory"

msgid "No md5 Generated"
msgstr "Nevygenerovaný md5"

msgid "Errors"
msgstr "Chyby"

msgid "Close the Media Verify Tool"
msgstr "Zavrieť nástroj na overenie médií"

msgid "Generate"
msgstr "Generovať"

msgid "Generate md5 hashes for media objects"
msgstr "Vygeneruje md5 hashe pre mediálne objekty"

msgid "Verify"
msgstr "Overiť"

msgid "Check media paths and report missing, duplicate and extra files"
msgstr ""
"Skontroluje cesty k médiám a nahlási chýbajúce, duplicitné a nadbytočné "
"súbory"

msgid "Export"
msgstr "Exportovať"

msgid "Export the results to a text file"
msgstr "Exportuje výsledky do textového súboru"

msgid "Fix"
msgstr "Opraviť"

msgid "Fix media paths of moved and renamed files"
msgstr "Opraví mediálne cesty presunutých a premenovaných súborov"

msgid "Verify Gramps media using md5 hashes"
msgstr "Overí médiá Gramps pomocou md5 hashov"

msgid "Files"
msgstr "Súbory"

msgid "Export results to a text file"
msgstr "Export výsledkov do textového súboru"

#, python-format
msgid "Error when writing the report: %s"
msgstr "Chyba pri zápise správy: %s"

msgid "Generating media hashes"
msgstr "Generovanie mediálnych hashov"

msgid "Set media hashes"
msgstr "Nastaviť mediálne hashe"

msgid ""
"Media path not set.  You must set the \"Base path for relative media paths\" "
"in the Preferences."
msgstr ""
"Cesta k médiám nie je nastavená.   Musíte nastaviť \"Základnú cestu pre "
"relatívne cesty k médiám\" v Nastaveniach."

msgid "Finding files"
msgstr "Hľadanie súborov"

msgid "Checking paths"
msgstr "Kontrolovanie ciest"

msgid "Fixing file paths"
msgstr "Opravovanie ciest k súborom"

msgid "Fix media paths"
msgstr "Opraviť cesty k médiám"

msgid "Media Verify"
msgstr "Overenie médií"

msgid "Verify that media is present in the correct path"
msgstr "Overte, či sa médiá nachádzajú v správnej ceste"
