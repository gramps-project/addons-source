msgid "Audit Given and Patronymic Names"
msgstr "Kontrola křestních jmen a otčestva"

msgid ""
"Tools to rename given name, audit and infer patronymic (East Slavic) names."
msgstr ""
"Nástroje pro změnu křestních jmen, kontrolu a odvozování východoslovanského "
"otčestva."

msgid "Patronymic Suggestion"
msgstr "Návrh otčestva"

msgid "Suggests (East Slavic) patronymic names in real-time as you navigate."
msgstr "Při procházení osob průběžně navrhuje východoslovanské otčestvo."

msgid "Use"
msgstr "Použít"

#, python-brace-format
msgid ""
"Missing Patronymic Detected.\n"
"Suggested: {0}\n"
"Based on father: {1}"
msgstr ""
"Zjištěno chybějící otčestvo.\n"
"Návrh: {0}\n"
"Na základě otce: {1}"

msgid "Navigate to an individual to check patronymic status."
msgstr "Přejděte na osobu a zkontrolujte stav otčestva."

msgid "No active person selected."
msgstr "Není vybraná žádná aktivní osoba."

msgid ""
"Patronymic inference can't be inferred for non-binary or unknown genders."
msgstr "U nebinárního nebo neznámého pohlaví nelze otčestvo odvodit."

msgid "Individual already has a recorded patronymic."
msgstr "Osoba již má zaznamenané otčestvo."

msgid "No attached father found in database family records."
msgstr "V záznamech rodin v databázi nebyl nalezen připojený otec."

msgid "Father lacks a recorded first name."
msgstr "Otec nemá zaznamenané křestní jméno."

msgid "Could not generate valid morphology patterns."
msgstr "Nepodařilo se vytvořit platné morfologické vzory."

msgid "Patronymic applied successfully!"
msgstr "Otčestvo bylo úspěšně použito!"

msgid "Apply Suggestion"
msgstr "Použít návrh"

msgid "Infer East Slavic Patronymics"
msgstr "Odvodit východoslovanské otčestvo"

msgid "Rename Given Names"
msgstr "Přejmenovat křestní jména"

msgid "Audit Patronymics"
msgstr "Zkontrolovat otčestvo"

msgid "Auditing Settings"
msgstr "Nastavení kontroly"

msgid "All Records"
msgstr "Všechny záznamy"

msgid "Males Only"
msgstr "Pouze muži"

msgid "Females Only"
msgstr "Pouze ženy"

msgid "Configure Rules..."
msgstr "Nastavit pravidla..."

msgid "Match Pre-Revolutionary Orthography"
msgstr "Zohlednit předrevoluční pravopis"

msgid "Audit Database"
msgstr "Zkontrolovat databázi"

msgid "Select All Safe Corrections"
msgstr "Vybrat všechny bezpečné opravy"

msgid "Apply Selected Corrections"
msgstr "Použít vybrané opravy"

msgid "Configure Rules"
msgstr "Nastavení pravidel"

msgid "Individual"
msgstr "Osoba"

msgid "Current"
msgstr "Současné"

msgid "Correction"
msgstr "Oprava"

msgid "Conf"
msgstr "Jistota"

msgid "Ref Year"
msgstr "Referenční rok"

msgid "Explanation"
msgstr "Vysvětlení"

msgid "Audit Complete!"
msgstr "Kontrola dokončena!"

msgid "No Results"
msgstr "Žádné výsledky"

msgid "No issues found."
msgstr "Nebyly nalezeny žádné problémy."

msgid "Search and Replace Options"
msgstr "Možnosti hledání a nahrazování"

msgid "Source Name:"
msgstr "Původní jméno:"

msgid "e.g. Иоанн"
msgstr "např. Иоанн"

msgid "Target Name:"
msgstr "Cílové jméno:"

msgid "e.g. Иван"
msgstr "např. Иван"

msgid "Match Mode:"
msgstr "Režim shody:"

