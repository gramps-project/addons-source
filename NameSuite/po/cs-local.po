msgstr "Přesná shoda"

msgid "Substring"
msgstr "Podřetězec"

msgid "Regular Expression"
msgstr "Regulární výraz"

msgid "Scan for Names"
msgstr "Vyhledat jména"

msgid "Preserve original name as alternative"
msgstr "Zachovat původní jméno jako alternativní"

