msgid "Audit Given and Patronymic Names"
msgstr "Kontrola daných (krstných) mien a patronymických mien"

msgid ""
"Tools to rename given name, audit and infer patronymic (East Slavic) names."
msgstr ""
"Nástroje na premenovanie daného (krstného) mena, kontrolu a odvodzovanie "
"patronymických (východoslovanských) mien."

msgid "Patronymic Suggestion"
msgstr "Návrh patronymického mena"

msgid "Suggests (East Slavic) patronymic names in real-time as you navigate."
msgstr ""
"Navrhuje (východoslovanské) patronymické mená v reálnom čase počas navigácie."

msgid "Auditing Settings"
msgstr "Nastavenia kontroly"

msgid "All Records"
msgstr "Všetky záznamy"

msgid "Males Only"
msgstr "Iba mužov"

msgid "Females Only"
msgstr "Iba ženy"

msgid "Configure Rules..."
msgstr "Konfigurácia pravidiel..."

msgid "Match Pre-Revolutionary Orthography"
msgstr "Zhoda s predrevolučnou ortografiou"

msgid "Audit Database"
msgstr "Skontrolovať databázu"

msgid "Select All Safe Corrections"
msgstr "Vybrať všetky bezpečné opravy"

msgid "Apply Selected Corrections"
msgstr "Aplikovať vybrané opravy"

msgid "Configure Rules"
msgstr "Konfigurácia pravidiel"

msgid "Individual"
msgstr "Jedinec"

msgid "Current"
msgstr "Aktuálne"

msgid "Correction"
msgstr "Korekcia"

msgid "Conf"
msgstr "Konfigurovať"

msgid "Ref Year"
msgstr "Referenčný rok"

msgid "Explanation"
msgstr "Vysvetlenie"

msgid "Audit Complete!"
msgstr "Kontrola dokončená!"

msgid "No Results"
msgstr "Žiadne výsledky"

msgid "No issues found."
msgstr "Neboli nájdené žiadne problémy."

msgid "Use"
msgstr "Použiť"

msgid "Search and Replace Options"
msgstr "Možnosti vyhľadávania a nahradzovania"

msgid "Source Name:"
msgstr "Zdrojové meno:"

msgid "e.g. Иоанн"
msgstr "napr. Иоанн"

msgid "Target Name:"
msgstr "Cieľové meno:"

msgid "e.g. Иван"
msgstr "napr. Иван"

msgid "Match Mode:"
msgstr "Režim zhody:"

msgid "Exact Match"
msgstr "Presná zhoda"

msgid "Substring"
msgstr "Časť reťazca"

msgid "Regular Expression"
msgstr "Regulárny výraz"

msgid "Scan for Names"
msgstr "Skenovať mená"

msgid "Preserve original name as alternative"
msgstr "Zachovať pôvodné meno ako alternatívu"

msgid "Select All"
msgstr "Vybrať všetky"

msgid "Proposed"
msgstr "Navrhované"

msgid "Infer East Slavic Patronymics"
msgstr "Odvodiť východoslovanské patronymá"

msgid "Rename Given Names"
msgstr "Premenovať dané (krstné) mená"

msgid "Audit Patronymics"
msgstr "Skontrolovať patronymá"

#, python-brace-format
msgid ""
"Missing Patronymic Detected.\n"
"Suggested: {0}\n"
"Based on father: {1}"
msgstr ""
"Zistené chýbajúce patronymické meno.\n"
"Navrhované: {0}\n"
"Na základe otca: {1}"

msgid "Navigate to an individual to check patronymic status."
msgstr "Prejdite na konkrétnu osobu a skontrolujte stav otcovského mena."

msgid "No active person selected."
msgstr "Nebola vybraná žiadna aktívna osoba."

msgid ""
"Patronymic inference can't be inferred for non-binary or unknown genders."
msgstr "Otcovské meno nemožno odvodiť pre nebinárne alebo neznáme pohlavia."

msgid "Individual already has a recorded patronymic."
msgstr "Osoba už má zaznamenané otcovské meno."

msgid "No attached father found in database family records."
msgstr "V databáze rodinných záznamov nebol nájdený žiadny priradený otec."

msgid "Father lacks a recorded first name."
msgstr "Otec nemá zaznamenané prvé (krstné) meno."

msgid "Could not generate valid morphology patterns."
msgstr "Nepodarilo sa vygenerovať platné morfologické vzory."

msgid "Patronymic applied successfully!"
msgstr "Otcovské meno bolo úspešne priradené!"

msgid "Apply Suggestion"
msgstr "Aplikovať návrh"

