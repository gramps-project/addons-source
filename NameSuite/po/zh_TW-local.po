msgstr "設定規則"

msgid "Individual"
msgstr "人物"

msgid "Current"
msgstr "目前值"

msgid "Correction"
msgstr "修正值"

msgid "Conf"
msgstr "信心度"

msgid "Ref Year"
msgstr "參考年份"

msgid "Explanation"
msgstr "說明"

msgid "Audit Complete!"
msgstr "稽核完成！"

msgid "No Results"
msgstr "無結果"

