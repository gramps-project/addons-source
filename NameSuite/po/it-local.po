msgid "Audit Given and Patronymic Names"
msgstr "Verifica nomi e patronimici"

msgid ""
"Tools to rename given name, audit and infer patronymic (East Slavic) names."
msgstr ""
"Strumenti per rinominare i nomi, verificare e dedurre i patronimici (slavi "
"orientali)."

msgid "Patronymic Suggestion"
msgstr "Suggerimento di patronimico"

msgid "Suggests (East Slavic) patronymic names in real-time as you navigate."
msgstr ""
"Suggerisce i patronimici (slavi orientali) in tempo reale durante la "
"navigazione."

msgid "Use"
msgstr "Usa"

#, python-brace-format
msgid ""
"Missing Patronymic Detected.\n"
"Suggested: {0}\n"
"Based on father: {1}"
msgstr ""
"Rilevato patronimico mancante.\n"
"Suggerito: {0}\n"
"In base al padre: {1}"

msgid "Navigate to an individual to check patronymic status."
msgstr "Vai a una persona per controllare lo stato del patronimico."

msgid "No active person selected."
msgstr "Nessuna persona attiva selezionata."

msgid ""
"Patronymic inference can't be inferred for non-binary or unknown genders."
msgstr ""
"Il patronimico non può essere dedotto per sesso non binario o sconosciuto."

msgid "Individual already has a recorded patronymic."
msgstr "La persona ha già un patronimico registrato."

msgid "No attached father found in database family records."
msgstr "Nessun padre collegato trovato nei record di famiglia del database."

msgid "Father lacks a recorded first name."
msgstr "Il padre non ha un nome registrato."

msgid "Could not generate valid morphology patterns."
msgstr "Impossibile generare schemi morfologici validi."

msgid "Patronymic applied successfully!"
msgstr "Patronimico applicato correttamente!"

msgid "Apply Suggestion"
msgstr "Applica il suggerimento"

msgid "Infer East Slavic Patronymics"
msgstr "Deduci i patronimici slavi orientali"

