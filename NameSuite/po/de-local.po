#, python-brace-format
msgid ""
"Missing Patronymic Detected.\n"
"Suggested: {0}\n"
"Based on father: {1}"
msgstr ""
"Fehlendes Patronymikum erkannt.\n"
"Vorschlag: {0}\n"
"Basierend auf dem Vater: {1}"

msgid "Navigate to an individual to check patronymic status."
msgstr "Navigiere zu einer Person, um den Status des Patronyms zu überprüfen."

msgid "No active person selected."
msgstr "Keine aktive Person ausgewählt."

msgid ""
"Patronymic inference can't be inferred for non-binary or unknown genders."
msgstr ""
"Bei nicht-binären oder unbekannten Geschlechtern kann kein Patronym "
"abgeleitet werden."

msgid "Individual already has a recorded patronymic."
msgstr "Für diese Person ist bereits ein Patronymikum erfasst."

msgid "No attached father found in database family records."
msgstr ""
"Keine Angaben zu einem Vater in den Familiendaten der Datenbank gefunden."

msgid "Father lacks a recorded first name."
msgstr "Der Vorname des Vaters ist nicht angegeben."

msgid "Could not generate valid morphology patterns."
msgstr "Es konnten keine gültigen Morphologiemuster generiert werden."

msgid "Patronymic applied successfully!"
msgstr "Patronymikum erfolgreich eingefügt!"

msgid "Apply Suggestion"
msgstr "Vorschlag anwenden"

