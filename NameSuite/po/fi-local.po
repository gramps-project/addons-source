msgid ""
"Missing Patronymic Detected.\n"
"Suggested: {0}\n"
"Based on father: {1}"
msgstr ""
"Puuttuva patronyymi havaittu.\n"
"Ehdotus: {0}\n"
"Isän mukaan: {1}"

msgid "Navigate to an individual to check patronymic status."
msgstr "Siirry henkilön tarkastaaksesi patronyymin."

msgid "No active person selected."
msgstr "Aktiivista henkilöä ei ole asetettu."

msgid ""
"Patronymic inference can't be inferred for non-binary or unknown genders."
msgstr ""
"Isännimeä ei voi päätellä ei-binäärisen tai tuntemattoman sukupuolen "
"perusteella."

