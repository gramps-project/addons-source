#, python-brace-format
msgid ""
"Missing Patronymic Detected.\n"
"Suggested: {0}\n"
"Based on father: {1}"
msgstr ""
"Patronímico em falta detectado.\n"
"Sugerido: {0}\n"
"Baseado no pai: {1}"

msgid "Navigate to an individual to check patronymic status."
msgstr "Aceda a um perfil individual para verificar o seu estado patronímico."

msgid "No active person selected."
msgstr "Sem indivíduo activo seleccionado."

msgid ""
"Patronymic inference can't be inferred for non-binary or unknown genders."
msgstr ""
"Impossível inferir o patronímico no caso de sexos não binários ou "
"desconhecidos."

msgid "Individual already has a recorded patronymic."
msgstr "O indivíduo já tem um patronímico registado."

msgid "No attached father found in database family records."
msgstr "Nenhum pai associado nos registos familiares da base de dados."

msgid "Father lacks a recorded first name."
msgstr "Não há registo do nome próprio do pai."

msgid "Could not generate valid morphology patterns."
msgstr "Impossível gerar padrões morfológicos válidos."

msgid "Patronymic applied successfully!"
msgstr "O patronímico foi aplicado com sucesso!"

