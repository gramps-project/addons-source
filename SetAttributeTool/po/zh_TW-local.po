msgid "Select filter to restrict people"
msgstr "選取篩選器以限定人物範圍"

msgid "Attribute type to add or edit"
msgstr "要新增或編輯的屬性類型"

msgid "Attribute value to add or edit"
msgstr "要新增或編輯的屬性值"

msgid "Remove attribute type and value set"
msgstr "移除已設定的屬性類型及值"

msgid "Set Attribute"
msgstr "設定屬性"

msgid "Processing...\n"
msgstr "處理中...\n"

msgid "Setting attributes..."
msgstr "正在設定屬性..."

#, python-format
msgid ""
"Setting '%s' attributes to '%s'...\n"
"\n"
msgstr ""
"正在將「%s」屬性設定為「%s」...\n"
"\n"

#, python-format
msgid ""
"\n"
"Set %d '%s' attributes to '%s'\n"
msgstr ""
"\n"
"將 %d 個「%s」屬性設為「%s」\n"

msgid "Remove Attribute"
msgstr "移除屬性"

msgid "Removing attributes..."
msgstr "正在移除屬性..."

#, python-format
msgid ""
"\n"
"Removing %d '%s' attributes to '%s'\n"
msgstr ""
"\n"
"正在移除第 %d 位人物的「%s」屬性，篩選值為「%s」\n"

msgid "Done!\n"
msgstr "完成！\n"

msgid "Set an attribute to a given value."
msgstr "將屬性設為指定值。"
