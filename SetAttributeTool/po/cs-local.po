msgid ""
"\n"
"Set %d '%s' attributes to '%s'\n"
msgstr ""
"\n"
"Počet nastavených atributů: %d; typ: '%s', hodnota: '%s'\n"

msgid "Remove Attribute"
msgstr "Odstranit atribut"

msgid "Removing attributes..."
msgstr "Odstraňování atributů..."

