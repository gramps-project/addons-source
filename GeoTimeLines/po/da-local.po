msgid "TimeLines Map"
msgstr "Tidsliniekort"

msgid "Choose View Format"
msgstr "Vælg format på visning"

msgid "Almost done"
msgstr "Næsten udført"

msgid "Gathering data"
msgstr "Samler data"

#, python-format
msgid "Number of Persons: %s"
msgstr "Antal personer: %s"

msgid ""
"Stagger the map markers\n"
"to differentiate different\n"
"markers at the same location"
msgstr ""
"Skub kortmarkørerne\n"
"for at skelne mellem forskellige\n"
"markører på samme plads"

msgid ""
"Stagger Radius (hectometers)\n"
"as measured along the equator\n"
"(includes latitude distortion)"
msgstr ""
"Flyt Radius (hektometer)\n"
"som målt ved ækvator\n"
"(medtag breddegradsforvrængning)"

msgid ""
"Display markers for unknown ancestors\n"
"based on earliest descendant location"
msgstr ""
"Vis mærker for ukendte aner\n"
"baseret på tidligste efterkommersted"

msgid ""
"Days to keep lines on the map after\n"
"an event"
msgstr ""
"Dage hvor linjer på kortet skal beholdes efter\n"
"en begivenhed"

msgid "Use custom map icons"
msgstr "Benyt brugerdefineredee kortikoner"

msgid ""
"If there is no birth event for a person, their age\n"
"is assumed to be this at their first event"
msgstr ""
"Hvis der ikke er en fødselsbegivenhed for en person, bliver\n"
"deres alder anslået til at være dette ved en første begivenhed"

msgid "Number of steps"
msgstr "Antal trin"

msgid "Type of steps"
msgstr "Typer trin"

msgid "Steps per millisecond"
msgstr "Trin per millisekund"

msgid "Show map travel lines on startup"
msgstr "Viser kortrejselinier ved opstart"

msgid "Show time ticks on navigation bar on startup"
msgstr "Vis tidsmærker i navigationsfeltet ved opstart"

msgid ""
"A view showing all the places visited by a person or persons on various date."
msgstr ""
"Et billede der viser alle steder som en person har besøgt på forskellige "
"datoer."

msgid "TimeLines map"
msgstr "Tidsliniekort"
