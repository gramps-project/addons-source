msgid "AncestorFill"
msgstr "Doplnenie predkov"

msgid "Report on the filling of the tree"
msgstr "Správa o naplnení stromu"

#, python-format
msgid "AncestorFill for %s"
msgstr "Naplnenie predkov pre %s"

msgid "Generation "
msgstr "Generácia "

msgid "Number of Ancestors found "
msgstr "Počet nájdených predkov "

msgid "Percent of Ancestors found "
msgstr "Percento nájdených predkov "

msgid "Number of unique Ancestors found "
msgstr "Počet nájdených jedinečných predkov "

msgid "Number of theoretical Ancestors "
msgstr "Počet teoretických predkov "

msgid "Pedigree Collapse "
msgstr "Kolaps rodokmeňa "

msgid "Total Number of Ancestors found "
msgstr "Celkový počet nájdených predkov "

msgid "Total Number of unique Ancestors found "
msgstr "Celkový počet nájdených jedinečných predkov "

msgid ""
"\n"
"\n"
"Note: This report only counts ancestors with a parent-child relationship of "
"birth."
msgstr ""
"\n"
"\n"
"Poznámka: Táto správa počíta iba predkov s príbuzenským vzťahom medzi "
"rodičom a dieťaťom typu „narodené”."

msgid "Filled digit"
msgstr "Vyplnená číslica"

msgid ""
"The number of digits after comma to include in the report for the percentage "
"of ancestor found at a given generation"
msgstr ""
"Počet číslic za čiarkou, ktoré sa majú zahrnúť do správy o percentách "
"nájdených predkov v danej generácii"

msgid "Collapsed digit"
msgstr "Zúžená číslica"

msgid ""
"The number of digits after comma to include in the report for the pedigree "
"Collapse"
msgstr ""
"Počet číslic za čiarkou, ktoré sa majú zahrnúť do správy pre Kolaps rodokmeňa"

msgid "Display theoretical"
msgstr "Zobraziť teoretické"

msgid "Whether to display the theoretical number of ancestor by generation"
msgstr "Či zobraziť teoretický počet predkov podľa generácie"

msgid "The style used for the title of the page."
msgstr "Štýl použitý pre titul strany."
