msgid "AncestorFill"
msgstr "Relleno de ancestros"

msgid "Report on the filling of the tree"
msgstr "Informe sobre el llenado del árbol"

#, python-format
msgid "AncestorFill for %s"
msgstr "AncestorFill para %s"

msgid "Generation "
msgstr "Generación "

msgid "Number of Ancestors found "
msgstr "Número de Ancestros encontrados "

msgid "Percent of Ancestors found "
msgstr "Porcentaje de Ancestros encontrados "

msgid "Number of unique Ancestors found "
msgstr "Número de Ancestros únicos encontrados "

msgid "Number of theoretical Ancestors "
msgstr "Número de Ancestros teóricos "

msgid "Pedigree Collapse "
msgstr "Colapso del Pedigrí "

msgid "Total Number of Ancestors found "
msgstr "Número Total de Ancestros encontrados "

msgid "Total Number of unique Ancestors found "
msgstr "Número Total de Ancestros únicos encontrados "

msgid ""
"\n"
"\n"
"Note: This report only counts ancestors with a parent-child relationship of "
"birth."
msgstr ""
"\n"
"\n"
"Nota: este informe solo cuenta ancestros con una relación de nacimiento "
"padre-hijo."

msgid "Filled digit"
msgstr "Dígito completado"

msgid ""
"The number of digits after comma to include in the report for the percentage "
"of ancestor found at a given generation"
msgstr ""
"El número de dígitos tras la coma que se deben incluir en el informe para el "
"porcentaje de antepasado encontrado en una generación determinada"

msgid "Collapsed digit"
msgstr "Dígito colapsado"

msgid ""
"The number of digits after comma to include in the report for the pedigree "
"Collapse"
msgstr ""
"El número de dígitos tras la coma para incluir en el informe para el "
"pedigree Colapso"

msgid "Display theoretical"
msgstr "Representación teorética"

msgid "Whether to display the theoretical number of ancestor by generation"
msgstr "Si exhibe el número teórico de ancestros por generación"

msgid "The style used for the title of the page."
msgstr "El estilo utilizado para el título de la página."
