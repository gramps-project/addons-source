msgid "AncestorFill"
msgstr "Fa kitöltése"

msgid "Report on the filling of the tree"
msgstr "Beszámoló a fa kitötéséről"

#, python-format
msgid "AncestorFill for %s"
msgstr "Fa kitöltése neki: %s"

msgid "Generation "
msgstr "Generációk "

msgid "Number of Ancestors found "
msgstr "Talált felmenők száma "

msgid "Percent of Ancestors found "
msgstr "Talált felmenők százaléka "

msgid "Number of unique Ancestors found "
msgstr "Talált egyedi ősök száma "

msgid "Number of theoretical Ancestors "
msgstr "Elméleti ősök száma "

msgid "Pedigree Collapse "
msgstr "Becsuk "

msgid "Total Number of Ancestors found "
msgstr "A megtalált ősök összes száma "

msgid "Total Number of unique Ancestors found "
msgstr "A megtalált egyedi ősök összes száma "

msgid ""
"\n"
"\n"
"Note: This report only counts ancestors with a parent-child relationship of "
"birth."
msgstr ""
"\n"
"\n"
"Megjegyzés: Ez a jelentés csak a születéskor szülő-gyermek "
"kapcsolattalrendelkező ősöket számolja meg."

msgid "Filled digit"
msgstr "Tizedes"

msgid ""
"The number of digits after comma to include in the report for the percentage "
"of ancestor found at a given generation"
msgstr ""
"A tizedesvessző utáni számjegyek száma, amely egy adott generációban talált "
"ősöket megjeleníti a beszámolóban"

msgid "Collapsed digit"
msgstr "Bezárt tizedes"

msgid ""
"The number of digits after comma to include in the report for the pedigree "
"Collapse"
msgstr ""
"A tizedesvessző utáni számjegyek száma, amelyet a származás becsukott "
"beszámolójában mutasson"

msgid "Display theoretical"
msgstr "Elméleti szám mutatása"

msgid "Whether to display the theoretical number of ancestor by generation"
msgstr "Megmutassa-e a generációnkénti ősök elméleti számát"

msgid "The style used for the title of the page."
msgstr "Az oldal címénél használt stílus"
