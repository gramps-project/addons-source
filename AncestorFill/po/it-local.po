msgid "Report on the filling of the tree"
msgstr "Resoconto sul riempimento dell'albero"

#, python-format
msgid "AncestorFill for %s"
msgstr "AncestorFill per %s"

msgid "Generation "
msgstr "Generazione "

msgid "Number of Ancestors found "
msgstr "Numero di ascendenti trovati "

msgid "Percent of Ancestors found "
msgstr "Percentuale di ascendenti trovati "

msgid "Number of unique Ancestors found "
msgstr "Numero di ascendenti unici trovati "

msgid "Number of theoretical Ancestors "
msgstr "Numero teorico di ascendenti "

msgid "Total Number of Ancestors found "
msgstr "Numero totale di ascendenti trovati "

msgid "Total Number of unique Ancestors found "
msgstr "Numero totale di ascendenti unici trovati "

msgid ""
"\n"
"\n"
"Note: This report only counts ancestors with a parent-child relationship of "
"birth."
msgstr ""
"\n"
"\n"
"Nota: Questo resoconto conta solo gli antenati che hanno una relazione "
"genitore-figlio alla nascita."

msgid "Filled digit"
msgstr "Numeri riempiti"

msgid ""
"The number of digits after comma to include in the report for the percentage "
"of ancestor found at a given generation"
msgstr ""
"Il numero di cifre dopo virgola da includere nel rapporto per la percentuale "
"di ascendenti trovati in una data generazione"

msgid "Collapsed digit"
msgstr "Numero Collapse"

msgid ""
"The number of digits after comma to include in the report for the pedigree "
"Collapse"
msgstr ""
"Il numero di cifre dopo la virgola da includere nel report per il pedigree "
"Collapse"

msgid "Display theoretical"
msgstr "Mostra teorico"

msgid "Whether to display the theoretical number of ancestor by generation"
msgstr "Se visualizzare o meno il numero teorico di ascendenti per generazione"

msgid "The style used for the title of the page."
msgstr "Lo stile usato per il titolo della pagina."
