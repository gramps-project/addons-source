msgid "Gramplet for importing text"
msgstr "גראמפלט לייבוא מלל"

msgid "VCard import"
msgstr "ייבוא VCard"

#, python-format
msgid ""
"The opened file has media path %s, which conflicts with the media path of "
"the family tree you import into. The original media path has been retained. "
"Copy the files to a correct directory or change the media path in the "
"Preferences."
msgstr ""
"לקובץ שנפתח יש נתיב מדיה %s, שמתנגש עם נתיב המדיה של אילן־היוחסין שאליו "
"מתבצע הייבוא. נתיב המדיה המקורי נשמר. יש להעתיק את הקבצים למחיצה נכונה או "
"לשנות את נתיב המדיה בהעדפות."

msgid ""
"Enter text to import and then click\n"
"the Import button at bottom"
msgstr ""
"יש להזין מלל לייבוא ולאחר מכן להקיש\n"
"על לחצן הייבוא למטה"

msgid "_Import"
msgstr "_ייבוא"

msgid "Import done"
msgstr "ייבוא הושלם"

msgid "Importing Text..."
msgstr "ייבוא מלל..."

msgid "Can't determine type of import"
msgstr "לא ניתן לקבוע את סוג הייבוא"
