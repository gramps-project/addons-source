msgid "Media Report"
msgstr "Raport mediów"

msgid "Generates report including images, image data and notes."
msgstr "Generuje raport zawierający obrazy, dane obrazów i notatki."

msgid "INFO"
msgstr "Informacje"

msgid "You have to select an image to generate this report."
msgstr "Musisz wybrać obraz, aby wygenerować ten raport."

msgid ""
"You have to select a custom note or uncheck the option 'include custom note' "
"to generate this report."
msgstr ""
"Musisz wybrać niestandardową notatkę lub odznaczyć opcję 'dołącz "
"niestandardową notatkę', aby wygenerować ten raport."

msgid "This report only supports PDF as output file format."
msgstr "Ten raport obsługuje tylko format pliku PDF jako wyjściowy."

msgid "General:"
msgstr "Ogólne:"

msgid "Image type:"
msgstr "Typ obrazu:"

msgid "Heading"
msgstr "Nagłówek"

msgid "Select a media file for this report"
msgstr "Wybierz plik medialny dla tego raportu"

msgid "Custom note"
msgstr "Niestandardowa notatka"

msgid "Select a note for this report"
msgstr "Wybierz notatkę dla tego raportu"

msgid "Include custom note"
msgstr "Dołącz niestandardową notatkę"

msgid "The custom note will be included"
msgstr "Niestandardowa notatka zostanie dołączona"

msgid "Include referenced people"
msgstr "Dołącz powiązane osoby"

msgid "Referenced people will be included"
msgstr "Powiązane osoby zostaną dołączone"

msgid "Include media data"
msgstr "Dołącz dane mediów"

msgid "Tags, notes and attributes will be included"
msgstr "Etykiety, notatki i atrybuty zostaną dołączone"

msgid "Media width"
msgstr "Szerokość mediów"

#, no-python-format
msgid "Maximum media width in % of available page width."
msgstr "Maksymalna szerokość mediów w % dostępnej szerokości strony."

msgid "Media height"
msgstr "Wysokość mediów"

#, no-python-format
msgid "Maximum media height in % of available page height."
msgstr "Maksymalna wysokość mediów w % dostępnej wysokości strony."
