msgid "INFO"
msgstr "INFO"

msgid "You have to select an image to generate this report."
msgstr "Na vygenerovanie tejto správy musíte vybrať obrázok."

msgid ""
"You have to select a custom note or uncheck the option 'include custom note' "
"to generate this report."
msgstr ""
"Na vygenerovanie tejto správy musíte vybrať vlastnú poznámku alebo zrušiť "
"začiarknutie voľby „zahrnúť vlastnú poznámku“."

msgid "This report only supports PDF as output file format."
msgstr "Táto správa podporuje ako výstupný formát iba PDF."

msgid "General:"
msgstr "Všeobecné:"

msgid "Image type:"
msgstr "Typ obrázku:"

msgid "Heading"
msgstr "Nadpis"

msgid "Select a media file for this report"
msgstr "Vyberte mediálny súbor pre túto správu"

msgid "Custom note"
msgstr "Vlastná poznámka"

msgid "Select a note for this report"
msgstr "Vyberte poznámku pre túto správu"

msgid "Include custom note"
msgstr "Zahrnúť vlastnú poznámku"

msgid "The custom note will be included"
msgstr "Vlastná poznámka bude zahrnutá"

msgid "Include referenced people"
msgstr "Zahrnúť odkazované osoby"

msgid "Referenced people will be included"
msgstr "Odkazované osoby budú zahrnuté"

msgid "Include media data"
msgstr "Zahrnúť mediálne údaje"

msgid "Tags, notes and attributes will be included"
msgstr "Štítky, poznámky a atribúty budú zahrnuté"

msgid "Media width"
msgstr "Šírka média"

#, no-python-format
msgid "Maximum media width in % of available page width."
msgstr "Maximálna šírka média v % dostupnej šírky stránky."

msgid "Media height"
msgstr "Výška média"

#, no-python-format
msgid "Maximum media height in % of available page height."
msgstr "Maximálna výška média v % dostupnej výšky stránky."

msgid "Media Report"
msgstr "Správa o médiách"

msgid "Generates report including images, image data and notes."
msgstr "Generuje správu obsahujúcu obrázky, údaje o obrázkoch a poznámky."
