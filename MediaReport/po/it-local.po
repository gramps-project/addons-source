msgid "INFO"
msgstr "INFO"

msgid "You have to select an image to generate this report."
msgstr "Devi selezionare un'immagine per generare questo resoconto."

msgid ""
"You have to select a custom note or uncheck the option 'include custom note' "
"to generate this report."
msgstr ""
"Devi selezionare una nota personalizzata, oppure deselezionare l'opzione "
"'includi note personalizzate', per generare questo resoconto."

msgid "This report only supports PDF as output file format."
msgstr "Questo resoconto supporta solo PDF come formato del file di uscita."

msgid "General:"
msgstr "Generale:"

msgid "Image type:"
msgstr "Tipo di immagine:"

msgid "Heading"
msgstr "Titolo"

msgid "Select a media file for this report"
msgstr "Seleziona un oggetto multimediale per questo resoconto"

msgid "Custom note"
msgstr "Nota personalizzata"

msgid "Select a note for this report"
msgstr "Seleziona una nota per questo resoconto"

msgid "Include custom note"
msgstr "Includi nota personalizzata"

msgid "The custom note will be included"
msgstr "La nota personalizzata sarà inclusa"

msgid "Include referenced people"
msgstr "Includi le persone citate"

msgid "Referenced people will be included"
msgstr "Le persone citate saranno incluse"

msgid "Include media data"
msgstr "Includi i dati dell'oggetto multimediale"

msgid "Tags, notes and attributes will be included"
msgstr "Etichette, note e attributi saranno inclusi"

msgid "Media width"
msgstr "Larghezza oggetto multimediale"

#, no-python-format
msgid "Maximum media width in % of available page width."
msgstr ""
"Massima larghezza dell'oggetto multimediale in percentuale della larghezza "
"disponibile della pagina."

msgid "Media height"
msgstr "Altezza dell'oggetto multimediale"

#, no-python-format
msgid "Maximum media height in % of available page height."
msgstr ""
"Massima altezza dell'oggetto multimediale in percentuale dell'altezza "
"disponibile della pagina."

msgid "Media Report"
msgstr "Resoconto file multimediali"

msgid "Generates report including images, image data and notes."
msgstr ""
"Genera un resoconto includendo immagini, i dati delle immagini, e le note."
