msgid "Ancestor Tree Expanded"
msgstr "Rozšířený strom předků"

msgid ""
"Expanded Ancestor Graph showing direct ancestors, siblings, cousins and "
"spouses."
msgstr ""
"Rozšířený graf předků zobrazující přímé předky, sourozence, bratrance, "
"sestřenice a partnery."

#, python-format
msgid "Ancestor Tree Expanded for %s"
msgstr "Rozšířený strom předků – %s"

msgid "Tree Truncated"
msgstr "Strom byl zkrácen"

msgid ""
"The generated tree reached the 400 people safety limit and has been "
"truncated.\n"
"\n"
"Please reduce the number of generations or disable some options to see all "
"branches."
msgstr ""
"Vytvořený strom dosáhl bezpečnostního limitu 400 osob a byl zkrácen.\n"
"\n"
"Chcete-li zobrazit všechny větve, snižte počet generací nebo vypněte některé "
"možnosti."

msgid "Include descendants of the center person"
msgstr "Zahrnout potomky výchozí osoby"

msgid ""
"Whether to display the children and full descending lines of the center "
"person"
msgstr "Zda zobrazit děti a celé potomkovské linie výchozí osoby"

msgid "Include siblings of ancestors"
msgstr "Zahrnout sourozence předků"

msgid "Whether to display the siblings of direct ancestors"
msgstr "Zda se mají zobrazovat sourozenci přímých předků"

msgid "Include cousins (collateral descendants)"
msgstr "Zahrnout bratrance a sestřenice (potomky ve vedlejších liniích)"

msgid ""
"Whether to display the cousins and descendants of the ancestors' siblings"
msgstr ""
"Zda se mají zobrazovat bratranci, sestřenice a potomci sourozenců předků"

msgid "Descendant Generations"
msgstr "Generací potomků"

msgid "The number of descendant generations to include"
msgstr "Zvolte počet generací potomků"

msgid "Whether to resize the page to fit the size of the tree."
msgstr "Zda přizpůsobit velikost stránky velikosti stromu."

msgid "Use random colors for family lines"
msgstr "Použít náhodné barvy rodinných linií"

msgid "Draw each family's connecting lines with a distinct color."
msgstr "Spojovací čáry každé rodiny kreslit odlišnou barvou."

msgid "The bold style used for the names."
msgstr "Tučný styl použitý pro jména."
