msgid "Ancestor Tree Expanded"
msgstr "Laajennettu esivanhempien puu"

msgid ""
"Expanded Ancestor Graph showing direct ancestors, siblings, cousins and "
"spouses."
msgstr ""
"Laajennettu esivanhempien kaavio näyttäen suorat esivanhemmat, sisarukset, "
"serkut ja puolisot."

#, python-format
msgid "Ancestor Tree Expanded for %s"
msgstr "Henkilön %s laajennettu esivanhempien puu"

msgid "Tree Truncated"
msgstr "Katkaistu puu"

msgid ""
"The generated tree reached the 400 people safety limit and has been "
"truncated.\n"
"\n"
"Please reduce the number of generations or disable some options to see all "
"branches."
msgstr ""
"Luotu sukupuu saavutti 400 henkilön turvarajan ja se on katkaistu.\n"
"\n"
"Vähennä sukupolvien määrää tai poista joitakin valintoja nähdäksesi kaikki "
"haarat."

msgid "Include descendants of the center person"
msgstr "Näyttää nykyisen henkilön jälkeläisten lukumäärän"

msgid ""
"Whether to display the children and full descending lines of the center "
"person"
msgstr "Näytetäänkö valitun henkilön lapset ja täydet jälkeläislinjat"

msgid "Include siblings of ancestors"
msgstr "Sisällytä esivanhempien sisarukset"

msgid "Whether to display the siblings of direct ancestors"
msgstr "Näytetäänkö suorien esivanhempien sisarukset"

msgid "Include cousins (collateral descendants)"
msgstr "Sisällytä serkut (sivujälkeläiset)"

msgid ""
"Whether to display the cousins and descendants of the ancestors' siblings"
msgstr "Näytetäänkö esivanhempien sisarusten serkut ja jälkeläiset"

msgid "Descendant Generations"
msgstr "Jälkeläisten sukupolvet"

msgid "The number of descendant generations to include"
msgstr "Sisällytettävien jälkipolvien lukumäärä"

msgid "Whether to resize the page to fit the size of the tree."
msgstr "Muutetaanko sivun kokoa puun koon mukaan."

msgid "Use random colors for family lines"
msgstr "Käytä sukulinjoille satunnaisia värejä"

msgid "Draw each family's connecting lines with a distinct color."
msgstr "Piirrä kunkin perheen yhdysviivat omilla väreillään."

msgid "The bold style used for the names."
msgstr "Nimien korostettu tyyli."
