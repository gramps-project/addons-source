msgid "Ancestor Tree Expanded"
msgstr "Rozšírený strom predkov"

msgid ""
"Expanded Ancestor Graph showing direct ancestors, siblings, cousins and "
"spouses."
msgstr ""
"Rozšírený graf predkov zobrazujúci priamych predkov, súrodencov, bratancov, "
"sesternice a manželov."

#, python-format
msgid "Ancestor Tree Expanded for %s"
msgstr "Rozšírený strom predkov pre %s"

msgid "Tree Truncated"
msgstr "Skrátený strom"

msgid ""
"The generated tree reached the 400 people safety limit and has been "
"truncated.\n"
"\n"
"Please reduce the number of generations or disable some options to see all "
"branches."
msgstr ""
"Vygenerovaný strom dosiahol bezpečnostný limit 400 osôb a bol skrátený.\n"
"\n"
"Prosím, znížte počet generácií alebo vypnite niektoré možnosti, aby ste "
"videli všetky vetvy."

msgid "Include descendants of the center person"
msgstr "Zahrnúť potomkov ústrednej osoby"

msgid ""
"Whether to display the children and full descending lines of the center "
"person"
msgstr "Či zobraziť deti a celé zostupné línie ústrednej osoby"

msgid "Include siblings of ancestors"
msgstr "Zahrnúť súrodencov predkov"

msgid "Whether to display the siblings of direct ancestors"
msgstr "Či zobraziť súrodencov priamych predkov"

msgid "Include cousins (collateral descendants)"
msgstr "Zahrnúť bratrancov a sesternice (vedľajších potomkov)"

msgid ""
"Whether to display the cousins and descendants of the ancestors' siblings"
msgstr "Či zobraziť bratrancov, sesternice a potomkov súrodencov predkov"

msgid "Descendant Generations"
msgstr "Generácie potomkov"

msgid "The number of descendant generations to include"
msgstr "Počet generácií potomkov, ktoré sa majú zahrnúť"

msgid "Whether to resize the page to fit the size of the tree."
msgstr "Či zmeniť veľkosť stránky tak, aby sa prispôsobila veľkosti stromu."

msgid "Use random colors for family lines"
msgstr "Použiť náhodné farby pre rodové línie"

msgid "Draw each family's connecting lines with a distinct color."
msgstr "Každú spojovaciu čiaru medzi rodinami znázorniť odlišnou farbou."

msgid "The bold style used for the names."
msgstr "Tučný štýl použitý pre mená."
