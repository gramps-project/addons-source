msgid "Ancestor Tree Expanded"
msgstr "Árvore ascendente expandida"

msgid ""
"Expanded Ancestor Graph showing direct ancestors, siblings, cousins and "
"spouses."
msgstr ""
"Gráfico de ascendentes expandido que mostra antepassados directos, irmãos, "
"primos e cônjuges."

#, python-format
msgid "Ancestor Tree Expanded for %s"
msgstr "Árvore de ascendentes de %s"

msgid "Tree Truncated"
msgstr "Árvore truncada"

msgid ""
"The generated tree reached the 400 people safety limit and has been "
"truncated.\n"
"\n"
"Please reduce the number of generations or disable some options to see all "
"branches."
msgstr ""
"A árvore gerada atingiu o limite de segurança de 400 pessoas e foi "
"truncada.\n"
"\n"
"Por favor, reduza o número de gerações ou desactive algumas opções para ver "
"todos os ramos."

msgid "Include descendants of the center person"
msgstr "Incluir descendentes do indivíduo central"

msgid ""
"Whether to display the children and full descending lines of the center "
"person"
msgstr ""
"Se se devem mostrar os filhos e todas as linhas descendentes do indivíduo "
"central"

msgid "Include siblings of ancestors"
msgstr "Incluir irmãos de ascendentes"

msgid "Whether to display the siblings of direct ancestors"
msgstr "Se se devem mostrar os irmãos de ascendentes directos"

msgid "Include cousins (collateral descendants)"
msgstr "Incluir primos (descendentes colaterais)"

msgid ""
"Whether to display the cousins and descendants of the ancestors' siblings"
msgstr "Se se devem mostrar os primos e descendentes de irmãos de ascendentes"

msgid "Descendant Generations"
msgstr "Gerações descendentes"

msgid "The number of descendant generations to include"
msgstr "O número de gerações descendentes a incluir"

msgid "Whether to resize the page to fit the size of the tree."
msgstr ""
"Se se deve redimensionar a página para se adaptar ao tamanho da árvore."

msgid "Use random colors for family lines"
msgstr "Utilizar cores aleatórias para as linhas familiares"

msgid "Draw each family's connecting lines with a distinct color."
msgstr "Desenhar linhas de ligação de cada família com uma cor diferente."

msgid "The bold style used for the names."
msgstr "O estilo enfatizado usado para nomes."
