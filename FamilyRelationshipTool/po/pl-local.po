msgid "Family Relationship Tool"
msgstr "Narzędzie relacji rodzinnych"

msgid "Mass-edit the family relationship type for a group of families."
msgstr "Masowa edycja typu relacji rodzinnych dla grupy rodzin."

msgid "All Families"
msgstr "Wszystkie rodziny"

msgid ""
"Choose the set of families to process.\n"
"Create custom filters if empty."
msgstr ""
"Wybierz zestaw rodzin do przetworzenia.\n"
"Utwórz własne filtry jeśli lista jest pusta."

msgid "Relationship Type"
msgstr "Typ pokrewieństwa"

msgid ""
"Choose the new family relationship type.\n"
"Custom relationship types aren't supported."
msgstr ""
"Wybierz nowy typ pokrewieństwa rodzinnego.\n"
"Niestandardowe typy pokrewieństwa nie są obsługiwane."

msgid "Process relationships..."
msgstr "Przetwarzanie relacji..."
