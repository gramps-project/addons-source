msgid "Family Relationship Tool"
msgstr "Nástroj pro rodinné vztahy"

msgid "Mass-edit the family relationship type for a group of families."
msgstr "Hromadně upravit typ rodinného vztahu u skupiny rodin."

msgid "All Families"
msgstr "Všechny rodiny"

msgid ""
"Choose the set of families to process.\n"
"Create custom filters if empty."
msgstr ""
"Vyberte skupinu rodin ke zpracování.\n"
"Pokud je seznam prázdný, vytvořte vlastní filtry."

msgid "Relationship Type"
msgstr "Typ vztahu"

msgid ""
"Choose the new family relationship type.\n"
"Custom relationship types aren't supported."
msgstr ""
"Vyberte nový typ rodinného vztahu.\n"
"Vlastní typy vztahů nejsou podporovány."

msgid "Process relationships..."
msgstr "Zpracovávají se vztahy..."
