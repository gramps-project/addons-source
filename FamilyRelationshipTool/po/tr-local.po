msgid "Family Relationship Tool"
msgstr "Aile İlişkileri Aracı"

msgid "Mass-edit the family relationship type for a group of families."
msgstr "Bir grup aile için aile ilişkisi türünü toplu olarak düzenleyin."

msgid "All Families"
msgstr "Tüm Aileler"

msgid ""
"Choose the set of families to process.\n"
"Create custom filters if empty."
msgstr ""
"İşlem yapılacak aile grubunu seçin.\n"
"Boşsa özel filtreler oluşturun."

msgid "Relationship Type"
msgstr "İlişki Türü"

msgid ""
"Choose the new family relationship type.\n"
"Custom relationship types aren't supported."
msgstr ""
"Yeni aile ilişkisi türünü seçin.\n"
"Özel ilişki türleri desteklenmemektedir."

msgid "Process relationships..."
msgstr "İlişkileri işleyin..."
