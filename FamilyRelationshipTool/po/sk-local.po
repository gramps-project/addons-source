msgid "Family Relationship Tool"
msgstr "Nástroj pre rodinné vzťahy"

msgid "Mass-edit the family relationship type for a group of families."
msgstr "Hromadná úprava typu rodinných vzťahov pre skupinu rodín."

msgid "All Families"
msgstr "Všetky rodiny"

msgid ""
"Choose the set of families to process.\n"
"Create custom filters if empty."
msgstr ""
"Vyberte skupinu rodín, ktoré chcete spracovať.\n"
"Ak je pole prázdne, vytvorte vlastné filtre."

msgid "Relationship Type"
msgstr "Druh vzťahu"

msgid ""
"Choose the new family relationship type.\n"
"Custom relationship types aren't supported."
msgstr ""
"Vyberte nový typ rodinného vzťahu.\n"
"Vlastné typy vzťahov nie sú podporované."

msgid "Process relationships..."
msgstr "Spracovať vzťahy..."
