msgid "Family Relationship Tool"
msgstr "כלי קשרי־קרבה במשפחה"

msgid "Mass-edit the family relationship type for a group of families."
msgstr "עריכה גורפת של סוג קשרי־הקרבה במשפחה עבור קבוצת משפחות."

msgid "All Families"
msgstr "כל המשפחות"

msgid ""
"Choose the set of families to process.\n"
"Create custom filters if empty."
msgstr ""
"בחירת קבוצת המשפחות לעיבוד.\n"
"יצירת מסננים מותאמים אם היא ריקה."

msgid "Relationship Type"
msgstr "קשר־קרבה סוג"

msgid ""
"Choose the new family relationship type.\n"
"Custom relationship types aren't supported."
msgstr ""
"בחירת סוג קשרי־הקרבה החדש במשפחה.\n"
"סוגי קשרי־קרבה מותאמים אינם נתמכים."

msgid "Process relationships..."
msgstr "מתבצע עיבוד קשרי־קירבה..."
